// FIXED: `ui::updateTable`'s Set Data `data` takes the rows array (`Struct[]`), which is what the
// table renders. It was declared as one `Struct`, so grouped rows were refused and the workaround
// wrapped them in a struct the table could not show. Kept as a POSITIVE regression test.
use log::{ info }

eventsSimple setTableData() {
    const { groups } = array::groupBy({ arrayIn: [], key: "depot" })
    ui::updateTable({ elementRef: ui::getElement({ elementRef: "s/table" }).element, operation: "Set Data", data: groups })
    info({ message: "table refreshed", toast: false })
}
