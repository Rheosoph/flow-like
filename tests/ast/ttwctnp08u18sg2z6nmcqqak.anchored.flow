    log::info({ message: "label: {label}\ngoal: {goal}\nsource: {src}\nweight: {weight}".format({ goal: getElementValue({ elementRef: getElement({ elementRef: "nkhigr7q8pwxtfzi729flmte/pa-goal" }).element }).value, src: getElementValue({ elementRef: getElement({ elementRef: "nkhigr7q8pwxtfzi729flmte/pa-content" }).element }).value, weight: getElementValue({ elementRef: getElement({ elementRef: "nkhigr7q8pwxtfzi729flmte/pa-weight" }).element }).value, label: getElementValue({ elementRef: getElement({ elementRef: "nkhigr7q8pwxtfzi729flmte/pa-label" }).element }).value }), toast: true })   //@n:y2y24w2fuhhbdcoy7c8zws5u
