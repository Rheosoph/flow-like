function constructPrompt(prompt: string): (out: string) {   //@l:olhizg2b8s6seeuntnn1ni4o
    const { date: date2 } = now()   //@n:j37yxnwykc08y10reikmija1
    return "{prompt}\n\nCurrent Time: {time}".format({ prompt: prompt, time: date2.format("rfc3339") })
}

eventsChat chatEvent(history: History, localSession: Struct, globalSession: Struct, tools: string[], actions: Struct[], attachments: Struct[], user: User) {   //@n:liqnumu9en44cq30tu9t5kez
    const { paths: paths2 } = extractAttachments({ history: history, attachments: attachments })   //@n:szmvl23cetvik1iwmnsslj26
    attachedFiles = {}   //@n:xal689cwuihke7lvj801euk9
    for (const item5 of paths2) {   //@n:yqfyly9dkiziqqa6uqmsxdzs
        let record = set({ structIn: attachedFiles, field: item5.path, value: item5 }).structOut   //@n:bqyfxi2pvgq0oz8i2q5awkyw
        attachedFiles = record   //@n:gwg2sgwfnu4df7rpj4akygr6
    }
    const { date } = now()   //@n:hz2lby9sw0zcg6e90b4etdhs
    const { historyOut: historyOut5 } = history.setSystemPrompt("{System_Prompt}\n\nCurrent Time: {time}\nAttached Files: {files}".format({ systemPrompt: mainAgent, time: date.toSqlTimestamp().timestampLiteral, files: attachedFiles.getFields().fieldNames }))   //@n:po5g5bn1yv4oxvzjo8xcoby2
    loadVariables()   //@n:e4rcqxledg33h95o8xiu91nq
    const streamInvokeAgent = fromModel({ model: mainModel, maxIter: 15, infiniteContext: false, contextMode: "summarize", maxContextTokens: 32000 }).registerMemory(createConfig({ database: memory, embeddingModel: embeddingModel, maxContextTokens: 4000, recallStrategy: "hybrid", recallTopK: 20, autoCompress: true, compressThreshold: 30 })).registerFunctionTools({ tools: [callLibrarian, askUser, internetResearcher, databaseManager] }).streamInvoke(historyOut5)   //@n:e9iktov7xhinlyw0xi8qe65z
    streamInvokeAgent {
        onStream: {
            pushChunk({ chunk: streamInvokeAgent.chunk })   //@n:ztf9lndtph25foybu5kh9hie
        }
        execDone: {
            pushResponse({ response: streamInvokeAgent.response })   //@n:l5kd33uhq2ymtb6kdet7hyh6
            pushStat({ stepName: "Agent", stat: streamInvokeAgent.stats })   //@n:almaszy4h7akmni3exepae3c
        }
    }
}

eventsGeneric addColumn(table: string, columnName: string, sqlExpression: string, payload: Struct) {   //@n:u11llqlso3ki71m6h6x1slvt
    const { database } = open({ name: table, userScoped: true, batchSize: 1000 })   //@n:dcc9b9ioxr85bjr1t6kt0cyt
    const { schema: schema4 } = database.addColumn({ columnName: columnName, sqlExpression: sqlExpression })   //@n:x02c1keipntdeemua38gmrsw
    return schema4   //@n:tu04p0m2yhjlgyrdwracwafa
}

eventsGeneric dropColumn(table: string, columnName: string, payload: Struct) {   //@n:l4jlgqw2hx5gm0373p8klkmm
    const { database: database10 } = open({ name: table, userScoped: true, batchSize: 1000 })   //@n:ig7gcpgqcdnsrbxhuxa8ay62
    const { schema: schema2 } = database10.dropColumn(columnName)   //@n:soofx7wqq0urk182m50vlgu7
    return schema2   //@n:wzuu665q0na68v9umz93x97q
}

eventsGeneric indexPath(path: string, payload: Struct) {   //@n:mrnr16nfnggz0g8f7kdhsw4q
    exists({ path: userDir({ nodeScope: false }).child(path) })   //@n:f337hswi55ynsxjl1ayejhv5
    const { pathOut: pathOut5 } = userDir({ nodeScope: false }).child(path).setExtension("flow_index")   //@n:rregdf6lvtdsjwh7gq0gb2mf
    if (exists({ path: pathOut5 })) { // exec_out_exists   //@n:cqrbjotyj6ppoatuxve6ewzl
        const { content: content4 } = userDir({ nodeScope: false }).child(path).readToBytes()   //@n:duplg3o61st9ky845h6gx1i2
        const { hash: hash2 } = blake3({ input: content4 })   //@n:b3co7gi21y7eztdp5zenyz6c
        const { content: content6 } = pathOut5.readToString()   //@n:t5cxnvoaaqehbqco13sqkn39
        if (!(parse({ string: content6 }).hash == hash2)) {   //@n:ghg5bjsyw6nlfmv33mmydc7h
            const { database: database15 } = open({ name: parse({ string: content6 }).reference_db, userScoped: true, batchSize: 1000 })   //@n:v67kmavcvxp2pbtfg5gn9uos
            database15.purge()   //@n:p8zbmn5vv1tjs8vw74ldozvd
            files.delete({ filter: `'reference_db' = ${parse({ string: content6 }).reference_db}` })   //@n:ou74or1cudv83uo5vwur8q8n
            reroute()   //@n:qm1linmwbhwfbrfh7mq3nt0q
            const { pages: pages2 } = extractDocumentAi({ file: userDir({ nodeScope: false }).child(path), model: smallModel, extractImages: true, imagesPerMessage: 1, pagesPerBatch: 4, temperature: 0.1, maxTokens: 0 })   //@n:ybwen1ecwc3cpqx69gq3a9qm
            const { summary: summary2 } = summarizeDocument({ pages: pages2, model: smallModel, detailLevel: "Medium", includeToc: true, strategy: "Refine", densification: "None", maxContextTokens: 8000, chunkOverlap: 10, trackEntities: false, parallelRequests: 4, densitySteps: 3 })   //@n:e14oowubmkkmm8nlewy3ivlu
            const { pathOut } = userDir({ nodeScope: false }).child(path).setExtension("flow_summary")   //@n:fj9c2ry7o4ad16kges3shwkc
            pathOut.writeString(summary2.summary)   //@n:eydk566pkivy859uphxqscup
            const { markdown: markdown2 } = pagesToMarkdown({ pages: pages2 })   //@n:l2xclkqnwuwx4496nn4yic2f
            const { pathOut: pathOut7 } = userDir({ nodeScope: false }).child(path).setExtension("flow_md")   //@n:v14hfegxczlpf2rhuldc254a
            pathOut7.writeString(markdown2)   //@n:ieeqjtlukoozasxoxbzezp2g
            const { vector: vector3 } = embedDocument({ queryString: summary2.summary, model: embeddingModel })   //@n:tt2szytgiqxdo82vh4amz5ol
            let record2 = set({ structIn: {}, field: "vector", value: vector3 }).structOut   //@n:e9kpfkp5ivihjbtmims8fy9r
            record2.content = summary2.summary   //@n:ql9k0oc83lxycuiyizqz3wk3
            const { date: date3 } = now()   //@n:q2cbltadjb08t1j1ba9519n2
            let row = set({ structIn: record2, field: "indexed", value: date3 }).structOut   //@n:a22a1br0nmgqkpwov1pz7p2x
            row.path = userDir({ nodeScope: false }).child(path).rawPath()   //@n:rf3rktm1f4ftyrwf0e16s8ft
            row.file_name = userDir({ nodeScope: false }).child(path).filename(true)   //@n:fwdsh4rorfsp1hg0u33u0zgj
            const { cuid } = random::cuid()   //@n:k10gsxn3te6tqaxf8kw6x17z
            row.reference_db = cuid   //@n:l6lsh3fdxpszz699wjzheoj0
            files.insertOne(row)   //@n:ot9y4104njuph6loxwaeloj1
            const { content: content2 } = userDir({ nodeScope: false }).child(path).readToBytes()   //@n:ap9a2oq5jd56oppttnhntyz8
            const { hash: hash3 } = blake3({ input: content2 })   //@n:u10ggc3447y21xhr6chplfy3
            let row2 = set({ structIn: {}, field: "hash", value: hash3 }).structOut   //@n:dlmgbjk5lofic9h0qnlad8hf
            row2.reference_db = cuid   //@n:j3ln3ged2q3y9im5i8hzznyf
            const { pathOut: pathOut3 } = userDir({ nodeScope: false }).child(path).setExtension("flow_index")   //@n:i7syn55nzv508vu1vy9zjm0d
            pathOut3.writeString(stringify({ value: row2, pretty: false }))   //@n:i988fpbssorl577cu81zakyi
            const { database: database5 } = open({ name: cuid, userScoped: true, batchSize: 1000 })   //@n:fzaqcxl9osvuwy0g9yxw8umg
            for (const item3 of pages2) {   //@n:emflpi61kfugpf37ht862gfm
                let record4 = set({ structIn: {}, field: "page", value: item3.page_number }).structOut   //@n:n8bqy27w41jzht7fhop3q4ko
                const { chunks } = chunkText({ text: item3.content, model: embeddingModel, capacity: 8000, overlap: 20, markdown: true })   //@n:sixj9z0by3rq9q3ihg2s9n3j
                for (const [index, item4] of chunks) {   //@n:j105jw40ombeqg414pr7swju
                    let record3 = set({ structIn: record4, field: "content", value: item4 }).structOut   //@n:i6nh6fapa0j1wuszj87dit4y
                    record3.chunk_id = index   //@n:jm47xl12ci20lk80zlvrbx40
                    const { vector: vector4 } = embedDocument({ queryString: item4, model: embeddingModel })   //@n:xwoggws1xtccwwbdgfosmv61
                    let row3 = set({ structIn: record3, field: "vector", value: vector4 }).structOut   //@n:q6suqnrf0jpevf6uy04ku267
                    database5.insertOne(row3)   //@n:hpm2vd2nmzj8h7hi1awt6omg
                }
            }
            database5.buildIndex({ column: "", type: "VECTOR" })   //@n:nwtoqies012u4k79ektz7kjs
            database5.optimize(false)   //@n:edhkjszurg00blcima48bzz4
        }
    } else { // exec_out_missing
        reroute()   //@n:ts5q4ul1xhy8imi5l9wpm9li
    }
}

