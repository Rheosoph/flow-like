}

eventsGeneric askUser(payload: Struct, name: string, description: string, optionA: string, optionB: string, freeform: bool) {   //@n:apowdhgvaoh06hpx8a3j4qpu
    const { response: response4 } = askSingleChoice({ name: name, description: description, options: optionA, options: optionB, allowFreeform: freeform, ttlSeconds: 120 })   //@n:n02xez0j5efophju3ufszhc1
    return response4   //@n:z0r9eem9ss2lr97m7us60xy9
}

eventsGeneric fetchPage(url: string, payload: Struct) {   //@n:jifmm59liln9cnwc7ec83rf5
    pushStep({ title: "Reading Website", description: url })   //@n:oyomq4tgddsswio67wqomq25
    const { response: response2 } = request({ method: "GET", url: url }).fetch()   //@n:idrp1wwe0i6p1tbvia6wj7yx
    const { text } = response2.toText()   //@n:sy8yfs8c7cyy5mueggnwguo2
    const { markdown } = md::fromHtml({ html: text, skippedTags: ["script","style","iframe"] })   //@n:ghwpj94m7foo8npks4b5r1qd
    return markdown   //@n:vv2ctjbgw7txduob2we5jdij
}

eventsGeneric makeColumnOptional(table: string, columnName: string, payload: Struct) {   //@n:lrgwibevm2khu0mk1f1md1n4
