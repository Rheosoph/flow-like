eventsGeneric readFile(path: string, summary: bool, payload: Struct) {   //@n:o4dbnck3e6otisqtml1l0fhw
    if (exists({ path: userDir({ nodeScope: false }).child(path) })) { // exec_out_exists   //@n:mj5m20m80usoqz2tctq8a1g9
        const { pathOut: pathOut4 } = userDir({ nodeScope: false }).child(path).setExtension("flow_index")   //@n:pd8mngp8dg77ntdkzzu9eq63
        if (exists({ path: pathOut4 })) { // exec_out_exists   //@n:mtn7qgfssz2266oq3u4u8qr0
        } else { // exec_out_missing
            indexPath({ path: path })   //@n:bhf5ysrs8kkvnihujne5oaw8
        }
        if (summary.fallback(true).result) {   //@n:nfc4p5mgnszvzwoyi0v63e4x
            const { pathOut: pathOut2 } = userDir({ nodeScope: false }).child(path).setExtension("flow_summary")   //@n:hei8qighn5h4rd1yw0yayxkv
            const { content: content3 } = pathOut2.readToString()   //@n:d25nzcnh8lssfuo5gf8zyetl
            return content3   //@n:de09bpkohphy3tdcc62kcj8a
        } else {
            const { pathOut: pathOut6 } = userDir({ nodeScope: false }).child(path).setExtension("flow_md")   //@n:sp4r8vqyry058rd5sftfsc6h
            const { content: content5 } = pathOut6.readToString()   //@n:fx72h965tbhonwgyrehqctem
            return content5   //@n:f5rma68p1tyzrewrxq6zekeu
        }
    } else { // exec_out_missing
        return `Path ${path} does not exist. No file found.`   //@n:a2ogmuh4frf12fkbme7f5mst
    }
}

eventsGeneric listFilesInPath(path: string, payload: Struct) {   //@n:iuj7lsynep4xqxshgp8g3h4r
    const { paths } = fromRawPath({ basePath: userDir({ nodeScope: false }), rawPath: path }).listPaths(false)   //@n:qt2j96v0nx2rb0ps9tjpuw5x
    const { folders } = fromRawPath({ basePath: userDir({ nodeScope: false }), rawPath: path }).listFolders(false)   //@n:yly5sss0lnawgzelngi29khs
    let record5 = set({ structIn: {}, field: "files", value: paths }).structOut   //@n:ndc55i1zej9krr8puvhma6mn
    record5.folders = folders   //@n:hwwnb1e3boml2bganej5m98n
    return record5   //@n:x8yuz6uqnn48da8aeq6cetjv
}

eventsGeneric searchInFiles(query: string, filter: string, payload: Struct) {   //@n:vxoe4h9j60ia1yande7dztwe
    pushStep({ title: "Querying files", description: query })   //@n:gp4jo6zd907p1g3u1ayywec3
    const { vector } = embedQuery({ queryString: query, model: embeddingModel })   //@n:bd3soso6llln3wxyuan2rymc
    const { values: values3 } = files.hybridSearch({ search: "", vector: vector, fields: [], filter: filter.fallback("").result, rerank: true, limit: 10, offset: 0 })   //@n:gxkh5h5asw2j55blmg431shf
    const { arrayOut: arrayOut3 } = values3.filterField("vector")   //@n:x09lmfp5fdh6g136yu2pzu17
    return arrayOut3   //@n:ry108qasir5oqmruafj8offf
}

eventsGeneric storeAttachment(attachmentPath: string, storagePath: string, payload: Struct) {   //@n:a7cmalf22cbojbumd8bmls7f
    pushStep({ title: "Storing Artifact", description: storagePath })   //@n:y1qith6m4yjovu9a7dar7gwf
    const { content } = attachedFiles.get(attachmentPath).value.readToBytes()   //@n:a159c66tin5k5q03mmh127fy
    fromRawPath({ basePath: uploadDir(), rawPath: storagePath }).writeBytes(content)   //@n:aco0cxuya6lux9e10wswjsx9
    indexPath({ path: storagePath })   //@n:z76l2qgsuuqu2kyfs4xzmo0m
    return `Indexed!`   //@n:yu9rohtu0ehrv6cknaxyqq03
}

eventsGeneric searchInFile(query: string, filter: string, path: string, payload: Struct) {   //@n:mc53d9qa5dv2iipd68u4l2ie
    pushStep({ title: "Searching Path", description: query })   //@n:maqd4j55k03g7rrqugkju1lw
    const { values } = files.filter({ filter: `path LIKE '${path}%'`, limit: 5, offset: 0 })   //@n:esfr5nmtupbk0dgf2wo0j04d
    if (values.length > 1) {   //@n:ix14u3xvffieq7tnq2f6ftyz
        const { arrayOut: arrayOut2 } = values.filterField("vector")   //@n:t14bw17dw14i500farohvuji
        return arrayOut2   //@n:rw2qg4h2vmn79gw4mbao87dp
    } else {
        if (values.get(0).success) {   //@n:zrh5eolpc1b9ahkv6pdg0c6b
            const { database: database4 } = open({ name: values[0].reference_db, userScoped: true, batchSize: 1000 })   //@n:f5jgsn39r8puu74twguidrqf
            const { vector: vector2 } = embedQuery({ queryString: query, model: embeddingModel })   //@n:l70vh3ycqn23g9iuuq1ekku2
            const { values: values2 } = database4.hybridSearch({ search: "", vector: vector2, fields: [], filter: filter.fallback("").result, rerank: true, limit: 10, offset: 0 })   //@n:ftshdvqs1az19o4bt94qhq57
            const { arrayOut } = values2.filterField("vector")   //@n:m06qw6gdg7afyvmv73ee8p5x
            return arrayOut   //@n:qcwis8zqwdyuxiplx6bhhln3
        } else {
            return `Path not found`   //@n:ihfefngj8nf9dhwknmkwv1f1
        }
    }
}

eventsGeneric readAttachment(attachmentPath: string, payload: Struct) {   //@n:i0qmpqpc8dpmyc5frtjy0zdi
    pushStep({ title: "Reading Attachment", description: attachmentPath })   //@n:saimklf3m7qe4i5n4hf8xu5q
    const { pages } = extractDocumentAi({ file: attachedFiles.get(attachmentPath).value, model: smallModel, extractImages: true, imagesPerMessage: 1, pagesPerBatch: 4, temperature: 0.1, maxTokens: 0 })   //@n:dsgyqjfwbdywtcncc201xls7
    const { markdown: markdown3 } = pagesToMarkdown({ pages: pages })   //@n:qp5086ebmbc92k4l1s2dimts
    return markdown3   //@n:e803l4ookx7jsswfa6fjwix6
}

eventsGeneric removePath(path: string, payload: Struct) {   //@n:n6bf38mnj6fwi1pl6sqzkt1o
    pushStep({ title: "Deleting Artifacts", description: path })   //@n:i3h6qfsa359inh2bn3sp1r1o
    files.delete({ filter: `path LIKE '${path}%'` })   //@n:tn39rpgs45x31nfe82c90uaq
    fromRawPath({ basePath: userDir({ nodeScope: false }), rawPath: path }).delete(true)   //@n:cadftkshruu5fbj4bs3ijxrv
    return `Deleted Files`   //@n:p7psr8n6ewhhr6ah3h6ir3q2
}

eventsGeneric moveFile(oldPath: string, newPath: string, payload: Struct) {   //@n:p73lfvy4jefdzh2yp1dhbbe1
    delay({ time: 1000.0 })   //@n:h3v6oan3tojem1amuw4v0d6w
}
