eventsSimple loadVariables() {   //@n:slde8unylsfksbdl72a0bfce
    const { preferencesOut: preferencesOut2 } = make({ multimodal: true }).setWeight({ preferencesKey: "Reasoning", weight: 1 })   //@n:lgo8z82ky6kdvptozoasjocf
    const { model } = findModel({ preferences: preferencesOut2 })   //@n:bnhgx6e0icx1bg7e27ffmmsg
    mainModel = model   //@n:fpyrvp4ga6q2x8113fecveil
    const { outputBit } = loadBit({ bitId: "api.alpha.flow-like.com:cunjxwl4c42jqz9c1t2ovoc3" })   //@n:wydf2gsmf9yj8fso90ge8srq
    const { model: model2 } = loadModel({ bit: outputBit })   //@n:inlv9dmld3ftpx3d6jddc75f
    embeddingModel = model2   //@n:vlyt5wpxx9m26zg19eug62xh
    const { database: database13 } = open({ name: "memory", userScoped: true, batchSize: 1000 })   //@n:o20ngu02bpt0hlm16ckg6cd0
    memory = database13   //@n:qvt2me6xxm0ko0m88muuqh5i
    const { preferencesOut } = make({ multimodal: true }).setWeight({ preferencesKey: "Cost", weight: 1 })   //@n:b12ltm8n9gc99bpz95pvmh38
    const { model: model3 } = findModel({ preferences: preferencesOut })   //@n:l10wjpupg28g6ulg9kx2ckaz
    smallModel = model3   //@n:ty18816iw02pfst7t59kw390
}

eventsGeneric upsertDatabaseItem(table: string, idField: string, item: Struct, payload: Struct) {   //@n:n11potzkr6tc5pib0mhzc7jx
    const { database: database14 } = open({ name: table, userScoped: true, batchSize: 1000 })   //@n:p11xzomudt9wbkxh8zds00zk
    const upsert = database14.upsert({ idRow: idField, value: item })   //@n:urnrsfrpau9gxxsvnla6pbzg
    upsert {
        execOut: {
            return `Success`   //@n:aw37j39tohjo6z847uc5e6f5
        }
        error: {
            return upsert.errorMessage   //@n:s9e85xhqc3x4hd5yyc5u16rc
        }
