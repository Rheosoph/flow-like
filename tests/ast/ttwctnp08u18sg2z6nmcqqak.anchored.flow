eventsGeneric queryItems(tables: string[], query: string, payload: Struct) {   //@n:picurh0xazovwtqtoilqhmus
    const { session } = df::createSession({ sessionName: "default", targetPartitions: 0, batchSize: 8192, repartitionJoins: true, repartitionAggregations: true, repartitionSorts: true, coalesceBatches: true, parquetPruning: true, collectStatistics: true })   //@n:bvnanveauu3d0ujy25s64dg1
    for (const item2 of tables) {   //@n:bcl92uzgcscfrnorvws50f5v
        const { database: database12 } = open({ name: item2, userScoped: true, batchSize: 1000 })   //@n:kr7jheffses6hdbkp8ywnbvd
        session.registerLance({ database: database12, tableName: item2 })   //@n:listba74iwsxf3w7dcoc5jdd
    }
    const { rows } = session.sqlQuery({ query: query })   //@n:tpb52weddm6rw8j90umn5bde
    return rows   //@n:bxd0u96i6a5421ivxz7ifqh6
}

eventsGeneric callLibrarian(task: string, payload: Struct) {   //@n:v36kd2hgbjdmg5m9xy0b2xg6
    pushStep({ title: "File Management", description: task })   //@n:wiqf4jne0b29zi6kv49mrf01
    const { database: database9 } = open({ name: "files", userScoped: true, batchSize: 1000 })   //@n:ic13nkshcfmyk8a3o0wnf5wr
    files = database9   //@n:jy746kf8fthhfofuwarcdsl1
    pushStep({ title: "Asking Librarian", description: task })   //@n:i5pjk4vxttwt6qykt4vx3njz
    const { database: database6 } = open({ name: "librarian_memory", userScoped: true, batchSize: 1000 })   //@n:geie1l0jtbq66ld1o9lmc5tw
    const { out: out2 } = constructPrompt({ prompt: librarian })   //@n:o336xwkn4lhf9s70qdyzzqk4
    const { historyOut: historyOut3 } = history::make({ modelName: "" }).setSystemPrompt(out2)   //@n:f96brkag9xfdifuuxcxytc3d
    const { historyOut: historyOut4 } = historyOut3.addMessage(history::makeMessage({ role: "User", type: "Text" }))   //@n:iluaeq6o8edr3m8igg5dymbd
    const { response } = fromModel({ model: mainModel, maxIter: 20, infiniteContext: false, contextMode: "summarize", maxContextTokens: 32000 }).registerMemory(createConfig({ database: database6, embeddingModel: embeddingModel, maxContextTokens: 4000, recallStrategy: "hybrid", recallTopK: 20, autoCompress: true, compressThreshold: 30 })).registerFunctionTools({ tools: [readFile, listFilesInPath, searchInFiles, storeAttachment, searchInFile, readAttachment, removePath] }).invoke(historyOut4)   //@n:i7nf9788tbvdlfwurj0nvar7
    pushTextToStep({ text: response.lastContent().content })   //@n:sjvd5583rn85d0c51ofe4b3f
    return response.lastContent().content   //@n:ox8u1qsug8cmwvu4fgke4kxp
}

eventsGeneric internetSearch(query: string, language: string, page: int, payload: Struct) {   //@n:ee1g939f5sshl86mgpju9upt
    pushStep({ title: "Searching Internet", description: query })   //@n:ar4s7g8fexh0zz0poakz6hqz
    const { response: response3 } = request({ method: "GET", url: "https://search.flow-like.com/search?q={q}&format=json&pageno={page}&language={lang}".format({ page: page.fallback(1).result, lang: language.fallback("en-US").result, q: urlEncode({ input: query }) }) }).fetch()   //@n:jzr66iw7c2h9d0bpb7atcztr
    const { struct: struct2 } = response3.toJson()   //@n:epe0y3sh3aczu7mta8f3v4gq
    return struct2   //@n:jg9pbwemxozegohcwyln8kxc
}

