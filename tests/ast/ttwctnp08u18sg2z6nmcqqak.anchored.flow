    database8.buildIndex({ column: column, type: fts.fallback(false).result ? "FULL TEXT" : "AUTO" })   //@n:lpezrmtusregg82cxtgngv57
    return `Success`   //@n:k110lhoo4xthdph8w1wt8er9
}

