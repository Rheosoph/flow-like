eventsGeneric queryItems(tables: string[], query: string, payload: Struct) {
    const createDataFusionSession = dfCreateSession({ sessionName: "default", targetPartitions: 0, batchSize: 8192, repartitionJoins: true, repartitionAggregations: true, repartitionSorts: true, coalesceBatches: true, parquetPruning: true, collectStatistics: true })
    for (const forEach of controlForEach({ array: tables })) {
        const openDatabase12 = openLocalDb({ name: forEach.value, userScoped: true, batchSize: 1000 })
        dfRegisterLance({ session: createDataFusionSession.session, database: openDatabase12.database, tableName: forEach.value })
    }
    const sQLQuery = dfSqlQuery({ session: createDataFusionSession.session, query: query })
    return sQLQuery.rows
}

eventsGeneric callLibrarian(task: string, payload: Struct) {
    eventsChatPushStep({ title: "File Management", description: task })
    const openDatabase9 = openLocalDb({ name: "files", userScoped: true, batchSize: 1000 })
    files = openDatabase9.database
    eventsChatPushStep({ title: "Asking Librarian", description: task })
    const openDatabase6 = openLocalDb({ name: "librarian_memory", userScoped: true, batchSize: 1000 })
    const callConstructPrompt2 = constructPrompt({ prompt: librarian })
    const setSystemMessage3 = aiGenerativeSetSystemPromptMessage({ history: aiGenerativeMakeHistory({ modelName: "" }), message: callConstructPrompt2.out })
    const pushMessage = aiGenerativeAddHistoryMessage({ history: setSystemMessage3.historyOut, message: aiGenerativeMakeHistoryMessage({ role: "User", type: "Text" }) })
    const invokeAgent = agentInvoke({ agent: agentRegisterFunctionTools({ agentIn: agentRegisterMemory({ agentIn: agentFromModel({ model: mainModel, maxIter: 20, infiniteContext: false, contextMode: "summarize", maxContextTokens: 32000 }), memoryConfig: memoryCreateConfig({ database: openDatabase6.database, embeddingModel: embeddingModel, maxContextTokens: 4000, recallStrategy: "hybrid", recallTopK: 20, autoCompress: true, compressThreshold: 30 }) }), tools: [readFile, listFilesInPath, searchInFiles, storeAttachment, searchInFile, readAttachment, removePath] }), history: pushMessage.historyOut })
    eventsChatPushTextToStep({ text: aiGenerativeLlmResponseLastContent({ response: invokeAgent.response }).content })
    return aiGenerativeLlmResponseLastContent({ response: invokeAgent.response }).content
}

eventsGeneric internetSearch(query: string, language: string, page: int, payload: Struct) {
    eventsChatPushStep({ title: "Searching Internet", description: query })
    const aPICall2 = httpFetch({ request: httpMakeRequest({ method: "GET", url: stringFormat({ formatString: "https://search.flow-like.com/search?q={q}&format=json&pageno={page}&language={lang}", page: utilsTypesFallback({ value: page, default: 1 }).result, lang: utilsTypesFallback({ value: language, default: "en-US" }).result, q: a2uiUrlEncode({ input: query }) }) }) })
    const toStruct = httpResponseToJson({ response: aPICall2.response })
    return toStruct.struct
}

