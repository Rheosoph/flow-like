eventsSimple loadVariables() {
    const setPreferenceWeight2 = aiGenerativeSetPreferenceWeight({ preferencesIn: aiGenerativeMakePreferences({ multimodal: true }), preferencesKey: "Reasoning", weight: 1 })
    const findModel = aiGenerativeFindModel({ preferences: setPreferenceWeight2.preferencesOut })
    mainModel = findModel.model
    const loadBit = bitFromString({ bitId: "api.alpha.flow-like.com:cunjxwl4c42jqz9c1t2ovoc3" })
    const loadEmbeddingModel = loadModel({ bit: loadBit.outputBit })
    embeddingModel = loadEmbeddingModel.model
    const openDatabase13 = openLocalDb({ name: "memory", userScoped: true, batchSize: 1000 })
    memory = openDatabase13.database
    const setPreferenceWeight = aiGenerativeSetPreferenceWeight({ preferencesIn: aiGenerativeMakePreferences({ multimodal: true }), preferencesKey: "Cost", weight: 1 })
    const findModel2 = aiGenerativeFindModel({ preferences: setPreferenceWeight.preferencesOut })
    smallModel = findModel2.model
}

