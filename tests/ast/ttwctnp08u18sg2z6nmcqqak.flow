function constructPrompt(prompt: string): (out: string) {
    const now2 = utilsDatetimeNow()
    return stringFormat({ formatString: "{prompt}\n\nCurrent Time: {time}", prompt: prompt, time: utilsDatetimeFormat({ date: now2.date, format: "rfc3339" }) })
}

eventsChat chatEvent(history: History, localSession: Struct, globalSession: Struct, tools: string[], actions: Struct[], attachments: Struct[], user: User) {
    const extractAttachments = aiGenLlmHistoryExtractAttachments({ history: history, attachments: attachments })
    attachedFiles = {}
    for (const forEach4 of controlForEach({ array: extractAttachments.paths })) {
        let record = structSet({ structIn: attachedFiles, field: forEach4.value.path, value: forEach4.value }).structOut
        attachedFiles = record
    }
    const now = utilsDatetimeNow()
    const setSystemMessage4 = aiGenerativeSetSystemPromptMessage({ history: history, message: stringFormat({ formatString: "{System_Prompt}\n\nCurrent Time: {time}\nAttached Files: {files}", systemPrompt: mainAgent, time: dfDatetimeToTimestamp({ datetime: now.date }).timestampLiteral, files: structGetFields({ struct: attachedFiles }).fieldNames }) })
    loadVariables()
    const streamInvokeAgent = agentStreamInvoke({ agent: agentRegisterFunctionTools({ agentIn: agentRegisterMemory({ agentIn: agentFromModel({ model: mainModel, maxIter: 15, infiniteContext: false, contextMode: "summarize", maxContextTokens: 32000 }), memoryConfig: memoryCreateConfig({ database: memory, embeddingModel: embeddingModel, maxContextTokens: 4000, recallStrategy: "hybrid", recallTopK: 20, autoCompress: true, compressThreshold: 30 }) }), tools: [callLibrarian, askUser, internetResearcher, databaseManager] }), history: setSystemMessage4.historyOut })
    streamInvokeAgent {
        onStream: {
            eventsChatPushResponseChunk({ chunk: streamInvokeAgent.chunk })
        }
        execDone: {
            eventsChatPushResponse({ response: streamInvokeAgent.response })
            eventsChatPushStat({ stepName: "Agent", stat: streamInvokeAgent.stats })
        }
    }
}

