eventsGeneric indexPath(path: string, payload: Struct) {
    pathExists({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }) })
    const setExtension5 = setExtension({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }), extension: "flow_index" })
    if (pathExists({ path: setExtension5.pathOut })) { // exec_out_exists
        const readToBytes3 = readToBytes({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }) })
        const blake3Hash = utilsHashBlake3({ input: readToBytes3.content })
        const readToString3 = readToString({ path: setExtension5.pathOut })
        if (!(valFromString({ string: readToString3.content }).hash == blake3Hash.hash)) {
            const openDatabase15 = openLocalDb({ name: valFromString({ string: readToString3.content }).reference_db, userScoped: true, batchSize: 1000 })
            purgeLocalDb({ database: openDatabase15.database })
            filterDeleteLocalDb({ database: files, filter: stringFormat({ formatString: "'reference_db' = {reference_db}", referenceDb: valFromString({ string: readToString3.content }).reference_db }) })
            reroute()
            const aIExtractDocument2 = aiProcessingExtractDocumentAi({ file: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }), model: smallModel, extractImages: true, imagesPerMessage: 1, pagesPerBatch: 4, temperature: 0.1, maxTokens: 0 })
            const summarizeDocument = aiProcessingSummarizeDocument({ pages: aIExtractDocument2.pages, model: smallModel, detailLevel: "Medium", includeToc: true, strategy: "Refine", densification: "None", maxContextTokens: 8000, chunkOverlap: 10, trackEntities: false, parallelRequests: 4, densitySteps: 3 })
            const setExtension = setExtension({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }), extension: "flow_summary" })
            writeString({ path: setExtension.pathOut, content: summarizeDocument.summary.summary })
            const pagesToMarkdown = aiProcessingPagesToMarkdown({ pages: aIExtractDocument2.pages })
            const setExtension7 = setExtension({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }), extension: "flow_md" })
            writeString({ path: setExtension7.pathOut, content: pagesToMarkdown.markdown })
            const embedDocument = embedDocument({ queryString: summarizeDocument.summary.summary, model: embeddingModel })
            let record2 = structSet({ structIn: {}, field: "vector", value: embedDocument.vector }).structOut
            record2.content = summarizeDocument.summary.summary
            const now3 = utilsDatetimeNow()
            let row = structSet({ structIn: record2, field: "indexed", value: now3.date }).structOut
            row.path = rawPath({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }) })
            row.file_name = filename({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }), removeExtension: true })
            const cUIDV2 = cuid()
            row.reference_db = cUIDV2.cuid
            insertLocalDb({ database: files, value: row })
            const readToBytes2 = readToBytes({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }) })
            const blake3Hash2 = utilsHashBlake3({ input: readToBytes2.content })
            let row2 = structSet({ structIn: {}, field: "hash", value: blake3Hash2.hash }).structOut
            row2.reference_db = cUIDV2.cuid
            const setExtension3 = setExtension({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }), extension: "flow_index" })
            writeString({ path: setExtension3.pathOut, content: valToString({ value: row2, pretty: false }) })
            const openDatabase5 = openLocalDb({ name: cUIDV2.cuid, userScoped: true, batchSize: 1000 })
            for (const forEach2 of controlForEach({ array: aIExtractDocument2.pages })) {
                let record4 = structSet({ structIn: {}, field: "page", value: forEach2.value.page_number }).structOut
                const chunkText = chunkText({ text: forEach2.value.content, model: embeddingModel, capacity: 8000, overlap: 20, markdown: true })
                for (const forEach3 of controlForEach({ array: chunkText.chunks })) {
                    let record3 = structSet({ structIn: record4, field: "content", value: forEach3.value }).structOut
                    record3.chunk_id = forEach3.index
                    const embedDocument2 = embedDocument({ queryString: forEach3.value, model: embeddingModel })
                    let row3 = structSet({ structIn: record3, field: "vector", value: embedDocument2.vector }).structOut
                    insertLocalDb({ database: openDatabase5.database, value: row3 })
                }
            }
            indexLocalDb({ database: openDatabase5.database, column: "", type: "VECTOR" })
            optimizeLocalDb({ database: openDatabase5.database, keepVersions: false })
        }
    } else { // exec_out_missing
        reroute()
    }
}

