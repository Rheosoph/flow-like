eventsGeneric databaseManager(task: string, payload: Struct) {
    eventsChatPushStep({ title: "Database Management", description: task })
    const callConstructPrompt = constructPrompt({ prompt: "## Available Database Tools\n\nYou have access to the following database and query tools. Use them deliberately and report important operations in the final result.\n\n---\n\n# Table and Schema Discovery\n\n## List Tables\n\nUse `List Tables` when:\n- the parent asks what databases or tables exist\n- you need to discover available tables before querying\n- memory may be incomplete or stale\n- you need to validate whether a table already exists\n\nReturn table names and, when known, their purpose from memory.\n\n## Get Database Schema / Get Schema\n\nUse schema inspection when:\n- writing to an existing table\n- validating incoming data\n- deciding whether schema evolution is needed\n- preparing joins\n- preparing SQL queries\n- checking whether a full-text index target column exists\n\nNever assume an existing table schema when a schema-sensitive operation depends on it.\n\n---\n\n# Database and SQL Session Tools\n\n## Query Items\n\nUse `Query Items` for SQL/DataFusion operations over one or more tables.\n\nUse it for:\n- filtering rows\n- projecting selected columns\n- sorting\n- limiting\n- aggregation\n- grouping\n- joining multiple tables\n- deduplication\n- checking rows before deletion\n- producing analytical summaries\n\nThe `Tables` input defines which tables are made available to the query. If the query joins across tables, all required tables must be handed over.\n\nRules:\n- Use explicit table names and aliases.\n- Select only needed columns.\n- Add limits for potentially large result sets.\n- Return row count when available.\n- Avoid cartesian joins.\n- Use SQL filters for structured data.\n- Use full-text search for indexed text lookup.\n\n## Create DataFusion Session\n\nUse this when you need an explicit query session for registering and querying several LanceDB tables.\n\nImportant parameters:\n- `Session Name`\n- `Target Partitions`\n- `Batch Size`\n- repartition settings\n- parquet pruning\n- coalesce batches\n- statistics collection\n\nUse reasonable defaults unless the parent has performance requirements.\n\nUse larger batch sizes and partitioning for large analytical queries. Use conservative settings for small or interactive queries.\n\n## Open Database\n\nUse `Open Database` when:\n- accessing a LanceDB-backed table\n- creating or opening a database by table name\n- preparing to register a table in DataFusion\n- preparing insert/upsert/index/search operations\n\nWriting can implicitly create a database/table when enough schema information is available.\n\n## Register Lance Table\n\nUse this after opening a database when a table needs to be queried via DataFusion SQL.\n\nUse it when:\n- SQL query needs the table\n- joining LanceDB tables\n- filtering or aggregating through DataFusion\n- validating table contents with SQL\n\n---\n\n# Insert and Upsert Tools\n\n## Insert Database Item\n\nUse `Insert Database Item` for one append-only record.\n\nUse it when:\n- the item is an event, log, observation, snapshot, or historical record\n- duplicates are acceptable or meaningful\n- there is no stable ID\n- the parent asks to append\n\nReturn the inserted count and table name.\n\n## Batch Insert Database Items\n\nUse `Batch Insert Database Items` for multiple append-only records.\n\nUse it when:\n- writing many observations, events, documents, facts, or logs\n- records should preserve history\n- repeated records are acceptable\n- performance matters\n\nValidate schema before batch insert where possible.\n\n## Upsert Database Item\n\nUse `Upsert Database Item` for one record with a stable identity.\n\nInputs:\n- Table\n- ID Field / ID Column\n- Item / Value\n\nUse it when:\n- the parent asks to save the latest version\n- the record should replace or update an existing row with the same ID\n- the item has a stable primary key, URL, external ID, hash, email, or normalized unique name\n\nDo not upsert without a credible stable ID.\n\n## Batch Upsert Database Items\n\nUse `Batch Upsert Database Items` for many records with stable identities.\n\nUse it when:\n- importing or refreshing known entities\n- deduplicating by ID\n- updating known records in bulk\n- storing latest versions of products, companies, sources, or entities\n\nReport the ID column and affected row count.\n\n---\n\n# Indexing and Search Tools\n\n## Build Index\n\nUse `Build Index` to create an index on a table column.\n\nInputs:\n- Table\n- Column\n- FTS\n\nUse it when:\n- the parent asks for searchable content\n- repeated search over a text column is likely\n- full-text search is needed\n- a large table has a commonly filtered or searched column\n\nIf `FTS` is enabled, build a full-text search index for a text column.\n\nGood FTS columns:\n- `content`\n- `text`\n- `body`\n- `summary`\n- `title`\n- `description`\n- `notes`\n- `claim`\n- `payload_text`\n\nAfter building an index:\n- update memory\n- report the indexed table and column\n\n## Search Items / Fulltext Search\n\nUse `Search Items` when the task is keyword or text retrieval over an indexed column.\n\nInputs:\n- Table\n- Query\n- Filter\n- Search Term\n\nUse it for:\n- retrieving documents by phrase\n- searching notes, summaries, claims, descriptions, content, or titles\n- narrowing search using a structured filter\n\nRules:\n- Prefer full-text search for natural-language text lookup.\n- Prefer SQL/DataFusion for structured conditions.\n- Combine search with filters when useful.\n- Return matching IDs, key fields, and short text snippets.\n- Do not return large raw documents unless requested.\n\n---\n\n# Delete Tools\n\n## Delete Items\n\nUse `Delete Items` for deleting rows from a table using an SQL filter.\n\nInputs:\n- Table\n- SQL Filter\n\nUse it when:\n- the parent explicitly asks to delete rows\n- a precise filter is provided\n- records created in the current operation need cleanup\n- stale records are clearly identified\n\nRules:\n- Deletion is destructive.\n- Use a precise SQL filter.\n- For broad filters, query/count matching rows first.\n- Do not delete whole tables unless explicitly instructed.\n- Do not delete ID, source, provenance, or audit-critical records through vague instructions.\n\nReturn affected row count when available.\n\n---\n\n# Schema Evolution Tools\n\n## Add Column\n\nUse `Add Column` when:\n- incoming data contains a stable new field that should be queryable\n- the parent explicitly asks to add a field\n- a deterministic SQL expression can compute a useful derived column\n- storing the value in `payload` would make later queries unnecessarily difficult\n\nInputs:\n- Table\n- Column Name\n- SQL Expression\n\nRules:\n- Prefer nullable columns unless the value is guaranteed.\n- Use stable, clear names.\n- Use SQL expressions for deterministic derived values.\n- Avoid creating many columns from unstable or sparse payload keys.\n- Update memory after adding the column.\n\n## Drop Column\n\nUse `Drop Column` only when:\n- the parent explicitly requests it\n- the column was created incorrectly in the current operation\n- the column is clearly obsolete and safely recoverable elsewhere\n\nRules:\n- Dropping a column is destructive.\n- Inspect schema first.\n- Do not drop ID columns, join keys, provenance fields, timestamps, raw payloads, or source fields unless explicitly instructed.\n- Report the dropped column.\n\n## Make Column Optional\n\nUse `Make Column Optional` when:\n- valid incoming records omit the field\n- older records do not contain the field\n- partial data should be accepted\n- schema strictness would otherwise block useful writes\n\nRules:\n- Prefer optionality over rejecting useful partial records.\n- This is usually safer than forcing fake default values.\n- Update memory after changing optionality.\n\n---\n\n# Recommended Tool Flows\n\n## Store new records\n\n1. List tables if target is unknown.\n2. Get schema if table exists.\n3. Decide insert vs upsert.\n4. Evolve schema if needed.\n5. Insert or batch insert, upsert or batch upsert.\n6. Build indexes if requested or clearly useful.\n7. Update memory.\n8. Return result.\n\n## Query structured data\n\n1. Identify required tables from request or memory.\n2. Open databases.\n3. Create DataFusion session if needed.\n4. Register required Lance tables.\n5. Run SQL query through `Query Items`.\n6. Return compact rows and count.\n\n## Join across tables\n\n1. Identify all required tables.\n2. Inspect schemas for join keys.\n3. Register all tables in a DataFusion session.\n4. Use explicit SQL joins.\n5. Limit output.\n6. Return rows plus assumptions about join keys.\n\n## Search text\n\n1. Identify target table and text column.\n2. Check schema.\n3. Build FTS index if needed and appropriate.\n4. Use `Search Items`.\n5. Apply filter if provided.\n6. Return compact matches.\n\n## Delete rows\n\n1. Identify exact table.\n2. Validate SQL filter.\n3. Query/count matches if broad or risky.\n4. Delete matching rows.\n5. Return affected count.\n6. Update memory only if schema or table metadata changed.\n\n## Evolve schema\n\n1. Inspect existing schema.\n2. Compare incoming data or requested change.\n3. Add column, make optional, or return conflict.\n4. Drop only with explicit scope.\n5. Update memory.\n6. Report every schema change." })
    const setSystemMessage2 = aiGenerativeSetSystemPromptMessage({ history: aiGenerativeMakeHistory({ modelName: "" }), message: callConstructPrompt.out })
    const pushMessage2 = aiGenerativeAddHistoryMessage({ history: setSystemMessage2.historyOut, message: aiGenerativeMakeHistoryMessage({ role: "User", type: "Text", text: task }) })
    const streamInvokeAgent3 = agentStreamInvoke({ agent: agentRegisterFunctionTools({ agentIn: agentRegisterMemory({ agentIn: agentFromModel({ model: mainModel, maxIter: 15, infiniteContext: false, contextMode: "summarize", maxContextTokens: 32000 }), memoryConfig: memoryCreateConfig({ database: memory, embeddingModel: embeddingModel, maxContextTokens: 4000, recallStrategy: "hybrid", recallTopK: 20, autoCompress: true, compressThreshold: 30 }) }), tools: [listTables, getDatabaseSchema, insertDatabaseItem, batchInsertDatabaseItems, upsertDatabaseItem, batchUpsertDatabaseItems, deleteItems, queryItems, buildIndex, searchItems, addColumn, dropColumn, makeColumnOptional2] }), history: pushMessage2.historyOut })
    eventsChatPushStat({ stepName: "Database Management", stat: streamInvokeAgent3.stats })
    return aiGenerativeLlmResponseLastContent({ response: streamInvokeAgent3.response }).content
}

eventsGeneric deleteItems(table: string, filterQuery: string, payload: Struct) {
    const openDatabase7 = openLocalDb({ name: table, userScoped: true, batchSize: 1000 })
    const delete = filterDeleteLocalDb({ database: openDatabase7.database, filter: filterQuery })
    return delete.deletedValues
}

eventsGeneric searchItems(table: string, query: string, filter: string, payload: Struct) {
    const openDatabase3 = openLocalDb({ name: table, userScoped: true, batchSize: 1000 })
    const fullTextSearch = ftsSearchLocalDb({ database: openDatabase3.database, search: query, fields: [], filter: utilsTypesFallback({ value: filter, default: "" }).result, limit: 10, offset: 0 })
    return fullTextSearch.values
}

eventsSimple addInterest() {
    logInfo({ message: stringFormat({ formatString: "label: {label}\ngoal: {goal}\nsource: {src}\nweight: {weight}", goal: a2uiGetElementValue({ elementRef: a2uiGetElement({ elementRef: "nkhigr7q8pwxtfzi729flmte/pa-goal" }).element }).value, src: a2uiGetElementValue({ elementRef: a2uiGetElement({ elementRef: "nkhigr7q8pwxtfzi729flmte/pa-content" }).element }).value, weight: a2uiGetElementValue({ elementRef: a2uiGetElement({ elementRef: "nkhigr7q8pwxtfzi729flmte/pa-weight" }).element }).value, label: a2uiGetElementValue({ elementRef: a2uiGetElement({ elementRef: "nkhigr7q8pwxtfzi729flmte/pa-label" }).element }).value }), toast: true })
}

eventsGeneric readFile(path: string, summary: bool, payload: Struct) {
    if (pathExists({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }) })) { // exec_out_exists
        const setExtension4 = setExtension({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }), extension: "flow_index" })
        if (pathExists({ path: setExtension4.pathOut })) { // exec_out_exists
            if (utilsTypesFallback({ value: summary, default: true }).result) {
                const setExtension2 = setExtension({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }), extension: "flow_summary" })
                const readToString = readToString({ path: setExtension2.pathOut })
                return readToString.content
            } else {
                const setExtension6 = setExtension({ path: child({ parentPath: pathFromUserDir({ nodeScope: false }), childName: path }), extension: "flow_md" })
                const readToString2 = readToString({ path: setExtension6.pathOut })
                return readToString2.content
            }
        } else { // exec_out_missing
            indexPath({ path: path })
        }
    } else { // exec_out_missing
        return stringFormat({ formatString: "Path {path} does not exist. No file found.", path: path })
    }
}

eventsGeneric listFilesInPath(path: string, payload: Struct) {
    const listPaths = pathListPaths({ prefix: fromRawPath({ basePath: pathFromUserDir({ nodeScope: false }), rawPath: path }), recursive: false })
    const listFolders = pathListFolders({ prefix: fromRawPath({ basePath: pathFromUserDir({ nodeScope: false }), rawPath: path }), recursive: false })
    let record5 = structSet({ structIn: {}, field: "files", value: listPaths.paths }).structOut
    record5.folders = listFolders.folders
    return record5
}

eventsGeneric searchInFiles(query: string, filter: string, payload: Struct) {
    eventsChatPushStep({ title: "Querying files", description: query })
    const embedQuery = embedQuery({ queryString: query, model: embeddingModel })
    const hybridSearch2 = hybridSearchLocalDb({ database: files, search: "", vector: embedQuery.vector, fields: [], filter: utilsTypesFallback({ value: filter, default: "" }).result, rerank: true, limit: 10, offset: 0 })
    const filterArrayField3 = arrayFilterField({ arrayIn: hybridSearch2.values, field: "vector" })
    return filterArrayField3.arrayOut
}

eventsGeneric storeAttachment(attachmentPath: string, storagePath: string, payload: Struct) {
    eventsChatPushStep({ title: "Storing Artifact", description: storagePath })
    const readToBytes = readToBytes({ path: structGet({ struct: attachedFiles, field: attachmentPath }).value })
    writeBytes({ path: fromRawPath({ basePath: pathFromUploadDir(), rawPath: storagePath }), content: readToBytes.content })
    indexPath({ path: storagePath })
    return stringFormat({ formatString: "Indexed!" })
}

eventsGeneric searchInFile(query: string, filter: string, path: string, payload: Struct) {
    eventsChatPushStep({ title: "Searching Path", description: query })
    const sQLFilterDatabase = filterLocalDb({ database: files, filter: stringFormat({ formatString: "path LIKE '{path}%'", path: path }), limit: 5, offset: 0 })
    if (sQLFilterDatabase.values.length > 1) {
        const filterArrayField2 = arrayFilterField({ arrayIn: sQLFilterDatabase.values, field: "vector" })
        return filterArrayField2.arrayOut
    } else {
        if (arrayGet({ arrayIn: sQLFilterDatabase.values, index: 0 }).success) {
            const openDatabase4 = openLocalDb({ name: sQLFilterDatabase.values[0].reference_db, userScoped: true, batchSize: 1000 })
            const embedQuery2 = embedQuery({ queryString: query, model: embeddingModel })
            const hybridSearch = hybridSearchLocalDb({ database: openDatabase4.database, search: "", vector: embedQuery2.vector, fields: [], filter: utilsTypesFallback({ value: filter, default: "" }).result, rerank: true, limit: 10, offset: 0 })
            const filterArrayField = arrayFilterField({ arrayIn: hybridSearch.values, field: "vector" })
            return filterArrayField.arrayOut
        } else {
            return stringFormat({ formatString: "Path not found" })
        }
    }
}

eventsGeneric readAttachment(attachmentPath: string, payload: Struct) {
    eventsChatPushStep({ title: "Reading Attachment", description: attachmentPath })
    const aIExtractDocument = aiProcessingExtractDocumentAi({ file: structGet({ struct: attachedFiles, field: attachmentPath }).value, model: smallModel, extractImages: true, imagesPerMessage: 1, pagesPerBatch: 4, temperature: 0.1, maxTokens: 0 })
    const pagesToMarkdown2 = aiProcessingPagesToMarkdown({ pages: aIExtractDocument.pages })
    return pagesToMarkdown2.markdown
}

eventsGeneric removePath(path: string, payload: Struct) {
    eventsChatPushStep({ title: "Deleting Artifacts", description: path })
    filterDeleteLocalDb({ database: files, filter: stringFormat({ formatString: "path LIKE '{path}%'", path: path }) })
    storageDelete({ path: fromRawPath({ basePath: pathFromUserDir({ nodeScope: false }), rawPath: path }), recursive: true })
    return stringFormat({ formatString: "Deleted Files" })
}

eventsGeneric moveFile(oldPath: string, newPath: string, payload: Struct) {
    delay({ time: 1000.0 })
}
