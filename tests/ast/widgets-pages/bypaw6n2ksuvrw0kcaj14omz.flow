interface Metadata {
    name: string;
    description: string;
    long_description?: string | null;
    release_notes?: string | null;
    tags: string[];
    use_case?: string | null;
    icon?: string | null;
    thumbnail?: string | null;
    preview_media: string[];
    age_rating?: int | null;
    website?: string | null;
    support_url?: string | null;
    docs_url?: string | null;
    organization_specific_values?: int[] | null;
    created_at: SystemTime;
    updated_at: SystemTime;
}
interface SystemTime {
    secs_since_epoch: int;
    nanos_since_epoch: int;
}
interface LlmModelEvaluation {
    slug: string;
    name: string;
    release_date?: string | null;
    creator_name: string;
    creator_slug: string;
    evaluations?: any;
    pricing?: any;
    median_output_tokens_per_second?: float | null;
    median_time_to_first_token_seconds?: float | null;
    median_time_to_first_answer_token?: float | null;
}
interface Bit {
    id?: string = "";
    type?: "Llm" | "Vlm" | "Tts" | "Stt" | "Embedding" | "ImageEmbedding" | "File" | "Media" | "ImageGeneration" | "VideoGeneration" | "Template" | "Tokenizer" | "TokenizerConfig" | "SpecialTokensMap" | "Config" | "Course" | "PreprocessorConfig" | "Projection" | "Project" | "Board" | "Other" | "ObjectDetection" = "Other";
    meta?: Map<string, Metadata> = {};
    authors?: string[] = [];
    repository?: string | null = null;
    download_link?: string | null = null;
    file_name?: string | null = null;
    hash?: string = "";
    size?: int | null = null;
    hub?: string = "";
    parameters?: any = null;
    version?: string | null = null;
    license?: string | null = null;
    dependencies?: string[] = [];
    dependency_tree_hash?: string = "";
    created?: string = "";
    updated?: string = "";
    model_slug?: string | null = null;
    model_evaluation?: LlmModelEvaluation | null = null;
}
interface HistoryMessage {
    role: "system" | "user" | "assistant" | "function" | "tool";
    content: string | Struct[];
    name?: string | null;
    tool_calls?: ToolCall[] | null;
    tool_call_id?: string | null;
    annotations?: Annotation[] | null;
}
interface ImageUrl {
    url: string;
    detail?: string | null;
}
interface ToolCall {
    id: string;
    type: string;
    function: ToolCallFunction;
}
interface ToolCallFunction {
    name: string;
    arguments: string;
}
interface Annotation {
    type: string;
    url_citation?: UrlCitation | null;
}
interface UrlCitation {
    end_index: int;
    start_index: int;
    title: string;
    url: string;
    content?: string | null;
}
interface StreamOptions {
    include_usage: bool;
}
interface Tool {
    type: "function";
    function: HistoryFunction;
}
interface HistoryFunction {
    name: string;
    description?: string | null;
    parameters: HistoryFunctionParameters;
}
interface HistoryFunctionParameters {
    type: "object" | "number" | "string" | "array" | "null" | "boolean";
    properties?: Map<string, HistoryJSONSchemaDefine> | null;
    required?: string[] | null;
}
interface HistoryJSONSchemaDefine {
    type?: "object" | "number" | "string" | "array" | "null" | "boolean" | null;
    description?: string | null;
    enum?: string[] | null;
    properties?: Map<string, HistoryJSONSchemaDefine> | null;
    required?: string[] | null;
    items?: HistoryJSONSchemaDefine | null;
}
interface Usage {
    include: bool;
}
interface History {
    model: string;
    messages: HistoryMessage[];
    preset?: string | null;
    stream?: bool | null;
    stream_options?: StreamOptions | null;
    max_completion_tokens?: int | null;
    top_p?: float | null;
    temperature?: float | null;
    thinking?: "off" | "low" | "mid" | "high" | null;
    seed?: int | null;
    presence_penalty?: float | null;
    frequency_penalty?: float | null;
    user?: string | null;
    stop?: string[] | null;
    response_format?: string | any | null;
    n?: int | null;
    tools?: Tool[] | null;
    tool_choice?: null | Struct | null;
    usage?: Usage | null;
}
interface NodeDBConnection {
    cache_key: string;
}
interface ReportEntry {
    title: string;
    uri: string;
    summary: string;
    date: string;
    interest?: string;
    report_id: string;
}
interface UserConfiguration {
    general: Struct;
    sources: Struct[];
}
interface Elements {
    label: string;
    content: string;
    goal: string;
    type: string;
}

const model: Bit
const rSSHistory: History = {"model":"","messages":[]}
@category("Prompts")
const rSSPrompt = "# News Research Agent\n\nYou process an RSS feed for a daily briefing pipeline. Your output feeds a downstream summarizer LLM — write for machines, not humans.\n\n## Hard constraints\n- **Max 5 tool calls total.** Budget aggressively, skip aggressively.\n- **Recency: today or yesterday only.** Drop everything else, including no-date entries. Apply before anything else — feeds carry weeks of backlog.\n- **Only `add_news` for articles you fetched.** Never summarize from RSS metadata alone.\n\n## Workflow\nFor each RSS entry:\n1. **Triage from metadata** (title, snippet, date). Stale or clearly off-Goal → skip, no fetch.\n2. **Fetch** via `fetch_page(url)` only if plausibly relevant.\n3. **Judge** post-fetch: substantive AND on-Goal? Yes → `add_news(...)`. No → move on.\n\nBe strict. Marginal relevance ≠ relevant.\n\n## Summary spec\nDense factual prose, 10–20 lines, never under 8. No bullets, no filler, no headline restatement, no editorializing.\n\nInclude where present:\n- Numbers, %, prices, rankings, statistics\n- Named entities (people, companies, countries, products, legislation)\n- Dates and forward timeline (what's next, when)\n- Causal context (why it matters, what triggered it)\n- Opposing views or official responses\n- Explicitly flag data series / comparisons suitable for charting\n\n## Inputs\n- RSS feed: titles, URLs, dates\n- Goal: user's interests and relevance criteria\n\n## Output\n`add_news` calls only. No prose, no status, no recap."
@category("Report")
const reportCreated = false
@category("Report")
const reportDB: NodeDBConnection = {}
@category("Report")
const reportEntry: ReportEntry[] = []
@category("Report")
const reportID = ""
const searchHistory: History = {"model":"","messages":[]}
@category("Prompts")
const searchPrompt = "# News Research Agent\n\nYou research a topic for a daily briefing pipeline. Your output feeds a downstream summarizer LLM — write for machines, not humans.\n\n## Hard constraints\n- **Recency: today or yesterday only.** Encode into every query (`after:YYYY-MM-DD`, `\"Month YYYY\"`). Discard anything not demonstrably recent. No visible date → skip.\n- **Only `add_news` for pages you fetched.** Never summarize from search snippets alone.\n- **Depth over breadth.** Three well-sourced detailed entries beat ten shallow ones.\n\n## Workflow\n\n### Phase 1 — Search\n1. Formulate 1–3 SearXNG queries covering different angles (latest developments, key actors, data/stats). Use operators where useful: `\"exact phrase\"`, `site:`, `after:`.\n2. Call `search(query)` for each. Scan titles, snippets, dates.\n3. Pick promising URLs. Prioritise primary sources (official statements, wire services, major outlets) over aggregators and opinion.\n\n### Phase 2 — Fetch & Evaluate\n4. `fetch_page(url)` on each candidate.\n5. Decide:\n   - Relevant + recent + substantive → `add_news(title, uri, summary, date)`\n   - Irrelevant, duplicate, stale → discard\n6. If coverage is thin after round 1, run one refined query and repeat. Stop there.\n\nBe strict on relevance — marginal ≠ relevant.\n\n## Summary spec\nDense factual prose, 10–20 lines, never under 8. No bullets, no filler, no headline restatement, no editorializing.\n\nInclude where present:\n- Numbers, %, prices, rankings, statistics\n- Named entities (people, companies, countries, products, legislation)\n- Dates and forward timeline (what's next, when)\n- Causal context (why it matters, what triggered it)\n- Opposing views or official responses\n- Explicitly flag data series / comparisons suitable for charting\n\n## Inputs\n- Topic: subject to research\n- Goal: user's interests and relevance criteria\n\n## Output\n`add_news` calls only. No prose, no status, no recap."
const userConfiguration: UserConfiguration = {"general":{},"sources":[]}

function filterSources(hash: string) {
    let elements: Elements[] = []
    elements = []
    for (const item3 of userConfiguration.sources) {
        const hash2 = md5({ input: item3.content })
        if (hash != hash2) {
            const arrayOut3 = elements.push(item3)
            elements = arrayOut3
        }
    }
    userConfiguration = { general: userConfiguration.general, sources: elements }
}

function perpareNews(source: Struct) {
    let label: string = ""
    log::info({ message: source, toast: false })
    label = source.label
    if (source.type == "Search") {
        const historyOut3 = searchHistory.addMessage(makeMessage({ role: "User", type: "Text", text: "Topic {label}\nSearch for: {Query}\nGoal: {Goal}".format({ goal: source.goal, label: source.label, query: source.content }) }))
        const { stats: stats2 } = fromModel({ model: model, maxIter: 20, infiniteContext: true, contextMode: "summarize", maxContextTokens: 32000 }).registerFunctionTools({ tools: [search, fetchPage, addNews] }).invoke(historyOut3)
        pushStat({ stepName: source.label, stat: stats2 })
    } else {
        const response = request({ method: "GET", url: (source.type == "Reddit") ? "https://www.reddit.com/{subreddit}/.rss?limit=30".format({ subreddit: source.content }) : (contains({ string: source.content, substring: "?" }) ? "{url}&limit=30".format({ url: source.content }) : "{url}?limit=30".format({ url: source.content })) }).fetch()
        const text2 = response.toText()
        const date4 = now()
        if (filterFeedItemsByDate({ items: parseFeed({ feedBody: text2, sourceUrl: (source.type == "Reddit") ? "https://www.reddit.com/{subreddit}/.rss?limit=30".format({ subreddit: source.content }) : (contains({ string: source.content, substring: "?" }) ? "{url}&limit=30".format({ url: source.content }) : "{url}?limit=30".format({ url: source.content })) }).items, releasedFrom: date4.add({ days: -2, hours: 0, minutes: 0, seconds: 0 }), releasedTo: date4, dateField: "release_date", includeUndated: false }).filteredItems.length > 0) {
            const historyOut = rSSHistory.addMessage(makeMessage({ role: "User", type: "Text", text: "Topic {label}\nGoal: {Goal}\n\n## Feed\n{feed}\n".format({ goal: source.goal, label: source.label, feed: filterFeedItemsByDate({ items: parseFeed({ feedBody: text2, sourceUrl: (source.type == "Reddit") ? "https://www.reddit.com/{subreddit}/.rss?limit=30".format({ subreddit: source.content }) : (contains({ string: source.content, substring: "?" }) ? "{url}&limit=30".format({ url: source.content }) : "{url}?limit=30".format({ url: source.content })) }).items, releasedFrom: date4.add({ days: -2, hours: 0, minutes: 0, seconds: 0 }), releasedTo: date4, dateField: "release_date", includeUndated: false }).filteredItems }) }))
            const { stats } = fromModel({ model: model, maxIter: 20, infiniteContext: true, contextMode: "summarize", maxContextTokens: 32000 }).registerFunctionTools({ tools: [fetchPage, addNews] }).invoke(historyOut)
            pushStat({ stepName: source.label, stat: stats })
        }
    }
    eventsGeneric addNews(title: string, summary: string, uri: string, date: string, payload: Struct) {
        const arrayOut2 = reportEntry.push({ value: { title: title, uri: uri, summary: summary, date: date, interest: label, report_id: reportID } })
        reportEntry = arrayOut2
        return `Successfully Added`
    }
    eventsGeneric fetchPage(url: string, payload: Struct) {
        pushStep({ title: "Reading Website", description: url })
        const aPICall = request({ method: "GET", url: url }).fetch()
        aPICall {
            execSuccess: {
                const text = aPICall.response.toText()
                const markdown = md::fromHtml({ html: text, skippedTags: ["script","style","iframe"] })
                return markdown
            }
            execError: {
                return `FAILED TO FETCH WEBSITE - SKIP`
            }
        }
    }
    eventsGeneric search(query: string, language: string, page: int, payload: Struct) {
        pushStep({ title: "Searching Internet", description: query })
        const aPICall3 = request({ method: "GET", url: "https://search.flow-like.com/search?q={q}&format=json&pageno={page}&language={lang}".format({ page: page.fallback(1).result, lang: language.fallback("en-US").result, q: urlEncode({ input: query }) }) }).fetch()
        aPICall3 {
            execSuccess: {
                const struct2 = aPICall3.response.toJson()
                return struct2
            }
            execError: {
                return `FAILED TO SEARCH`
            }
        }
    }
}

function saveConfig(config: Struct) {
    userDir({ nodeScope: false }).child("config.json").writeString(stringify({ value: config, pretty: true }))
}

eventsSimple clickLatestOverview() {
    const database2 = open({ name: "report_overview", userScoped: true, batchSize: 1000 })
    const session2 = createSession({ sessionName: "default", targetPartitions: 0, batchSize: 8192, repartitionJoins: true, repartitionAggregations: true, repartitionSorts: true, coalesceBatches: true, parquetPruning: true, collectStatistics: true })
    session2.registerLance({ database: database2, tableName: "reports" })
    const { rows: rows2 } = session2.sqlQuery({ query: "SELECT\n  report_id,\n  title,\n  description,\n  report,\n  created\nFROM reports\nORDER BY to_timestamp(created) DESC\nLIMIT 1;" })
    navigateTo({ route: "/briefing?report_id={id}".format({ id: rows2[0].report_id }) })
}

eventsSimple loadOverview() {
    const database = open({ name: "report_overview", userScoped: true, batchSize: 1000 })
    const session = createSession({ sessionName: "default", targetPartitions: 0, batchSize: 8192, repartitionJoins: true, repartitionAggregations: true, repartitionSorts: true, coalesceBatches: true, parquetPruning: true, collectStatistics: true })
    session.registerLance({ database: database, tableName: "reports" })
    const { rows: rows3 } = session.sqlQuery({ query: "SELECT\n  report_id,\n  title,\n  description,\n  report,\n  created\nFROM reports\nORDER BY to_timestamp(created) DESC\nLIMIT 25;" })
    setElementText({ elementRef: "exjwj78m9nryq5r8rfvmz7lt/subline-right", text: "{num} Briefing(s)".format({ num: rows3.length }) })
    setElementText({ elementRef: "e6x8wvsr1r6ouilc1qbop8uz/latest-title", text: rows3[0].title })
    setElementText({ elementRef: "e6x8wvsr1r6ouilc1qbop8uz/latest-markdown", text: rows3[0].description })
    setElementText({ elementRef: "e6x8wvsr1r6ouilc1qbop8uz/latest-date", text: format({ date: rows3[0].created, format: "%A, %B %-d, %Y" }) })
    const date6 = now()
    setElementText({ elementRef: "e6x8wvsr1r6ouilc1qbop8uz/generated-date", text: date6.format("%A, %B %-d, %Y") })
    clearChildren({ containerRef: getElement({ elementRef: "e6x8wvsr1r6ouilc1qbop8uz/archive-grid" }).element })
    for (const [index, item2] of rows3) {
        if (index > 0) {
            const elementRef2 = instantiateWidget({ widgetSelector: "Report", instanceId: item2.report_id, dynPathDate: format({ date: item2.created, format: "%A, %B %-d, %Y" }), dynPathSummary: item2.description, dynPathTitle: item2.title, fnRefs: [widgetActionEvent2] })
            pushToContainer({ containerRef: getElement({ elementRef: "e6x8wvsr1r6ouilc1qbop8uz/archive-grid" }).element, elementRef: elementRef2, position: -1 })
        }
    }
    showScreen()
}

eventsWidgetAction widgetActionEvent(widgetInstanceId: string, eventName: string, actionContext: Struct, inputValues: Struct) {
    navigateTo({ route: "/briefing?report_id={id}".format({ id: widgetInstanceId }) })
}

eventsSimple loadConfig() {
    if (exists({ path: userDir({ nodeScope: false }).child("config.json") })) { // exec_out_exists
        const content = userDir({ nodeScope: false }).child("config.json").readToString()
        userConfiguration = parse({ string: content })
    } else { // exec_out_missing
        userConfiguration = { general: { arXiv: false, hn: false, news: false }, sources: [] }
        saveConfig({ config: userConfiguration })
    }
}

eventsSimple generateFeed() {
    const model2 = ai::findModel({ preferences: {"multimodal":null,"cost_weight":null,"speed_weight":null,"reasoning_weight":null,"creativity_weight":null,"factuality_weight":null,"function_calling_weight":null,"safety_weight":null,"openness_weight":null,"multilinguality_weight":null,"coding_weight":null,"model_hint":null} })
    model = model2
    const cuid3 = cuid()
    reportID = cuid3
    const database3 = open({ name: "reports", userScoped: true, batchSize: 1000 })
    reportDB = database3
    loadConfig()
    const date2 = now()
    const historyOut5 = make({ modelName: "" }).setSystemPrompt("{prompt}\n\nTODAY: {today}".format({ prompt: rSSPrompt, today: date2 }))
    rSSHistory = historyOut5
    const historyOut4 = make({ modelName: "" }).setSystemPrompt("{prompt}\n\nTODAY: {today}".format({ prompt: searchPrompt, today: date2 }))
    searchHistory = historyOut4
    const date5 = now()
    for (const parallelForEach2 of parallelForEach({ array: userConfiguration.sources, maxConcurrent: 15 })) {
        perpareNews({ source: parallelForEach2.value })
    }
    reportDB.batchInsert(reportEntry)
    const historyOut6 = make({ modelName: "" }).setSystemPrompt("You are a professional news analyst delivering concise, high-signal morning briefings.\n\n## Your Task\nGiven a set of news articles, produce a structured morning briefing in markdown. Call `write_report` exactly once with the complete report and a short non MD summary — no other output.\n\n---\n\n## Report Structure\n\n### 1. 🗞️ Morning Briefing — {Today's Date}\n*One-sentence framing of the day's overall news landscape.*\n\n---\n\n### 2. Executive Summary\n3–5 bullet points covering the most critical developments. Each bullet is one crisp, specific sentence — names, numbers, stakes. A busy executive should need nothing else.\n\n---\n\n### 3. In-Depth Briefing\nOne section per major story or theme. Group thematically when articles overlap.\n\nFor each story:\n\n**### [Descriptive Headline]**\n\n2–4 sentences of context and significance. Be specific — named actors, concrete numbers, clear causality. Note conflicting viewpoints or official responses where reported.\n\nIf the article has a thumbnail or lead image, embed it: `![Alt text](image_url)`\n*(Source: [Publication Name](article_url))*\n\n> If quantitative data is present, embed a chart here — see Chart Rules below.\n\n---\n\n### 4. What to Watch\n2–3 forward-looking bullets on upcoming decisions, deadlines, or developments flagged in the articles. Include dates where known.\n\n---\n\n## Linking Rules — Mandatory\n\n- Every source reference must be a real, working markdown hyperlink: `[Publication Name](url)`\n- Inline hyperlinks are encouraged wherever you reference a named entity, report, or dataset that has a URL in the source material\n- Never write a bare URL — always use anchor text\n- Do not omit sources to save space\n\n---\n\n## Image Rules\n\n- If an article's source metadata includes a thumbnail, hero image, or og:image URL, embed it at the top of that story's section using `![descriptive alt text](url)`\n- Only embed images that are direct asset URLs (ending in `.jpg`, `.png`, `.webp`, `.gif`, or clearly an image CDN path) — skip tracking pixels, icons, or ambiguous URLs\n- One image per story maximum; skip if no clean URL is available\n\n---\n\n## Chart Rules\n\nCharts are a key part of this briefing. Be proactive — if numbers exist in the articles, find a way to visualize them.\n\n**Actively look for chart opportunities in:**\n- Any percentage changes, growth rates, or year-over-year comparisons\n- Price or index movements over time\n- Rankings, market share, or survey results\n- Multi-country or multi-company comparisons\n- Budget figures, trade volumes, or economic indicators\n\n**The bar for inclusion is low: if the data makes a point more clearly as a chart than as prose, use a chart.**\n\nNever fabricate or estimate data — only chart figures explicitly stated in the source articles.\n\n**When a chart is used:**\n- Place it inline within the relevant story section, directly after the prose it illustrates\n- Introduce it with one sentence explaining what the data shows and why it matters\n- Follow it with one sentence interpreting the most important pattern visible\n- Never drop a chart without this surrounding context sandwich\n\n### Nivo (preferred for most charts)\n```nivo\ntype: bar|line|pie|radar|heatmap|scatter|funnel|treemap|sunburst|waffle|radialBar|bump|areaBump\ntitle: Chart Title\ncolors: paired|nivo|category10|accent|dark2|set1|set2|set3|pastel1|pastel2|spectral\nheight: 300\nshowLegend: true\nstacked: false\nlayout: vertical|horizontal\n---\ncol1,col2,col3\nval1,val2,val3\n```\n\n### Plotly (for statistical or multi-trace charts)\n```plotly\ntype: bar|line|scatter|pie\ntitle: Chart Title\n---\ncol1,col2\nval1,val2\n```\n\n---\n\n## Style Rules\n- Tone: calm, authoritative, neutral — no sensationalism, but not sterile either\n- Be specific: names, numbers, dates always beat vague generalities\n- Sentence variety: mix short punchy statements with longer contextual ones\n- Length scales with article volume — substance over padding, but don't truncate important stories\n- A good briefing has rhythm: a reader should want to continue to the next section")
    const historyOut2 = historyOut6.addMessage(makeMessage({ role: "User", type: "Text", text: "## News\n{news}\n\nToday: {today}".format({ news: reportEntry, today: date5 }) }))
    const { stats: stats3 } = fromModel({ model: model, maxIter: 15, infiniteContext: false, contextMode: "summarize", maxContextTokens: 32000 }).registerFunctionTools({ tools: [writeReport] }).invoke(historyOut2)
    pushStat({ stepName: "Briefing", stat: stats3 })
}

eventsSimple simpleEvent() {
    user({ title: "Notification", description: "", link: "/briefing?report_id={id}", showDesktop: true })
}

eventsSimple setupNewElement() {
    loadConfig()
    const arrayOut = array::push({ arrayIn: userConfiguration.sources, value: { label: getElementValue({ elementRef: getElement({ elementRef: "yg7y9ag1wz4ib8wg95k93erh/pa-label" }).element }).value, content: getElementValue({ elementRef: getElement({ elementRef: "yg7y9ag1wz4ib8wg95k93erh/pa-content" }).element }).value, goal: getElementValue({ elementRef: getElement({ elementRef: "yg7y9ag1wz4ib8wg95k93erh/pa-goal" }).element }).value, type: (startsWith({ string: getElementValue({ elementRef: getElement({ elementRef: "yg7y9ag1wz4ib8wg95k93erh/pa-content" }).element }).value, prefix: "https://" }) || startsWith({ string: getElementValue({ elementRef: getElement({ elementRef: "yg7y9ag1wz4ib8wg95k93erh/pa-content" }).element }).value, prefix: "http://" })) ? "RSS" : (startsWith({ string: getElementValue({ elementRef: getElement({ elementRef: "yg7y9ag1wz4ib8wg95k93erh/pa-content" }).element }).value, prefix: "r/" }) ? "Reddit" : "Search") } })
    userConfiguration = { general: userConfiguration.general, sources: arrayOut }
    saveConfig({ config: userConfiguration })
    loadConfigDashboard()
}

eventsSimple loadConfigDashboard() {
    clearChildren({ containerRef: getElement({ elementRef: "yg7y9ag1wz4ib8wg95k93erh/pi-list" }).element })
    loadConfig()
    for (const item4 of userConfiguration.sources) {
        const hash3 = md5({ input: item4.content })
        const elementRef = instantiateWidget({ widgetSelector: "Config Element", instanceId: hash3, dynPathTitle: item4.label, dynPathDescription: item4.content, dynPathLabel: item4.type, fnRefs: [widgetActionEvent] })
        pushChild({ containerRef: getElement({ elementRef: "yg7y9ag1wz4ib8wg95k93erh/pi-list" }).element, childRef: elementRef })
    }
}

eventsSimple showBriefing() {
    const { value, exists: exists2 } = getQueryParam({ paramName: "report_id" })
    if (exists2) {
        if (parallel({ threadModel: "tasks" })) { // exec_out
            const database4 = open({ name: "report_overview", userScoped: true, batchSize: 1000 })
            const values = database4.filter({ filter: "`report_id` = '{id}'".format({ id: value }), limit: 10, offset: 0 })
            if (values.get(0).success) {
                setElementText({ elementRef: "exjwj78m9nryq5r8rfvmz7lt/issue-text", text: values[0].report_id })
                setElementText({ elementRef: "exjwj78m9nryq5r8rfvmz7lt/briefing-date-top", text: format({ date: values[0].created, format: "%A, %B %-d, %Y" }) })
                setElementText({ elementRef: "exjwj78m9nryq5r8rfvmz7lt/content", text: values[0].report })
                showScreen()
            }
        } else { // exec_out[#2]
            clearChildren({ containerRef: getElement({ elementRef: "exjwj78m9nryq5r8rfvmz7lt/article-grid" }).element })
            const database5 = open({ name: "reports", userScoped: true, batchSize: 1000 })
            const session3 = createSession({ sessionName: "default", targetPartitions: 0, batchSize: 8192, repartitionJoins: true, repartitionAggregations: true, repartitionSorts: true, coalesceBatches: true, parquetPruning: true, collectStatistics: true })
            session3.registerLance({ database: database5, tableName: "reports" })
            const { rows, rowCount } = session3.sqlQuery({ query: "SELECT\n  date,\n  report_id,\n  summary,\n  title,\n  uri\nFROM reports\nWHERE report_id = '{id}'\nORDER BY date DESC;".format({ id: value }) })
            setElementText({ elementRef: "exjwj78m9nryq5r8rfvmz7lt/articles-count-badge", text: "{cnt} Stories".format({ cnt: rowCount }) })
            for (const item of rows) {
                const cuid2 = cuid()
                const elementRef3 = instantiateWidget({ widgetSelector: "Article", instanceId: cuid2, dynPathDate: (length({ string: item.date }) > 10) ? types::tryTransform({ typeIn: item.date }).typeOut.format("%B %-d, %Y") : item.date, dynPathSummary: item.summary, dynPathTitle: item.title, dynPathInterest: item.interest })
                pushToContainer({ containerRef: getElement({ elementRef: "exjwj78m9nryq5r8rfvmz7lt/article-grid" }).element, elementRef: elementRef3, position: -1 })
            }
        }
    }
}

notifyProjectUser(success: bool) {
}

eventsGeneric writeReport(title: string, shortSummary: string, report: string, payload: Struct) {
    if (reportCreated) {
        return `Already created a report`
    } else {
        reportCreated = true
        const date3 = now()
        let record = struct::set({ structIn: {}, field: "created", value: date3 }).structOut
        record.title = title
        record.report = report
        record.description = shortSummary
        record.report_id = reportID
        const database6 = open({ name: "report_overview", userScoped: true, batchSize: 1000 })
        database6.insertOne(record)
        user({ title: title, description: "", link: "/briefing?report_id={id}".format({ id: reportID }), showDesktop: true })
        return `Successfully created Report. You are done now!`
    }
}

eventsWidgetAction widgetActionEvent(widgetInstanceId: string, eventName: string, actionContext: Struct, inputValues: Struct) {
    loadConfig()
    filterSources({ hash: widgetInstanceId })
    saveConfig({ config: userConfiguration })
    loadConfigDashboard()
}
