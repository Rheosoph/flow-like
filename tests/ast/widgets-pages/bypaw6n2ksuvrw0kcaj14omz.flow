interface Metadata {
    name: string;
    description: string;
    long_description?: string | null;
    release_notes?: string | null;
    tags: string[];
    use_case?: string | null;
    icon?: string | null;
    thumbnail?: string | null;
    preview_media: string[];
    age_rating?: int | null;
    website?: string | null;
    support_url?: string | null;
    docs_url?: string | null;
    organization_specific_values?: int[] | null;
    created_at: SystemTime;
    updated_at: SystemTime;
}
interface SystemTime {
    secs_since_epoch: int;
    nanos_since_epoch: int;
}
interface LlmModelEvaluation {
    slug: string;
    name: string;
    release_date?: string | null;
    creator_name: string;
    creator_slug: string;
    evaluations?: any;
    pricing?: any;
    median_output_tokens_per_second?: float | null;
    median_time_to_first_token_seconds?: float | null;
    median_time_to_first_answer_token?: float | null;
}
interface Bit {
    id?: string = "";
    type?: "Llm" | "Vlm" | "Tts" | "Stt" | "Embedding" | "ImageEmbedding" | "File" | "Media" | "ImageGeneration" | "VideoGeneration" | "Template" | "Tokenizer" | "TokenizerConfig" | "SpecialTokensMap" | "Config" | "Course" | "PreprocessorConfig" | "Projection" | "Project" | "Board" | "Other" | "ObjectDetection" = "Other";
    meta?: Map<string, Metadata> = {};
    authors?: string[] = [];
    repository?: string | null = null;
    download_link?: string | null = null;
    file_name?: string | null = null;
    hash?: string = "";
    size?: int | null = null;
    hub?: string = "";
    parameters?: any = null;
    version?: string | null = null;
    license?: string | null = null;
    dependencies?: string[] = [];
    dependency_tree_hash?: string = "";
    created?: string = "";
    updated?: string = "";
    model_slug?: string | null = null;
    model_evaluation?: LlmModelEvaluation | null = null;
}
interface HistoryMessage {
    role: "system" | "user" | "assistant" | "function" | "tool";
    content: string | Struct[];
    name?: string | null;
    tool_calls?: ToolCall[] | null;
    tool_call_id?: string | null;
    annotations?: Annotation[] | null;
}
interface ImageUrl {
    url: string;
    detail?: string | null;
}
interface ToolCall {
    id: string;
    type: string;
    function: ToolCallFunction;
}
interface ToolCallFunction {
    name: string;
    arguments: string;
}
interface Annotation {
    type: string;
    url_citation?: UrlCitation | null;
}
interface UrlCitation {
    end_index: int;
    start_index: int;
    title: string;
    url: string;
    content?: string | null;
}
interface StreamOptions {
    include_usage: bool;
}
interface Tool {
    type: "function";
    function: HistoryFunction;
}
interface HistoryFunction {
    name: string;
    description?: string | null;
    parameters: HistoryFunctionParameters;
}
interface HistoryFunctionParameters {
    type: "object" | "number" | "string" | "array" | "null" | "boolean";
    properties?: Map<string, HistoryJSONSchemaDefine> | null;
    required?: string[] | null;
}
interface HistoryJSONSchemaDefine {
    type?: "object" | "number" | "string" | "array" | "null" | "boolean" | null;
    description?: string | null;
    enum?: string[] | null;
    properties?: Map<string, HistoryJSONSchemaDefine> | null;
    required?: string[] | null;
    items?: HistoryJSONSchemaDefine | null;
}
interface Usage {
    include: bool;
}
interface History {
    model: string;
    messages: HistoryMessage[];
    preset?: string | null;
    stream?: bool | null;
    stream_options?: StreamOptions | null;
    max_completion_tokens?: int | null;
    top_p?: float | null;
    temperature?: float | null;
    thinking?: "off" | "low" | "mid" | "high" | null;
    seed?: int | null;
    presence_penalty?: float | null;
    frequency_penalty?: float | null;
    user?: string | null;
    stop?: string[] | null;
    response_format?: string | any | null;
    n?: int | null;
    tools?: Tool[] | null;
    tool_choice?: null | Struct | null;
    usage?: Usage | null;
}
interface NodeDBConnection {
    cache_key: string;
}
interface ReportEntry {
    title: string;
    uri: string;
    summary: string;
    date: string;
    interest?: string;
    report_id: string;
}
interface UserConfiguration {
    general: Struct;
    sources: Struct[];
}
interface Elements {
    label: string;
    content: string;
    goal: string;
    type: string;
}

const model: Bit
const rSSHistory: History = {"model":"","messages":[]}
@category("Prompts")
const rSSPrompt = "# News Research Agent\n\nYou process an RSS feed for a daily briefing pipeline. Your output feeds a downstream summarizer LLM — write for machines, not humans.\n\n## Hard constraints\n- **Max 5 tool calls total.** Budget aggressively, skip aggressively.\n- **Recency: today or yesterday only.** Drop everything else, including no-date entries. Apply before anything else — feeds carry weeks of backlog.\n- **Only `add_news` for articles you fetched.** Never summarize from RSS metadata alone.\n\n## Workflow\nFor each RSS entry:\n1. **Triage from metadata** (title, snippet, date). Stale or clearly off-Goal → skip, no fetch.\n2. **Fetch** via `fetch_page(url)` only if plausibly relevant.\n3. **Judge** post-fetch: substantive AND on-Goal? Yes → `add_news(...)`. No → move on.\n\nBe strict. Marginal relevance ≠ relevant.\n\n## Summary spec\nDense factual prose, 10–20 lines, never under 8. No bullets, no filler, no headline restatement, no editorializing.\n\nInclude where present:\n- Numbers, %, prices, rankings, statistics\n- Named entities (people, companies, countries, products, legislation)\n- Dates and forward timeline (what's next, when)\n- Causal context (why it matters, what triggered it)\n- Opposing views or official responses\n- Explicitly flag data series / comparisons suitable for charting\n\n## Inputs\n- RSS feed: titles, URLs, dates\n- Goal: user's interests and relevance criteria\n\n## Output\n`add_news` calls only. No prose, no status, no recap."
@category("Report")
const reportCreated = false
@category("Report")
const reportDB: NodeDBConnection = {}
@category("Report")
const reportEntry: ReportEntry[] = []
@category("Report")
const reportID = ""
const searchHistory: History = {"model":"","messages":[]}
@category("Prompts")
const searchPrompt = "# News Research Agent\n\nYou research a topic for a daily briefing pipeline. Your output feeds a downstream summarizer LLM — write for machines, not humans.\n\n## Hard constraints\n- **Recency: today or yesterday only.** Encode into every query (`after:YYYY-MM-DD`, `\"Month YYYY\"`). Discard anything not demonstrably recent. No visible date → skip.\n- **Only `add_news` for pages you fetched.** Never summarize from search snippets alone.\n- **Depth over breadth.** Three well-sourced detailed entries beat ten shallow ones.\n\n## Workflow\n\n### Phase 1 — Search\n1. Formulate 1–3 SearXNG queries covering different angles (latest developments, key actors, data/stats). Use operators where useful: `\"exact phrase\"`, `site:`, `after:`.\n2. Call `search(query)` for each. Scan titles, snippets, dates.\n3. Pick promising URLs. Prioritise primary sources (official statements, wire services, major outlets) over aggregators and opinion.\n\n### Phase 2 — Fetch & Evaluate\n4. `fetch_page(url)` on each candidate.\n5. Decide:\n   - Relevant + recent + substantive → `add_news(title, uri, summary, date)`\n   - Irrelevant, duplicate, stale → discard\n6. If coverage is thin after round 1, run one refined query and repeat. Stop there.\n\nBe strict on relevance — marginal ≠ relevant.\n\n## Summary spec\nDense factual prose, 10–20 lines, never under 8. No bullets, no filler, no headline restatement, no editorializing.\n\nInclude where present:\n- Numbers, %, prices, rankings, statistics\n- Named entities (people, companies, countries, products, legislation)\n- Dates and forward timeline (what's next, when)\n- Causal context (why it matters, what triggered it)\n- Opposing views or official responses\n- Explicitly flag data series / comparisons suitable for charting\n\n## Inputs\n- Topic: subject to research\n- Goal: user's interests and relevance criteria\n\n## Output\n`add_news` calls only. No prose, no status, no recap."
const userConfiguration: UserConfiguration = {"general":{},"sources":[]}

function filterSources(hash: string) {
    let elements: Elements[] = []
    elements = []
    for (const item of userConfiguration.sources) {
        const hash2 = md5(item.content)
        if (hash != hash2) {
            const arrayOut = elements.push(item)
            elements = arrayOut
        }
    }
    userConfiguration = { general: userConfiguration.general, sources: elements }
}

function perpareNews(source: Struct) {
    let label: string = ""
    log::info(source, { toast: false })
    label = source.label
    if (source.type == "Search") {
        const historyOut2 = searchHistory.addMessage(makeMessage("User", "Text", { text: "Topic {label}\nSearch for: {Query}\nGoal: {Goal}".format({ goal: source.goal, label: source.label, query: source.content }) }))
        const { stats: stats2 } = fromModel(model, { maxIter: 20, infiniteContext: true, contextMode: "summarize", maxContextTokens: 32000 }).registerFunctionTools({ tools: [search, fetchPage, addNews] }).invoke(historyOut2)
        pushStat(source.label, stats2)
    } else {
        const response = request("GET", (source.type == "Reddit") ? "https://www.reddit.com/{subreddit}/.rss?limit=30".format({ subreddit: source.content }) : (contains(source.content, "?") ? "{url}&limit=30".format({ url: source.content }) : "{url}?limit=30".format({ url: source.content }))).fetch()
        const text2 = response.toText()
        const date2 = now()
        if (filterFeedItemsByDate(parseFeed(text2, (source.type == "Reddit") ? "https://www.reddit.com/{subreddit}/.rss?limit=30".format({ subreddit: source.content }) : (contains(source.content, "?") ? "{url}&limit=30".format({ url: source.content }) : "{url}?limit=30".format({ url: source.content }))).items, date2.add({ days: -2, hours: 0, minutes: 0, seconds: 0 }), { releasedTo: date2, dateField: "release_date", includeUndated: false }).filteredItems.length > 0) {
            const historyOut = rSSHistory.addMessage(makeMessage("User", "Text", { text: "Topic {label}\nGoal: {Goal}\n\n## Feed\n{feed}\n".format({ goal: source.goal, label: source.label, feed: filterFeedItemsByDate(parseFeed(text2, (source.type == "Reddit") ? "https://www.reddit.com/{subreddit}/.rss?limit=30".format({ subreddit: source.content }) : (contains(source.content, "?") ? "{url}&limit=30".format({ url: source.content }) : "{url}?limit=30".format({ url: source.content }))).items, date2.add({ days: -2, hours: 0, minutes: 0, seconds: 0 }), { releasedTo: date2, dateField: "release_date", includeUndated: false }).filteredItems }) }))
            const { stats } = fromModel(model, { maxIter: 20, infiniteContext: true, contextMode: "summarize", maxContextTokens: 32000 }).registerFunctionTools({ tools: [fetchPage, addNews] }).invoke(historyOut)
            pushStat(source.label, stats)
        }
    }
    @description("Add News to the report")
    eventsGeneric addNews(title: string, summary: string, uri: string, date: string, payload: Struct) {
        const arrayOut = reportEntry.push({ value: { title: title, uri: uri, summary: summary, date: date, interest: label, report_id: reportID } })
        reportEntry = arrayOut
        return `Successfully Added`
    }
    eventsGeneric fetchPage(url: string, payload: Struct) {
        @collapse("Fetch Website") {
            pushStep("Reading Website", url)
            const aPICall = request("GET", url).fetch()
            aPICall {
                execSuccess: {
                    const text = aPICall.response.toText()
                    const markdown = md::fromHtml(text, ["script","style","iframe"])
                    return markdown
                }
                execError: {
                    return `FAILED TO FETCH WEBSITE - SKIP`
                }
            }
        }
    }
    eventsGeneric search(query: string, language: string, page: int, payload: Struct) {
        @collapse("Internet Search") {
            pushStep("Searching Internet", query)
            const aPICall3 = request("GET", "https://search.flow-like.com/search?q={q}&format=json&pageno={page}&language={lang}".format({ page: page.fallback(1).result, lang: language.fallback("en-US").result, q: urlEncode(query) })).fetch()
            aPICall3 {
                execSuccess: {
                    const struct2 = aPICall3.response.toJson()
                    return struct2
                }
                execError: {
                    return `FAILED TO SEARCH`
                }
            }
        }
    }
}

function saveConfig(config: Struct) {
    userDir(false).child("config.json").writeString(stringify(config, { pretty: true }))
}

@description("A simple event without input or output")
eventsSimple clickLatestOverview() {
    const database2 = open("report_overview", { userScoped: true, batchSize: 1000 })
    const session2 = createSession("default", { targetPartitions: 0, batchSize: 8192, repartitionJoins: true, repartitionAggregations: true, repartitionSorts: true, coalesceBatches: true, parquetPruning: true, collectStatistics: true })
    session2.registerLance(database2, { tableName: "reports" })
    const { rows: rows2 } = session2.sqlQuery({ query: "SELECT\n  report_id,\n  title,\n  description,\n  report,\n  created\nFROM reports\nORDER BY to_timestamp(created) DESC\nLIMIT 1;" })
    navigateTo("/briefing?report_id={id}".format({ id: rows2[0].report_id }))
}

@description("A simple event without input or output")
eventsSimple loadOverview() {
    const database = open("report_overview", { userScoped: true, batchSize: 1000 })
    const session = createSession("default", { targetPartitions: 0, batchSize: 8192, repartitionJoins: true, repartitionAggregations: true, repartitionSorts: true, coalesceBatches: true, parquetPruning: true, collectStatistics: true })
    session.registerLance(database, { tableName: "reports" })
    const { rows: rows3 } = session.sqlQuery({ query: "SELECT\n  report_id,\n  title,\n  description,\n  report,\n  created\nFROM reports\nORDER BY to_timestamp(created) DESC\nLIMIT 25;" })
    setElementText("exjwj78m9nryq5r8rfvmz7lt/subline-right", "{num} Briefing(s)".format({ num: rows3.length }))
    setElementText("e6x8wvsr1r6ouilc1qbop8uz/latest-title", rows3[0].title)
    setElementText("e6x8wvsr1r6ouilc1qbop8uz/latest-markdown", rows3[0].description)
    setElementText("e6x8wvsr1r6ouilc1qbop8uz/latest-date", format({ date: rows3[0].created, format: "%A, %B %-d, %Y" }))
    const date5 = now()
    setElementText("e6x8wvsr1r6ouilc1qbop8uz/generated-date", date5.format("%A, %B %-d, %Y"))
    clearChildren(getElement("e6x8wvsr1r6ouilc1qbop8uz/archive-grid").element)
    for (const [index, item2] of rows3) {
        if (index > 0) {
            const elementRef2 = instantiateWidget({ widgetSelector: "Report", instanceId: item2.report_id, dynPathDate: format({ date: item2.created, format: "%A, %B %-d, %Y" }), dynPathSummary: item2.description, dynPathTitle: item2.title, fnRefs: [widgetActionEvent2] })
            pushToContainer(getElement("e6x8wvsr1r6ouilc1qbop8uz/archive-grid").element, elementRef2, { position: -1 })
        }
    }
    showScreen()
}

@description("Entry point triggered when a widget action is invoked. Provides action context data.")
eventsWidgetAction widgetActionEvent(widgetInstanceId: string, eventName: string, actionContext: Struct, inputValues: Struct) {
    navigateTo("/briefing?report_id={id}".format({ id: widgetInstanceId }))
}

@description("A simple event without input or output")
eventsSimple loadConfig() {
    @collapse("Load Config") {
        if (exists(userDir(false).child("config.json"))) { // exec_out_exists
            const content = userDir(false).child("config.json").readToString()
            userConfiguration = parse({ string: content })
        } else { // exec_out_missing
            userConfiguration = { general: { arXiv: false, hn: false, news: false }, sources: [] }
            saveConfig({ config: userConfiguration })
        }
    }
}

@description("A simple event without input or output")
eventsSimple generateFeed() {
    @collapse("Generate Briefing") {
        const model2 = ai::findModel({ preferences: {"multimodal":null,"cost_weight":null,"speed_weight":null,"reasoning_weight":null,"creativity_weight":null,"factuality_weight":null,"function_calling_weight":null,"safety_weight":null,"openness_weight":null,"multilinguality_weight":null,"coding_weight":null,"model_hint":null} })
        model = model2
        const cuid3 = cuid()
        reportID = cuid3
        const database3 = open("reports", { userScoped: true, batchSize: 1000 })
        reportDB = database3
        loadConfig()
        @collapse("Prepare Prompts") {
            const date2 = now()
            const historyOut3 = make("").setSystemPrompt("{prompt}\n\nTODAY: {today}".format({ prompt: rSSPrompt, today: date2 }))
            rSSHistory = historyOut3
            const historyOut2 = make("").setSystemPrompt("{prompt}\n\nTODAY: {today}".format({ prompt: searchPrompt, today: date2 }))
            searchHistory = historyOut2
        }
        const date4 = now()
        for (const parallelForEach2 of parallelForEach(userConfiguration.sources, { maxConcurrent: 15 })) {
            perpareNews({ source: parallelForEach2.value })
        }
        reportDB.batchInsert(reportEntry)
        const historyOut4 = make("").setSystemPrompt("You are a professional news analyst delivering concise, high-signal morning briefings.\n\n## Your Task\nGiven a set of news articles, produce a structured morning briefing in markdown. Call `write_report` exactly once with the complete report and a short non MD summary — no other output.\n\n---\n\n## Report Structure\n\n### 1. 🗞️ Morning Briefing — {Today's Date}\n*One-sentence framing of the day's overall news landscape.*\n\n---\n\n### 2. Executive Summary\n3–5 bullet points covering the most critical developments. Each bullet is one crisp, specific sentence — names, numbers, stakes. A busy executive should need nothing else.\n\n---\n\n### 3. In-Depth Briefing\nOne section per major story or theme. Group thematically when articles overlap.\n\nFor each story:\n\n**### [Descriptive Headline]**\n\n2–4 sentences of context and significance. Be specific — named actors, concrete numbers, clear causality. Note conflicting viewpoints or official responses where reported.\n\nIf the article has a thumbnail or lead image, embed it: `![Alt text](image_url)`\n*(Source: [Publication Name](article_url))*\n\n> If quantitative data is present, embed a chart here — see Chart Rules below.\n\n---\n\n### 4. What to Watch\n2–3 forward-looking bullets on upcoming decisions, deadlines, or developments flagged in the articles. Include dates where known.\n\n---\n\n## Linking Rules — Mandatory\n\n- Every source reference must be a real, working markdown hyperlink: `[Publication Name](url)`\n- Inline hyperlinks are encouraged wherever you reference a named entity, report, or dataset that has a URL in the source material\n- Never write a bare URL — always use anchor text\n- Do not omit sources to save space\n\n---\n\n## Image Rules\n\n- If an article's source metadata includes a thumbnail, hero image, or og:image URL, embed it at the top of that story's section using `![descriptive alt text](url)`\n- Only embed images that are direct asset URLs (ending in `.jpg`, `.png`, `.webp`, `.gif`, or clearly an image CDN path) — skip tracking pixels, icons, or ambiguous URLs\n- One image per story maximum; skip if no clean URL is available\n\n---\n\n## Chart Rules\n\nCharts are a key part of this briefing. Be proactive — if numbers exist in the articles, find a way to visualize them.\n\n**Actively look for chart opportunities in:**\n- Any percentage changes, growth rates, or year-over-year comparisons\n- Price or index movements over time\n- Rankings, market share, or survey results\n- Multi-country or multi-company comparisons\n- Budget figures, trade volumes, or economic indicators\n\n**The bar for inclusion is low: if the data makes a point more clearly as a chart than as prose, use a chart.**\n\nNever fabricate or estimate data — only chart figures explicitly stated in the source articles.\n\n**When a chart is used:**\n- Place it inline within the relevant story section, directly after the prose it illustrates\n- Introduce it with one sentence explaining what the data shows and why it matters\n- Follow it with one sentence interpreting the most important pattern visible\n- Never drop a chart without this surrounding context sandwich\n\n### Nivo (preferred for most charts)\n```nivo\ntype: bar|line|pie|radar|heatmap|scatter|funnel|treemap|sunburst|waffle|radialBar|bump|areaBump\ntitle: Chart Title\ncolors: paired|nivo|category10|accent|dark2|set1|set2|set3|pastel1|pastel2|spectral\nheight: 300\nshowLegend: true\nstacked: false\nlayout: vertical|horizontal\n---\ncol1,col2,col3\nval1,val2,val3\n```\n\n### Plotly (for statistical or multi-trace charts)\n```plotly\ntype: bar|line|scatter|pie\ntitle: Chart Title\n---\ncol1,col2\nval1,val2\n```\n\n---\n\n## Style Rules\n- Tone: calm, authoritative, neutral — no sensationalism, but not sterile either\n- Be specific: names, numbers, dates always beat vague generalities\n- Sentence variety: mix short punchy statements with longer contextual ones\n- Length scales with article volume — substance over padding, but don't truncate important stories\n- A good briefing has rhythm: a reader should want to continue to the next section")
        const historyOut = historyOut4.addMessage(makeMessage("User", "Text", { text: "## News\n{news}\n\nToday: {today}".format({ news: reportEntry, today: date4 }) }))
        const { stats } = fromModel(model, { maxIter: 15, infiniteContext: false, contextMode: "summarize", maxContextTokens: 32000 }).registerFunctionTools({ tools: [writeReport] }).invoke(historyOut)
        pushStat("Briefing", stats)
    }
}

