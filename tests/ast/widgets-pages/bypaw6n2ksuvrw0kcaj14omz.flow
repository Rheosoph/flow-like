    }
}

@description("A simple event without input or output")
eventsSimple setupNewElement() {
    @collapse("Add Config") {
        loadConfig()
        const arrayOut = array::push(userConfiguration.sources, { value: { label: getElementValue(getElement("yg7y9ag1wz4ib8wg95k93erh/pa-label").element).value, content: getElementValue(getElement("yg7y9ag1wz4ib8wg95k93erh/pa-content").element).value, goal: getElementValue(getElement("yg7y9ag1wz4ib8wg95k93erh/pa-goal").element).value, type: (startsWith(getElementValue(getElement("yg7y9ag1wz4ib8wg95k93erh/pa-content").element).value, "https://") || startsWith(getElementValue(getElement("yg7y9ag1wz4ib8wg95k93erh/pa-content").element).value, "http://")) ? "RSS" : (startsWith(getElementValue(getElement("yg7y9ag1wz4ib8wg95k93erh/pa-content").element).value, "r/") ? "Reddit" : "Search") } })
        userConfiguration = { general: userConfiguration.general, sources: arrayOut }
        saveConfig({ config: userConfiguration })
        loadConfigDashboard()
    }
}

@description("A simple event without input or output")
eventsSimple loadConfigDashboard() {
    @collapse("Load Config Dashboard") {
        clearChildren(getElement("yg7y9ag1wz4ib8wg95k93erh/pi-list").element)
        loadConfig()
        for (const item3 of userConfiguration.sources) {
            const hash2 = md5(item3.content)
            const elementRef = instantiateWidget({ widgetSelector: "Config Element", instanceId: hash2, dynPathTitle: item3.label, dynPathDescription: item3.content, dynPathLabel: item3.type, fnRefs: [widgetActionEvent] })
            pushChild(getElement("yg7y9ag1wz4ib8wg95k93erh/pi-list").element, elementRef)
        }
    }
}

@description("A simple event without input or output")
eventsSimple showBriefing() {
    @collapse("Show Briefing") {
        const { value, exists: exists2 } = getQueryParam("report_id")
        if (exists2) {
            if (parallel("tasks")) { // exec_out
                const database4 = open("report_overview", { userScoped: true, batchSize: 1000 })
                const values = database4.filter({ filter: "`report_id` = '{id}'".format({ id: value }), limit: 10, offset: 0 })
                if (values.get(0).success) {
                    setElementText("exjwj78m9nryq5r8rfvmz7lt/issue-text", values[0].report_id)
                    setElementText("exjwj78m9nryq5r8rfvmz7lt/briefing-date-top", format({ date: values[0].created, format: "%A, %B %-d, %Y" }))
                    setElementText("exjwj78m9nryq5r8rfvmz7lt/content", values[0].report)
                    showScreen()
                }
            } else { // exec_out[#2]
                clearChildren(getElement("exjwj78m9nryq5r8rfvmz7lt/article-grid").element)
                const database5 = open("reports", { userScoped: true, batchSize: 1000 })
                const session3 = createSession("default", { targetPartitions: 0, batchSize: 8192, repartitionJoins: true, repartitionAggregations: true, repartitionSorts: true, coalesceBatches: true, parquetPruning: true, collectStatistics: true })
                session3.registerLance(database5, { tableName: "reports" })
                const { rows, rowCount } = session3.sqlQuery({ query: "SELECT\n  date,\n  report_id,\n  summary,\n  title,\n  uri\nFROM reports\nWHERE report_id = '{id}'\nORDER BY date DESC;".format({ id: value }) })
                setElementText("exjwj78m9nryq5r8rfvmz7lt/articles-count-badge", "{cnt} Stories".format({ cnt: rowCount }))
                for (const item of rows) {
                    const cuid2 = cuid()
                    const elementRef3 = instantiateWidget({ widgetSelector: "Article", instanceId: cuid2, dynPathDate: (length(item.date) > 10) ? types::tryTransform(item.date).typeOut.format("%B %-d, %Y") : item.date, dynPathSummary: item.summary, dynPathTitle: item.title, dynPathInterest: item.interest })
                    pushToContainer(getElement("exjwj78m9nryq5r8rfvmz7lt/article-grid").element, elementRef3, { position: -1 })
                }
            }
        }
    }
}

@description("A generic event without input or output")
eventsGeneric writeReport(title: string, shortSummary: string, report: string, payload: Struct) {
    @collapse("Generate Briefing") {
        if (reportCreated) {
            return `Already created a report`
        } else {
            reportCreated = true
            const date3 = now()
            let row = struct::set({ structIn: {}, field: "created", value: date3 }).structOut
            row.title = title
            row.report = report
            row.description = shortSummary
            row.report_id = reportID
            const database6 = open("report_overview", { userScoped: true, batchSize: 1000 })
            database6.insertOne(row)
            user(title, "", { link: "/briefing?report_id={id}".format({ id: reportID }), showDesktop: true })
            return `Successfully created Report. You are done now!`
        }
    }
}

@description("Entry point triggered when a widget action is invoked. Provides action context data.")
eventsWidgetAction widgetActionEvent2(widgetInstanceId: string, eventName: string, actionContext: Struct, inputValues: Struct) {
    @collapse("Load Config Dashboard") {
        loadConfig()
        filterSources({ hash: widgetInstanceId })
        saveConfig({ config: userConfiguration })
        loadConfigDashboard()
    }
}

