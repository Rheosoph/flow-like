{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmbeddingBatch",
  "type": "object",
  "properties": {
    "embeddings": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "space": {
      "$ref": "#/$defs/EmbeddingSpace"
    },
    "provenance": {
      "$ref": "#/$defs/EmbeddingProvenance"
    },
    "usage": {
      "$ref": "#/$defs/EmbeddingUsage"
    }
  },
  "required": [
    "embeddings",
    "space",
    "provenance",
    "usage"
  ],
  "$defs": {
    "EmbeddingSpace": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Identifies a validated compatible query/document space, including the output recipe.",
          "type": "string"
        },
        "dimensions": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "normalized": {
          "type": "boolean"
        },
        "metric": {
          "$ref": "#/$defs/EmbeddingMetric"
        }
      },
      "required": [
        "id",
        "dimensions",
        "normalized",
        "metric"
      ]
    },
    "EmbeddingMetric": {
      "type": "string",
      "enum": [
        "cosine",
        "dot_product",
        "euclidean"
      ]
    },
    "EmbeddingProvenance": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "pipeline_fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "adapter",
        "pipeline_fingerprint"
      ]
    },
    "EmbeddingUsage": {
      "type": "object",
      "properties": {
        "input_items": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "text_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "audio_duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "video_frames": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "input_items",
        "audio_duration_ms",
        "video_frames"
      ]
    }
  }
}