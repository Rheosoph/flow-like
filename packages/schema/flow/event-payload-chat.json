    "allow_file_upload": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "allow_voice_input": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "allow_voice_output": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "allow_voice_mode": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "tools": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "default_tools": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "example_messages": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    }
  }
