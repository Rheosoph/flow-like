{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "RemoveNodeCommand",
	"type": "object",
	"properties": {
		"node": {
			"$ref": "#/$defs/Node"
		},
		"connected_nodes": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/Node"
			}
		}
	},
	"required": ["node", "connected_nodes"],
	"$defs": {
		"Node": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"friendly_name": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"coordinates": {
					"type": ["array", "null"],
					"prefixItems": [
						{
							"type": "number",
							"format": "float"
						},
						{
							"type": "number",
							"format": "float"
						},
						{
							"type": "number",
							"format": "float"
						}
					],
					"minItems": 3,
					"maxItems": 3
				},
				"category": {
					"type": "string"
				},
				"scores": {
					"anyOf": [
						{
							"$ref": "#/$defs/NodeScores"
						},
						{
							"type": "null"
						}
					]
				},
				"pins": {
					"type": "object",
					"additionalProperties": {
						"$ref": "#/$defs/Pin"
					}
				},
				"start": {
					"type": ["boolean", "null"]
				},
				"icon": {
					"type": ["string", "null"]
				},
				"comment": {
					"type": ["string", "null"]
				},
				"long_running": {
					"type": ["boolean", "null"]
				},
				"error": {
					"type": ["string", "null"]
				},
				"docs": {
					"type": ["string", "null"]
				},
				"event_callback": {
					"type": ["boolean", "null"]
				},
				"layer": {
					"type": ["string", "null"]
				},
				"hash": {
					"type": ["integer", "null"],
					"format": "uint64",
					"minimum": 0
				},
				"fn_refs": {
					"anyOf": [
						{
							"$ref": "#/$defs/FnRefs"
						},
						{
							"type": "null"
						}
					]
				},
				"oauth_providers": {
					"description": "OAuth provider IDs this node requires (references Hub's oauth_providers config)",
					"type": ["array", "null"],
					"items": {
						"type": "string"
					}
				},
				"required_oauth_scopes": {
					"description": "OAuth scopes required by this node (provider_id -> scopes)",
					"type": ["object", "null"],
					"additionalProperties": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				},
				"only_offline": {
					"description": "If true, this node can only run locally (compute-intensive, RPA, browser automation)",
					"type": "boolean",
					"default": false
				},
				"version": {
					"description": "Schema version for node migration. When catalog version > placed version, pins are synced.\nNone means unversioned (legacy). Bump this when changing pins in get_node().",
					"type": ["integer", "null"],
					"format": "uint32",
					"minimum": 0
				},
				"wasm": {
					"description": "WASM metadata for external nodes. None for built-in catalog nodes.\nPopulated automatically when placing or pasting nodes; never trust frontend-supplied values.",
					"anyOf": [
						{
							"$ref": "#/$defs/NodeWasm"
						},
						{
							"type": "null"
						}
					]
				},
				"namespace": {
					"description": "FlowScript namespace path (`string`, `http`, `utils.markdown`; dotted when nested).\nPresentation only — never part of node identity (`name` stays the id).",
					"type": ["string", "null"]
				},
				"alias": {
					"description": "FlowScript member name inside `namespace` (`trim`, `fetch`, `createIssue`).\nPresentation only — never part of node identity.",
					"type": ["string", "null"]
				},
				"receiver": {
					"description": "Name of the data input pin that receives the value in FlowScript method form (`s` in `s.trim()`).\nPresentation only. Absent applies the default rule; an empty string opts out (static only).",
					"type": ["string", "null"]
				}
			},
			"required": [
				"id",
				"name",
				"friendly_name",
				"description",
				"category",
				"pins"
			]
		},
		"NodeScores": {
			"description": "Represents quality metrics for a node, with scores ranging from 0 to 10 (low - high).\nHigher values indicate higher risk/impact in the given category. Use 0 for \"none/low\"\nand 10 for \"very high\".\n\n# Score Categories\n* `privacy` - Measures data protection and confidentiality (0 low - 10 high).\n* `security` - Assesses resistance against potential attacks and exposure (0 low - 10 high).\n* `performance` - Evaluates computational efficiency and speed. Higher means worse performance.\n* `governance` - Indicates compliance and auditability with policies and regulations.\n* `reliability` - Measures stability, error rates and recoverability.\n* `cost` - Represents resource/cost impact for running this node.",
			"type": "object",
			"properties": {
				"privacy": {
					"type": "integer",
					"format": "uint8",
					"minimum": 0,
					"maximum": 255
				},
				"security": {
					"type": "integer",
					"format": "uint8",
					"minimum": 0,
					"maximum": 255
				},
				"performance": {
					"type": "integer",
					"format": "uint8",
					"minimum": 0,
					"maximum": 255
				},
				"governance": {
					"type": "integer",
					"format": "uint8",
					"minimum": 0,
					"maximum": 255
				},
				"reliability": {
					"type": "integer",
					"format": "uint8",
					"minimum": 0,
					"maximum": 255
				},
				"cost": {
					"type": "integer",
					"format": "uint8",
					"minimum": 0,
					"maximum": 255
				}
			},
			"required": [
				"privacy",
				"security",
				"performance",
				"governance",
				"reliability",
				"cost"
			]
		},
		"Pin": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"friendly_name": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"pin_type": {
					"$ref": "#/$defs/PinType"
				},
				"data_type": {
					"$ref": "#/$defs/VariableType"
				},
				"schema": {
					"type": ["string", "null"]
				},
				"value_type": {
					"$ref": "#/$defs/ValueType"
				},
				"depends_on": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"type": "string"
					}
				},
				"connected_to": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"type": "string"
					}
				},
				"default_value": {
					"type": ["array", "null"],
					"items": {
						"type": "integer",
						"format": "uint8",
						"minimum": 0,
						"maximum": 255
					}
				},
				"index": {
					"type": "integer",
					"format": "uint16",
					"minimum": 0,
					"maximum": 65535
				},
				"options": {
					"anyOf": [
						{
							"$ref": "#/$defs/PinOptions"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
				"id",
				"name",
				"friendly_name",
				"description",
				"pin_type",
				"data_type",
				"value_type",
				"depends_on",
				"connected_to",
				"index"
			]
		},
		"PinType": {
			"type": "string",
			"enum": ["Input", "Output"]
		},
		"VariableType": {
			"type": "string",
			"enum": [
				"Execution",
				"String",
				"Integer",
				"Float",
				"Boolean",
				"Date",
				"PathBuf",
				"Generic",
				"Struct",
				"Byte"
			]
		},
		"ValueType": {
			"type": "string",
			"enum": ["Array", "Normal", "HashMap", "HashSet"]
		},
		"PinOptions": {
			"type": "object",
			"properties": {
				"sensitive": {
					"type": ["boolean", "null"]
				},
				"valid_values": {
					"type": ["array", "null"],
					"items": {
						"type": "string"
					}
				},
				"range": {
					"type": ["array", "null"],
					"prefixItems": [
						{
							"type": "number",
							"format": "double"
						},
						{
							"type": "number",
							"format": "double"
						}
					],
					"minItems": 2,
					"maxItems": 2
				},
				"step": {
					"type": ["number", "null"],
					"format": "double"
				},
				"enforce_schema": {
					"type": ["boolean", "null"]
				},
				"enforce_generic_value_type": {
					"type": ["boolean", "null"]
				}
			}
		},
		"FnRefs": {
			"type": "object",
			"properties": {
				"fn_refs": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"can_reference_fns": {
					"type": "boolean"
				},
				"can_be_referenced_by_fns": {
					"type": "boolean"
				}
			},
			"required": ["fn_refs", "can_reference_fns", "can_be_referenced_by_fns"]
		},
		"NodeWasm": {
			"type": "object",
			"properties": {
				"package_id": {
					"type": "string"
				},
				"permissions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/NodePermission"
					},
					"default": []
				}
			},
			"required": ["package_id"]
		},
		"NodePermission": {
			"description": "Permissions a WASM node can request.\nEach node declares exactly which capabilities it needs so the sandbox\nand UI can enforce/display them precisely.",
			"oneOf": [
				{
					"description": "Outbound HTTP requests",
					"type": "string",
					"const": "network:http"
				},
				{
					"description": "WebSocket connections",
					"type": "string",
					"const": "network:websocket"
				},
				{
					"description": "TCP socket access",
					"type": "string",
					"const": "network:tcp"
				},
				{
					"description": "UDP socket access",
					"type": "string",
					"const": "network:udp"
				},
				{
					"description": "DNS lookups",
					"type": "string",
					"const": "network:dns"
				},
				{
					"description": "Read from node/user storage",
					"type": "string",
					"const": "storage:read"
				},
				{
					"description": "Write to node/user storage",
					"type": "string",
					"const": "storage:write"
				},
				{
					"description": "Access flow variables",
					"type": "string",
					"const": "variables"
				},
				{
					"description": "Access execution cache",
					"type": "string",
					"const": "cache"
				},
				{
					"description": "Stream responses to the client",
					"type": "string",
					"const": "streaming"
				},
				{
					"description": "Access LLM / model providers",
					"type": "string",
					"const": "models"
				},
				{
					"description": "Dynamic UI (Agent-to-UI)",
					"type": "string",
					"const": "a2ui"
				},
				{
					"description": "OAuth authentication",
					"type": "string",
					"const": "oauth"
				},
				{
					"description": "Call other functions/sub-flows",
					"type": "string",
					"const": "functions"
				}
			]
		}
	}
}
