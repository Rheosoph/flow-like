{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "board_id": {
      "type": "string"
    },
    "board_version": {
      "type": [
        "array",
        "null"
      ],
      "prefixItems": [
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "node_id": {
      "type": "string"
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Variable"
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0,
        "maximum": 255
      }
    },
    "active": {
      "type": "boolean"
    },
    "canary": {
      "anyOf": [
        {
          "$ref": "#/$defs/CanaryEvent"
        },
        {
          "type": "null"
        }
      ]
    },
    "priority": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "event_type": {
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseNotes"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_version": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "created_at": {
      "$ref": "#/$defs/SystemTime"
    },
    "updated_at": {
      "$ref": "#/$defs/SystemTime"
    },
    "default_page_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "description": "Input pins copied from the node (populated at upsert time)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/EventInput"
      },
      "default": []
    },
    "route": {
      "description": "URL route path that maps to this event (e.g., \"/\", \"/dashboard\")",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "is_default": {
      "description": "Whether this is the default event/route for the app (shown at \"/\")",
      "type": "boolean",
      "default": false
    },
    "execution_mode": {
      "description": "Where this event runs (Local/offline vs Remote/server). Inherited from\nthe board's `execution_mode` when that mode is not Hybrid.",
      "$ref": "#/$defs/EventExecutionMode",
      "default": "Local"
    },
    "exposure": {
      "description": "Whether the event is publicly reachable or only callable by connected\napps via the app-connection proxy. Only meaningful for REST/MCP events.",
      "$ref": "#/$defs/EventExposure",
      "default": "PUBLIC"
    },
    "correlation_mappings": {
      "description": "Process-mining case-key mappings: business key name → dot-path into\nthe invocation payload (e.g. `order_id` → `order.id`). Extracted on\nevery run so cases group by business object automatically.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "board_id",
    "node_id",
    "variables",
    "config",
    "active",
    "priority",
    "event_type",
    "event_version",
    "created_at",
    "updated_at"
  ],
  "$defs": {
    "Variable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_value": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0,
            "maximum": 255
          }
        },
        "data_type": {
          "$ref": "#/$defs/VariableType"
        },
        "value_type": {
          "$ref": "#/$defs/ValueType"
        },
        "exposed": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "editable": {
          "type": "boolean"
        },
        "hash": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_configured": {
          "description": "If true, this variable is configured per-user at runtime (stored locally, not in flow)",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "id",
        "name",
        "data_type",
        "value_type",
        "exposed",
        "secret",
        "editable"
      ]
    },
    "VariableType": {
      "type": "string",
      "enum": [
        "Execution",
        "String",
        "Integer",
        "Float",
        "Boolean",
        "Date",
        "PathBuf",
        "Generic",
        "Struct",
        "Byte"
      ]
    },
    "ValueType": {
      "type": "string",
      "enum": [
        "Array",
        "Normal",
        "HashMap",
        "HashSet"
      ]
    },
    "CanaryEvent": {
      "type": "object",
      "properties": {
        "weight": {
          "type": "number",
          "format": "float"
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Variable"
          }
        },
        "board_id": {
          "type": "string"
        },
        "board_version": {
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "node_id": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/SystemTime"
        },
        "updated_at": {
          "$ref": "#/$defs/SystemTime"
        }
      },
      "required": [
        "weight",
        "variables",
        "board_id",
        "node_id",
        "created_at",
        "updated_at"
      ]
    },
    "SystemTime": {
      "type": "object",
      "properties": {
        "secs_since_epoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "nanos_since_epoch": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "secs_since_epoch",
        "nanos_since_epoch"
      ]
    },
    "ReleaseNotes": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "NOTES": {
              "type": "string"
            }
          },
          "required": [
            "NOTES"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "URL": {
              "type": "string"
            }
          },
          "required": [
            "URL"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EventInput": {
      "description": "Simplified input pin metadata for events (used when board can't be fetched)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "friendly_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "data_type": {
          "type": "string"
        },
        "value_type": {
          "type": "string"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_value": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0,
            "maximum": 255
          }
        },
        "index": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "id",
        "name",
        "friendly_name",
        "description",
        "data_type",
        "value_type",
        "index"
      ]
    },
    "EventExecutionMode": {
      "description": "Where a single event runs. Unlike `Board::ExecutionMode`, events are never\nHybrid — an event is always bound to exactly one environment so its\nconfiguration (URLs, credentials, tutorials) can be unambiguous.",
      "oneOf": [
        {
          "description": "Runs on the user's device (desktop app / synced into local sqlite).",
          "type": "string",
          "const": "Local"
        },
        {
          "description": "Runs on the server (cloud endpoint, cron worker, sink service).",
          "type": "string",
          "const": "Remote"
        }
      ]
    },
    "EventExposure": {
      "description": "Where an event is reachable from. `Public` events with a REST/MCP surface\nare served on the public inbound routers with their configured auth.\n`Internal` events are only callable by connected apps through the\napp-connection proxy (gated by the connection role) and are never exposed\npublicly — so a public secret can never be bypassed via the proxy.",
      "oneOf": [
        {
          "description": "Public HTTP surface (REST/MCP), protected by the event's own auth.",
          "type": "string",
          "const": "PUBLIC"
        },
        {
          "description": "Reachable only via app connections, never publicly.",
          "type": "string",
          "const": "INTERNAL"
        }
      ]
    }
  }
}