{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AppStatus"
    },
    "visibility": {
      "$ref": "#/$defs/AppVisibility"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changelog": {
      "type": [
        "string",
        "null"
      ]
    },
    "primary_category": {
      "anyOf": [
        {
          "$ref": "#/$defs/AppCategory"
        },
        {
          "type": "null"
        }
      ]
    },
    "secondary_category": {
      "anyOf": [
        {
          "$ref": "#/$defs/AppCategory"
        },
        {
          "type": "null"
        }
      ]
    },
    "app_type": {
      "description": "Owner-declared app type. `None` means unclassified.",
      "anyOf": [
        {
          "$ref": "#/$defs/AppType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rating_sum": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "rating_count": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "download_count": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "interactions_count": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "avg_rating": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "relevance_score": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "execution_mode": {
      "$ref": "#/$defs/AppExecutionMode"
    },
    "updated_at": {
      "$ref": "#/$defs/SystemTime"
    },
    "created_at": {
      "$ref": "#/$defs/SystemTime"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "frontend": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrontendConfiguration"
        },
        {
          "type": "null"
        }
      ]
    },
    "price": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "widget_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "page_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "packages": {
      "description": "WASM packages required by this app: package_id -> version",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "allow_forking": {
      "description": "Project-level opt-in for the Fork-an-app feature. Apps default to\n`false`; the owner must explicitly allow forking before any other\npermission check applies.",
      "type": "boolean",
      "default": false
    },
    "forked_from": {
      "description": "For forked apps: the source app's id (for lineage / attribution).",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "forked_at": {
      "description": "For forked apps: when the fork was created.",
      "anyOf": [
        {
          "$ref": "#/$defs/SystemTime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "bot_id": {
      "description": "Set on a bot's workspace: the id of the bot it belongs to. App lists hide such apps.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "status",
    "visibility",
    "authors",
    "bits",
    "boards",
    "events",
    "templates",
    "rating_sum",
    "rating_count",
    "download_count",
    "interactions_count",
    "execution_mode",
    "updated_at",
    "created_at"
  ],
  "$defs": {
    "AppStatus": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive",
        "Archived"
      ]
    },
    "AppVisibility": {
      "type": "string",
      "enum": [
        "Public",
        "PublicRequestAccess",
        "Private",
        "Prototype",
        "Offline"
      ]
    },
    "AppCategory": {
      "type": "string",
      "enum": [
        "Other",
        "Productivity",
        "Social",
        "Entertainment",
        "Education",
        "Health",
        "Finance",
        "Lifestyle",
        "Travel",
        "News",
        "Sports",
        "Shopping",
        "FoodAndDrink",
        "Music",
        "Photography",
        "Utilities",
        "Weather",
        "Games",
        "Business",
        "Communication",
        "Anime"
      ]
    },
    "AppType": {
      "description": "What kind of thing the app is, structurally — an agent, a pipeline, a form.\nOrthogonal to [`AppCategory`], which says what the app is *about*. Left\nunset until the owner classifies it; the UI derives a suggestion from the\napp's contents in the meantime.",
      "type": "string",
      "enum": [
        "Agent",
        "CustomInterface",
        "DataFocus",
        "DataPipeline",
        "Analytics",
        "Form"
      ]
    },
    "AppExecutionMode": {
      "type": "string",
      "enum": [
        "Any",
        "Local",
        "Remote"
      ]
    },
    "SystemTime": {
      "type": "object",
      "properties": {
        "secs_since_epoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "nanos_since_epoch": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "secs_since_epoch",
        "nanos_since_epoch"
      ]
    },
    "FrontendConfiguration": {
      "type": "object",
      "properties": {
        "landing_page": {
          "type": [
            "string",
            "null"
          ]
        },
        "custom_css": {
          "description": "App-wide stylesheet. Injected once above every page surface and scoped\nto the app root, so page-level CSS stays later in document order and\nkeeps winning ties.",
          "type": [
            "string",
            "null"
          ]
        },
        "legal_notice_url": {
          "description": "The app publisher's legal notice (imprint), linked from hosted pages.",
          "type": [
            "string",
            "null"
          ]
        },
        "privacy_policy_url": {
          "description": "The app publisher's privacy policy, linked from hosted pages.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}