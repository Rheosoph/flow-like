{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "EmbeddingModelProvider",
	"type": "object",
	"required": [
		"input_length",
		"languages",
		"pooling",
		"prefix",
		"provider",
		"vector_length"
	],
	"properties": {
		"languages": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"vector_length": {
			"type": "integer",
			"format": "uint32",
			"minimum": 0.0
		},
		"input_length": {
			"type": "integer",
			"format": "uint32",
			"minimum": 0.0
		},
		"prefix": {
			"$ref": "#/definitions/Prefix"
		},
		"pooling": {
			"$ref": "#/definitions/Pooling"
		},
		"provider": {
			"$ref": "#/definitions/ModelProvider"
		},
		"remote": {
			"$ref": "#/definitions/RemoteExecutionConfig"
		}
	},
	"definitions": {
		"Prefix": {
			"type": "object",
			"required": ["paragraph", "query"],
			"properties": {
				"query": {
					"type": "string"
				},
				"paragraph": {
					"type": "string"
				}
			}
		},
		"Pooling": {
			"type": "string",
			"enum": ["CLS", "Mean", "None"]
		},
		"ModelProvider": {
			"type": "object",
			"required": ["provider_name"],
			"properties": {
				"provider_name": {
					"type": "string"
				},
				"model_id": {
					"type": ["string", "null"]
				},
				"version": {
					"type": ["string", "null"]
				},
				"params": {
					"type": ["object", "null"],
					"additionalProperties": true
				}
			}
		},
		"RemoteExecutionConfig": {
			"type": "object",
			"properties": {
				"endpoint": {
					"type": ["string", "null"],
					"description": "Deprecated per-bit endpoint URL. Remote embeddings use the shared INTERNAL_EMBEDDING_ENDPOINT secret resolved by the API."
				},
				"secret_name": {
					"type": ["string", "null"],
					"description": "Optional API key secret override. Defaults to INTERNAL_EMBEDDING_SECRET."
				},
				"implementation": {
					"$ref": "#/definitions/RemoteEmbeddingProvider"
				},
				"model_id": {
					"type": ["string", "null"],
					"description": "Deployed model ID for the shared internal gateway"
				}
			}
		},
		"RemoteEmbeddingProvider": {
			"type": "string",
			"enum": ["Internal"]
		}
	}
}
