{
	"name": "@flow-like/widget-bundler",
	"version": "0.1.1",
	"type": "module",
	"description": "Flow-Like widget bundler: extracts typed contracts from TS widgets and packs framework builds into .flwb bundles.",
	"license": "MIT",
	"files": ["src"],
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"flow-like-widgets": "./src/cli.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./vite": "./src/vite.ts"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@flow-like/widget-sdk": "workspace:*",
		"fflate": "0.8.3",
		"smol-toml": "1.8.0",
		"ts-json-schema-generator": "^2.4.0",
		"typescript": "^5.7.3"
	},
	"devDependencies": {
		"vite": "^7.3.6"
	},
	"peerDependencies": {
		"vite": ">=5"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
