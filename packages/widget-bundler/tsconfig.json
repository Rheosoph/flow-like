{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true,
		"noEmit": true,
		"types": ["bun-types", "node"]
	},
	"include": ["src", "tests"],
	"exclude": ["tests/fixtures"]
}
