  <div class="[&amp;_h1:first-of-type]:mt-0 [&amp;_h2:first-of-type]:mt-0 [&amp;_h3:first-of-type]:mt-0 [&amp;_h4:first-of-type]:mt-0 [&amp;_h5:first-of-type]:mt-0 [&amp;_h6:first-of-type]:mt-0 py-0 slate-editor" data-slate-editor="true" data-slate-node="value">
    <div class="my-1 slate-equation" data-slate-node="element" data-slate-tex-expression="\\href{javascript:window.__xss=18}{x}" data-slate-type="equation" data-slate-void="true" style="position: relative;">
      <div class="data-[selected=true]:bg-primary/10 flex group hover:bg-primary/10 items-center justify-center px-2 py-1 rounded-sm select-none">
        <span>
          <span class="katex">
            <span class="katex-mathml">
              <math display="block" xmlns="http://www.w3.org/1998/Math/MathML">
                <semantics>
                  <mrow>
                    <mstyle mathcolor="#cc0000">
                      <mtext>"\\\\href"</mtext>
                    </mstyle>
                  </mrow>
                  <annotation encoding="application/x-tex">"\\\\href{javascript:window.__xss=18}{x}"</annotation>
                </semantics>
              </math>
            </span>
            <span aria-hidden="true" class="katex-html">
              <span class="base">
                <span class="strut" style="height:1em;vertical-align:-0.25em;"></span>
                <span class="mord text" style="color:#cc0000;">
                  <span class="mord" style="color:#cc0000;">"\\\\href"</span>
                </span>
              </span>
            </span>
          </span>
        </span>
      </div>
      <span data-slate-spacer="true" style="color: transparent; height: 0px; position: absolute; outline-color: none; outline-style: none; outline-width: initial;">
        <span data-slate-node="text">
          <span data-slate-leaf="true">
            <span data-slate-string="true">"\\ufeff"</span>
          </span>
        </span>
      </span>
    </div>
    <div class="slate-p" data-slate-node="element" data-slate-type="p" style="position: relative;">
      <div class="[&amp;_.katex-display]:my-0 inline-block rounded-sm select-none slate-inline_equation" data-slate-inline="true" data-slate-node="element" data-slate-tex-expression="\\url{javascript:window.__xss=22} \\htmlId{x}{y}" data-slate-type="inline_equation" data-slate-void="true" style="position: relative;">
        <div class="after:-left-1 after:-top-0.5 after:absolute after:content-[&quot;&quot;] after:h-[calc(100%)+4px] after:inset-0 after:rounded-sm after:w-[calc(100%+8px)] after:z-1 h-6">
          <span class="font-mono leading-none">
            <span class="katex">
              <span class="katex-mathml">
                <math display="block" xmlns="http://www.w3.org/1998/Math/MathML">
                  <semantics>
                    <mrow>
                      <mstyle mathcolor="#cc0000">
                        <mtext>"\\\\url"</mtext>
                      </mstyle>
                      <mstyle mathcolor="#cc0000">
                        <mtext>"\\\\htmlId"</mtext>
                      </mstyle>
                    </mrow>
                    <annotation encoding="application/x-tex">"\\\\url{javascript:window.__xss=22} \\\\htmlId{x}{y}"</annotation>
                  </semantics>
                </math>
              </span>
              <span aria-hidden="true" class="katex-html">
                <span class="base">
                  <span class="strut" style="height:1em;vertical-align:-0.25em;"></span>
                  <span class="mord text" style="color:#cc0000;">
                    <span class="mord" style="color:#cc0000;">"\\\\url"</span>
                  </span>
                  <span class="mord text" style="color:#cc0000;">
                    <span class="mord" style="color:#cc0000;">"\\\\htmlId"</span>
                  </span>
                </span>
              </span>
            </span>
          </span>
        </div>
        <span data-slate-spacer="true" style="color: transparent; height: 0px; position: absolute; outline-color: none; outline-style: none; outline-width: initial;">
          <span data-slate-node="text">
            <span data-slate-leaf="true">
              <span data-slate-string="true">"\\ufeff"</span>
            </span>
          </span>
        </span>
      </div>
    </div>
  </div>
</div>"
`;

