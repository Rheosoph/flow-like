exports[`markdown fixtures M06-code-blocks serializes back to markdown 1`] = `
{
  "markdown":
"\`\`\`ts
export const answer: number = 42;
function greet(name: string) { return \`hi \${name}\`; }
\`\`\`

\`\`\`python
def fib(n):
    return n if n < 2 else fib(n - 1) + fib(n - 2)
\`\`\`

\`\`\`rust
fn main() { println!("{}", 1 + 1); }
\`\`\`

\`\`\`json
{ "a": [1, 2, { "b": null }] }
\`\`\`

\`\`\`bash
echo "$HOME" | grep -v x
\`\`\`

\`\`\`sql
SELECT id, name FROM users WHERE id = 1;
\`\`\`

\`\`\`not-a-language
plain content
\`\`\`

\`\`\`
no language
	with a tab
\`\`\`

\`\`\`yaml
key: value
\`\`\`
"
,
  "reparsesToSameValue": true,
}
`;

