/// A team of bots and the people who work with them. Teams nest: the teams under one top-level
/// team form an org, and every active member of any of its teams sees the whole org.
model BotTeam {
  id             String          @id
  name           String
  /// What every bot in the team reads about its work.
  purpose        String?
  parentId       String?
  parent         BotTeam?        @relation("BotTeamTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       BotTeam[]       @relation("BotTeamTree")
  /// One of the team's active bots; null while the team has no lead.
  leadBotId      String?
  lead           Bot?            @relation("BotTeamLead", fields: [leadBotId], references: [id], onDelete: SetNull)
  /// Another owner's bot an admin asked to lead the team; it leads once its owner accepts.
  leadOfferBotId String?
  leadOffer      Bot?            @relation("BotTeamLeadOffer", fields: [leadOfferBotId], references: [id], onDelete: SetNull)
  leadOfferBy    String?
  leadOfferAt    DateTime?       @db.Timestamptz(3)
  /// Teammates ask each other without the first-time Allow card once their owners agreed.
  directAsks     Boolean         @default(false)
  /// The team room: a group conversation of the team's active people and bots.
  conversationId String?         @unique
  conversation   Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// The person who created the team.
  createdBy      String
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @db.Timestamptz(3)
  people         BotTeamPerson[]
  bots           BotTeamBot[]
  apps           BotTeamApp[]
  threads        BotTeamThread[]
  /// People's classifications in the org this team is the top-level team of.
  classifications BotOrgClassification[]

  @@index([parentId])
}

/// A person in a team. ADMIN manages the team, MEMBER works with its bots. PENDING until they accept.
model BotTeamPerson {
  teamId     String
  team       BotTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ADMIN | MEMBER
  role       String    @default("MEMBER")
  /// PENDING | ACTIVE
  status     String    @default("PENDING")
  invitedBy  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)

  @@id([teamId, userId])
  @@index([userId])
}

/// A bot in a team. An owner's own bot joins at once; another person's bot is PENDING until its
/// owner accepts. A bot is active in at most one team.
model BotTeamBot {
  teamId       String
  team         BotTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  botId        String
  bot          Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  /// PENDING | ACTIVE
  status       String    @default("PENDING")
  /// The bot's owner agreed to direct asks in this team.
  directAgreed Boolean   @default(false)
  /// The BotRoomLimits its owner set for the team and its room; null adds none.
  limits       Json?
  invitedBy    String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  acceptedAt   DateTime? @db.Timestamptz(3)

  @@id([teamId, botId])
  @@index([botId])
}

/// An app pinned to a team, shown in its org chart. Whoever pins it owns or administers the app.
/// A team admin's pin is ACTIVE at once; a member's pin is PENDING until a team admin approves it.
model BotTeamApp {
  teamId     String
  team       BotTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  appId      String
  app        App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// PENDING | ACTIVE
  status     String    @default("PENDING")
  /// The person who pinned the app, by value: their pins go when they leave the org.
  pinnedBy   String
  /// The team admin who approved a member's pin.
  approvedBy String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  approvedAt DateTime? @db.Timestamptz(3)

  @@id([teamId, appId])
  @@index([appId])
}

/// A person's thread with a team: their `#Team` requests land here and the team's lead answers.
/// Its members are the person, the current lead and the lead's owner.
model BotTeamThread {
  teamId         String
  team           BotTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@id([teamId, userId])
  @@index([userId])
}

/// A person's chat with another owner's bot of an org they share. The person asks, the bot's
/// owner decides; the chat's members are the person, the bot and the owner, who watches it.
model BotTeamChat {
  botId          String
  bot            Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The bot's owner when the person asked: who decides and watches.
  ownerId        String
  /// PENDING | ACTIVE | DECLINED | ENDED
  status         String        @default("PENDING")
  /// Created on approval; the person keeps it with its history after the chat ends.
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// The BotRoomLimits the owner set on approval; null adds none.
  limits         Json?
  /// Why the person asks.
  note           String?
  requestedAt    DateTime      @default(now()) @db.Timestamptz(3)
  decidedAt      DateTime?     @db.Timestamptz(3)
  endedAt        DateTime?     @db.Timestamptz(3)

  @@id([botId, userId])
  @@index([userId])
  @@index([ownerId, status])
}

/// A person's classification in an org, set by an admin of its top-level team. A person without a
/// row counts as internal.
model BotOrgClassification {
  /// The org's top-level team.
  orgId          String
  org            BotTeam  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DataClassification, lowercase.
  classification String
  setBy          String
  updatedAt      DateTime @default(now()) @db.Timestamptz(3)

  @@id([orgId, userId])
  @@index([userId])
}
