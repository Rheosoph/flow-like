model PaymentRequest {
  id String @id
  runId String
  nodeId String
  nonce String
  requestDigest String
  appId String
  boardId String?
  eventId String?
  payerUserId String
  payeeUserId String
  connectedAccountId String?
  platformAccountId String
  livemode Boolean
  amount BigInt
  currency String
  applicationFeeAmount BigInt
  feeBps Int
  productName String
  description String
  reference String?
  snapshot Json
  status String @default("CREATED")
  reason String?
  cancelRequested Boolean @default(false)
  acceptedAttemptId String?
  runRevision BigInt?
  settingsRevision BigInt?
  bindingRevision BigInt?
  expiresAt BigInt
  nextCheckAt BigInt
  revision BigInt @default(0)
  createdAt BigInt
  updatedAt BigInt
  @@unique([runId, nodeId, nonce], map: "PaymentRequest_runId_nodeId_nonce_key")
  @@index([runId, status], map: "PaymentRequest_runId_status_idx")
  @@index([appId, createdAt], map: "PaymentRequest_appId_createdAt_idx")
  @@index([payerUserId, appId, reference], map: "PaymentRequest_payerUserId_appId_reference_idx")
  @@index([payeeUserId, createdAt], map: "PaymentRequest_payeeUserId_createdAt_idx")
  @@index([status, nextCheckAt], map: "PaymentRequest_status_nextCheckAt_idx")
  @@index([status, expiresAt], map: "PaymentRequest_status_expiresAt_idx")
}

