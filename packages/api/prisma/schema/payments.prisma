/// Financial references intentionally have no foreign keys to deletable product or user rows.
model PaymentAccountBinding {
  id String @id
  userId String
  livemode Boolean
  purpose String
  activeAccountId String?
  candidateAccountId String?
  generation BigInt @default(0)
  revision BigInt @default(0)
  createdAt BigInt
  updatedAt BigInt
  @@unique([userId, livemode, purpose], map: "PaymentAccountBinding_userId_livemode_purpose_key")
  @@index([activeAccountId], map: "PaymentAccountBinding_activeAccountId_idx")
  @@index([candidateAccountId], map: "PaymentAccountBinding_candidateAccountId_idx")
}

model ConnectedAccount {
  id String @id
  userId String
  platformAccountId String
  livemode Boolean
  purpose String
  generation BigInt
  stripeAccountId String?
  creationParams Json
  state String @default("creating")
  country String
  defaultCurrency String?
  business Json?
  requirements Json?
  capabilities Json?
  chargesEnabled Boolean @default(false)
  payoutsEnabled Boolean @default(false)
  canAcceptPayments Boolean @default(false)
  canSell Boolean @default(false)
  disabledReason String?
  retiredAt BigInt?
  retiredReason String?
  consentId String?
  resumeNonceHash String?
  resumeExpiresAt BigInt?
  resumeUsedAt BigInt?
  syncedAt BigInt?
  syncRevision BigInt @default(0)
  syncLeaseUntil BigInt?
  syncNextAt BigInt @default(0)
  syncAttempts Int @default(0)
  revision BigInt @default(0)
  createdAt BigInt
  updatedAt BigInt
  @@unique([platformAccountId, livemode, stripeAccountId], map: "ConnectedAccount_platformAccountId_livemode_stripeAccountId_key")
  @@unique([userId, livemode, purpose, generation], map: "ConnectedAccount_userId_livemode_purpose_generation_key")
  @@index([userId, livemode, retiredAt], map: "ConnectedAccount_userId_livemode_retiredAt_idx")
  @@index([state, syncedAt], map: "ConnectedAccount_state_syncedAt_idx")
}

