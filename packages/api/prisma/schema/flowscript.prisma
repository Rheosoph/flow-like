/// A FlowScript apply that failed, was blocked, or applied with warnings, captured with the
/// source that produced it so the team can see what users expected the editor to do.
///
/// This is NOT anonymous telemetry and deliberately does not live in `telemetry.prisma`: the row
/// names the reporting user, because one person's repeated attempts at the same edit are the
/// signal. That identity is exactly why the source is redacted before it is ever written —
/// declared variable values dropped, long literals generalized, see
/// `flow_like_ast::redact_flowscript` — and why only `GlobalPermission::Admin` can read it back.
model FlowScriptApplyFailure {
  id String @id

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  /// App and board the edit targeted. Deliberately plain columns, not foreign keys: a desktop-only
  /// app has no row on the hub at all, and those failures are the ones nothing else can see.
  appId   String
  boardId String
  layerId String?

  /// Where the apply ran: "desktop" (local Tauri apply) or "web" (the apply endpoint).
  source  String
  /// Who authored the source: "editor" (a person in the FlowScript panel) or "agent" (FlowPilot).
  /// Both go through the same board pipeline, so without this the panel could not tell them apart.
  origin  String
  /// "error" — the apply threw; "blocked" — no commands, diagnostics only; "partial" — commands
  /// were applied alongside diagnostics.
  outcome String

  /// The one line that explains this row: the error for a thrown apply, the first diagnostic
  /// otherwise. A plain column so "what breaks most" is a group-by instead of a table scan.
  cause          String
  errorMessage   String?
  diagnostics    Json?
  corrections    Json?
  commandCount   Int     @default(0)
  allowDeletions Boolean @default(false)

  /// The redacted FlowScript the user submitted. Line numbers match the source, so a diagnostic's
  /// line:col still points at the right line.
  flowscript       String
  flowscriptChars  Int     @default(0)
  droppedValues    Int     @default(0)
  redactedLiterals Int     @default(0)
  truncated        Boolean @default(false)

  appVersion String?
  platform   String?
  /// Trace the apply request belonged to, when it carried one, so a row opens in the trace explorer.
  traceId    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([outcome, createdAt])
  @@index([userId, createdAt])
  @@index([appId, createdAt])
  @@index([cause, createdAt])
  @@index([origin, createdAt])
}
