// WASM Package Registry - stores custom node packages
// Packages are private by default. Going public requires admin approval.

enum WasmPackageStatus {
  PENDING_REVIEW // Awaiting admin approval
  ACTIVE // Approved and usable
  REJECTED // Rejected by admin
  DEPRECATED // Still usable but shows warning
  DISABLED // Not usable
}

enum WasmPackageVisibility {
  PRIVATE // Only WasmPackageUsers can discover and download
  PUBLIC // Everyone can discover and download
  PUBLIC_REQUEST_ACCESS // Visible to all, but requires access request or purchase
}

enum WasmCompilationStatus {
  COMPILED // Server-side .cwasm available in meta bucket
  LOCAL_ONLY // Compilation failed — only usable locally
  PENDING // Compilation in progress or queued
}

model WasmPackage {
  id String @id

  name        String
  description String
  version     String
  users       WasmPackageUser[]
  license     String?
  homepage    String?
  repository  String?
  keywords    String[]

  status     WasmPackageStatus     @default(PENDING_REVIEW)
  visibility WasmPackageVisibility @default(PRIVATE)
  verified   Boolean               @default(false)

  downloadCount BigInt @default(0)

  wasmPath String
  wasmHash String
  wasmSize BigInt

  nodes       Json
  permissions Json

  readme String?

  /// Price in cents (0 = free)
  price BigInt @default(0)

  metadata Meta[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  versions    WasmPackageVersion[]
  reviews     WasmPackageReview[]
  invitations WasmPackageInvitation[]
  joinQueue   WasmPackageJoinQueue[]
  purchases   WasmPackagePurchase[]
  authors     WasmPackageAuthor[]

  @@unique([id, version])
  @@index([name])
  @@index([status])
  @@index([visibility])
  @@index([verified])
  @@index([downloadCount])
  @@index([createdAt])
  @@index([keywords])
  @@index([price])
}

model WasmPackageVersion {
  id String @id @default(cuid())

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  version  String
  wasmPath String
  wasmHash String
  wasmSize BigInt

  nodes Json @default("[]")

  releaseNotes       String?
  minFlowLikeVersion String?
  yanked             Boolean           @default(false)
  status             WasmPackageStatus @default(PENDING_REVIEW)

  compilationStatus WasmCompilationStatus @default(PENDING)
  compiledPlatforms String[]              @default([])
  compilationError  String?

  duplicateOfPackageId String?
  duplicateOfVersion   String?
  duplicateFlagged     Boolean @default(false)

  publishedAt DateTime  @default(now())
  approvedAt  DateTime?

  @@unique([packageId, version])
  @@index([packageId])
  @@index([version])
  @@index([publishedAt])
  @@index([status])
  @@index([compilationStatus])
  @@index([wasmHash])
  @@index([duplicateFlagged])
}

model WasmPackageReview {
  id String @id @default(cuid())

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  reviewer     User             @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId   String
  action       WasmReviewAction
  comment      String?
  internalNote String?

  securityScore      Int?
  codeQualityScore   Int?
  documentationScore Int?

  createdAt DateTime @default(now())

  @@index([packageId])
  @@index([reviewerId])
  @@index([action])
  @@index([createdAt])
}

enum WasmReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
  REQUESTED_CHANGES
  COMMENTED
  FLAGGED
}

model WasmPackageUser {
  id String @id @default(cuid())

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  permission BigInt // Bitflag: Owner=1, Maintainer=2, User=4

  grantedBy String?
  grantedAt DateTime @default(now())

  @@unique([packageId, userId])
  @@index([packageId])
  @@index([userId])
  @@index([permission])
}

model WasmPackageInvitation {
  id String @id @default(cuid())

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  invitedBy   User   @relation("WasmInviter", fields: [invitedById], references: [id])
  invitedById String

  invitee   User   @relation("WasmInvitee", fields: [inviteeId], references: [id])
  inviteeId String

  permission BigInt // Permission level being offered

  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  expiresAt DateTime?

  @@unique([packageId, inviteeId])
  @@index([packageId])
  @@index([inviteeId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Authors / contributors of a WASM package
model WasmPackageAuthor {
  id String @id @default(cuid())

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  role    String?
  addedAt DateTime @default(now())

  @@unique([packageId, userId])
  @@index([packageId])
  @@index([userId])
}

/// Join queue for packages with PublicRequestAccess visibility
model WasmPackageJoinQueue {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, packageId])
  @@index([userId, packageId])
  @@index([packageId, createdAt])
}

/// Tracks individual WASM package purchases
model WasmPackagePurchase {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  /// Price paid in cents at time of purchase
  pricePaid     BigInt
  /// Original price before discount (in cents)
  originalPrice BigInt
  /// Discount amount in cents (0 if none)
  discountAmount BigInt @default(0)

  /// Currency code (e.g., "EUR", "USD")
  currency String @default("EUR")

  /// Stripe checkout session ID for this purchase
  stripeSessionId       String
  /// Stripe payment intent ID
  stripePaymentIntentId String?

  status PurchaseStatus @default(PENDING)

  /// When purchase was completed
  completedAt  DateTime?
  /// When refunded (if applicable)
  refundedAt   DateTime?
  /// Refund reason if refunded
  refundReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([packageId])
  @@index([packageId, status])
  @@index([packageId, completedAt])
  @@index([stripeSessionId])
}
