// WASM Package Registry - stores custom node packages
// Packages are private by default. Going public requires admin approval.

model WasmPackage {
  id String @id

  name        String
  description String
  version     String
  users       WasmPackageUser[]
  license     String?
  homepage    String?
  repository  String?
  keywords    Json?

  primaryCategory   String?
  secondaryCategory String?

  status     String  @default("PENDING_REVIEW")
  visibility String  @default("PRIVATE")
  verified   Boolean @default(false)

  downloadCount BigInt @default(0)

  wasmPath String
  wasmHash String
  wasmSize BigInt

  /// Widget bundle (.flwb) sha256 hash — set when the package ships widgets
  widgetBundleHash String?
  /// Widget bundle size in bytes
  widgetBundleSize BigInt?

  nodes       Json
  /// PackageWidgetEntry[] from the manifest, persisted like nodes
  widgets     Json @default("[]")
  permissions Json

  readme String?

  /// Price in cents (0 = free)
  price BigInt @default(0)

  metadata Meta[]

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)

  versions    WasmPackageVersion[]
  reviews     WasmPackageReview[]
  invitations WasmPackageInvitation[]
  joinQueue   WasmPackageJoinQueue[]
  purchases   WasmPackagePurchase[]
  authors     WasmPackageAuthor[]
  comments    Comment[]

  ratingSum   BigInt @default(0)
  ratingCount BigInt @default(0)
  avgRating   Float?

  @@unique([id, version])
  @@index([name])
  @@index([status])
  @@index([visibility])
  @@index([verified])
  @@index([downloadCount])
  @@index([createdAt])
  @@index([primaryCategory])
  @@index([secondaryCategory])
  @@index([price])
}

model WasmPackageVersion {
  id String @id @default(cuid())

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  version  String
  wasmPath String
  wasmHash String
  wasmSize BigInt

  /// Widget bundle (.flwb) sha256 hash — set when the version ships widgets
  widgetBundleHash String?
  /// Widget bundle size in bytes
  widgetBundleSize BigInt?

  nodes   Json @default("[]")
  /// PackageWidgetEntry[] from the manifest, persisted like nodes
  widgets Json @default("[]")

  releaseNotes       String?
  minFlowLikeVersion String?
  yanked             Boolean @default(false)
  status             String  @default("PENDING_REVIEW")

  compilationStatus         String  @default("PENDING")
  compiledPlatforms         Json?   @default("[]")
  supportedWasmtimeVersions Json?   @default("[]")
  compilationError          String?

  duplicateOfPackageId String?
  duplicateOfVersion   String?
  duplicateFlagged     Boolean @default(false)

  publishedAt DateTime  @default(now()) @db.Timestamptz(3)
  approvedAt  DateTime? @db.Timestamptz(3)

  @@unique([packageId, version])
  @@index([packageId])
  @@index([version])
  @@index([publishedAt])
  @@index([status])
  @@index([compilationStatus])
  @@index([wasmHash])
  @@index([duplicateFlagged])
}

model WasmPackageReview {
  id String @id @default(cuid())

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  reviewer     User    @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId   String
  action       String
  comment      String?
  internalNote String?

  securityScore      Int?
  codeQualityScore   Int?
  documentationScore Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([packageId])
  @@index([reviewerId])
  @@index([action])
  @@index([createdAt])
}

model WasmPackageUser {
  id String @id @default(cuid())

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  permission BigInt // Bitflag: Owner=1, Maintainer=2, User=4

  grantedBy String?
  grantedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([packageId, userId])
  @@index([packageId])
  @@index([userId])
  @@index([permission])
}

model WasmPackageInvitation {
  id String @id @default(cuid())

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  invitedBy   User   @relation("WasmInviter", fields: [invitedById], references: [id])
  invitedById String

  invitee   User   @relation("WasmInvitee", fields: [inviteeId], references: [id])
  inviteeId String

  permission BigInt // Permission level being offered

  status    String    @default("PENDING")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime? @db.Timestamptz(3)

  @@unique([packageId, inviteeId])
  @@index([packageId])
  @@index([inviteeId])

  @@index([invitedById])
}

/// Authors / contributors of a WASM package
model WasmPackageAuthor {
  id String @id @default(cuid())

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  role    String?
  addedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([packageId, userId])
  @@index([packageId])
  @@index([userId])
}

/// Join queue for packages with PublicRequestAccess visibility
model WasmPackageJoinQueue {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  comment String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, packageId])
  @@index([userId, packageId])
  @@index([packageId, createdAt])
}

/// Tracks individual WASM package purchases
model WasmPackagePurchase {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  package   WasmPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String

  /// Price paid in cents at time of purchase
  pricePaid      BigInt
  /// Original price before discount (in cents)
  originalPrice  BigInt
  /// Discount amount in cents (0 if none)
  discountAmount BigInt @default(0)

  /// Currency code (e.g., "EUR", "USD")
  currency String @default("EUR")

  /// Stripe checkout session ID for this purchase
  stripeSessionId       String
  /// Stripe payment intent ID
  stripePaymentIntentId String?

  status String @default("PENDING")

  /// When purchase was completed
  completedAt  DateTime? @db.Timestamptz(3)
  /// When refunded (if applicable)
  refundedAt   DateTime? @db.Timestamptz(3)
  /// Refund reason if refunded
  refundReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([packageId])
  @@index([packageId, status])
  @@index([packageId, completedAt])
  @@index([stripeSessionId])
}
