// Audit trail: insert-only records, sealed per chain by the audit worker, anchored in
// signed platform-wide epochs, archived monthly to the audit bucket.
// Design: todo/874-audit-retention.md.

/// Legacy hash chain from before the 2026-09 redesign. Nothing writes to it; the audit
/// worker exports it once, raw, to the audit bucket and then deletes its rows. Drop the
/// table in a later migration.
model AuditEntry {
  id       String @id @default(cuid())
  sequence BigInt

  timestamp DateTime @default(now()) @db.Timestamptz(3)

  // Actor
  actorId   String
  actorType String
  actorIp   String?

  // Action
  action       String // e.g. "app.create", "board.update", "registry.publish"
  resourceType String // e.g. "App", "Board", "WasmPackage"
  resourceId   String

  // Chain scope — null = platform root chain, non-null = branch chain
  chainId String? // app_id or package_id — identifies which branch chain this belongs to

  // Payload
  summary String
  details Json?

  // Cryptographic integrity
  entryHash String // "v2:" + blake3 over canonical JSON of every column except entryHash and signature (audit/chain.rs); entries without the prefix use the legacy concatenated hash
  prevHash  String // hash of previous entry in this chain (genesis = "0000...0000")
  signature String? // raw P-256 ECDSA signature (base64 DER) over entryHash
  kid       String? // key identifier used for the signature — enables key rotation auditing

  @@unique([chainId, sequence])
  @@index([chainId, sequence])
  @@index([chainId, timestamp])
  @@index([actorId, timestamp])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([entryHash])
  @@index([timestamp])
}

/// One audited change. Rows without a seal id are pending; the audit worker verifies their
/// MAC and seals them. The row holds no chain fields: the chain lives in AuditSeal.
model AuditRecord {
  id                String   @id
  /// "platform", an app or package id, or "<scope>#activity" for verbose-only actions
  chainId           String
  timestamp         DateTime @db.Timestamptz(3)
  actorId           String
  actorType         String
  action            String
  resourceType      String
  resourceId        String
  /// Salted BLAKE3 commitments to the personal fields; the record hash covers these
  ipCommitment      Bytes?
  detailsCommitment Bytes?
  /// Raw personal values and their salts, set to NULL when they expire
  actorIp           String?
  ipSalt            Bytes?
  details           Json?
  detailsSalt       Bytes?
  /// Keyed BLAKE3 MAC with the API entry key while pending, cleared once sealed
  mac               Bytes?
  /// Seal id, or "invalid" for a pending record whose MAC failed
  sealId            String?

  @@index([chainId, timestamp, id])
  @@index([sealId, chainId, timestamp, id])
}

/// A sealed batch of one chain's records. Seals of a chain link by prevHash.
model AuditSeal {
  id             String   @id
  chainId        String
  seq            BigInt
  /// "evidence" or "activity"
  class          String
  prevHash       Bytes
  recordCount    Int
  /// RFC 6962 Merkle root over the record hashes in (timestamp, id) order
  recordsRoot    Bytes
  firstAt        DateTime @db.Timestamptz(3)
  lastAt         DateTime @db.Timestamptz(3)
  sealedAt       DateTime @db.Timestamptz(3)
  hash           Bytes
  /// Set once an epoch commits to this seal
  epochSeq       BigInt?
  epochIndex     Int?
  /// RFC 6962 inclusion proof of this seal in its epoch
  epochProof     Bytes?
  /// Keyed BLAKE3 of the seal hash with the entry key, protecting the seal until an
  /// epoch anchors it; cleared on anchoring
  mac            Bytes?
  /// Some record still holds a raw value of that kind awaiting expiry
  ipPending      Boolean  @default(false)
  detailsPending Boolean  @default(false)

  @@unique([chainId, seq])
  @@index([epochSeq, epochIndex])
  @@index([class, lastAt])
  @@index([ipPending, lastAt])
  @@index([detailsPending, lastAt])
}

/// Platform-wide timeline: each epoch commits to the seals it covers and is signed
/// with the audit key.
model AuditEpoch {
  seq       BigInt   @id
  prevHash  Bytes
  sealCount Int
  sealsRoot Bytes
  createdAt DateTime @db.Timestamptz(3)
  hash      Bytes
  kid       String
  /// Raw 64-byte P-256 ECDSA signature (r || s) over the epoch hash
  signature Bytes

  @@index([createdAt])
}

/// Last pruned seal of a chain ("~epochs" for the epoch chain), signed so verification
/// can start there.
model AuditWatermark {
  chainId    String   @id
  seq        BigInt
  hash       Bytes
  prunedAt   DateTime @db.Timestamptz(3)
  /// One signature covers every watermark of a prune run: the Merkle root over their
  /// hashes is signed, and each row carries its inclusion proof
  batchRoot  Bytes
  batchSize  Int
  batchIndex Int
  batchProof Bytes
  kid        String
  signature  Bytes
  /// Seals at or below `seq` may still exist and wait for deletion
  pendingDelete Boolean @default(false)

  @@index([prunedAt])
  @@index([pendingDelete])
}

/// Archive objects written to the audit bucket. Part 0 is the signed manifest that
/// completes a period ("YYYY-MM" or "legacy").
model AuditArchive {
  period      String
  part        Int
  objectKey   String
  sha256      Bytes
  byteSize    BigInt
  firstEpoch  BigInt?
  lastEpoch   BigInt?
  epochCount  BigInt
  sealCount   BigInt
  recordCount BigInt
  createdAt   DateTime @db.Timestamptz(3)
  kid         String?
  signature   Bytes?
  /// Part 0 only: the manifest without its signature, so the signed manifest can be
  /// verified and re-uploaded without reading the bucket or signing again
  manifest    Json?
  /// When the object was confirmed written; a part 0 row without it still waits for
  /// its upload
  uploadedAt  DateTime? @db.Timestamptz(3)

  @@id([period, part])
}

/// A chain with a seal that failed its hash or MAC before an epoch signed it. Its seals
/// are never signed, archived or pruned until an operator resolves the incident.
model AuditHeldChain {
  chainId String   @id
  seq     BigInt
  sealId  String
  heldAt  DateTime @db.Timestamptz(3)
  reason  String
}

/// Per-app webhook that receives the app's sealed audit records.
model AuditExportTarget {
  appId           String    @id
  url             String
  /// Signing secret, encrypted with the platform encryption key
  secret          String
  active          Boolean   @default(true)
  evidenceCursor  BigInt    @default(0)
  activityCursor  BigInt    @default(0)
  failures        Int       @default(0)
  nextAttemptAt   DateTime? @db.Timestamptz(3)
  lastDeliveredAt DateTime? @db.Timestamptz(3)
  lastError       String?
  createdAt       DateTime  @db.Timestamptz(3)
  updatedAt       DateTime  @db.Timestamptz(3)
}

/// Worker coordination is separate from API mutation locks. Only the worker role can write it.
model AuditWorkerLease {
  id        BigInt    @id
  owner     String?
  expiresAt DateTime? @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @db.Timestamptz(3)
}
