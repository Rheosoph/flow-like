model DeviceArchive {
  deviceId String
  archiveId String
  ownerId String
  scope String
  kind String
  sequence BigInt
  digest String
  // Legacy archives retain their inline bundle until they expire.
  bundle String?
  payloadRef String?
  manifestJws String?
  rosterJws String?
  sizeBytes BigInt
  createdAt BigInt
  expiresAt BigInt
  @@id([deviceId, archiveId])
  @@unique([deviceId, scope, kind, sequence])
  // Serves owner sums, per-device usage and expired-row batches without row reads.
  // DSQL stores sizeBytes and createdAt with INCLUDE; Prisma lists them as keys for db push.
  @@index([ownerId, expiresAt, deviceId, archiveId, sizeBytes, createdAt], map: "DeviceArchive_ownerUsage_idx")
  @@index([expiresAt])
}

/// Bytes of an owner's stored archives, expired or not. Every insert and delete of
/// DeviceArchive rows changes it in the same transaction, under the owner's User row
/// fence. A missing row is initialized from the owner's archives on first use.
model DeviceArchiveUsage {
  ownerId   String @id
  usedBytes BigInt
}

model DeviceArchiveHead {
  deviceId String
  scope String
  kind String
  sequence BigInt
  digest String
  @@id([deviceId, scope, kind])
}
