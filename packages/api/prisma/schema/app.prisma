enum Category {
  OTHER
  PRODUCTIVITY
  SOCIAL
  ENTERTAINMENT
  EDUCATION
  HEALTH
  FINANCE
  LIFESTYLE
  TRAVEL
  NEWS
  SPORTS
  SHOPPING
  FOOD_AND_DRINK
  MUSIC
  PHOTOGRAPHY
  UTILITIES
  WEATHER
  GAMES
  BUSINESS
  COMMUNICATION
  ANIME
}

/// What kind of thing the app is, structurally. Orthogonal to Category, which
/// describes the topic. Null means the owner has not classified it yet.
enum AppType {
  AGENT
  CUSTOM_INTERFACE
  DATA_FOCUS
  DATA_PIPELINE
  ANALYTICS
  FORM
}

enum Status {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ExecutionMode {
  ANY
  LOCAL
  REMOTE
}

enum Visibility {
  PUBLIC
  PUBLIC_REQUEST_ACCESS
  PRIVATE
  PROTOTYPE
  OFFLINE
}

model App {
  id String @id

  status     Status     @default(ACTIVE)
  visibility Visibility @default(PRIVATE)

  meta Meta[]

  templates Template[]
  widgets   Widget[]
  pages     Page[]
  queue     JoinQueue[]
  members   Membership[]
  comments  Comment[]
  changelog String?

  courseLinks   CourseAppLink[]
  inviteLinks   InviteLink[]
  invitations   Invitation[]
  notifications Notification[]

  feedback            Feedback[]
  publicationRequests PublicationRequest[]

  defaultRole   Role?   @relation("defaultForApp", fields: [defaultRoleId], references: [id])
  defaultRoleId String? @unique
  ownerRole     Role?   @relation("ownerForApp", fields: [ownerRoleId], references: [id])
  ownerRoleId   String? @unique
  roles         Role[]

  primaryCategory   Category?
  secondaryCategory Category?
  appType           AppType?

  ratingSum         BigInt @default(0)
  ratingCount       BigInt @default(0)
  downloadCount     BigInt @default(0)
  interactionsCount BigInt @default(0)

  avgRating      Float? @default(0)
  // Relevance formula: (downloads * 2 + interactions) * (1 + avgRating/5) * log(ratingCount + 1)
  relevanceScore Float? @default(0)

  totalSize BigInt @default(0)

  price   BigInt  @default(0)
  version String?

  /// Project owner opts in to the Fork-an-app feature. Apps default to
  /// false; without this flag the fork endpoints reject the request.
  allowForking Boolean @default(false)
  /// Owner-defined fork policy: which asset categories a fork of this app
  /// copies, and how the project database is handled. NULL = platform
  /// default (copy everything), which preserves pre-#756 behavior for
  /// every existing row.
  forkPolicy   Json?
  /// For forked apps: the source app's id, kept as a free-form string so a
  /// fork survives even if the source app is later deleted.
  forkedFrom   String?
  /// For forked apps: when the fork happened.
  forkedAt     DateTime?

  technicalUsers TechnicalUser[]

  outgoingAppConnections AppConnection[] @relation("outgoingAppConnections")
  incomingAppConnections AppConnection[] @relation("incomingAppConnections")
  processNotes           AppProcessNote[]

  ownedGroups      AppGroup[]       @relation("ownedGroups")
  groupMemberships AppGroupMember[] @relation("appGroupMemberships")

  llmUsage       LLMUsageTracking[]
  usageLimits    AppUsageLimit[]
  executionUsage ExecutionUsageTracking[]
  executionRuns  ExecutionRun[]
  executionMode  ExecutionMode            @default(ANY)

  syncs  BoardSync[]
  boardScores AppBoardScore[]
  bits   String[]    @default([])
  events Event[]
  sinks  EventSink[]

  eventRemoteAuths         EventRemoteAuth[]
  eventRemoteRegistrations EventRemoteRegistration[]
  eventAliases             EventAlias[]
  eventSetups              EventSetup[]

  regressionSuites    RegressionSuite[]
  regressionSuiteRuns RegressionSuiteRun[]

  packages   AppPackage[]
  purchases  AppPurchase[]
  discounts  AppDiscount[]
  salesDaily     AppSalesDaily[]
  analyticsDaily AppAnalyticsDaily[]

  aiActAssessments       AiActAssessment[]
  aiActModelObservations AiActModelObservation[]


  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  embeddingUsageTrackings EmbeddingUsageTracking[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([avgRating])
  @@index([relevanceScore])
  @@index([ratingSum])
  @@index([status])
}

model AppUsageLimit {
  id String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String
  /// Empty string means app-wide. A user id means per-user limit within the app.
  /// Technical-user scoped limits use the technical user's id in the same column.
  userId String @default("")

  /// Valid values are weekly, monthly, yearly.
  period           String
  costMicroDollars BigInt?
  tokenLimit       BigInt?
  enabled Boolean @default(true)
  hard Boolean @default(true)
  warningThresholdPercent Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, userId, period])
  @@index([appId])
  @@index([userId])
}

enum CacheScope {
  APP
  USER
}

/// Key/value cache entries written by flows, plus the API's own coordination state
/// under the reserved `__platform__` partition. This is the fallback backend; when
/// CACHE_BACKEND selects redis, dynamodb, cosmos or firestore the entries live there
/// instead and this table stays empty.
///
/// `appId` is deliberately not a foreign key: the platform partition has no App row.
/// App deletion removes its rows explicitly in the same transaction.
model AppCacheEntry {
  appId String

  scope CacheScope
  /// Empty string for app-scoped entries. A user id for user-scoped entries.
  userId String @default("")
  /// Optional grouping for bulk invalidation; empty for unnamespaced entries.
  namespace String @default("")
  key       String

  value Json

  /// Null means the entry persists until it is explicitly deleted. Postgres has no
  /// native TTL, so expired rows are removed by the cache sweeper.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([appId, scope, userId, namespace, key])
  @@index([expiresAt])
  @@index([appId])
}

model TechnicalUser {
  id String @id

  name        String
  description String?
  key         String  @unique

  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)
  roleId String?

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  creatorUser   User?   @relation("TechnicalUserCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  creatorUserId String?
  creatorMembership   Membership? @relation("TechnicalUserCreatorMembership", fields: [creatorMembershipId], references: [id], onDelete: Cascade)
  creatorMembershipId String?

  llmUsage                    LLMUsageTracking[]
  embeddingUsage              EmbeddingUsageTracking[]
  executionUsage              ExecutionUsageTracking[]
  executionRuns               ExecutionRun[]

  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([appId])
  @@index([creatorUserId])
  @@index([creatorMembershipId])
}

model Feedback {
  id String @id

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  app   App?    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String?

  template   Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String?

  eventId String?
  context Json?
  comment String
  rating  BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId, eventId])
  @@index([appId])
  @@index([createdAt])
  @@index([userId])
}

model Comment {
  id String @id

  text   String
  rating BigInt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  app   App?    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String?

  template   Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String?

  package   WasmPackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, appId])
  @@unique([userId, packageId])
  @@index([appId])
  @@index([packageId])
  @@index([userId])
}

model Template {
  id String @id

  meta Meta[]

  comments  Comment[]
  changelog String?

  feedback Feedback[]

  ratingSum   BigInt @default(0)
  ratingCount BigInt @default(0)

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  version String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId])
}

model Widget {
  id String @id

  meta Meta[]

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  version String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId])
}

model Page {
  id String @id

  name        String
  description String?

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  boardId String?

  version String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId])
  @@index([boardId])
}

model BoardSync {
  id String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  boardId      String
  lastSyncedAt DateTime

  syncEncryptionKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, boardId])
}

/// Persisted quality / governance scores for a single board, aggregated as the
/// MIN across that board's nodes per category (0-10, higher = better). App-level
/// scores are derived on read via aggregation over these rows.
model AppBoardScore {
  id String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  boardId String

  security    Int
  privacy     Int
  performance Int
  governance  Int
  reliability Int
  cost        Int

  /// Minimum across all six categories - single sortable "how bad" value.
  worstScore Int

  nodeCount        Int @default(0)
  scoredNodeCount  Int @default(0)
  connectionCount  Int @default(0)

  /// Nodes dragging scores down: [{ node, category, score, count? }]
  flaggedPatterns Json?

  /// Cached lightweight board summary metadata (name, stage, counts, ...) used
  /// to serve board summaries without reading every board from object storage.
  summary Json?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([appId, boardId])
  @@index([appId])
  @@index([worstScore])
  @@index([governance])
  @@index([security])
}

/// Event model - mirrors the Event structure stored in bucket for fast lookups
/// The full Event data is kept in the bucket for versioning, this is the DB mirror
model Event {
  id String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  name        String
  description String?

  /// Event type: "chat", "api", "email", "quick_action", etc.
  eventType String

  /// Whether this event is active
  active Boolean @default(true)

  /// Priority for ordering events
  priority Int @default(0)

  /// Board this event triggers (mutually exclusive with pageId for A2UI events)
  boardId      String?
  /// Board version as semver string "major.minor.patch"
  boardVersion String?
  /// Node ID within the board
  nodeId       String?

  /// For A2UI events: default page to render
  pageId String?

  /// URL route path that maps to this event (e.g., "/", "/dashboard")
  route String?

  /// Whether this is the default event/route for the app
  isDefault Boolean @default(false)

  /// Event version as semver string "major.minor.patch"
  eventVersion String @default("0.0.0")

  /// Where this event runs: "Local" (offline/desktop) or "Remote" (server).
  /// Events never run Hybrid — they must be bound to one environment so their
  /// config (URLs, credentials, tutorials) is unambiguous.
  executionMode String @default("Local")

  /// Reachability: "PUBLIC" (public REST/MCP surface with its own auth) or
  /// "INTERNAL" (only callable by connected apps via the app-connection proxy).
  exposure String @default("PUBLIC")

  /// Variables for this event (JSON blob)
  variables Json?

  /// Event config (stored as base64 or JSON depending on content)
  config Json?

  /// Input pins metadata for quick access without loading board
  inputs Json?

  /// Release notes - can be plain text or URL
  notes Json?

  /// Canary configuration for A/B testing
  canary Json?

  /// Canary/shadow variant targets (JSON array of EventVariant). Empty set is
  /// stored as NULL; the legacy `canary` column is the fallback mirror.
  variants Json?

  /// Process-mining case-key mappings: business key name → dot-path into the
  /// invocation payload (e.g. {"order_id": "order.id"}). Extracted
  /// automatically on every run so cases group by business object without
  /// callers having to pass correlation explicitly.
  correlationMappings Json?

  sink EventSink?

  /// Status of the most recent remote setup run: "running", "ok", "error".
  /// Only meaningful for events whose underlying flow
  /// contains REST/MCP server nodes that are executed remotely.
  setupStatus String?

  /// Timestamp of the last setup run completion.
  lastSetupAt DateTime?

  /// Event version that was active during the last successful setup. Used to
  /// match `EventRemoteRegistration` rows when serving inbound requests.
  /// Remains the stable variant's serving pointer; the stable `EventSetup`
  /// row mirrors it.
  lastSetupVersion String?

  /// Last setup error message (truncated), populated only when setupStatus = "error".
  lastSetupError String?

  remoteAuths         EventRemoteAuth[]
  remoteRegistrations EventRemoteRegistration[]
  aliases             EventAlias[]
  setups              EventSetup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, route])
  @@index([appId])
  @@index([appId, active])
  @@index([appId, eventType])
  @@index([appId, isDefault])
  @@index([boardId])
  @@index([pageId])
}

/// Per-variant serving pointer for the inbound REST/MCP surface: which event
/// version (and board) a variant's traffic dispatches into. One row per
/// (event, variant); the "stable" row mirrors the legacy
/// Event.lastSetupVersion scalar, which keeps being written for back-compat.
model EventSetup {
  id String @id @default(cuid())

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  /// Variant name this row serves ("stable" or an EventVariant.name).
  variant String

  /// Event version whose registration rows serve this variant's traffic.
  eventVersion String

  /// Board the variant's setup run dispatched into.
  boardId      String
  /// Board version as semver string "major.minor.patch". NULL = floating latest.
  boardVersion String?

  /// Status of the most recent setup run for this variant: "running", "ok", "error".
  setupStatus String?

  /// Timestamp of the last setup run completion.
  lastSetupAt DateTime?

  /// Last setup error message (truncated), populated only when setupStatus = "error".
  lastSetupError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, variant])
  @@index([appId, eventId])
}

/// Auth configuration captured per remote server node during setup.
/// Inbound requests look this up via EventRemoteRegistration.authId.
model EventRemoteAuth {
  id String @id @default(cuid())

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  /// Event version this auth config belongs to. Replaced atomically per setup.
  eventVersion String

  /// Variant this auth config serves ("stable" or an EventVariant.name).
  variant String @default("stable")

  /// node_id of the server node that emitted this config.
  nodeId String

  /// "rest" or "mcp".
  kind String

  /// Serialized RestAuthConfig / McpAuthConfig. Secret fields are stored as
  /// *_encrypted values using the sink token encryption key.
  configJson Json

  registrations EventRemoteRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId, eventId, eventVersion, variant])
  @@index([appId, eventId, eventVersion, variant, nodeId, kind])
}

/// Registration row written by the setup-collector for every route, file,
/// openapi spec, tool, resource, or prompt emitted by remote server nodes.
model EventRemoteRegistration {
  id String @id @default(cuid())

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  /// Event version this registration belongs to. The inbound dispatcher
  /// reads the rows matching the served variant's EventSetup.eventVersion
  /// (falling back to event.lastSetupVersion for stable).
  eventVersion String

  /// Variant this registration serves ("stable" or an EventVariant.name).
  /// Inbound dispatch resolves the serving variant first and only ever
  /// matches rows within one variant's bucket.
  variant String @default("stable")

  /// One of: "rest_fn", "rest_file", "rest_openapi", "rest_openapi_ui",
  /// "mcp_raw", "mcp_tool", "mcp_resource", "mcp_prompt".
  kind String

  /// HTTP method for rest_fn (uppercase, or "ANY"). NULL for everything else.
  method String?

  /// Route path for REST kinds. For mcp_resource this is the URI. For
  /// mcp_tool / mcp_prompt this is the tool/prompt name.
  path String

  /// Target node ID to dispatch into for function-like registrations
  /// (rest_fn, mcp_tool, mcp_prompt). NULL for file/openapi/resource rows
  /// that serve static content.
  nodeId String?

  /// JSON Schema for input validation / MCP advertising.
  schemaJson Json?

  /// Kind-specific extras (content_type, ui_path, mime_type, …).
  extrasJson Json?

  /// Optional auth row to apply.
  auth   EventRemoteAuth? @relation(fields: [authId], references: [id], onDelete: SetNull)
  authId String?

  createdAt DateTime @default(now())

  @@index([appId, eventId, eventVersion, variant])
  @@index([appId, eventId, eventVersion, variant, kind])
  // Avoid a 63-character CockroachDB name collision with the index above.
  @@index([appId, eventId, eventVersion, variant, kind, method, path], map: "EventRemoteRegistration_route_lookup_idx")
}

/// Vanity slug -> event mapping. Slug is the global URL key; uniqueness
/// is enforced by the PK. Router/common slugs and generated-id-length
/// slugs are hard-reserved; brand-sensitive slugs (see
/// `utils::event_alias::is_admin_reserved_slug`) require platform admin.
model EventAlias {
  /// URL-safe slug, e.g. "checkout" or "twilio-inbound".
  /// Regex: [a-z0-9-]{3,64}. Reserved: api, r, m, health, metrics,
  /// generated id lengths, swagger, api-doc, openapi, docs, __, etc.
  slug String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, eventId])
  @@index([appId])
  @@index([eventId])
}

/// Event Sink Registration - tracks which events have active server-side sinks
/// Most config comes from the Event itself via join - we only store sink-specific data
model EventSink {
  id String @id @default(cuid())

  /// The event this sink is for - unique 1:1 mapping
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// App the event belongs to (for permission checks and lookups)
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  /// Sink type: "http", "cron", "discord", "telegram", etc. (from event.eventType)
  sinkType String

  /// Is the sink currently active on the server?
  active Boolean @default(true)

  /// For HTTP sinks: the unique path to listen on
  path String?

  /// For HTTP sinks: the accepted HTTP method (GET/POST/PUT/PATCH/DELETE).
  /// Different methods on the same path are treated as distinct sinks so
  /// `POST /foo` and `GET /foo` can route to different events.
  method String?

  /// Auth token for securing HTTP endpoints (optional, auto-generated if not provided)
  authToken String?

  /// Secret for webhook verification (Telegram)
  webhookSecret String?

  /// For cron sinks: the cron expression (e.g., "0 * * * *")
  cronExpression String?

  /// For cron sinks: timezone (default UTC)
  cronTimezone String?

  /// Encrypted Personal Access Token for execution (optional - allows model/file access)
  patEncrypted String?

  /// Encrypted OAuth tokens JSON (optional - for provider-specific access like Google, GitHub, etc.)
  oauthTokensEncrypted String?

  /// Snapshot of the last updater's profile JSON (bits, hubs) for trigger execution
  profileJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, path, method])
  @@index([appId])
  @@index([active])
  @@index([sinkType])
  @@index([sinkType, active])
}

/// Service Sink Token - JWT tokens issued to internal services for triggering sinks
/// Each token is scoped to a specific sink type and can be individually revoked
model SinkToken {
  /// JWT ID (jti claim) - unique identifier for the token
  id String @id

  /// The sink type this token is authorized to trigger (e.g., "cron", "discord", "telegram")
  sinkType String

  /// Human-readable name/description for the token
  name String?

  /// Whether this token has been revoked
  revoked Boolean @default(false)

  /// When the token was revoked (if applicable)
  revokedAt DateTime?

  /// Who/what revoked the token
  revokedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sinkType])
  @@index([revoked])
  @@index([sinkType, revoked])
}

// ================== Sales & Purchases ==================

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Tracks individual app purchases
model AppPurchase {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  /// Price paid in cents at time of purchase
  pricePaid      BigInt
  /// Original price before discount (in cents)
  originalPrice  BigInt
  /// Discount amount in cents (0 if none)
  discountAmount BigInt @default(0)

  discount   AppDiscount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountId String?

  /// Currency code (e.g., "EUR", "USD")
  currency String @default("EUR")

  /// Stripe checkout session ID for this purchase
  stripeSessionId       String
  /// Stripe payment intent ID
  stripePaymentIntentId String?

  status PurchaseStatus @default(PENDING)

  /// When purchase was completed
  completedAt  DateTime?
  /// When refunded (if applicable)
  refundedAt   DateTime?
  /// Refund reason if refunded
  refundReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([appId])
  @@index([appId, status])
  @@index([appId, completedAt])
  @@index([stripeSessionId])
}

/// Discount codes for apps
model AppDiscount {
  id String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  /// Discount code (e.g., "LAUNCH20")
  code        String
  /// Human-readable name for the discount
  name        String
  /// Description of the discount
  description String?

  discountType  DiscountType
  /// Discount value (percentage 0-100 or fixed amount in cents)
  discountValue BigInt

  /// Maximum number of uses (null = unlimited)
  maxUses           BigInt?
  /// Current number of times used
  usedCount         BigInt  @default(0)
  /// Minimum purchase amount required (in cents, null = no minimum)
  minPurchaseAmount BigInt?

  /// When the discount becomes active
  startsAt  DateTime  @default(now())
  /// When the discount expires (null = never)
  expiresAt DateTime?
  /// Whether the discount is currently active
  isActive  Boolean   @default(true)

  purchases AppPurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, code])
  @@index([appId])
  @@index([appId, isActive])
  @@index([code])
}

/// Pre-aggregated daily analytics data for efficient dashboard queries
model AppAnalyticsDaily {
  id String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  /// Date for this aggregation
  date DateTime @db.Date

  totalExecutions      BigInt @default(0)
  successfulExecutions BigInt @default(0)
  failedExecutions     BigInt @default(0)
  uniqueUsers          BigInt @default(0)
  feedbackCount        BigInt @default(0)
  avgFeedbackRating    Float?
  positiveFeedback     BigInt @default(0)
  negativeFeedback     BigInt @default(0)
  totalLlmCalls        BigInt @default(0)
  totalLlmTokensIn     BigInt @default(0)
  totalLlmTokensOut    BigInt @default(0)
  totalLlmCost         BigInt @default(0)
  avgLatencyMs         Float?
  p95LatencyMs         Float?
  totalEmbeddingCalls  BigInt @default(0)
  totalEmbeddingTokens BigInt @default(0)
  totalEmbeddingCost   BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, date])
  @@index([appId])
  @@index([appId, date])
}

/// Pre-aggregated daily sales data for efficient dashboard queries
model AppSalesDaily {
  id String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  /// Date for this aggregation
  date DateTime @db.Date

  /// Total revenue for the day (in cents)
  totalRevenue      BigInt @default(0)
  /// Gross revenue before discounts (in cents)
  grossRevenue      BigInt @default(0)
  /// Total discount amount given (in cents)
  totalDiscounts    BigInt @default(0)
  /// Number of purchases
  purchaseCount     BigInt @default(0)
  /// Number of refunds
  refundCount       BigInt @default(0)
  /// Total refund amount (in cents)
  refundAmount      BigInt @default(0)
  /// Number of unique buyers
  uniqueBuyers      BigInt @default(0)
  /// Average order value (in cents)
  avgOrderValue     BigInt @default(0)
  /// Number of discount codes used
  discountCodesUsed BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, date])
  @@index([appId])
  @@index([appId, date])
}

model AppPackage {
  id String @id @default(cuid())

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  /// Nullable: set to null when the member who added this package leaves
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  membershipId String?

  packageId String
  version   String

  addedAt    DateTime @default(now())
  autoUpdate Boolean  @default(false)

  /// When true the package is frozen: can’t be updated, version-changed, or placed on new boards
  stale Boolean @default(false)

  @@unique([appId, packageId])
  @@index([appId])
  @@index([packageId])
  @@index([membershipId])
}
