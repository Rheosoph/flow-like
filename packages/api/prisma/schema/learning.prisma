model Course {
  id String @id

  language         String
  slug             String?
  difficulty       String  @default("BEGINNER")
  category         String  @default("GENERAL")
  estimatedMinutes Int     @default(0)
  isPublished      Boolean @default(false)
  authorId         String?
  iconUrl          String?
  bannerUrl        String?
  tags             Json?
  position         Int?

  meta         Meta[]
  modules      CourseModule[]
  appLinks     CourseAppLink[]
  assets       CourseAsset[]
  enrollments  UserCourseEnrollment[]
  certificates Certificate[]
  pathSteps    LearningPathCourse[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([language])
  @@index([category])
  @@index([isPublished])
  @@index([slug])
  @@index([position])
}

model LearningPath {
  id          String  @id
  slug        String?
  title       String
  description String?
  position    Int     @default(0)
  isPublished Boolean @default(false)

  steps LearningPathCourse[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isPublished])
  @@index([slug])
  @@index([position])
}

model LearningPathCourse {
  pathId   String
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  courseId String
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position Int          @default(0)

  @@id([pathId, courseId])
  @@index([pathId])
  @@index([courseId])
  @@index([pathId, position])
}

model CourseModule {
  id       String @id
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  position    Int     @default(0)

  lessons Lesson[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([courseId])
  @@index([courseId, position])
}

model Lesson {
  id       String       @id
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title            String
  position         Int     @default(0)
  language         String  @default("en")
  content          String
  videoUrl         String?
  estimatedMinutes Int     @default(5)
  isOptional       Boolean @default(false)

  challenges Challenge[]
  appRefs    LessonAppRef[]
  progress   UserLessonProgress[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([moduleId])
  @@index([moduleId, position])
}

model Challenge {
  id       String @id
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  position    Int     @default(0)
  kind        String
  prompt      String
  explanation String?
  payload     Json
  points      Int     @default(10)

  attempts         UserChallengeAttempt[]
  weeklyChallenges WeeklyChallenge[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([lessonId])
}

model CourseAppLink {
  id       String @id
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  appId   String
  app     App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  purpose String  @default("SHARED_TEMPLATE")
  alias   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([courseId, appId])
  @@index([appId])
  @@index([courseId])
}

model CourseAsset {
  id       String @id
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  name       String
  storageKey String
  filename   String
  mimeType   String
  size       Int
  kind       String @default("DOCUMENT")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([courseId, name])
  @@index([courseId])
}

model LessonAppRef {
  id       String @id
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  appAlias String?
  appId    String?

  kind   String
  target Json

  label String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([lessonId])
}

model UserCourseEnrollment {
  id       String @id
  userId   String
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // alias -> forked appId. Backward compatible: keys are app aliases from
  // CourseAppLink, values are the user-owned app IDs after forking.
  linkedAppIds Json @default("{}")

  // alias -> { boards: { src->dst }, nodes: { src->dst }, pins: { src->dst },
  //            events: { src->dst }, pages: { src->dst } }
  // Used by the server to translate original IDs (referenced by lesson
  // payloads/refs) into the user-specific ones at validation/navigation time.
  idMaps Json @default("{}")

  startedAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model UserLessonProgress {
  id       String @id
  userId   String
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  status      String    @default("IN_PROGRESS")
  completedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model UserChallengeAttempt {
  id          String    @id
  userId      String
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  submission    Json
  isCorrect     Boolean
  pointsAwarded Int      @default(0)
  attemptedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([challengeId])
  @@index([userId, challengeId])
}

model Certificate {
  id       String @id
  userId   String
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  issuedAt DateTime @default(now()) @db.Timestamptz(3)
  hash     String
  pdfUrl   String?

  @@unique([userId, courseId])
  @@index([userId])

  @@index([courseId])
}

model LeaderboardOptIn {
  userId      String   @id
  displayName String
  isOptedIn   Boolean  @default(true)
  totalPoints Int      @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model WeeklyChallenge {
  id          String    @id
  weekIso     String
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  expiresAt   DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([weekIso])
  @@index([expiresAt])
  @@index([challengeId])
}
