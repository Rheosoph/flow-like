model InviteLink {
  id String @id

  name    String?
  maxUses BigInt  @default(-1) // -1 means unlimited uses

  token String @unique
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  countJoined BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId, createdAt])
  @@index([appId, token])
}

model JoinQueue {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, appId])
  @@index([userId, appId])
  @@index([appId, createdAt])
}

model Invitation {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  name        String
  description String?
  message     String?

  byMember   Membership @relation(fields: [byMemberId], references: [id], onDelete: Cascade)
  byMemberId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, appId])
  @@index([userId, createdAt])
}

model Membership {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String

  invitations   Invitation[]
  addedPackages AppPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  joinedVia String?

  @@unique([userId, appId])
  @@index([appId, roleId])
}

model Role {
  id String @id

  name        String
  description String?

  attributes  String[]
  permissions BigInt

  memberships    Membership[]
  technicalUsers TechnicalUser[]

  app   App?    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String?

  defaultForApp App? @relation("defaultForApp")
  ownerForApp   App? @relation("ownerForApp")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationType {
  WORKFLOW
  SYSTEM
}

enum PushNotificationTargetPlatform {
  IOS
  ANDROID
  DESKTOP
}

enum PushNotificationTargetProvider {
  FCM
  AWS_SNS
  AZURE_NOTIFICATION_HUBS
}

model Notification {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  app   App?    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String?

  title       String
  description String?
  icon        String?
  link        String?

  type NotificationType @default(WORKFLOW)
  read Boolean          @default(false)

  sourceRunId  String?
  sourceNodeId String?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, read])
  @@index([appId, createdAt])
}

model PushNotificationTarget {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  deviceId String

  platform PushNotificationTargetPlatform
  provider PushNotificationTargetProvider

  tokenEncrypted String
  endpointArn    String?
  installationId String?
  channelId      String?
  deviceName     String?
  metadata       Json?

  pushEnabled        Boolean   @default(true)
  lastRegisteredAt   DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  invalidatedAt      DateTime?
  invalidationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId, provider])
  @@index([userId, pushEnabled])
  @@index([provider, platform])
  @@index([invalidatedAt])
}
