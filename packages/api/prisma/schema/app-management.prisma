model InviteLink {
  id String @id

  name    String?
  maxUses BigInt  @default(-1) // -1 means unlimited uses

  token String @unique
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  countJoined BigInt    @default(0)
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId, createdAt])
  @@index([appId, token])
}

model JoinQueue {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, appId])
  @@index([userId, appId])
  @@index([appId, createdAt])
}

model Invitation {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  name        String
  description String?
  message     String?

  byMember   Membership @relation(fields: [byMemberId], references: [id], onDelete: Cascade)
  byMemberId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, appId])
  @@index([userId, createdAt])
}

enum AppConnectionStatus {
  PENDING
  ACTIVE
}

model AppConnection {
  id String @id

  sourceApp   App    @relation("outgoingAppConnections", fields: [sourceAppId], references: [id], onDelete: Cascade)
  sourceAppId String

  targetApp   App    @relation("incomingAppConnections", fields: [targetAppId], references: [id], onDelete: Cascade)
  targetAppId String

  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)
  roleId String?

  status AppConnectionStatus @default(PENDING)

  comment String?

  requestedByUserId String?
  approvedByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceAppId, targetAppId])
  @@index([targetAppId, status])
  @@index([sourceAppId, status])
}

/// Free-form documentation app owners/admins attach to their app for the
/// cross-app process/chain view (e.g. "this app handles invoice OCR").
model AppProcessNote {
  id String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  authorUserId String?
  content      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId, createdAt])
}

model Membership {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String

  invitations   Invitation[]
  addedPackages AppPackage[]
  technicalUsersCreated TechnicalUser[] @relation("TechnicalUserCreatorMembership")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  joinedVia String?

  @@unique([userId, appId])
  @@index([appId, roleId])
}

model Role {
  id String @id

  name        String
  description String?

  attributes  String[]
  permissions BigInt

  memberships    Membership[]
  technicalUsers TechnicalUser[]
  appConnections AppConnection[]

  app   App?    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String?

  defaultForApp App? @relation("defaultForApp")
  ownerForApp   App? @relation("ownerForApp")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationType {
  WORKFLOW
  SYSTEM
}

enum PushNotificationTargetPlatform {
  IOS
  ANDROID
  DESKTOP
}

enum PushNotificationTargetProvider {
  FCM
  AWS_SNS
  AZURE_NOTIFICATION_HUBS
}

model Notification {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  app   App?    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String?

  title       String
  description String?
  icon        String?
  link        String?

  type NotificationType @default(WORKFLOW)
  read Boolean          @default(false)

  sourceRunId  String?
  sourceNodeId String?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, read])
  @@index([appId, createdAt])
}

model PushNotificationTarget {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  deviceId String

  platform PushNotificationTargetPlatform
  provider PushNotificationTargetProvider

  tokenEncrypted String
  endpointArn    String?
  installationId String?
  channelId      String?
  deviceName     String?
  metadata       Json?

  pushEnabled        Boolean   @default(true)
  failureCount       Int       @default(0)
  lastRegisteredAt   DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  invalidatedAt      DateTime?
  invalidationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId, provider])
  @@index([userId, pushEnabled])
  @@index([provider, platform])
  @@index([invalidatedAt])
}

enum AppGroupMemberStatus {
  PENDING
  ACTIVE
}

enum AppGroupMemberKind {
  PRIMARY
  MEMBER
}

/// A curated, store-facing bundle of related apps presented as a single unit
/// (a "suite"). Branding (name/icon/banner/description) lives in Meta,
/// per-language, exactly like apps — no bespoke columns here. The group is
/// governed by its owner app's Owner/Admins.
model AppGroup {
  id String @id

  status     Status     @default(ACTIVE)
  visibility Visibility @default(PRIVATE)

  meta Meta[]

  /// The app whose Owner/Admins may edit this group; also the default branding
  /// anchor when the group has no Meta of its own.
  ownerApp   App    @relation("ownedGroups", fields: [ownerAppId], references: [id], onDelete: Cascade)
  ownerAppId String

  members AppGroupMember[]

  /// Suites go through the same review pipeline as apps to reach a public
  /// visibility; see `PublicationRequest`.
  publicationRequests PublicationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerAppId])
  @@index([visibility])
  @@index([createdAt])
}

/// Curated membership of an app in a group. Consent: adding an app the caller
/// owns/admins — or that already has an active AppConnection with the group's
/// apps — activates immediately; otherwise the row stays PENDING until the
/// member app's owner accepts. This is a presentation grant only and never
/// changes runtime data-access permissions.
model AppGroupMember {
  id String @id

  group   AppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  app   App    @relation("appGroupMemberships", fields: [appId], references: [id], onDelete: Cascade)
  appId String

  kind   AppGroupMemberKind   @default(MEMBER)
  status AppGroupMemberStatus @default(PENDING)

  /// Curated display order within the group.
  position Int @default(0)

  addedByUserId    String?
  approvedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, appId])
  @@index([groupId, status])
  @@index([appId, status])
}
