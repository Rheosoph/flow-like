model LlmModel {
  slug String @id

  name        String
  releaseDate DateTime? @db.Timestamptz(3)

  creatorName String
  creatorSlug String

  evaluations Json?
  pricing     Json?

  medianOutputTokensPerSecond   Float?
  medianTimeToFirstTokenSeconds Float?
  medianTimeToFirstAnswerToken  Float?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  bits Bit[]

  @@index([creatorSlug])
}

model Bit {
  id String @id

  authors      Json?
  type         String
  meta         Meta[]
  repository   String?
  downloadLink String?
  fileName     String?
  hash         String?
  parameters   Json?

  size BigInt?
  hub  String

  version String?
  license String?

  dependencies       Json?
  dependencyTreeHash String? @unique

  modelSlug String?
  model     LlmModel? @relation(fields: [modelSlug], references: [slug])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  cache  BitTreeCache?
  caches BitCache[]

  @@index([type])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([hash])
  @@index([hub])
  @@index([modelSlug])
}

model BitCache {
  id String @id

  bit   Bit?    @relation(fields: [bitId], references: [id], onDelete: Cascade)
  bitId String?

  externalBit Json?

  bitTreeCache       BitTreeCache @relation(fields: [dependencyTreeHash], references: [dependencyTreeHash], onDelete: Cascade)
  dependencyTreeHash String

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([dependencyTreeHash])

  @@index([bitId])
}

model BitTreeCache {
  dependencyTreeHash String @id
  bit                Bit    @relation(fields: [dependencyTreeHash], references: [dependencyTreeHash], onDelete: Cascade)

  bits BitCache[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model TemplateProfile {
  id String @id

  name        String
  thumbnail   String?
  icon        String?
  description String?
  secure      Boolean @default(true)
  interests   Json?
  tags        Json?

  theme    Json?
  settings Json?

  // JSON with the apps that are part of the profile. Contains the app ID, if it is favorite, pinned and position of the two
  apps   Json?
  bitIds Json?
  hub    String
  hubs   Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
