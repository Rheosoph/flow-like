model User {
  id String @id

  stripeId   String? @unique
  trackingId String? @unique

  email             String?
  username          String? @unique
  preferredUsername String? @unique
  name              String?
  description       String?
  avatar            String?

  additionalInformation Json?

  permission           BigInt  @default(0)
  acceptedTermsVersion String?
  tutorialCompleted    Boolean @default(false)
  devMode              Boolean @default(false)

  memberships                 Membership[]
  profiles                    Profile[]
  personalAccessToken         PAT[]
  queue                       JoinQueue[]
  comments                    Comment[]
  llmUsage                    LLMUsageTracking[]
  embeddingUsage              EmbeddingUsageTracking[]
  executionUsage              ExecutionUsageTracking[]
  executionRuns               ExecutionRun[]
  feedback                    Feedback[]
  flowScriptApplyFailures     FlowScriptApplyFailure[]
  assignedPublicationRequests PublicationRequest[]
  publicationLogs             PublicationLog[]
  invitations                 Invitation[]
  transactions                Transaction[]
  notifications               Notification[]
  pushNotificationTargets     PushNotificationTarget[]
  userBits                    UserBit[]
  wasmPackageAccess           WasmPackageUser[]
  wasmPackageReviews          WasmPackageReview[]
  wasmInvitesSent             WasmPackageInvitation[]  @relation("WasmInviter")
  wasmInvitesReceived         WasmPackageInvitation[]  @relation("WasmInvitee")
  wasmPackageJoinQueue        WasmPackageJoinQueue[]
  wasmPackagePurchases        WasmPackagePurchase[]
  wasmPackagesAuthored        WasmPackageAuthor[]
  purchases                   AppPurchase[]
  technicalUsersCreated       TechnicalUser[]          @relation("TechnicalUserCreator")

  status String @default("ACTIVE")
  tier   String @default("FREE")

  totalSize             BigInt  @default(0)
  totalLLMPrice         BigInt  @default(0)
  totalEmbeddingPrice   BigInt  @default(0)
  llmPriceTrackingMonth String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // User search resolves a pasted address exactly before it falls back to a scan.
  @@index([email])
}

model Profile {
  id String

  name        String
  thumbnail   String?
  icon        String?
  description String?
  interests   Json?
  tags        Json?

  theme    Json?
  settings Json?

  // JSON with the apps that are part of the profile. Contains the app ID, if it is favorite, pinned and position of the two
  apps      Json?
  shortcuts Json?
  homeLayout Json?
  homeDefaultId String?
  bitIds    Json?
  hub       String
  hubs      Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@id([userId, id])
  @@index([userId])
  @@index([userId, deletedAt])
}

model UserBit {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  type String

  repository   String?
  downloadLink String?
  fileName     String?
  hash         String?
  size         BigInt?

  // LLMParameters/VLMParameters shape WITHOUT secret provider params
  parameters       Json?
  // AES-256-GCM encrypted JSON map of secret provider params (api_key, ...)
  secretsEncrypted String?

  // {lang: Metadata} map, always contains "en"
  meta Json?

  version String?
  license String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([userId, type])
}

model PAT {
  id String @id

  name        String
  key         String @unique
  permissions BigInt @default(1)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  validUntil DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Transaction {
  id String @id

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  stripeId String @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model LLMUsageTracking {
  id String @id

  modelId           String
  provider          String?
  endpoint          String?
  invocationId      String?
  providerRequestId String?
  rawUsage          Json?
  tokenIn           BigInt
  tokenOut          BigInt

  latency Float?

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  technicalUserId String?
  technicalUser   TechnicalUser? @relation(fields: [technicalUserId], references: [id], onDelete: SetNull)

  app   App?    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String?

  price BigInt

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([appId, createdAt])
  @@index([userId, createdAt])
  @@index([modelId, createdAt])
  @@index([provider, createdAt])
  @@index([invocationId])
  @@index([technicalUserId, createdAt])
}

model EmbeddingUsageTracking {
  id String @id

  modelId           String
  provider          String?
  endpoint          String?
  invocationId      String?
  providerRequestId String?
  rawUsage          Json?
  tokenCount        BigInt
  latency           Float?

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  app   App?    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String?

  technicalUserId String?
  technicalUser   TechnicalUser? @relation(fields: [technicalUserId], references: [id], onDelete: SetNull)

  price BigInt

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([appId, createdAt])
  @@index([userId, createdAt])
  @@index([modelId, createdAt])
  @@index([provider, createdAt])
  @@index([invocationId])
  @@index([technicalUserId, createdAt])
}

model ExecutionUsageTracking {
  id String @id

  instance String?

  boardId String
  nodeId  String
  version String

  microseconds BigInt
  status       String

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  app   App?    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String?

  technicalUserId String?
  technicalUser   TechnicalUser? @relation(fields: [technicalUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([appId, createdAt])
  @@index([userId, createdAt])
  @@index([technicalUserId, createdAt])
  @@index([version])
}

model UsageInvocation {
  id String @id

  /// llm, embedding, execution, etc.
  kind   String
  /// pending, completed, failed, cancelled, unknown_usage.
  status String

  userId          String?
  technicalUserId String?
  appId           String?

  provider          String?
  endpoint          String?
  modelId           String?
  providerRequestId String?

  estimatedTokens           BigInt @default(0)
  estimatedCostMicroDollars BigInt @default(0)
  inputTokens               BigInt @default(0)
  outputTokens              BigInt @default(0)
  embeddingTokens           BigInt @default(0)
  costMicroDollars          BigInt @default(0)

  latency  Float?
  rawUsage Json?
  error    String?

  startedAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([appId, createdAt])
  @@index([userId, createdAt])
  @@index([technicalUserId, createdAt])
  @@index([provider, modelId, createdAt])
  @@index([providerRequestId])
}

model UsageAlert {
  id String @id

  kind     String
  severity String
  period   String?
  message  String

  appId  String?
  userId String?

  thresholdPercent        Int?
  currentCostMicroDollars BigInt?
  currentTokens           BigInt?

  acknowledgedAt       DateTime? @db.Timestamptz(3)
  acknowledgedByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([appId, createdAt])
  @@index([userId, createdAt])
  @@index([kind, severity, createdAt])
  @@index([acknowledgedAt])
}

model UsageLimitAuditLog {
  id String @id

  appId       String?
  userId      String?
  actorUserId String?
  action      String
  before      Json?
  after       Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([appId, createdAt])
  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Streaming events from execution environments
/// These are batch-pushed by executors and fetched via long polling
model ExecutionEvent {
  id String @id

  /// The run this event belongs to
  run   ExecutionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  /// Event sequence number (for ordering)
  sequence  Int
  /// Event type (log, progress, output, error, etc.)
  eventType String
  /// Event payload (JSON)
  payload   Json

  /// Whether this event has been delivered to the client
  delivered Boolean @default(false)

  /// Auto-cleanup after TTL
  expiresAt DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// Object-store reference ("store://<path>") when the payload was too large
  /// to keep in the row; `payload` then holds a marked placeholder
  payloadRef String?

  @@index([runId, delivered, sequence])
  @@index([expiresAt])
}

/// Tracks individual execution runs of boards/events
model ExecutionRun {
  id String @id

  /// The board being executed
  boardId String
  /// Version of the board (optional)
  version String?
  /// Event ID if triggered by an event
  eventId String?
  /// Node ID that was executed (start node)
  nodeId  String?

  /// Execution status
  status   String @default("PENDING")
  /// Execution mode (local, k8s isolated, k8s pool, function)
  mode     String @default("LOCAL")
  /// Highest log level encountered during execution (0=Debug, 1=Info, 2=Warn, 3=Error, 4=Fatal)
  logLevel Int    @default(0)

  /// Length of input payload in bytes (for tracking only)
  inputPayloadLen  BigInt  @default(0)
  /// Encryption key for input payload stored in object storage (base64 encoded)
  inputPayloadKey  String?
  /// Length of output payload in bytes (for tracking only)
  outputPayloadLen BigInt  @default(0)
  /// Error message if failed
  errorMessage     String?

  /// Progress percentage (0-100)
  progress    Int     @default(0)
  /// Current step/stage description
  currentStep String?

  /// When execution started
  startedAt   DateTime? @db.Timestamptz(3)
  /// When execution completed
  completedAt DateTime? @db.Timestamptz(3)
  /// TTL - auto-cleanup streaming events after this time
  expiresAt   DateTime? @db.Timestamptz(3)

  /// User who initiated the run
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  /// App the board belongs to
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  technicalUserId String?
  technicalUser   TechnicalUser? @relation(fields: [technicalUserId], references: [id], onDelete: SetNull)

  /// If the run was triggered through an app connection: the chain of apps
  /// that led to this run (first = original caller), stored as a JSON string
  /// array. Membership queries ("chains containing app X") go through the
  /// indexed `ExecutionRunCallerApp` rows written alongside this column.
  callerAppChain Json?
  callerApps     ExecutionRunCallerApp[]

  /// Process-mining correlation. `parentRunId` is the run that directly
  /// triggered this one (null = root); walking it reconstructs an end-to-end
  /// case across apps/events. `traceId` denormalizes the root run id.
  /// `correlationKeys` holds business/object keys (order_id, customer_id, …)
  /// tagged at invoke time — the case notion is chosen from these.
  traceId         String?
  parentRunId     String?
  correlationKeys Json?

  /// Which release lane produced this run. Non-PRIMARY runs are excluded
  /// from business cases and per-event stats.
  runVariant      String  @default("PRIMARY")
  /// The EventVariant.name that produced this run (non-PRIMARY only)
  variantName     String?
  /// SHADOW runs only: the PRIMARY run being mirrored
  shadowOfRunId   String?
  /// REGRESSION runs only: the suite run that scheduled this replay
  regressionRunId String?

  /// Streaming events for this run
  events ExecutionEvent[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([appId, status])
  @@index([userId, status])
  @@index([boardId])
  @@index([expiresAt])
  @@index([parentRunId])
  @@index([traceId])
  @@index([eventId, runVariant, createdAt])

  @@index([technicalUserId])
}

/// One row per app in `ExecutionRun.callerAppChain` (`position` = index in the chain).
/// Gives the process graph a btree-indexed membership lookup without array or GIN support.
model ExecutionRunCallerApp {
  runId    String
  appId    String
  position Int

  run ExecutionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, position])
  @@index([appId, runId])
}
