/// Key/value cache entries written by flows, plus the API's own coordination state
/// under the reserved `__platform__` partition. This is the fallback backend; when
/// CACHE_BACKEND selects redis, dynamodb, cosmos or firestore the entries live there
/// instead and this table stays empty.
///
/// `appId` is deliberately not a foreign key: the platform partition has no App row.
/// App deletion removes its rows explicitly in the same transaction.
model AppCacheEntry {
  appId String

  scope     String
  /// Empty string for app-scoped entries. A user id for user-scoped entries.
  userId    String @default("")
  /// Optional grouping for bulk invalidation; empty for unnamespaced entries.
  namespace String @default("")
  key       String

  value Json

  /// Null means the entry persists until it is explicitly deleted. Postgres has no
  /// native TTL, so expired rows are removed by the cache sweeper.
  expiresAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([appId, scope, userId, namespace, key])
  @@index([expiresAt])
  @@index([appId])
}

