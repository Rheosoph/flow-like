// ---- channel.prisma
/// One flat coordination table for the HTTP channel transport. A row is one pending server→client
/// request (REQUEST), one unsolicited client→server message (INBOUND, e.g. steering text) or a
/// cancel tombstone (CANCEL). Request details never live here — they ride the run's event stream.
/// Rows are deleted by the waiter on every exit path and swept by `expiresAt` otherwise.
model Channel {
  id        String   @id // request id / message id
  channelId String // run id (or chat run id)
  sub       String
  appId     String?
  /// REQUEST (pending server→client request), INBOUND (unsolicited client→server message,
  /// e.g. steering text) or CANCEL (tombstone).
  kind      String   @default("REQUEST")
  status    String   @default("PENDING")
  expiresAt BigInt
  value     String? // reply / inbound body, JSON text
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([channelId, kind])
  @@index([sub, expiresAt])
  @@index([expiresAt])
}

// ---- error-reporting.prisma
model ErrorReport {
  id         String   @id
  userId     String?
  method     String
  path       String
  statusCode Int
  publicCode String
  summary    String
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
}

// ---- file-accounting.prisma
/// The AWS file tracker commits an object's accounted size together with app and user totals.
/// Deleted objects retain a zero-size row so replayed S3 events cannot count them again.
/// No foreign keys: late storage events can arrive after an app or user has been removed.
model FileAccountingObject {
  id        String   @id
  bucket    String
  objectKey String
  appId     String
  userId    String?
  size      BigInt
  sequencer String
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([appId])
  @@index([userId])
}

// ---- flowscript.prisma
/// A FlowScript apply that failed, was blocked, or applied with warnings, captured with the
/// source that produced it so the team can see what users expected the editor to do.
///
/// This is NOT anonymous telemetry and deliberately does not live in `telemetry.prisma`: the row
/// names the reporting user, because one person's repeated attempts at the same edit are the
/// signal. That identity is exactly why the source is redacted before it is ever written —
/// declared variable values dropped, long literals generalized, see
/// `flow_like_ast::redact_flowscript` — and why only `GlobalPermission::Admin` can read it back.
model FlowScriptApplyFailure {
  id String @id

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  /// App and board the edit targeted. Deliberately plain columns, not foreign keys: a desktop-only
  /// app has no row on the hub at all, and those failures are the ones nothing else can see.
  appId   String
  boardId String
  layerId String?

  /// Where the apply ran: "desktop" (local Tauri apply) or "web" (the apply endpoint).
  source  String
  /// Who authored the source: "editor" (a person in the FlowScript panel) or "agent" (FlowPilot).
  /// Both go through the same board pipeline, so without this the panel could not tell them apart.
  origin  String
  /// "error" — the apply threw; "blocked" — no commands, diagnostics only; "partial" — commands
  /// were applied alongside diagnostics.
  outcome String

  /// The one line that explains this row: the error for a thrown apply, the first diagnostic
  /// otherwise. A plain column so "what breaks most" is a group-by instead of a table scan.
  cause          String
  errorMessage   String?
  diagnostics    Json?
  corrections    Json?
  commandCount   Int     @default(0)
  allowDeletions Boolean @default(false)

  /// The redacted FlowScript the user submitted. Line numbers match the source, so a diagnostic's
  /// line:col still points at the right line.
  flowscript       String
  flowscriptChars  Int     @default(0)
  droppedValues    Int     @default(0)
  redactedLiterals Int     @default(0)
  truncated        Boolean @default(false)

  appVersion String?
  platform   String?
  /// Trace the apply request belonged to, when it carried one, so a row opens in the trace explorer.
  traceId    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([outcome, createdAt])
  @@index([userId, createdAt])
  @@index([appId, createdAt])
  @@index([cause, createdAt])
  @@index([origin, createdAt])
}

// ---- governance.prisma
/// A review of a visibility change. Targets exactly one of an App or an
/// AppGroup ("suite") — the XOR cannot be expressed as a Prisma constraint and
/// is enforced in Rust by `routes::publication::PublicationTarget`, which is
/// the only sanctioned way to construct or read the target.
model PublicationRequest {
  id String @id

  targetVisibility String

  approver   User?   @relation(fields: [approverId], references: [id], onDelete: SetNull)
  approverId String?

  app   App?    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String?

  group   AppGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String?

  status String

  /// Binds the submitted AI Act assessment to this review (record-keeping).
  /// Always null for suite targets — a suite is gated on the aggregate of its
  /// member apps' assessments, which it does not own.
  aiActAssessmentId String?

  logs PublicationLog[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([appId])
  @@index([groupId])
  @@index([approverId])
  @@index([aiActAssessmentId])
}

model PublicationLog {
  id String @id

  request   PublicationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  message    String?
  visibility String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([requestId])
  @@index([authorId])
}

