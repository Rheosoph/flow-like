/// A curated, store-facing bundle of related apps presented as a single unit
/// (a "suite"). Branding (name/icon/banner/description) lives in Meta,
/// per-language, exactly like apps — no bespoke columns here. The group is
/// governed by its owner app's Owner/Admins.
model AppGroup {
  id String @id

  status     String @default("ACTIVE")
  visibility String @default("PRIVATE")

  meta Meta[]

  /// The app whose Owner/Admins may edit this group; also the default branding
  /// anchor when the group has no Meta of its own.
  ownerApp   App    @relation("ownedGroups", fields: [ownerAppId], references: [id], onDelete: Cascade)
  ownerAppId String

  members AppGroupMember[]

  /// Suites go through the same review pipeline as apps to reach a public
  /// visibility; see `PublicationRequest`.
  publicationRequests PublicationRequest[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([ownerAppId])
  @@index([visibility])
  @@index([createdAt])
}

/// Curated membership of an app in a group. Consent: adding an app the caller
/// owns/admins — or that already has an active AppConnection with the group's
/// apps — activates immediately; otherwise the row stays PENDING until the
/// member app's owner accepts. This is a presentation grant only and never
/// changes runtime data-access permissions.
model AppGroupMember {
  id String @id

  group   AppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  app   App    @relation("appGroupMemberships", fields: [appId], references: [id], onDelete: Cascade)
  appId String

  kind   String @default("MEMBER")
  status String @default("PENDING")

  /// Curated display order within the group.
  position Int @default(0)

  addedByUserId    String?
  approvedByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([groupId, appId])
  @@index([groupId, status])
  @@index([appId, status])
}

// ---- app.prisma
model App {
  id String @id

  status     String @default("ACTIVE")
  visibility String @default("PRIVATE")

  meta Meta[]

  templates Template[]
  widgets   Widget[]
  pages     Page[]
  queue     JoinQueue[]
  members   Membership[]
  comments  Comment[]
  changelog String?

  courseLinks   CourseAppLink[]
  inviteLinks   InviteLink[]
  invitations   Invitation[]
  notifications Notification[]

  feedback            Feedback[]
  publicationRequests PublicationRequest[]

  defaultRole   Role?   @relation("defaultForApp", fields: [defaultRoleId], references: [id])
  defaultRoleId String? @unique
  ownerRole     Role?   @relation("ownerForApp", fields: [ownerRoleId], references: [id])
  ownerRoleId   String? @unique
  roles         Role[]

  primaryCategory   String?
  secondaryCategory String?
  /// What kind of thing the app is, structurally. Orthogonal to the categories, which
  /// describe the topic. Null means the owner has not classified it yet.
  appType           String?

  ratingSum         BigInt @default(0)
  ratingCount       BigInt @default(0)
  downloadCount     BigInt @default(0)
  interactionsCount BigInt @default(0)

  avgRating      Float? @default(0)
  // Relevance formula: (downloads * 2 + interactions) * (1 + avgRating/5) * log(ratingCount + 1)
  relevanceScore Float? @default(0)

  totalSize BigInt @default(0)

  price   BigInt  @default(0)
  version String?

  /// Project owner opts in to the Fork-an-app feature. Apps default to
  /// false; without this flag the fork endpoints reject the request.
  allowForking Boolean   @default(false)
  /// Owner-defined fork policy: which asset categories a fork of this app
  /// copies, and how the project database is handled. NULL = platform
  /// default (copy everything), which preserves pre-#756 behavior for
  /// every existing row.
  forkPolicy   Json?
  /// For forked apps: the source app's id, kept as a free-form string so a
  /// fork survives even if the source app is later deleted.
  forkedFrom   String?
  /// For forked apps: when the fork happened.
  forkedAt     DateTime? @db.Timestamptz(3)

  technicalUsers TechnicalUser[]

  outgoingAppConnections AppConnection[]  @relation("outgoingAppConnections")
  incomingAppConnections AppConnection[]  @relation("incomingAppConnections")
  processNotes           AppProcessNote[]

  ownedGroups      AppGroup[]       @relation("ownedGroups")
  groupMemberships AppGroupMember[] @relation("appGroupMemberships")

  llmUsage       LLMUsageTracking[]
  usageLimits    AppUsageLimit[]
  executionUsage ExecutionUsageTracking[]
  executionRuns  ExecutionRun[]
  executionMode  String                   @default("ANY")

  syncs       BoardSync[]
  boardScores AppBoardScore[]
  bits        Json?           @default("[]")
  events      Event[]
  sinks       EventSink[]

  eventRemoteAuths         EventRemoteAuth[]
  eventRemoteRegistrations EventRemoteRegistration[]
  eventAliases             EventAlias[]
  eventSetups              EventSetup[]

  regressionSuites    RegressionSuite[]
  regressionSuiteRuns RegressionSuiteRun[]

  packages       AppPackage[]
  purchases      AppPurchase[]
  discounts      AppDiscount[]
  salesDaily     AppSalesDaily[]
  analyticsDaily AppAnalyticsDaily[]

  aiActAssessments       AiActAssessment[]
  aiActModelObservations AiActModelObservation[]

  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  embeddingUsageTrackings EmbeddingUsageTracking[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([avgRating])
  @@index([relevanceScore])
  @@index([ratingSum])
  @@index([status])
}

model AppUsageLimit {
