// ---- locking.prisma
/// Durable coordination rows for operations whose source of truth lives outside SQL.
///
/// Rows are intentionally unreferenced and retained. A holder claims a row as a lease
/// (`owner` + `expiresAt`) instead of holding a row lock, so the mutex works on optimistic
/// engines that never block; expiry covers crashed holders.
model MutationLock {
  id        BigInt    @id
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  owner     String?
  expiresAt DateTime? @db.Timestamptz(3)
}

