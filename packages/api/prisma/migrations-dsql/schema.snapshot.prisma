/// Persisted quality / governance scores for a single board, aggregated as the
/// MIN across that board's nodes per category (0-10, higher = better). App-level
/// scores are derived on read via aggregation over these rows.
model AppBoardScore {
  id String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  boardId String

  security    Int
  privacy     Int
  performance Int
  governance  Int
  reliability Int
  cost        Int

  /// Minimum across all six categories - single sortable "how bad" value.
  worstScore Int

  nodeCount       Int @default(0)
  scoredNodeCount Int @default(0)
  connectionCount Int @default(0)

  /// Nodes dragging scores down: [{ node, category, score, count? }]
  flaggedPatterns Json?

  /// Cached lightweight board summary metadata (name, stage, counts, ...) used
  /// to serve board summaries without reading every board from object storage.
  summary Json?

  computedAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([appId, boardId])
  @@index([appId])
  @@index([worstScore])
  @@index([governance])
  @@index([security])
}

/// Event model - mirrors the Event structure stored in bucket for fast lookups
/// The full Event data is kept in the bucket for versioning, this is the DB mirror
model Event {
  id String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  name        String
  description String?

  /// Event type: "chat", "api", "email", "quick_action", etc.
  eventType String

  /// Whether this event is active
  active Boolean @default(true)

  /// Priority for ordering events
  priority Int @default(0)

  /// Board this event triggers (mutually exclusive with pageId for A2UI events)
  boardId      String?
  /// Board version as semver string "major.minor.patch"
  boardVersion String?
  /// Node ID within the board
  nodeId       String?

  /// For A2UI events: default page to render
  pageId String?

  /// URL route path that maps to this event (e.g., "/", "/dashboard")
  route String?

  /// Whether this is the default event/route for the app
  isDefault Boolean @default(false)

  /// Event version as semver string "major.minor.patch"
  eventVersion String @default("0.0.0")

  /// Where this event runs: "Local" (offline/desktop) or "Remote" (server).
  /// Events never run Hybrid — they must be bound to one environment so their
  /// config (URLs, credentials, tutorials) is unambiguous.
  executionMode String @default("Local")

  /// Reachability: "PUBLIC" (public REST/MCP surface with its own auth) or
  /// "INTERNAL" (only callable by connected apps via the app-connection proxy).
  exposure String @default("PUBLIC")

  /// Variables for this event (JSON blob)
  variables Json?

  /// Event config (stored as base64 or JSON depending on content)
  config Json?

  /// Input pins metadata for quick access without loading board
  inputs Json?

  /// Release notes - can be plain text or URL
  notes Json?

  /// Canary configuration for A/B testing
  canary Json?

  /// Canary/shadow variant targets (JSON array of EventVariant). Empty set is
  /// stored as NULL; the legacy `canary` column is the fallback mirror.
  variants Json?

  /// Process-mining case-key mappings: business key name → dot-path into the
  /// invocation payload (e.g. {"order_id": "order.id"}). Extracted
  /// automatically on every run so cases group by business object without
  /// callers having to pass correlation explicitly.
  correlationMappings Json?

  sink EventSink?

  /// Status of the most recent remote setup run: "running", "ok", "error".
  /// Only meaningful for events whose underlying flow
  /// contains REST/MCP server nodes that are executed remotely.
  setupStatus String?

  /// Timestamp of the last setup run completion.
  lastSetupAt DateTime? @db.Timestamptz(3)

  /// Event version that was active during the last successful setup. Used to
  /// match `EventRemoteRegistration` rows when serving inbound requests.
  /// Remains the stable variant's serving pointer; the stable `EventSetup`
  /// row mirrors it.
  lastSetupVersion String?

  /// Last setup error message (truncated), populated only when setupStatus = "error".
  lastSetupError String?

  remoteAuths         EventRemoteAuth[]
  remoteRegistrations EventRemoteRegistration[]
  aliases             EventAlias[]
  setups              EventSetup[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([appId, route])
  @@index([appId])
  @@index([appId, active])
  @@index([appId, eventType])
  @@index([appId, isDefault])
  @@index([boardId])
  @@index([pageId])
}

/// Per-variant serving pointer for the inbound REST/MCP surface: which event
/// version (and board) a variant's traffic dispatches into. One row per
/// (event, variant); the "stable" row mirrors the legacy
/// Event.lastSetupVersion scalar, which keeps being written for back-compat.
model EventSetup {
  id String @id @default(cuid())

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  /// Variant name this row serves ("stable" or an EventVariant.name).
  variant String

  /// Event version whose registration rows serve this variant's traffic.
  eventVersion String

  /// Board the variant's setup run dispatched into.
  boardId      String
  /// Board version as semver string "major.minor.patch". NULL = floating latest.
  boardVersion String?

  /// Status of the most recent setup run for this variant: "running", "ok", "error".
  setupStatus String?

  /// Timestamp of the last setup run completion.
  lastSetupAt DateTime? @db.Timestamptz(3)

  /// Last setup error message (truncated), populated only when setupStatus = "error".
  lastSetupError String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([eventId, variant])
  @@index([appId, eventId])
}

/// Auth configuration captured per remote server node during setup.
/// Inbound requests look this up via EventRemoteRegistration.authId.
model EventRemoteAuth {
  id String @id @default(cuid())

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  /// Event version this auth config belongs to. Replaced atomically per setup.
  eventVersion String

  /// Variant this auth config serves ("stable" or an EventVariant.name).
  variant String @default("stable")

  /// node_id of the server node that emitted this config.
  nodeId String

  /// "rest" or "mcp".
  kind String

  /// Serialized RestAuthConfig / McpAuthConfig. Secret fields are stored as
  /// *_encrypted values using the sink token encryption key.
  configJson Json

  registrations EventRemoteRegistration[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([appId, eventId, eventVersion, variant])
  @@index([appId, eventId, eventVersion, variant, nodeId, kind])
  @@index([eventId])
}

/// Registration row written by the setup-collector for every route, file,
/// openapi spec, tool, resource, or prompt emitted by remote server nodes.
model EventRemoteRegistration {
  id String @id @default(cuid())

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  /// Event version this registration belongs to. The inbound dispatcher
  /// reads the rows matching the served variant's EventSetup.eventVersion
  /// (falling back to event.lastSetupVersion for stable).
  eventVersion String

  /// Variant this registration serves ("stable" or an EventVariant.name).
  /// Inbound dispatch resolves the serving variant first and only ever
  /// matches rows within one variant's bucket.
  variant String @default("stable")

  /// One of: "rest_fn", "rest_file", "rest_openapi", "rest_openapi_ui",
  /// "mcp_raw", "mcp_tool", "mcp_resource", "mcp_prompt".
  kind String

  /// HTTP method for rest_fn (uppercase, or "ANY"). NULL for everything else.
  method String?

  /// Route path for REST kinds. For mcp_resource this is the URI. For
  /// mcp_tool / mcp_prompt this is the tool/prompt name.
  path String

  /// Target node ID to dispatch into for function-like registrations
  /// (rest_fn, mcp_tool, mcp_prompt). NULL for file/openapi/resource rows
  /// that serve static content.
  nodeId String?

  /// JSON Schema for input validation / MCP advertising.
  schemaJson Json?

  /// Kind-specific extras (content_type, ui_path, mime_type, …).
  extrasJson Json?

  /// Optional auth row to apply.
  auth   EventRemoteAuth? @relation(fields: [authId], references: [id], onDelete: SetNull)
  authId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([appId, eventId, eventVersion, variant])
  @@index([appId, eventId, eventVersion, variant, kind])
  // Avoid a 63-character CockroachDB name collision with the index above.
  @@index([appId, eventId, eventVersion, variant, kind, method, path], map: "EventRemoteRegistration_route_lookup_idx")
  @@index([eventId])
  @@index([authId])
}

/// Vanity slug -> event mapping. Slug is the global URL key; uniqueness
/// is enforced by the PK. Router/common slugs and generated-id-length
/// slugs are hard-reserved; brand-sensitive slugs (see
/// `utils::event_alias::is_admin_reserved_slug`) require platform admin.
model EventAlias {
  /// URL-safe slug, e.g. "checkout" or "twilio-inbound".
  /// Regex: [a-z0-9-]{3,64}. Reserved: api, r, m, health, metrics,
  /// generated id lengths, swagger, api-doc, openapi, docs, __, etc.
  slug String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  createdBy String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([appId, eventId])
  @@index([appId])
  @@index([eventId])
}

/// Event Sink Registration - tracks which events have active server-side sinks
/// Most config comes from the Event itself via join - we only store sink-specific data
model EventSink {
  id String @id @default(cuid())

  /// The event this sink is for - unique 1:1 mapping
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// App the event belongs to (for permission checks and lookups)
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  /// Sink type: "http", "cron", "discord", "telegram", etc. (from event.eventType)
  sinkType String

  /// Is the sink currently active on the server?
  active Boolean @default(true)

  /// For HTTP sinks: the unique path to listen on
  path String?

  /// For HTTP sinks: the accepted HTTP method (GET/POST/PUT/PATCH/DELETE).
  /// Different methods on the same path are treated as distinct sinks so
  /// `POST /foo` and `GET /foo` can route to different events.
  method String?

  /// Auth token for securing HTTP endpoints (optional, auto-generated if not provided)
  authToken String?

  /// Secret for webhook verification (Telegram)
  webhookSecret String?

  /// For cron sinks: the cron expression (e.g., "0 * * * *")
  cronExpression String?

  /// For cron sinks: timezone (default UTC)
  cronTimezone String?

  /// Encrypted Personal Access Token for execution (optional - allows model/file access)
  patEncrypted String?

  /// Encrypted OAuth tokens JSON (optional - for provider-specific access like Google, GitHub, etc.)
  oauthTokensEncrypted String?

  /// Snapshot of the last updater's profile JSON (bits, hubs) for trigger execution
  profileJson Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([appId, path, method])
  @@index([appId])
  @@index([active])
  @@index([sinkType])
  @@index([sinkType, active])
}

/// Service Sink Token - JWT tokens issued to internal services for triggering sinks
/// Each token is scoped to a specific sink type and can be individually revoked
model SinkToken {
  /// JWT ID (jti claim) - unique identifier for the token
  id String @id

  /// The sink type this token is authorized to trigger (e.g., "cron", "discord", "telegram")
  sinkType String

  /// Human-readable name/description for the token
  name String?

  /// Whether this token has been revoked
  revoked Boolean @default(false)

  /// When the token was revoked (if applicable)
  revokedAt DateTime? @db.Timestamptz(3)

  /// Who/what revoked the token
  revokedBy String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([sinkType])
  @@index([revoked])
  @@index([sinkType, revoked])
}

// ================== Sales & Purchases ==================

/// Tracks individual app purchases
model AppPurchase {
  id String @id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  /// Price paid in cents at time of purchase
  pricePaid      BigInt
  /// Original price before discount (in cents)
  originalPrice  BigInt
  /// Discount amount in cents (0 if none)
  discountAmount BigInt @default(0)

  discount   AppDiscount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountId String?

  /// Currency code (e.g., "EUR", "USD")
  currency String @default("EUR")

  /// Stripe checkout session ID for this purchase
  stripeSessionId       String
  /// Stripe payment intent ID
  stripePaymentIntentId String?

  status String @default("PENDING")

  /// When purchase was completed
  completedAt  DateTime? @db.Timestamptz(3)
  /// When refunded (if applicable)
  refundedAt   DateTime? @db.Timestamptz(3)
  /// Refund reason if refunded
  refundReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([appId])
  @@index([appId, status])
  @@index([appId, completedAt])
  @@index([stripeSessionId])
  @@index([discountId])
}

/// Discount codes for apps
model AppDiscount {
  id String @id

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  /// Discount code (e.g., "LAUNCH20")
  code        String
  /// Human-readable name for the discount
  name        String
  /// Description of the discount
  description String?

  discountType  String
  /// Discount value (percentage 0-100 or fixed amount in cents)
  discountValue BigInt

  /// Maximum number of uses (null = unlimited)
  maxUses           BigInt?
  /// Current number of times used
  usedCount         BigInt  @default(0)
  /// Minimum purchase amount required (in cents, null = no minimum)
  minPurchaseAmount BigInt?

  /// When the discount becomes active
  startsAt  DateTime  @default(now()) @db.Timestamptz(3)
  /// When the discount expires (null = never)
  expiresAt DateTime? @db.Timestamptz(3)
  /// Whether the discount is currently active
  isActive  Boolean   @default(true)

  purchases AppPurchase[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([appId, code])
  @@index([appId])
  @@index([appId, isActive])
  @@index([code])
}

