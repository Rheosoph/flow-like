=\"0\" bgcolor=\"#f3f3f7\" style=\"width:100%;background-color:#f3f3f7;\">\n<tr><td align=\"center\" style=\"padding:32px 12px 40px 12px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->\n<table role=\"presentation\" class=\"fl-shell\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;\">\n<tr><td style=\"padding:0 4px 18px 4px;\"><span class=\"fl-ink\" style=\"font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:17px;line-height:24px;font-weight:700;letter-spacing:-0.2px;color:#16161d;\"><span style=\"color:#6366f1;\">&#10022;</span>&nbsp;Flow-Like</span></td></tr>\n<tr><td class=\"fl-card\" bgcolor=\"#ffffff\" style=\"background-color:#ffffff;border:1px solid #e4e4ea;border-radius:16px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;\">\n<tr><td height=\"4\" bgcolor=\"#6366f1\" style=\"height:4px;line-height:4px;font-size:4px;background-color:#6366f1;background-image:linear-gradient(90deg,#3b82f6,#8b5cf6,#ec4899);border-radius:16px 16px 0 0;\">&nbsp;</td></tr>\n<tr><td class=\"fl-pad\" style=\"padding:36px 40px 24px 40px;\"><p class=\"fl-link\" style=\"margin:0 0 6px 0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:12px;line-height:16px;font-weight:600;letter-spacing:0.6px;text-transform:uppercase;color:#4f46e5;\">Welcome</p><h1 class=\"fl-ink fl-title\" style=\"margin:0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:26px;line-height:32px;font-weight:700;letter-spacing:-0.4px;color:#16161d;\">Your Flow-Like account is ready</h1><p class=\"fl-muted\" style=\"margin:8px 0 0 0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;line-height:24px;font-weight:400;color:#5c5c68;\">Sign in with these details, then choose your own password.</p></td></tr><tr><td class=\"fl-pad\" style=\"padding:0px 40px 20px 40px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;\"><tr><td class=\"fl-panel fl-rule\" bgcolor=\"#f7f7fa\" style=\"background-color:#f7f7fa;border:1px solid #e9e9f0;border-radius:10px;padding:16px 18px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;\"><tr><td colspan=\"2\" style=\"padding:0 0 4px 0;\"><p class=\"fl-subtle\" style=\"margin:0 0 6px 0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:12px;line-height:16px;font-weight:600;letter-spacing:0.6px;text-transform:uppercase;color:#7c7c8a;\">Sign-in details</p></td></tr><tr><td class=\"fl-label fl-muted fl-rule\" valign=\"top\" style=\"padding:8px 12px 8px 0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:20px;font-weight:400;color:#5c5c68;\">Username</td><td class=\"fl-value fl-ink fl-rule\" align=\"right\" valign=\"top\" style=\"padding:8px 0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:20px;font-weight:600;color:#16161d;text-align:right;word-break:break-word;\"><span class=\"fl-code\" style=\"display:inline-block;padding:2px 8px;border-radius:6px;background-color:#eef0ff;color:#312e81;font-family:'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', monospace;font-size:13px;line-height:20px;\">{username}</span></td></tr><tr><td class=\"fl-label fl-muted fl-rule\" valign=\"top\" style=\"padding:8px 12px 8px 0;border-top:1px solid #e9e9f0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:20px;font-weight:400;color:#5c5c68;\">