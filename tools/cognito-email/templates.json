 100% !important; }\n  .fl-action { display: block !important; width: 100% !important; }\n  .fl-action-gap { display: block !important; width: 100% !important; height: 10px !important; }\n  .fl-btn, .fl-btn td { width: 100% !important; }\n  .fl-btn a { display: block !important; }\n}\n</style>\n<style>\n[data-ogsb] .fl-fill { background-color: #FB562D !important; background-image: linear-gradient(100deg,#FB562D 0%,#F6472C 100%) !important; }\n@media print {\n  body, table, td, div, p, h1, span, a, strong { color: #111111 !important; background: #FFFFFF !important; border-color: #DDDDDD !important; box-shadow: none !important; }\n}\n</style>\n</head>\n<body style=\"margin:0;padding:0;width:100%;background-color:#0C0E13;\">\n<div style=\"display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:#0C0E13;\">Use this code to continue on Flow-Like.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0C0E13\" style=\"width:100%;background-color:#0C0E13;\">\n<tr><td class=\"fl-outer\" align=\"center\" style=\"padding:16px 12px 40px 12px;background-color:#0C0E13;background-image:radial-gradient(ellipse 80% 60% at 30% 0%, rgba(246,71,44,0.32) 0%, rgba(246,71,44,0.11) 45%, rgba(12,14,19,0) 100%);\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;\">\n<tr><td class=\"fl-pad\" style=\"padding:24px 32px 0px 32px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td valign=\"middle\" width=\"28\" style=\"width:28px;\"><img src=\"https://flow-like.com/android-chrome-192x192.png\" width=\"28\" height=\"28\" alt=\"\" style=\"display:block;width:28px;height:28px;border:0;outline:none;text-decoration:none;\"></td><td valign=\"middle\" style=\"padding-left:10px;font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:18px;line-height:28px;font-weight:600;letter-spacing:-0.3px;color:#F3EFEC;\">Flow Like</td></tr></table></td></tr>\n<tr><td class=\"fl-pad\" style=\"padding:44px 32px 32px 32px;\"><p style=\"margin:0 0 22px 0;font-family:'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;font-size:11px;line-height:16px;font-weight:500;letter-spacing:1.8px;text-transform:uppercase;color:#F6472C;\"><span style=\"display:inline-block;width:6px;height:6px;border-radius:3px;background-color:#F6472C;box-shadow:0 0 12px rgba(246,71,44,0.75);vertical-align:middle;margin:-2px 10px 0 0;font-size:0;line-height:0;\">&nbsp;</span>Verification</p><h1 class=\"fl-title\" style=\"margin:0;font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:40px;line-height:43px;font-weight:700;letter-spacing:-1.8px;color:#F3EFEC;text-wrap:balance;\">Your Flow-Like code</h1><p class=\"fl-lead\" style=\"margin:18px 0 0 0;font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:17px;line-height:27px;font-weight:400;color:#999EA8;\">Enter this code in Flow-Like to continue.</p></td></tr><tr><td class=\"fl-pad\" style=\"padding:0px 32px 28px 32px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;\"><tr><td bgcolor=\"#13161B\" style=\"background-color:#13161B;border:1px solid #4A231D;border-radius:14px;box-shadow:0 24px 64px -28px rgba(251,86,45,0.45);\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;\"><tr><td style=\"padding:28px 16px 28px 24px;\"><p class=\"fl-code-text\" style=\"margin:0;font-family:'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;font-size:36px;line-height:44px;font-weight:600;letter-spacing:10px;color:#F3EFEC;text-align:center;\">{####}</p></td></tr></table></td></tr></table></td></tr><tr><td class=\"fl-pad\" style=\"padding:0 32px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;\"><tr><td style=\"border-top:1px solid #282C33;font-size:0;line-height:0;height:20px;\">&nbsp;</td></tr></table></td></tr><tr><td class=\"fl-pad\" style=\"padding:0px 32px 10px 32px;\"><p style=\"margin:0;font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:13px;line-height:20px;font-weight:400;color:#999EA8;\">It confirms this email address, or lets you choose a new password, and works only for a short time.</p></td></tr><tr><td class=\"fl-pad\" style=\"padding:0px 32px 10px 32px;\"><p style=\"margin:0;font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:13px;line-height:20px;font-weight:400;color:#999EA8;\">Didn’t ask for a code? You can ignore this email: nothing changes without it.</p></td></tr>\n<tr><td class=\"fl-pad\" style=\"padding:28px 32px 0 32px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;\"><tr><td style=\"border-top:1px solid #20232A;padding-top:24px;\"><p style=\"margin:0 0 6px 0;font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:12px;line-height:19px;font-weight:400;color:#80858F;\">You’re receiving this because this address was entered on Flow-Like.</p><p style=\"margin:0 0 6px 0;font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:12px;line-height:19px;font-weight:400;color:#80858F;\">Questions? Write to <a href=\"mailto:info@flow-like.com\" style=\"color:#FF7350;text-decoration:underline;\">info@flow-like.com</a></p><p style=\"margin:0 0 6px 0;font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:12px;line-height:19px;font-weight:400;color:#80858F;\"><a href=\"https://flow-like.com/privacy-policy\" target=\"_blank\" rel=\"noopener\" style=\"color:#999EA8;text-decoration:underline;\">Privacy policy</a> &nbsp;&middot;&nbsp; <a href=\"https://flow-like.com/legal-notice\" target=\"_blank\" rel=\"noopener\" style=\"color:#999EA8;text-decoration:underline;\">Legal notice</a></p><p style=\"margin:0;font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:12px;line-height:19px;font-weight:400;color:#80858F;\">&copy; Flow-Like by Rheosoph GmbH</p></td></tr></table></td></tr>\n</table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr>\n</table>\n</body>\n</html>"
