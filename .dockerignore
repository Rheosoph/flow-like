# Git
.git/
.gitignore

# Build artifacts
target/
**/target/

# Node.js
node_modules/
**/node_modules/

# Next.js
.next/
**/.next/

# Environment and secrets
.env
.env.*
**/.env
**/.env.*
*.local
**/*.local
*.pem
**/*.pem
api.config.json
**/api.config.json
# Deployment-specific Azure config enters builds only as a BuildKit secret,
# never via the context. The tracked flow-like.config.json public default must
# stay in the context - builds read it.
flow-like.azure.config.json
**/flow-like.azure.config.json
.cargo/config
**/.cargo/config
# Keep per-example Cargo overrides out of backend build contexts, while
# allowing the reviewed repository-wide configuration added below.
**/.cargo/config.toml
!.cargo/config.toml
**/values-secrets.yaml
**/values-secret*.yaml
**/values-secrets.yml
**/values-secret*.yml
.claude/settings.local.json
**/.claude/settings.local.json
.claude/CLAUDE.local.md
**/.claude/CLAUDE.local.md

# Large files and caches
*.log
tmp/
apps/desktop/dist/
apps/desktop/out/
apps/desktop/.tauri/
apps/web-app/dist/
apps/website/dist/
apps/docs/dist/
apps/embedded/dist/
thirdparty/
tests/data/
assets/

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Managed live-deployment exclusions
api.config.json
**/api.config.json
*.pem
**/*.pem
**/values-secrets.yml
**/values-secret*.yml

# Compose deployment credentials may use a non-dot filename.
**/*.env
**/real.env
secrets/**
**/.secrets/**
apps/backend/**/secrets/**
**/__pycache__/**
**/*.pyc
.codex/
.agents/
.local-notes/

# Kubernetes generated Secrets must never enter application image contexts.
apps/backend/kubernetes/.generated/**
