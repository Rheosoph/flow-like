# Git
.git/
**/.git
.gitignore

# Build artifacts
target/
**/target/

# Node.js
node_modules/
**/node_modules/

# Next.js
.next/
**/.next/

# Environment and secrets
.env
.env.*
**/.env
**/.env.*
# Credentials from developer tooling must not enter COPY . . or build caches.
**/.git-credentials
**/.netrc
**/.npmrc
**/.cargo/credentials
**/.cargo/credentials.toml
**/.aws/**
**/.azure/**
**/.config/gcloud/**
**/.ssh/**
**/.kube/**
**/*.key
**/*.p12
**/*.pfx
**/*.tfstate
**/*.tfstate.*
*.local
**/*.local
*.pem
**/*.pem
api.config.json
**/api.config.json
# Deployment-specific cloud configs enter builds only as BuildKit secrets,
# never via the context. The tracked flow-like.config.json public default must
# stay in the context - builds read it.
flow-like.azure.config.json
**/flow-like.azure.config.json
flow-like.gcp.config.json
**/flow-like.gcp.config.json
.cargo/config
**/.cargo/config
# Keep per-example Cargo overrides out of backend build contexts, while
# allowing the reviewed repository-wide configuration added below.
**/.cargo/config.toml
!.cargo/config.toml
**/values-secrets.yaml
**/values-secret*.yaml
**/values-secrets.yml
**/values-secret*.yml
.claude/settings.local.json
**/.claude/settings.local.json
.claude/CLAUDE.local.md
**/.claude/CLAUDE.local.md

# Large files and caches
*.log
tmp/
apps/desktop/dist/
apps/desktop/out/
apps/desktop/.tauri/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/binaries/linux/x64/libggml-vulkan.so*
apps/desktop/src-tauri/binaries/win/x64/ggml-vulkan.dll
apps/web-app/dist/
apps/website/dist/
apps/docs/dist/
apps/embedded/dist/
thirdparty/
tests/data/
# Rust embeds the MCP browser inspector when building the API and web catalog.
assets/*
!assets/mcp-inspector.html

# Local build outputs are also excluded when AWS builds use this repository.
**/*.tsbuildinfo
**/.gradle/
**/.build/
**/_build/
**/build/
.codacy/

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Managed live-deployment exclusions
api.config.json
**/api.config.json
*.pem
**/*.pem
**/values-secrets.yml
**/values-secret*.yml

# Compose deployment credentials may use a non-dot filename.
**/*.env
**/real.env
secrets/**
**/.secrets/**
apps/backend/**/secrets/**
**/__pycache__/**
**/*.pyc
.codex/
.agents/
.local-notes/

# Kubernetes generated Secrets must never enter application image contexts.
apps/backend/kubernetes/.generated/**
