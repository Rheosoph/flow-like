		"wrangler": "4.90.0"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "1.30.1"
	},
	"patchedDependencies": {
		"@astrojs/starlight@0.41.7": "patches/@astrojs%2Fstarlight@0.41.7.patch",
		"next-themes@0.4.6": "patches/next-themes@0.4.6.patch",
		"indexeddbshim@17.0.0": "patches/indexeddbshim@17.0.0.patch"
	}
