{
	"name": "flow-like",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"docs:screenshot": "bun apps/desktop/scripts/doc-screenshot.ts",
		"workflow:screenshot": "bun apps/desktop/scripts/workflow-screenshot.ts",
		"docs:nodes": "cargo run --locked -p flow-like-catalog --no-default-features --features all-metadata --bin generate_node_docs",
		"flowpilot:e2e": "bun apps/desktop/scripts/flowpilot-e2e.ts",
		"university": "bun apps/desktop/scripts/university.ts",
		"university:check": "bun apps/desktop/scripts/university-check.ts",
		"icons:lint": "bun scripts/sync-node-icons.ts --check",
		"icons:sync": "bun scripts/sync-node-icons.ts",
		"test:e2e:package-security": "bun test tests/package-manager-security.e2e.test.ts",
		"build:device-crypto": "node packages/device-crypto/build-web.mjs",
		"build:board-canvas": "node packages/board-canvas/build-web.mjs",
		"preview:board:build": "node packages/board-canvas/build-web.mjs --dev && vite build --config tests/board-canvas-browser/vite.config.ts",
		"preview:board": "vite preview --config tests/board-canvas-browser/vite.config.ts",
		"test:board-canvas:browser": "node tests/board-canvas-browser/verify.mjs",
		"test:board-canvas:presentation": "node tests/board-canvas-browser/verify-presentation.mjs",
		"bench:board-canvas": "node tests/board-canvas-browser/measure.mjs",
		"preview:board:parity": "next dev tests/board-parity-browser --hostname 127.0.0.1 --port 4339",
		"test:board-parity:browser": "node tests/board-parity-browser/verify.mjs",
		"test:board-parity:large": "node tests/board-parity-browser/verify-large.mjs",
		"test:board-host:browser": "node tests/board-parity-browser/verify-host.mjs",
		"test:board-host:actions": "node tests/board-parity-browser/verify-host-actions.mjs",
		"test:board-host:drop": "node tests/board-parity-browser/verify-drop-ghosts.mjs",
		"bench:board:build": "node tests/board-render-browser/build-wasm.mjs && vite build --config tests/board-render-browser/vite.config.ts",
		"bench:board:serve": "vite preview --config tests/board-render-browser/vite.config.ts",
		"bench:board": "node tests/board-render-browser/run.mjs",
		"build:craft-viewers": "node packages/craft-viewers/build-web.mjs",
		"test:craft-browser": "bun tests/craft-browser/verify.ts && bun tests/craft-office-browser/verify.ts && bun tests/craft-media-browser/verify.ts && bun tests/craft-solid-browser/verify.ts && node --test packages/craft-viewers/deckcraft/browser-media.test.mjs && bun tests/craft-image-browser/verify.ts && bun tests/craft-mcp-browser/verify.ts && bun tests/craft-create-browser/verify.ts && CRAFT_NESTED_PREVIEW=1 bun tests/craft-create-browser/verify.ts solidcraft wordcraft && bun tests/a2ui-file-editor-browser/verify.ts",
		"test:craft-viewers": "node --test packages/craft-viewers/mcp.test.mjs packages/craft-viewers/host.test.mjs packages/craft-viewers/deckcraft-thumbnail.test.mjs packages/craft-viewers/build-lock.test.mjs packages/craft-viewers/build-pool.test.mjs packages/craft-viewers/build-tools.test.mjs packages/craft-viewers/licenses.test.mjs packages/craft-viewers/codec-policy.test.mjs packages/craft-viewers/soundcraft/audio.test.mjs packages/craft-viewers/filmcraft/browser-codecs.test.mjs && vitest run packages/ui/components/storage/craft-mcp-session.test.ts packages/ui/components/storage/craft-document.dom.test.tsx packages/ui/components/storage/craft-viewers.test.ts packages/ui/components/storage/viewer-about.dom.test.tsx packages/ui/components/storage/storage-system.dom.test.tsx packages/ui/components/ui/file-previewer.dom.test.tsx --environment happy-dom --maxWorkers 1",
		"build:wordcraft": "node packages/wordcraft/build-web.mjs",
		"test:wordcraft": "node --test packages/wordcraft/host.test.mjs && vitest run packages/ui/components/storage/storage-system.dom.test.tsx packages/ui/components/storage/storage-docx-history.dom.test.tsx packages/ui/components/storage/wordcraft-document.dom.test.tsx packages/ui/components/storage/wordcraft-protocol.test.ts --environment happy-dom --maxWorkers 1 && vitest run apps/desktop/components/tauri-provider/__tests__/storage-state.test.ts --maxWorkers 1 && bun tests/wordcraft-browser/verify.ts"
	},
	"workspaces": [
		"packages/*",
		"packages/dexie-tauri-adapter/*",
		"apps/*",
		"libs/*/*",
		"examples/*/widgets/*"
	],
