		"hono": "4.13.11",
		"http-cache-semantics": "4.3.0",
		"ip-address": "10.7.4",
		"js-cookie": "3.0.8",
		"js-video-url-parser": "workspace:*",
		"js-yaml": "4.3.2",
		"langsmith": "0.6.3",
		"lodash": "4.18.1",
		"lodash-es": "4.18.1",
		"mdast-util-to-hast": "13.2.1",
		"mysql2": "3.23.1",
		"next": "16.4.3",
		"path-to-regexp": "8.4.2",
		"picomatch": "4.0.4",
		"postcss": "8.5.26",
		"postcss-selector-parser": "6.1.5",
		"preact": "10.29.1",
		"protobufjs": "7.5.8",
		"protocol-buffers-schema": "3.6.1",
		"proxy-addr": "2.0.8",
