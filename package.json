		"rollup": "4.60.3",
		"serialize-javascript": "7.1.3",
		"sharp": "0.35.5",
		"shell-quote": "1.11.0",
		"smol-toml": "1.9.0",
		"source-map-js": "1.2.2",
		"svgo": "4.1.0",
		"undici": "7.30.1",
		"uuid": "11.1.1",
		"valibot": "1.5.0",
		"validator": "13.15.35",
		"vitest": "4.1.12",
		"webpack": "5.106.2",
		"ws": "8.21.3",
		"yaml": "2.9.0"
	},
	"trustedDependencies": [
		"esbuild",
