---
const href = Astro.props.siteTitleHref ?? "/";
---

<a href={href} class="site-title">
	<img src="/icon.webp" alt="Flow Like logo" width="40" height="40" />
	<span class="brand-text">Flow Like</span>
	<span class="docs-pill">Docs</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.site-title:hover {
		color: var(--sl-color-accent-high);
	}

	img {
		width: 2rem;
		height: 2rem;
		object-fit: contain;
		border-radius: 8px;
		box-shadow: 0 8px 24px color-mix(in oklab, var(--sl-color-accent) 22%, transparent);
	}

	.brand-text {
		font-size: 1rem;
		letter-spacing: 0;
	}

	.docs-pill {
		display: inline-flex;
		align-items: center;
		height: 1.35rem;
		padding: 0 0.45rem;
		border: 1px solid color-mix(in oklab, var(--sl-color-gray-5) 75%, transparent);
		border-radius: 999px;
		background: color-mix(in oklab, var(--sl-color-gray-6) 45%, transparent);
		color: var(--sl-color-gray-2);
		font-size: 0.72rem;
		font-weight: 650;
	}

	@media (max-width: 480px) {
		.docs-pill {
			display: none;
		}
	}
</style>
