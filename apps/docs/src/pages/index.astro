---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const primaryLinks = [
	{
		href: "/start/getting-started/",
		label: "Start guide",
		icon: "/flow/icons/play.svg",
	},
	{
		href: "/nodes/overview/",
		label: "Node catalog",
		icon: "/flow/icons/workflow.svg",
	},
	{
		href: "https://flow-like.com/download",
		label: "Download Studio",
		icon: "/flow/icons/cloud.svg",
		external: true,
	},
];

const tracks = [
	{
		href: "/start/getting-started/",
		kicker: "01",
		title: "Get oriented",
		desc: "Install Flow-Like, understand boards and flows, and get a first working automation running.",
		icon: "/flow/icons/route.svg",
	},
	{
		href: "/studio/overview/",
		kicker: "02",
		title: "Build visually",
		desc: "Work with the editor, nodes, layers, variables, local execution, logs, and FlowPilot.",
		icon: "/flow/icons/shape.svg",
	},
	{
		href: "/dev/wasm-nodes/overview/",
		kicker: "03",
		title: "Extend the engine",
		desc: "Write custom nodes, ship WASM packages, use SDKs, and wire new sinks into the system.",
		icon: "/flow/icons/box.svg",
	},
	{
		href: "/self-hosting/overview/",
		kicker: "04",
		title: "Run it yourself",
		desc: "Deploy with Docker Compose or Kubernetes, configure storage, and operate execution backends.",
		icon: "/flow/icons/shield.svg",
	},
];

const references = [
	{ href: "/nodes/overview/", label: "Generated node catalog", icon: "/flow/icons/workflow.svg" },
	{ href: "/topics/genai/overview/", label: "GenAI workflows", icon: "/flow/icons/bot-plan.svg" },
	{ href: "/topics/data-pipelines/overview/", label: "Data pipelines", icon: "/flow/icons/database.svg" },
	{ href: "/topics/api-integrations/overview/", label: "API integrations", icon: "/flow/icons/web.svg" },
	{ href: "/reference/a2ui-components/", label: "A2UI components", icon: "/flow/icons/palette.svg" },
	{ href: "/reference/security/", label: "Security reference", icon: "/flow/icons/lock.svg" },
];

const routeStrip = [
	{ href: "/studio/overview/", label: "Studio", detail: "Editor, nodes, logs" },
	{ href: "/apps/overview/", label: "Apps", detail: "Pages, widgets, routes" },
	{ href: "/dev/wasm-nodes/overview/", label: "WASM", detail: "Custom node runtime" },
	{ href: "/self-hosting/overview/", label: "Deploy", detail: "Docker and Kubernetes" },
];

const footerLinks = [
	{ href: "https://flow-like.com", label: "Website" },
	{ href: "https://flow-like.com/eula", label: "EULA" },
	{ href: "https://flow-like.com/privacy-policy", label: "Privacy" },
	{ href: "https://flow-like.com/data-deletion", label: "Data deletion" },
	{ href: "https://great-co.de/legal-notice", label: "Imprint" },
];
---

<StarlightPage
	frontmatter={{
		title: "Flow-Like Docs: Open Source Workflow Engine Documentation",
		template: "splash",
		description:
			"Documentation for Flow-Like, the open source local-first workflow engine for type-safe, self-hosted automation.",
	}}
>
	<div class="docs-home-v3 not-content">
		<header class="docs-hero">
			<canvas id="docs-web-shader" class="hero-shader" aria-hidden="true"></canvas>
			<div class="hero-fallback" aria-hidden="true"></div>
			<div class="hero-grid" aria-hidden="true"></div>

			<div class="hero-copy">
				<a class="hero-badge" href="/start/getting-started/">
					<span class="hero-badge-dot"></span>
					Flow-Like Docs
					<svg viewBox="0 0 12 12" aria-hidden="true">
						<path d="M4.5 2.5 8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
				<img class="hero-logo" src="/icon.webp" alt="Flow Like" width="76" height="76" />
				<h1 class="hero-title">Docs that move like the canvas.</h1>
				<p class="hero-subtitle">
					Trace concepts into nodes, app surfaces, and self-hosting routes through a map that mirrors how Flow-Like is built.
				</p>
				<nav class="hero-actions" aria-label="Primary documentation links">
					{primaryLinks.map((link) => (
						<a
							href={link.href}
							class:list={["hero-action", link.external && "hero-action-muted"]}
							target={link.external ? "_blank" : undefined}
							rel={link.external ? "noopener" : undefined}
						>
							<span class="icon-tile" aria-hidden="true">
								<img src={link.icon} alt="" loading="lazy" />
							</span>
							<span>{link.label}</span>
							{link.external && (
								<svg class="external-icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
									<path fill="currentColor" d="M14 3h7v7h-2V6.41l-9.3 9.3-1.4-1.41L17.59 5H14V3ZM5 5h5v2H7v10h10v-3h2v5H5V5Z" />
								</svg>
							)}
						</a>
					))}
				</nav>
			</div>

			<nav class="route-strip" aria-label="Popular documentation routes">
				{routeStrip.map((item) => (
					<a href={item.href}>
						<strong>{item.label}</strong>
						<span>{item.detail}</span>
					</a>
				))}
			</nav>
		</header>

		<main>
			<section class="track-section" aria-labelledby="tracks-title">
				<div class="section-copy">
					<p>Docs paths</p>
					<h2 id="tracks-title">The shortest route to the thing you are changing.</h2>
				</div>
				<div class="track-grid">
					{tracks.map((track) => (
						<a href={track.href} class="track-card">
							<span class="track-number">{track.kicker}</span>
							<span class="track-icon" aria-hidden="true">
								<img src={track.icon} alt="" loading="lazy" />
							</span>
							<strong>{track.title}</strong>
							<span>{track.desc}</span>
						</a>
					))}
				</div>
			</section>

			<section class="reference-section" aria-labelledby="reference-title">
				<div class="section-copy">
					<p>Reference shelf</p>
					<h2 id="reference-title">High-frequency docs stay close to the top.</h2>
					<span>
						Generated pages and implementation references are grouped for repeat visits, so the homepage stays useful after the first read.
					</span>
				</div>
				<nav class="reference-grid" aria-label="Reference links">
					{references.map((item) => (
						<a href={item.href} class="reference-link">
							<span class="icon-tile" aria-hidden="true">
								<img src={item.icon} alt="" loading="lazy" />
							</span>
							<span>{item.label}</span>
						</a>
					))}
				</nav>
			</section>
		</main>

		<footer class="docs-footer">
			<div>
				<strong>Flow Like</strong>
				<span>Open source workflow engine documentation.</span>
			</div>
			<nav aria-label="Website and legal links">
				{footerLinks.map((link) => (
					<a href={link.href} target="_blank" rel="noopener">{link.label}</a>
				))}
			</nav>
		</footer>
	</div>
</StarlightPage>

<style>
	:global(html:has(.docs-home-v3)) {
		--sl-content-width: 100%;
		background: oklch(0.164 0.0111 268.0057);
	}

	:global(html:has(.docs-home-v3) .content-panel) {
		border: 0;
		padding: 0;
	}

	:global(html:has(.docs-home-v3) body),
	:global(html:has(.docs-home-v3) .page),
	:global(html:has(.docs-home-v3) .main-frame),
	:global(html:has(.docs-home-v3) .main-pane),
	:global(html:has(.docs-home-v3) .main-pane > main),
	:global(html:has(.docs-home-v3) .content-panel:has(.docs-home-v3)) {
		background: oklch(0.164 0.0111 268.0057);
	}

	:global(html:has(.docs-home-v3) .content-panel:has(.docs-home-v3) > .sl-container) {
		max-width: none;
		padding: 0;
	}

	:global(html:has(.docs-home-v3) .sl-markdown-content:has(.docs-home-v3) + footer),
	:global(html:has(.docs-home-v3) .content-panel:has(.docs-home-v3) > .sl-container > footer:not(.docs-footer)) {
		display: none;
	}

	:global(html:has(.docs-home-v3) .main-pane > main) {
		padding-bottom: 0;
	}

	:global(html:has(.docs-home-v3) .sl-markdown-content:has(.docs-home-v3)) {
		margin: 0;
	}

	:global(html:has(.docs-home-v3) h1#_top),
	:global(.sl-markdown-content > h1:not(.hero-title)) {
		display: none !important;
	}

	.docs-home-v3 {
		--sl-color-white: oklch(0.9544 0.0059 59.6503);
		--sl-color-gray-1: oklch(0.9247 0.0077 61.447);
		--sl-color-gray-2: oklch(0.82 0.012 264.467);
		--sl-color-gray-3: oklch(0.6984 0.0157 264.467);
		--sl-color-gray-4: oklch(0.52 0.015 264.467);
		--sl-color-gray-5: oklch(0.2921 0.014 261.7008);
		--sl-color-gray-6: oklch(0.1993 0.0111 260.661);
		--sl-color-black: oklch(0.164 0.0111 268.0057);
		--sl-color-accent-high: color-mix(in oklab, var(--sl-color-accent) 76%, white 24%);
		--sl-color-accent-low: color-mix(in oklab, var(--sl-color-black) 88%, var(--sl-color-accent) 12%);
		--hero-bg: oklch(0.164 0.0111 268.0057);
		--hero-panel: oklch(0.1993 0.0111 260.661);
		--hero-text: oklch(0.9544 0.0059 59.6503);
		--hero-muted: oklch(0.78 0.014 264.467);
		--hero-soft: oklch(0.62 0.014 264.467);
		--hero-line: color-mix(in oklab, var(--hero-text) 10%, transparent);
		--hero-line-strong: color-mix(in oklab, var(--hero-text) 16%, transparent);
		width: 100%;
		max-width: 100%;
		overflow: hidden;
		background: var(--hero-bg);
		color: var(--hero-text);
	}

	.docs-hero {
		position: relative;
		display: grid;
		align-content: center;
		gap: clamp(1.25rem, 2.6vw, 2.1rem);
		min-height: calc(100svh - var(--sl-nav-height));
		padding: clamp(2.4rem, 4.8vw, 4.2rem) clamp(1rem, 5vw, 4rem) clamp(1.6rem, 3vw, 2.4rem);
		overflow: hidden;
		border-bottom: 1px solid var(--hero-line);
		isolation: isolate;
	}

	.hero-shader,
	.hero-fallback,
	.hero-grid {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.hero-shader {
		z-index: -4;
		width: 100%;
		height: 100%;
		opacity: 0.96;
	}

	.hero-fallback {
		z-index: -5;
		background:
			radial-gradient(44rem 28rem at 50% 14%, color-mix(in oklab, var(--sl-color-accent) 20%, transparent), transparent 72%),
			radial-gradient(32rem 24rem at 12% 72%, color-mix(in oklab, var(--flx-emerald) 12%, transparent), transparent 72%),
			linear-gradient(180deg, var(--hero-bg), color-mix(in oklab, var(--hero-bg) 88%, black));
	}

	.hero-grid {
		z-index: -3;
		background-image:
			linear-gradient(color-mix(in oklab, var(--hero-text) 4%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in oklab, var(--hero-text) 4%, transparent) 1px, transparent 1px),
			radial-gradient(color-mix(in oklab, var(--hero-text) 12%, transparent) 1px, transparent 1px);
		background-size:
			64px 64px,
			64px 64px,
			16px 16px;
		mask-image: linear-gradient(180deg, black 0%, black 74%, transparent 100%);
		-webkit-mask-image: linear-gradient(180deg, black 0%, black 74%, transparent 100%);
		opacity: 0.76;
	}

	.hero-copy {
		position: relative;
		z-index: 2;
		display: grid;
		justify-items: center;
		width: min(900px, calc(100vw - 2rem));
		margin-inline: auto;
		text-align: center;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.15rem;
		padding: 0 0.85rem 0 0.7rem;
		border: 1px solid color-mix(in oklab, var(--sl-color-accent) 38%, transparent);
		border-radius: 999px;
		background: color-mix(in oklab, var(--hero-bg) 58%, transparent);
		color: var(--sl-color-accent-high);
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
		backdrop-filter: blur(18px);
		box-shadow: 0 0 0 1px color-mix(in oklab, black 18%, transparent) inset;
	}

	.hero-badge svg {
		width: 0.75rem;
		height: 0.75rem;
		transition: transform 160ms ease;
	}

	.hero-badge:hover svg {
		transform: translateX(2px);
	}

	.hero-badge-dot {
		position: relative;
		width: 0.46rem;
		height: 0.46rem;
		border-radius: 999px;
		background: var(--sl-color-accent);
		box-shadow: 0 0 18px color-mix(in oklab, var(--sl-color-accent) 86%, transparent);
	}

	.hero-badge-dot::after {
		content: "";
		position: absolute;
		inset: -0.25rem;
		border-radius: inherit;
		background: color-mix(in oklab, var(--sl-color-accent) 44%, transparent);
		animation: badge-pulse 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
	}

	.hero-logo {
		width: 4.35rem;
		height: 4.35rem;
		margin-top: 1rem;
		border-radius: 14px;
		box-shadow:
			0 24px 85px color-mix(in oklab, var(--sl-color-accent) 32%, transparent),
			0 0 0 1px color-mix(in oklab, var(--hero-text) 14%, transparent);
	}

	.hero-title {
		width: min(100%, 14ch);
		max-width: 14ch;
		margin: 0.95rem 0 0;
		color: var(--hero-text);
		font-size: clamp(3rem, 6.6vw, 5.8rem);
		font-weight: 850;
		letter-spacing: 0;
		line-height: 0.94;
		text-wrap: balance;
		background: linear-gradient(
			135deg,
			var(--hero-text) 12%,
			color-mix(in oklab, var(--hero-text) 82%, var(--sl-color-accent) 18%) 38%,
			var(--sl-color-accent-high) 72%,
			var(--hero-text) 100%
		);
		background-size: 220% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		animation: headline-shift 8s ease infinite;
	}

	.hero-subtitle {
		max-width: 42rem;
		margin: 1rem 0 0;
		color: var(--hero-muted);
		font-size: clamp(1rem, 1.8vw, 1.22rem);
		line-height: 1.65;
		text-wrap: balance;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.35rem;
	}

	.hero-action,
	.reference-link {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		min-height: 2.85rem;
		padding: 0.55rem 0.95rem;
		border: 1px solid var(--hero-line);
		border-radius: 999px;
		background: color-mix(in oklab, var(--hero-bg) 68%, transparent);
		color: var(--hero-text);
		font-size: 0.92rem;
		font-weight: 730;
		text-decoration: none;
		backdrop-filter: blur(18px);
		transition:
			border-color 160ms ease,
			background 160ms ease,
			box-shadow 160ms ease,
			transform 160ms ease;
	}

	.hero-action:first-child {
		border-color: color-mix(in oklab, var(--sl-color-accent) 70%, transparent);
		background:
			linear-gradient(135deg, color-mix(in oklab, var(--sl-color-accent) 94%, black), color-mix(in oklab, var(--sl-color-accent) 78%, #ffb545)),
			var(--sl-color-accent);
		color: white;
		box-shadow:
			0 0 0 1px color-mix(in oklab, white 18%, transparent) inset,
			0 18px 48px color-mix(in oklab, var(--sl-color-accent) 24%, transparent);
	}

	.hero-action:first-child .icon-tile {
		border-color: color-mix(in oklab, white 24%, transparent);
		background: color-mix(in oklab, white 16%, transparent);
	}

	.hero-action:first-child .icon-tile img {
		filter: brightness(0) invert(1);
		opacity: 0.94;
	}

	.hero-action-muted {
		color: var(--hero-muted);
	}

	.hero-action:hover,
	.reference-link:hover {
		border-color: color-mix(in oklab, var(--sl-color-accent) 58%, transparent);
		background: color-mix(in oklab, var(--sl-color-accent) 10%, var(--hero-bg));
		color: var(--hero-text);
		transform: translateY(-1px);
	}

	.icon-tile,
	.track-icon {
		display: inline-grid;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid color-mix(in oklab, var(--sl-color-accent) 28%, transparent);
		border-radius: 8px;
		background: color-mix(in oklab, var(--sl-color-accent) 11%, transparent);
	}

	.icon-tile {
		width: 1.65rem;
		height: 1.65rem;
	}

	.icon-tile img,
	.track-icon img {
		object-fit: contain;
		filter: brightness(0) saturate(100%) invert(54%) sepia(97%) saturate(2344%) hue-rotate(338deg) brightness(101%) contrast(101%);
	}

	.icon-tile img {
		width: 0.95rem;
		height: 0.95rem;
	}

	.external-icon {
		flex: 0 0 auto;
		opacity: 0.72;
	}

	.route-strip {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.65rem;
		width: min(980px, 100%);
		margin-inline: auto;
	}

	.route-strip a {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
		min-height: 4.7rem;
		align-content: center;
		padding: 0.85rem 0.95rem;
		border: 1px solid color-mix(in oklab, var(--hero-text) 8%, transparent);
		border-radius: 8px;
		background: color-mix(in oklab, var(--hero-bg) 60%, transparent);
		color: inherit;
		text-decoration: none;
		backdrop-filter: blur(16px);
		transition:
			border-color 160ms ease,
			background 160ms ease,
			transform 160ms ease;
	}

	.route-strip a:hover {
		border-color: color-mix(in oklab, var(--sl-color-accent) 40%, transparent);
		background: color-mix(in oklab, var(--sl-color-accent) 8%, var(--hero-bg));
		transform: translateY(-1px);
	}

	.route-strip strong {
		color: var(--hero-text);
		font-size: 0.96rem;
		line-height: 1.2;
	}

	.route-strip span {
		color: var(--hero-soft);
		font-size: 0.82rem;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}

	.section-copy p {
		display: block;
		color: var(--sl-color-accent-high);
		font-family: var(--sl-font-mono);
		font-size: 0.7rem;
		font-weight: 820;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.track-section,
	.reference-section,
	.docs-footer {
		width: min(1180px, calc(100% - 2rem));
		margin-inline: auto;
	}

	.track-section {
		display: grid;
		gap: 1.4rem;
		padding: clamp(3rem, 7vw, 5.5rem) 0;
	}

	.section-copy {
		max-width: 690px;
	}

	.section-copy p {
		margin: 0 0 0.75rem;
	}

	.section-copy h2 {
		margin: 0;
		color: var(--sl-color-white);
		font-size: clamp(1.9rem, 4vw, 3.35rem);
		font-weight: 790;
		letter-spacing: 0;
		line-height: 1.05;
		text-wrap: balance;
	}

	.section-copy > span {
		display: block;
		max-width: 34rem;
		margin-top: 1rem;
		color: var(--sl-color-gray-3);
		line-height: 1.7;
	}

	.track-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.track-card {
		position: relative;
		display: grid;
		min-height: 16.5rem;
		align-content: end;
		gap: 0.75rem;
		padding: 1rem;
		overflow: hidden;
		border: 1px solid color-mix(in oklab, var(--sl-color-white) 8%, transparent);
		border-radius: 8px;
		background:
			linear-gradient(180deg, transparent 0%, color-mix(in oklab, var(--sl-color-black) 78%, transparent) 100%),
			color-mix(in oklab, var(--sl-color-gray-6) 58%, transparent);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 160ms ease,
			background 160ms ease,
			transform 160ms ease;
	}

	.track-card::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 20% 14%, color-mix(in oklab, var(--sl-color-accent) 17%, transparent), transparent 36%),
			linear-gradient(135deg, color-mix(in oklab, var(--sl-color-white) 5%, transparent), transparent 44%);
		opacity: 0.78;
		pointer-events: none;
	}

	.track-card:hover {
		border-color: color-mix(in oklab, var(--sl-color-accent) 44%, transparent);
		background:
			linear-gradient(180deg, transparent 0%, color-mix(in oklab, var(--sl-color-black) 78%, transparent) 100%),
			color-mix(in oklab, var(--sl-color-accent) 6%, var(--sl-color-gray-6));
		transform: translateY(-2px);
	}

	.track-number {
		position: absolute;
		top: 0.85rem;
		right: 1rem;
		color: color-mix(in oklab, var(--sl-color-white) 16%, transparent);
		font-family: var(--sl-font-mono);
		font-size: 3.25rem;
		font-weight: 900;
		line-height: 1;
