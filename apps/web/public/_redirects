# The AASA claims /store/*, and the website links packages as /store/packages/<id>, but the
# static export only ships /store/packages with an ?id= query. Translate the path form so the
# link works in a browser when the app is not installed.
/store/packages/:id  /store/packages?id=:id  302

# Hosted app routes (/a/<app>/<route>) are resolved by the API after the static interface loads.
# Pages 308s any *.html request to its extensionless path, and a 200 rewrite hands that redirect
# to the browser, dropping the slug. Rewrite to the clean URL instead.
/a/*  /a  200
/use/*  /use  200
