---
import "@tm9657/flow-like-ui/global.css";
import "../../styles/website-base.css";
import { Header } from "../../components/header";

import AmbientGlow from "../../components/ambient-glow.astro";
import SoftSeam from "../../components/soft-seam.astro";

import HeroV3 from "../../sections/hero-v3.astro";
import SolutionEngineering from "../../sections/solution-engineering.astro";
import ShowcaseV3 from "../../sections/showcase-v3.astro";
import ProofBeltV3 from "../../sections/proof-belt-v3.astro";
import BentoV3 from "../../sections/bento-v3.astro";
import TeamsV3 from "../../sections/teams-v3.astro";
import ProtoV3 from "../../sections/proto-v3.astro";
import HowV3 from "../../sections/how-v3.astro";
import TrustV3 from "../../sections/trust-v3.astro";
import TestimonialsV3 from "../../sections/testimonials-v3.astro";
import DevV3 from "../../sections/dev-v3.astro";
import DeployV3 from "../../sections/deploy-v3.astro";
import BlogV3 from "../../sections/blog-v3.astro";
import NewsletterV3 from "../../sections/newsletter-v3.astro";
import FaqV3 from "../../sections/faq-v3.astro";
import CtaV3 from "../../sections/cta-v3.astro";
import { BlogFooter } from "../../components/blog-footer";
import { translations, languages } from "../../i18n";

const lang = "sv";
const t = translations[lang] as Record<string, string>;
const en = translations.en as Record<string, string>;

// --- SEO constants ---
const site = "https://flow-like.com";
const title = t["v3.meta.title"] ?? en["v3.meta.title"] ?? t["v2.meta.title"];
const description = t["v3.meta.description"] ?? en["v3.meta.description"] ?? t["v2.meta.description"];
const keywords = t["v3.meta.keywords"] ?? en["v3.meta.keywords"] ?? t["v2.meta.keywords"];
const appName = "Flow-Like";
const orgName = "TM9657 GmbH";
const canonicalUrl = `${site}/sv`;
const ogImage = `${site}/og.png`;
const ogImageAlt = t["v3.meta.ogAlt"] ?? en["v3.meta.ogAlt"] ?? t["v2.meta.ogAlt"];
const twitterCard = "summary_large_image";

const github = "https://github.com/TM9657/flow-like";
const docs = "https://docs.flow-like.com";
const download = "https://github.com/TM9657/flow-like/releases";

const ldOrganization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: orgName,
  url: site,
  logo: `${site}/favicon.svg`,
  sameAs: [github, docs]
};

const ldSoftware = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: appName,
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "Workflow automation",
  operatingSystem: "macOS, Windows, Linux",
  url: site,
  downloadUrl: download,
  image: ogImage,
  description,
  license: `${github}/blob/main/LICENSE`
};

const ldWebSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: appName,
  url: site,
  publisher: { "@type": "Organization", name: orgName },
  inLanguage: "sv"
};

const ldWebPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  url: canonicalUrl,
  name: title,
  description,
  isPartOf: { "@type": "WebSite", url: site, name: appName },
  inLanguage: "sv"
};

const alternateLinks = [
  { hreflang: "en", href: site },
  { hreflang: "de", href: `${site}/de` },
  { hreflang: "es", href: `${site}/es` },
  { hreflang: "fr", href: `${site}/fr` },
  { hreflang: "zh", href: `${site}/zh` },
  { hreflang: "ja", href: `${site}/ja` },
  { hreflang: "ko", href: `${site}/ko` },
  { hreflang: "pt", href: `${site}/pt` },
  { hreflang: "it", href: `${site}/it` },
  { hreflang: "nl", href: `${site}/nl` },
  { hreflang: "sv", href: `${site}/sv` },
  { hreflang: "x-default", href: site }
];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="application-name" content={appName} />
    <meta name="robots" content="index,follow" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map(alt => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" type="application/rss+xml" title="Flow-Like Blog" href="/rss.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f19" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={appName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="sv_SE" />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(ldOrganization)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ldSoftware)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ldWebSite)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ldWebPage)} />

    <style is:global>
      body {
        background-image: radial-gradient(
          color-mix(in srgb, var(--muted) 20%, transparent) 1px,
          transparent 1px
        ) !important;
        background-size: 16px 16px !important;
        background-attachment: scroll !important;
      }
      @media (hover: none) and (pointer: coarse) {
        [data-overlay], [data-visual], .overlay, .backdrop {
          pointer-events: none;
          touch-action: pan-y;
        }
        * { scroll-snap-type: none !important; }
        html { scroll-behavior: auto !important; }
      }
    </style>
  </head>

  <body class="bg-background text-foreground antialiased selection:bg-primary/30">
    <main id="content" class="w-full max-w-full overflow-x-clip">
      <AmbientGlow />
      <Header client:only="react"/>
      <HeroV3 lang={lang} />

      <SoftSeam />
      <SolutionEngineering lang={lang} />

      <SoftSeam />
      <ShowcaseV3 lang={lang} />
      <ProofBeltV3 lang={lang} />

      <SoftSeam />
      <BentoV3 lang={lang} />

      <SoftSeam />
      <TeamsV3 lang={lang} />

      <SoftSeam />
      <ProtoV3 lang={lang} />

      <SoftSeam />
      <HowV3 lang={lang} />

      <SoftSeam />
      <TrustV3 lang={lang} />

      <SoftSeam />
      <TestimonialsV3 lang={lang} />

      <SoftSeam />
      <DevV3 lang={lang} />

      <SoftSeam />
      <DeployV3 lang={lang} />

      <SoftSeam />
      <BlogV3 lang={lang} />
      <NewsletterV3 lang={lang} />

      <SoftSeam />
      <FaqV3 lang={lang} />

      <SoftSeam />
      <CtaV3 lang={lang} />
    </main>

    <BlogFooter client:only="react" />
  </body>
</html>
