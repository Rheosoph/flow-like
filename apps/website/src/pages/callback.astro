---
import "@flow-like/flow-like-ui/global.css";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="flex flex-col items-center justify-center h-screen gap-4 px-6 text-center">
        <h1>Redirecting...</h1>
        <p id="hint" class="text-sm text-gray-500">Returning you to Flow-Like.</p>
        <a
            id="deeplink"
            class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 font-medium text-primary-foreground transition-opacity hover:opacity-90"
            href="#"
        >
            Open Flow-Like
        </a>
    </div>
    <script>
        (function () {
            try {
                var isIOS =
                    /iPad|iPhone|iPod/.test(navigator.userAgent) ||
                    (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

                var search = new URLSearchParams(window.location.search);
                var hash = window.location.hash ? window.location.hash.substring(1) : "";
                if (hash) {
                    var hashParams = new URLSearchParams(hash);
                    hashParams.forEach(function (v, k) { search.set(k, v); });
                }
                var qs = search.toString();

                var universalLink = "https://app.flow-like.com/callback" + (qs ? "?" + qs : "");
                var schemeLink = "flow-like://auth" + (qs ? "?" + qs : "");

                // iOS does not hand a script-initiated navigation to the Universal Link handler —
                // Safari just loads app.flow-like.com, where the OIDC state does not exist. The
                // custom scheme is the only target either OS honours without a user gesture.
                var automaticTarget = schemeLink;
                // A tap is honoured everywhere, and on iOS the Universal Link skips the
                // "Open in Flow-Like?" confirmation that the custom scheme triggers.
                var manualTarget = isIOS ? universalLink : schemeLink;

                var link = document.getElementById("deeplink");
                if (link) link.setAttribute("href", manualTarget);

                var leftPage = false;
                window.addEventListener("pagehide", function () { leftPage = true; }, { once: true });
                document.addEventListener("visibilitychange", function () {
                    if (document.visibilityState === "hidden") {
                        leftPage = true;
                    }
                });

                window.location.replace(automaticTarget);

                // Chrome on Android blocks custom-scheme launches that no user gesture initiated,
                // so the button is the real path there. Say so rather than leaving the user on a
                // page that claims to be redirecting.
                window.setTimeout(function () {
                    if (leftPage || document.visibilityState === "hidden") return;
                    var hint = document.getElementById("hint");
                    if (hint) hint.textContent = "Tap the button below to finish signing in.";
                }, 1200);
            } catch (_) { /* noop */ }
        })();
    </script>
</Layout>
