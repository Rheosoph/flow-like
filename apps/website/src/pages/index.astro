---
import "@flow-like/flow-like-ui/global.css";
import "../styles/website-base.css";
import { Header } from "../components/header";

import V5Hero from "../sections/v5-hero.astro";
import V5Apps from "../sections/v5-apps.astro";
import V5Platform from "../sections/v5-platform.astro";
import V5Flowpilot from "../sections/v5-flowpilot.astro";
import V5Control from "../sections/v5-control.astro";
import NotesFooterV4 from "../sections/notes-footer-v4.astro";

const site = "https://flow-like.com";
const title = "Flow-Like — The Source-Available Operating System for Data & AI";
const description = "One source-available system for your data, automations, AI, and apps, published under BSL 1.1. Runs on your own servers or fully offline, records every action. Free to start. Built in Germany, GDPR-ready.";
const keywords = [
  "source available data operating system",
  "sovereign AI platform",
  "air-gapped AI platform",
  "self-hosted AI platform",
  "AI operating system for business",
  "source available data platform",
  "self-hosted workflow automation",
  "on-premise AI agent platform",
  "GDPR AI platform",
  "European AI platform",
  "digital sovereignty software",
  "offline AI platform",
  "source available internal tool builder",
  "secure AI platform for government",
  "rust workflow engine",
  "souveräne Datenplattform",
  "souveräne KI-Plattform",
  "digitale Souveränität Software",
  "DSGVO-konforme KI-Plattform",
].join(", ");
const github = "https://github.com/Rheosoph/flow-like";
const docs = "https://docs.flow-like.com";
const download = `${github}/releases`;
const ogImage = `${site}/og.png`;

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Rheosoph GmbH",
  url: site,
  logo: `${site}/favicon.svg`,
  sameAs: [github, docs],
};
const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Flow-Like",
  applicationCategory: "BusinessApplication",
  applicationSubCategory: "Data, AI and workflow operating system",
  operatingSystem: "macOS, Windows, Linux",
  url: site,
  downloadUrl: download,
  image: ogImage,
  description,
  license: `${github}/blob/main/LICENSE`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR", category: "Individual" },
};
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Flow-Like",
  url: site,
  description,
  inLanguage: "en",
  publisher: { "@type": "Organization", name: "Rheosoph GmbH" },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth light" style="color-scheme: light;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="application-name" content="Flow-Like" />
    <meta name="apple-mobile-web-app-title" content="Flow-Like" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no, address=no, email=no, url=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={site} />
    {[
      ["en", ""], ["de", "/de"], ["es", "/es"], ["fr", "/fr"], ["zh", "/zh"],
      ["ja", "/ja"], ["ko", "/ko"], ["pt", "/pt"], ["it", "/it"], ["nl", "/nl"], ["sv", "/sv"],
    ].map(([language, path]) => <link rel="alternate" hreflang={language} href={`${site}${path}`} />)}
    <link rel="alternate" hreflang="x-default" href={site} />
    <link rel="alternate" type="application/rss+xml" title="Flow-Like Blog" href="/rss.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#ef5b42" />
    <meta name="msapplication-TileColor" content="#ef5b42" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Flow-Like" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Flow-Like — the source-available operating system for data and AI" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://docs.flow-like.com" crossorigin />
    <link rel="preconnect" href="https://api.github.com" crossorigin />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)} />
    <style is:global>
      body {
        background-image: radial-gradient(color-mix(in srgb, var(--muted) 18%, transparent) 1px, transparent 1px) !important;
        background-size: 18px 18px !important;
        background-attachment: scroll !important;
      }
      section { scroll-margin-top: 5rem; }
      @media (hover: none) and (pointer: coarse) {
        html { scroll-behavior: auto !important; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto !important; }
      }
    </style>
  </head>
  <body class="bg-background text-foreground antialiased selection:bg-primary/25 selection:text-foreground">
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:text-sm focus:shadow-xl">Skip to content</a>
    <Header client:only="react" />
    <main id="content" class="w-full max-w-full overflow-x-clip">
      <V5Hero />
      <V5Apps />
      <V5Platform />
      <V5Flowpilot />
      <V5Control />
    </main>
    <NotesFooterV4 />
  </body>
</html>
