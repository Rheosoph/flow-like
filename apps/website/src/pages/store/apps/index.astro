---
export const prerender = false;

import StoreLayout from "../../../layouts/StoreLayout.astro";
import {
	searchApps,
	isStoreEnabled,
	formatCategory,
	formatPrice,
	type AppSearchResult,
} from "../../../lib/registry";

if (!isStoreEnabled()) return Astro.redirect("/");

let apps: AppSearchResult[] = [];

try {
	apps = await searchApps(200);
} catch (e) {
	console.error("App search error:", e);
}

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "Flow-Like Apps",
	description:
		"Discover ready-to-use automation applications built on the Flow-Like platform. Enterprise-grade apps for every workflow.",
	url: "https://flow-like.com/store/apps",
	numberOfItems: apps.length,
	isPartOf: {
		"@type": "WebSite",
		name: "Flow-Like",
		url: "https://flow-like.com",
	},
};
---

<StoreLayout
	title="Apps | Flow-Like Store"
	description={`Browse ${apps.length} automation apps for the Flow-Like platform. Enterprise-grade, ready-to-use applications.`}
	jsonLd={jsonLd}
>
	<section class="max-w-7xl mx-auto px-6 pt-12 pb-20">
		<nav class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
			<a href="/store" class="hover:text-foreground transition-colors">Store</a>
			<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
			<span class="text-foreground font-medium">Apps</span>
		</nav>

		<div class="mb-10">
			<h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">
				Applications
			</h1>
			<p class="text-muted-foreground max-w-2xl">
				{apps.length} pre-built automation solutions, templates, and workflows ready to deploy.
			</p>
		</div>

		{apps.length > 0 ? (
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
				{apps.map(([app, meta]) => {
					const displayName = meta?.name || app.id;
					const displayDesc =
						meta?.description || "No description available";
					const icon = meta?.icon;
					const thumbnail = meta?.thumbnail;
					return (
						<a
							href={`/store/apps/${app.id}`}
							class="group block rounded-2xl border border-border bg-card overflow-hidden hover:border-foreground/20 hover:shadow-xl transition-all duration-300"
						>
							{thumbnail ? (
								<div class="aspect-video w-full overflow-hidden bg-muted">
									<img
										src={thumbnail}
										alt={displayName}
										class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
										loading="lazy"
									/>
								</div>
							) : (
								<div class="aspect-video w-full bg-gradient-to-br from-muted/80 to-muted/30 flex items-center justify-center">
									<div class="w-14 h-14 rounded-2xl bg-background/80 flex items-center justify-center">
										<svg class="w-7 h-7 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
									</div>
								</div>
							)}
							<div class="p-5">
								<div class="flex items-center gap-3 mb-2">
									{icon ? (
										<img
											src={icon}
											alt=""
											class="w-9 h-9 rounded-xl object-cover ring-1 ring-border"
											loading="lazy"
										/>
									) : (
										<div class="w-9 h-9 rounded-xl bg-muted flex items-center justify-center ring-1 ring-border">
											<svg class="w-4.5 h-4.5 text-muted-foreground/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6z"/></svg>
										</div>
									)}
									<div class="min-w-0">
										<h3 class="font-semibold truncate group-hover:text-primary transition-colors">
											{displayName}
										</h3>
									</div>
								</div>
								<p class="text-sm text-muted-foreground line-clamp-2 mb-3">
									{displayDesc}
								</p>
								<div class="flex items-center justify-between text-xs text-muted-foreground">
									<div class="flex items-center gap-3">
										<span>{formatCategory(app.primary_category)}</span>
										{app.templates.length > 0 && (
											<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 text-[11px] font-medium">
												{app.templates.length} template{app.templates.length > 1 ? "s" : ""}
											</span>
										)}
									</div>
									<span class="font-semibold text-foreground">
										{formatPrice(app.price)}
									</span>
								</div>
								{app.avg_rating && app.rating_count > 0 && (
									<div class="flex items-center gap-1.5 mt-2.5 text-xs text-muted-foreground">
										<span class="text-amber-500">★</span>
										<span>{app.avg_rating.toFixed(1)}</span>
										<span class="text-muted-foreground/60">({app.rating_count})</span>
									</div>
								)}
							</div>
						</a>
					);
				})}
			</div>
		) : (
			<div class="text-center py-20 rounded-2xl border border-dashed border-border">
				<div class="w-14 h-14 rounded-2xl bg-muted flex items-center justify-center mx-auto mb-5">
					<svg class="w-7 h-7 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
				</div>
				<h3 class="text-lg font-semibold mb-2">No apps yet</h3>
				<p class="text-muted-foreground max-w-md mx-auto">
					Applications are coming soon. Check back later!
				</p>
			</div>
		)}
	</section>
</StoreLayout>
