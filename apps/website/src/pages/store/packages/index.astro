---
export const prerender = false;

import StoreLayout from "../../../layouts/StoreLayout.astro";
import {
	searchPackages,
	isStoreEnabled,
	formatPrice,
	type PackageSummary,
} from "../../../lib/registry";

if (!isStoreEnabled()) return Astro.redirect("/");

let packages: PackageSummary[] = [];
let totalCount = 0;

try {
	const res = await searchPackages(200);
	packages = res.packages;
	totalCount = res.totalCount;
} catch (e) {
	console.error("Package search error:", e);
}

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "Flow-Like Packages",
	description:
		"Browse WASM automation packages for the Flow-Like platform. Custom nodes, integrations, and workflow components.",
	url: "https://flow-like.com/store/packages",
	numberOfItems: totalCount,
	isPartOf: {
		"@type": "WebSite",
		name: "Flow-Like",
		url: "https://flow-like.com",
	},
};

Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=600, stale-while-revalidate=3600");
---

<StoreLayout
	title="Packages | Flow-Like Store"
	description={`Browse ${totalCount} automation packages for the Flow-Like platform. Custom nodes, integrations, and workflow components.`}
	jsonLd={jsonLd}
>
	<section class="max-w-7xl mx-auto px-6 pt-12 pb-20">
		<nav class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
			<a href="/store" class="hover:text-foreground transition-colors">Store</a>
			<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
			<span class="text-foreground font-medium">Packages</span>
		</nav>

		<div class="mb-10">
			<h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">
				Packages
			</h1>
			<p class="text-muted-foreground max-w-2xl">
				{totalCount} WASM packages available. Custom nodes, integrations, AI
				models, and workflow components for the Flow-Like automation platform.
			</p>
		</div>

		{packages.length > 0 ? (
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
				{packages.map((pkg) => {
					const meta = pkg.metadata;
					const displayName = meta?.name || pkg.name;
					const displayDesc = meta?.description || pkg.description;
					const icon = meta?.icon;
					return (
						<a
							href={`/store/packages/${pkg.id}`}
							class="group block rounded-xl border border-border bg-card p-5 hover:border-foreground/20 hover:shadow-md transition-all duration-200"
						>
							<div class="flex items-start gap-3 mb-3">
								{icon ? (
									<img
										src={icon}
										alt={displayName}
										class="w-10 h-10 rounded-lg object-cover shrink-0 ring-1 ring-border"
										loading="lazy"
									/>
								) : (
									<div class="w-10 h-10 rounded-lg bg-muted flex items-center justify-center shrink-0">
										<svg class="w-5 h-5 text-muted-foreground/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
									</div>
								)}
								<div class="min-w-0">
									<h3 class="font-semibold truncate group-hover:text-primary transition-colors">
										{displayName}
									</h3>
									<span class="text-xs text-muted-foreground">
										v{pkg.latestVersion}
									</span>
								</div>
							</div>
							<p class="text-sm text-muted-foreground line-clamp-2 mb-3">
								{displayDesc}
							</p>
							<div class="flex items-center justify-between text-xs text-muted-foreground">
								<span>{pkg.downloadCount.toLocaleString()} downloads</span>
								<span class="font-medium text-foreground">
									{formatPrice(pkg.price)}
								</span>
							</div>
							{pkg.keywords.length > 0 && (
								<div class="flex flex-wrap gap-1 mt-3">
									{pkg.keywords.slice(0, 3).map((kw) => (
										<span class="inline-block px-2 py-0.5 text-[11px] rounded-full bg-muted text-muted-foreground">
											{kw}
										</span>
									))}
								</div>
							)}
							{pkg.verified && (
								<span class="inline-flex items-center gap-1 mt-2 text-xs text-green-600 dark:text-green-400">
									<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
									Verified
								</span>
							)}
						</a>
					);
				})}
			</div>
		) : (
			<div class="text-center py-20 rounded-2xl border border-dashed border-border">
				<div class="w-14 h-14 rounded-2xl bg-muted flex items-center justify-center mx-auto mb-5">
					<svg class="w-7 h-7 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
				</div>
				<h3 class="text-lg font-semibold mb-2">No packages yet</h3>
				<p class="text-muted-foreground max-w-md mx-auto">
					Packages are coming soon. Check back later!
				</p>
			</div>
		)}
	</section>
</StoreLayout>
