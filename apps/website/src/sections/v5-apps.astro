<script>
  import type { ActiveMode, DescentController } from "../components/v5/descent/controller";
  import { bootDescent } from "../components/v5/descent/controller";

  const root = document.querySelector<HTMLElement>("[data-v5-apps]");
  const descent = root ? bootDescent(root) : null;
  if (import.meta.env.DEV && descent) installDevHook(descent);

  function installDevHook(descent: DescentController) {
    interface Frame {
      name: string;
      mode?: ActiveMode;
      p?: number;
      intro?: number;
      extra?: number;
      t?: number;
      app?: number;
      scenario?: number;
      at?: "top" | "under" | "still";
    }
    const frames: Frame[] = [
      { name: "01-intro", intro: 0.55, p: 0, t: 1.4, app: 0 },
      { name: "02-rest", p: 0, t: 3.2, app: 0 },
      { name: "03-app-selected", p: 0, t: 3.7, app: 6 },
      { name: "04a-glass", p: 0.22, t: 4.1, app: 1 },
      { name: "04b-board", p: 0.3, t: 4.1, app: 1 },
      { name: "05-alive", p: 0.44, t: 2.2, app: 1 },
      { name: "06-settle", p: 0.56, t: 2.9, app: 1 },
      { name: "07a-approval-hop", p: 1, t: 1.4, scenario: 0 },
      { name: "07b-approval-arrive", p: 1, t: 4.6, scenario: 0 },
      { name: "08a-insight-hop", p: 1, t: 1.8, scenario: 1 },
      { name: "08b-insight-arrive", p: 1, t: 3.75, scenario: 1 },
      { name: "09a-flowpilot-hop", p: 1, t: 1.6, scenario: 2 },
      { name: "09b-flowpilot-arrive", p: 1, t: 4.95, scenario: 2 },
      { name: "10-handoff", p: 1, extra: 0.5, t: 3.0, scenario: 0 },
      { name: "11a-reduced-top", mode: "reduced", scenario: 0, at: "top" },
      { name: "11b-reduced-still", mode: "reduced", scenario: 0, at: "still" },
      { name: "12a-fallback-surface", mode: "fallback", app: 1, at: "top" },
      { name: "12b-fallback-beneath", mode: "fallback", at: "under" },
    ];
    const jump = (top: number) => window.scrollTo({ top, behavior: "instant" });
    const frame = () => new Promise((resolve) => requestAnimationFrame(resolve));
    const absolute = (el: Element) => window.scrollY + el.getBoundingClientRect().top;
    // The scene replays the frame's scenario events itself on snap(); the
    // progress bar it started is then held at the frame's time.
    const holdProgress = (t: number) => {
      for (const animation of descent.root.getAnimations({ subtree: true })) {
        if (animation.id !== "descent-progress") continue;
        animation.pause();
        const duration = Number(animation.effect?.getTiming().duration) || t * 1000;
        animation.currentTime = Math.min(t * 1000, duration);
      }
    };
    const showStatic = async (f: Frame) => {
      const stage = descent.track.querySelector("[data-stage]");
      const host = descent.track.querySelector("[data-scene]");
      if (f.at === "under") jump(absolute(descent.board) - 64);
      else if (f.at === "still" && host) jump(absolute(host));
      else jump(absolute(stage ?? descent.track) - 40);
      await new Promise((resolve) => setTimeout(resolve, 60));
      descent.refresh();
      const scene = descent.scene();
      if (!scene) return;
      await scene.ready;
      scene.render();
    };
    const goto = async (f: Frame): Promise<void> => {
      descent.interact();
      const want = f.mode ?? "motion";
      if (want !== descent.mode()) await descent.enterMode(want);
      if (f.app !== undefined) descent.selectApp(f.app);
      if (f.scenario !== undefined) descent.selectScenario(f.scenario);
      if (descent.mode() !== "motion") return showStatic(f);
      const r = descent.track.getBoundingClientRect();
      const stage = descent.track.querySelector<HTMLElement>("[data-stage]");
      const top = window.scrollY + r.top;
      const span = r.height - (stage?.offsetHeight ?? window.innerHeight);
      let y = top + (f.p ?? 0) * span;
      if (f.intro !== undefined) y = top - (1 - f.intro) * window.innerHeight;
      if (f.extra) y = top + span + f.extra * window.innerHeight;
      jump(y);
      await frame();
      const scene = descent.scene();
      if (!scene) return;
      await scene.ready;
      const intro = f.intro ?? 1;
      const p = f.p ?? 0;
      scene.setProgress(p, true);
      scene.setIntro(intro, true);
      scene.setTime(f.t ?? 2);
      scene.setScenarioClock(0);
      descent.applyProgress(p, intro);
      scene.snap();
      scene.render();
      if (f.scenario !== undefined) holdProgress(f.t ?? 2);
    };
    (window as unknown as { __proto?: unknown }).__proto = {
      ready: (async () => {
        await document.fonts.ready;
        await descent.settled;
        return true;
      })(),
      frames,
      goto,
      info: () => ({ ...(descent.scene()?.info() ?? {}), mode: descent.mode(), safeArea: descent.safeArea() }),
    };
  }
</script>
