---
import type { Lang, TranslationKey } from "../i18n";
import { defaultLang, translations } from "../i18n";

interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = (key: TranslationKey): string => {
  const localized = translations[lang] as Record<string, string>;
  const english = translations.en as Record<string, string>;
  return localized?.[key] ?? english[key] ?? key;
};
const tList = (key: TranslationKey): string[] => t(key).split("|");

// Client-script labels (kept in sync with the server-rendered initial state below).
const labels = {
  connectedLayer: t("v5.apps.state.connectedLayer"),
  builtWith: t("v5.apps.state.builtWith"),
  liveFlag: t("v5.apps.state.liveFlag"),
  selectApp: t("v5.apps.state.selectApp"),
  live: t("v5.apps.state.live"),
  ready: t("v5.apps.state.ready"),
  exchanging: t("v5.apps.state.exchanging"),
  connected: t("v5.apps.state.connected"),
  frontendSelected: t("v5.apps.bridge.frontendSelected"),
};

// [name, category, mockup-kind, color, screenshot-slug]. Drop a real screenshot at
// /public/images/apps/<slug>.webp and it crossfades in over the mockup fallback.
const carouselApps = [
  ["Operations HQ", t("v5.apps.cat.operations"), "ops", "coral", "operations-hq"],
  ["Finance Approvals", t("v5.apps.cat.finance"), "finance", "orange", "finance-approvals"],
  ["Customer 360", t("v5.apps.cat.revenue"), "customer", "red", "customer-360"],
  ["Knowledge Graph", t("v5.apps.cat.data"), "graph", "rust", "knowledge-graph"],
  ["AI Control Center", t("v5.apps.cat.governance"), "control", "coral", "ai-control-center"],
  ["Inventory Planner", t("v5.apps.cat.supplyChain"), "inventory", "orange", "inventory-planner"],
  ["FlowPilot Workspace", t("v5.apps.cat.everyone"), "agent", "red", "flowpilot-workspace"],
  ["Field Service", t("v5.apps.cat.mobile"), "field", "rust", "field-service"],
];

const appFlows = [
  {
    id: "approval",
    label: t("v5.apps.flow.approval.label"),
    title: t("v5.apps.flow.approval.title"),
    detail: t("v5.apps.flow.approval.detail"),
    nodes: ["email", "approval"],
    route: tList("v5.apps.flow.approval.route"),
  },
  {
    id: "insight",
    label: t("v5.apps.flow.insight.label"),
    title: t("v5.apps.flow.insight.title"),
    detail: t("v5.apps.flow.insight.detail"),
    nodes: ["data", "dashboard"],
    route: tList("v5.apps.flow.insight.route"),
  },
  {
    id: "flowpilot",
    label: t("v5.apps.flow.flowpilot.label"),
    title: t("v5.apps.flow.flowpilot.title"),
    detail: t("v5.apps.flow.flowpilot.detail"),
    nodes: ["email", "data", "notes", "dashboard", "calendar"],
    route: tList("v5.apps.flow.flowpilot.route"),
  },
];

const appFlowIndex = [1, 0, 2, 1, 2, 1, 2, 0];
const scenarioAppIndex = [1, 3, 6];

const linkLabel = (id: string): string =>
  id === "approval"
    ? t("v5.apps.link.approval")
    : id === "dashboard"
      ? t("v5.apps.link.dashboard")
      : id === "data"
        ? t("v5.apps.link.data")
        : id === "email"
          ? t("v5.apps.link.email")
          : id === "calendar"
            ? t("v5.apps.link.calendar")
            : t("v5.apps.link.notes");

function miniApp(kind: string): string {
  if (kind === "ops") {
    const bars = [43, 58, 49, 73, 62, 88, 78, 95]
      .map((x) => `<i style="height:${x}%"></i>`)
      .join("");
    return `<div class="mini ops-mini"><div class="metric-row"><span><b>98.4%</b><small>${t("v5.apps.mini.ops.onTime")}</small></span><span><b>214</b><small>${t("v5.apps.mini.ops.liveRuns")}</small></span><span><b>6</b><small>${t("v5.apps.mini.ops.attention")}</small></span></div><div class="bar-chart">${bars}</div></div>`;
  }
  if (kind === "finance") {
    const rows: [string, string][] = [
      ["PO–4482", "€24,800"],
      ["PO–4481", "€8,240"],
      ["PO–4479", "€61,020"],
    ];
    return `<div class="mini approval">${rows
      .map(
        (r, i) =>
          `<div><span><b>${r[0]}</b><small>${t("v5.apps.mini.finance.dept")}</small></span><em>${r[1]}</em><button>${i === 1 ? t("v5.apps.mini.finance.approve") : t("v5.apps.mini.finance.review")}</button></div>`,
      )
      .join("")}</div>`;
  }
  if (kind === "customer") {
    return `<div class="mini customer"><aside><i></i><i></i><i></i><i></i></aside><section><div class="avatar">AK</div><span><b>Acme Industries</b><small>${t("v5.apps.mini.customer.healthScore")} · 92</small></span><div class="health"><i></i></div><p>${t("v5.apps.mini.customer.briefing")}</p></section></div>`;
  }
  if (kind === "graph") {
    return `<div class="mini mini-graph"><span class="g-node g1">${t("v5.apps.mini.graph.customer")}</span><span class="g-node g2">${t("v5.apps.mini.graph.contract")}</span><span class="g-node g3">${t("v5.apps.mini.graph.product")}</span><span class="g-node g4">${t("v5.apps.mini.graph.interaction")}</span><i class="g-line l1"></i><i class="g-line l2"></i><i class="g-line l3"></i></div>`;
  }
  if (kind === "control") {
    const rows: [string, string][] = [
      [t("v5.apps.mini.control.row1"), t("v5.apps.status.compliant")],
      [t("v5.apps.mini.control.row2"), t("v5.apps.status.compliant")],
      [t("v5.apps.mini.control.row3"), t("v5.apps.status.review")],
    ];
    return `<div class="mini control">${rows
      .map(
        (r, i) =>
          `<div><i class="${i === 2 ? "warn" : ""}"></i><b>${r[0]}</b><em>${r[1]}</em></div>`,
      )
      .join("")}<span><i></i></span></div>`;
  }
  if (kind === "inventory") {
    const rows: [string, number, string][] = [
      ["Berlin", 72, "12.4k"],
      ["Porto", 48, "8.1k"],
      ["Warsaw", 86, "17.8k"],
      ["Lyon", 61, "9.6k"],
    ];
    return `<div class="mini inventory">${rows
      .map(
        (r) =>
          `<div><b>${r[0]}</b><span><i style="width:${r[1]}%"></i></span><em>${r[2]}</em></div>`,
      )
      .join("")}</div>`;
  }
  if (kind === "agent") {
    return `<div class="mini agent dark"><i class="orb">✦</i><p>${t("v5.apps.mini.agent.prompt")}</p><div><span>${t("v5.apps.mini.agent.mail")}</span><em>→</em><span>${t("v5.apps.mini.agent.data")}</span><em>→</em><span>${t("v5.apps.mini.agent.calendar")}</span></div></div>`;
  }
  return `<div class="mini field"><div class="map"><i></i><i></i><b>3</b></div><section><small>${t("v5.apps.mini.field.nextVisit")}</small><b>Turbine B–14</b><span>14:30 · 4.2 km</span><button>${t("v5.apps.mini.field.startRoute")}</button></section></div>`;
}

const mailCanvas = `<div class="mail-canvas"><div><i>AS</i><span><b>${t("v5.apps.mail.subject1")}</b><small>Anna Schmidt · 2m</small></span><em>${t("v5.apps.mail.new")}</em></div><div><i>JM</i><span><b>${t("v5.apps.mail.subject2")}</b><small>Jonas Müller · 18m</small></span><em>3</em></div><div><i>LP</i><span><b>${t("v5.apps.mail.subject3")}</b><small>Lea Peters · 42m</small></span><em>✓</em></div></div>`;
const notesCanvas = `<div class="notes-canvas"><span>${t("v5.apps.notes.title")}</span><p>${t("v5.apps.notes.body")}</p></div>`;
const calendarCanvas = `<div class="calendar-canvas"><span><b>24</b><small>${t("v5.apps.cal.day")}</small></span><p>${t("v5.apps.cal.event")}</p><i>10:30 — 11:15</i></div>`;

const connectedApps = [
  { id: "email", title: t("v5.apps.connected.email.title"), meta: t("v5.apps.connected.email.meta"), kind: "customer", compact: false, canvas: `<div class="connected-canvas">${mailCanvas}</div>` },
  { id: "approval", title: "Finance Approvals", meta: t("v5.apps.connected.approval.meta"), kind: "finance", compact: false, canvas: `<div class="connected-canvas">${miniApp("finance")}</div>` },
  { id: "data", title: "Data Studio", meta: t("v5.apps.connected.data.meta"), kind: "graph", compact: false, canvas: `<div class="connected-canvas">${miniApp("graph")}</div>` },
  { id: "dashboard", title: "Operations HQ", meta: t("v5.apps.connected.dashboard.meta"), kind: "ops", compact: false, canvas: `<div class="connected-canvas">${miniApp("ops")}</div>` },
  { id: "notes", title: t("v5.apps.connected.notes.title"), meta: t("v5.apps.connected.notes.meta"), kind: "customer", compact: true, canvas: notesCanvas },
  { id: "calendar", title: t("v5.apps.connected.calendar.title"), meta: t("v5.apps.connected.calendar.meta"), kind: "field", compact: true, canvas: calendarCanvas },
];

const nodeIds = ["email", "approval", "data", "dashboard", "notes", "calendar"] as const;

// Initial state: selectedIndex 0, flowIndex appFlowIndex[0] = 1
const selectedIndex0 = 0;
const flowIndex0 = appFlowIndex[selectedIndex0];
const flow0 = appFlows[flowIndex0];
const selApp0 = carouselApps[selectedIndex0];
const active0 = (id: string): boolean => flow0.nodes.includes(id);
---

<section id="apps" class="v5-apps apps unified-apps" data-v5-apps>
  <div class="section-head unified-head website-content-canvas">
    <span class="eyebrow">01 / {t("v5.apps.eyebrow")}</span>
    <div>
      <h2>{t("v5.apps.h2.l1")}<br />{t("v5.apps.h2.l2")}</h2>
      <p>{t("v5.apps.intro")}</p>
    </div>
  </div>

  <div class="subsection-head">
    <span class="sub-kicker"><i></i> {t("v5.apps.sub.kicker")}</span>
    <h3>{t("v5.apps.sub.h3")}</h3>
    <p>{t("v5.apps.sub.p")}</p>
  </div>

  <div class="unified-shell store-shell">
    <div class="app-store">
      <div class="app-rail-header">
        <span><i></i> {t("v5.apps.store.header")} <b>{t("v5.apps.store.count")}</b></span>
        <div>
          <button type="button" data-rail-prev aria-label={t("v5.apps.aria.prev")}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></svg>
          </button>
          <button type="button" data-rail-next aria-label={t("v5.apps.aria.next")}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </button>
        </div>
      </div>

      <div class="app-rail" data-rail aria-label={t("v5.apps.aria.rail")}>
        {carouselApps.map((app, index) => (
          <article
            class:list={["app-card", app[3], index === selectedIndex0 && "selected"]}
            data-app-card
            data-index={index}
            role="button"
            tabindex="0"
            aria-pressed={index === selectedIndex0 ? "true" : "false"}
          >
            <header><i>{app[0][0]}</i><span><b>{app[0]}</b><small>{app[1]}</small></span><em>•••</em></header>
            <div class="app-body">
              <div class="app-shot-fallback" set:html={miniApp(app[2])} />
              <img
                class="app-shot"
                src={`/images/apps/${app[4]}.webp`}
                alt={`${app[0]} — ${t("v5.apps.card.alt")}`}
                loading="lazy"
                decoding="async"
                onload="this.classList.add('shot-ready')"
                onerror="this.classList.add('shot-missing')"
              />
              <span class="app-shot-veil" aria-hidden="true"></span>
            </div>
            <footer>
              <span data-card-footer-span>{index === selectedIndex0 ? labels.connectedLayer : labels.builtWith}</span>
              <b data-card-footer-b>{index === selectedIndex0 ? labels.liveFlag : labels.selectApp}</b>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </div>

  <div class="unified-shell layer-shell">
    <div class="rail-bridge" aria-live="polite">
      <span>
        <i data-role="bridge-letter">{selApp0[0][0]}</i>
        <b data-role="bridge-name">{selApp0[0]}</b>
        <small data-role="bridge-cat">{selApp0[1]} {labels.frontendSelected}</small>
      </span>
      <div><i></i><b>{t("v5.apps.bridge.shared")}</b><i></i></div>
      <span>
        <i>FL</i>
        <b>{t("v5.apps.bridge.operatingLayer")}</b>
        <small data-role="bridge-right">{flow0.label}</small>
      </span>
    </div>

    <div class={`ecosystem flow-${flow0.id}`} data-ecosystem aria-label={t("v5.apps.aria.ecosystem")}>
      <div class="ecosystem-grid" aria-hidden="true"></div>

      {nodeIds.map((id) => (
        <div
          class:list={[
            "system-link",
            `link-${id}`,
            active0(id) && "active",
            (["email", "data", "notes"] as readonly string[]).includes(id) ? "inbound" : "outbound",
          ]}
          data-link={id}
          aria-hidden="true"
        >
          <span>{linkLabel(id)}</span>
          <i></i>
        </div>
      ))}

      {connectedApps.map((app) => {
        const on = active0(app.id);
        return (
          <article class:list={["connected-app", `app-${app.id}`, app.compact && "compact", on && "active"]} data-connected={app.id}>
            <header>
              <i>{app.title.slice(0, 2).toUpperCase()}</i>
              <span><b>{app.title}</b><small>{app.meta}</small></span>
              <em data-role="app-em">{on ? labels.live : labels.ready}</em>
            </header>
            <Fragment set:html={app.canvas} />
            <footer>
              <span data-role="app-foot-span">{on ? labels.exchanging : labels.connected}</span>
              <b data-role="app-foot-b">{on ? "●" : "○"}</b>
            </footer>
          </article>
        );
      })}

      <div class="os-core dark">
        <header><span><i></i> {t("v5.apps.core.header")}</span><em>LIVE</em></header>
        <div class="core-orbit"><i></i><i></i><i></i><img src="/favicon.svg" alt="Flow-Like" width="34" height="34" /></div>
        <label data-role="core-label">{selApp0[0]} / {flow0.label}</label>
        <h3 data-role="core-title">{flow0.title}</h3>
        <p data-role="core-detail">{flow0.detail}</p>
        <div class="core-route" data-role="core-route">
          {flow0.route.map((step, index) => (
            <span><b>{step}</b>{index < flow0.route.length - 1 && <i>→</i>}</span>
          ))}
        </div>
        <footer><span><i></i> {t("v5.apps.core.processRunning")}</span><b>{t("v5.apps.core.governed")}</b></footer>
      </div>
    </div>

    <div class="flow-switcher" aria-label={t("v5.apps.aria.switcher")}>
      {appFlows.map((item, index) => (
        <button
          type="button"
          class:list={[index === flowIndex0 && "active"]}
          data-scenario
          data-index={index}
          aria-pressed={index === flowIndex0 ? "true" : "false"}
        >
          <i>0{index + 1}</i><span><b>{item.label}</b><small>{item.title}</small></span><em>↗</em>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  .eyebrow { font: 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .16em; color: var(--muted-foreground); }

  /* Apps section shell */
  .apps { padding: 150px 0 130px; background: var(--background); color: var(--foreground); overflow: hidden; }
  .section-head { display: grid; grid-template-columns: 24% 1fr; padding: 0 clamp(22px, 6vw, 115px) 75px; }
  .apps .eyebrow { padding-top: 13px; color: var(--muted-foreground); }
  .section-head > div { display: flex; flex-direction: column; align-items: flex-start; gap: 34px; }
  .section-head h2 { margin: 0; font-size: clamp(54px, 6.1vw, 96px); line-height: .92; letter-spacing: -.065em; font-weight: 650; white-space: nowrap; }
  .section-head p { align-self: flex-end; width: 380px; margin: 0; color: var(--muted-foreground); font-size: 15px; line-height: 1.55; }

  /* App cards (authored shells) */
  .app-card { width: 380px; height: 270px; flex: 0 0 auto; overflow: hidden; border: 1px solid var(--border); border-radius: 15px; background: var(--card); box-shadow: 0 16px 50px color-mix(in oklab, var(--foreground) 8%, transparent); transition: transform .3s, box-shadow .3s; }
  .app-card:hover { transform: translateY(-5px); box-shadow: 0 24px 70px color-mix(in oklab, var(--foreground) 14%, transparent); }
  .app-card > header { height: 50px; padding: 0 12px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border); }
  .app-card > header > i { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 7px; background: var(--primary); color: var(--primary-foreground); font-size: 11px; font-weight: 800; font-style: normal; }
  .app-card.orange > header > i { background: var(--accent); }
  .app-card.red > header > i { background: var(--primary); }
  .app-card.rust > header > i { background: color-mix(in oklab, var(--primary) 60%, black); }
  .app-card.coral > header > i { background: var(--accent); }
  .app-card > header span { display: grid; gap: 1px; }
  .app-card > header b { font-size: 11px; }
  .app-card > header small { font-size: 8px; color: var(--muted-foreground); }
  .app-card > header em { margin-left: auto; color: color-mix(in oklab, var(--muted-foreground) 75%, transparent); font-size: 9px; font-style: normal; letter-spacing: .1em; }
  .app-body { position: relative; height: 190px; padding: 13px; overflow: hidden; background: color-mix(in oklab, var(--muted) 70%, var(--background)); }
  .app-card > footer { height: 30px; padding: 0 13px; display: flex; align-items: center; justify-content: space-between; color: var(--muted-foreground); font-size: 8px; }
  .app-card > footer b { font-weight: 500; color: var(--foreground); }

  /* Real screenshot bleeds edge-to-edge over the mockup fallback and crossfades in.
     Missing file -> the img flags itself .shot-missing and the mockup stays visible. */
  .app-shot-fallback { height: 100%; }
  .app-shot { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; object-fit: cover; object-position: top center; opacity: 0; transform: scale(1.015); transition: opacity .55s ease, transform .5s ease; }
  .app-shot.shot-ready { opacity: 1; transform: scale(1); }
  .app-shot.shot-missing { display: none; }
  .app-shot-veil { position: absolute; inset: 0; z-index: 3; pointer-events: none; opacity: 0; transition: opacity .55s ease; box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--foreground) 5%, transparent); background: linear-gradient(to top, color-mix(in oklab, var(--foreground) 9%, transparent) 0%, transparent 26%), linear-gradient(to bottom, color-mix(in oklab, var(--background) 22%, transparent) 0%, transparent 14%); }
  .app-shot.shot-ready ~ .app-shot-veil { opacity: 1; }
  .app-card:hover .app-shot.shot-ready { transform: scale(1.05); }
  .app-card.selected .app-shot.shot-ready { transform: scale(1.03); }

  /* Ecosystem (authored) */
  .ecosystem { position: relative; width: min(1380px, 94vw); height: 780px; margin: 0 auto; overflow: hidden; border: 1px solid var(--border); border-radius: 24px; background: var(--muted); box-shadow: 0 40px 100px color-mix(in oklab, var(--foreground) 10%, transparent); }
  .ecosystem:after { content: ""; position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 100px color-mix(in oklab, var(--foreground) 8%, transparent); }
  .ecosystem-grid { position: absolute; inset: 0; opacity: .42; background-image: linear-gradient(color-mix(in oklab, var(--foreground) 6.5%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in oklab, var(--foreground) 6.5%, transparent) 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(circle at center, #000 25%, transparent 82%); }

  .connected-app { position: absolute; z-index: 4; width: clamp(225px, 21vw, 290px); height: 205px; overflow: hidden; border: 1px solid var(--border); border-radius: 14px; background: var(--card); box-shadow: 0 18px 50px color-mix(in oklab, var(--foreground) 10%, transparent); opacity: .76; transition: opacity .45s, transform .45s, box-shadow .45s, border-color .45s; }
  .connected-app:before { content: ""; position: absolute; z-index: 3; top: 0; left: 0; width: 100%; height: 2px; background: var(--primary); opacity: 0; transition: opacity .4s; }
  .connected-app.active { opacity: 1; border-color: color-mix(in oklab, var(--primary) 55%, var(--border)); box-shadow: 0 22px 65px color-mix(in oklab, var(--primary) 19%, transparent); transform: translateY(-4px); }
  .connected-app.active:before { opacity: 1; }
  .connected-app > header { height: 46px; display: flex; align-items: center; gap: 9px; padding: 0 11px; border-bottom: 1px solid var(--border); }
  .connected-app > header > i { display: grid; place-items: center; width: 27px; height: 27px; border-radius: 7px; background: var(--foreground); color: var(--background); font: 7px ui-monospace, SFMono-Regular, Menlo, monospace; font-style: normal; }
  .connected-app > header > span { display: grid; }
  .connected-app > header b { font-size: 10px; }
  .connected-app > header small { color: var(--muted-foreground); font-size: 7px; }
  .connected-app > header em { margin-left: auto; color: var(--muted-foreground); font: 7px ui-monospace, SFMono-Regular, Menlo, monospace; font-style: normal; }
  .connected-app.active > header em { color: var(--primary); }
  .connected-app > footer { height: 28px; display: flex; align-items: center; justify-content: space-between; padding: 0 11px; color: var(--muted-foreground); font: 7px ui-monospace, SFMono-Regular, Menlo, monospace; }
  .connected-app > footer b { color: color-mix(in oklab, var(--muted-foreground) 70%, transparent); }
  .connected-app.active > footer b { color: var(--primary); text-shadow: 0 0 8px color-mix(in oklab, var(--primary) 50%, transparent); }
  .connected-app.compact { width: 190px; height: 126px; }
  .connected-app.compact > header { height: 40px; }
  .connected-app.compact > footer { height: 24px; }

  .app-email { top: 4%; left: 2.5%; }
  .app-approval { top: 4%; right: 2.5%; }
  .app-data { bottom: 4%; left: 2.5%; }
  .app-dashboard { right: 2.5%; bottom: 4%; }
  .app-notes { top: 42%; left: 21.5%; }
  .app-calendar { top: 42%; right: 21.5%; }

  /* OS core — dark island */
