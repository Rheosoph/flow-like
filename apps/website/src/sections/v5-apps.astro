---
import type { BoardRoute, MeasureText, PlacedNode, PlacedPin, Point } from "../components/v5/board/board-layout";
import { boardCurve, layoutBoard } from "../components/v5/board/board-layout";
import type { RGBA } from "../components/v5/board/board-paint";
import { BOARD_PALETTE_DARK, css, edgeColor, mix, pinColor } from "../components/v5/board/board-paint";
import type { BoardNodeKind, BoardScenarioId, BoardStrings } from "../components/v5/board/board-spec";
import { BOARD_STRING_KEYS, createBoard } from "../components/v5/board/board-spec";
import type { DescentApp, DescentData } from "../components/v5/descent/types";
import type { AppKind } from "../components/v5/descent/ui-draw";
import { APP_SPECS, ARC_ORDER, FIXTURES } from "../components/v5/descent/ui-draw";
import type { Lang, TranslationKey } from "../i18n";
import { defaultLang, translations } from "../i18n";

interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = (key: TranslationKey): string => {
  const localized = translations[lang] as Record<string, string>;
  const english = translations.en as Record<string, string>;
  return localized?.[key] ?? english[key] ?? key;
};
const tList = (key: TranslationKey): string[] => t(key).split("|");

const apps: DescentApp[] = [
  { name: "Operations HQ", category: t("v5.apps.cat.operations"), ui: { onTime: t("v5.apps.mini.ops.onTime"), liveRuns: t("v5.apps.mini.ops.liveRuns"), attention: t("v5.apps.mini.ops.attention") } },
  { name: "Finance Approvals", category: t("v5.apps.cat.finance"), ui: { dept: t("v5.apps.mini.finance.dept"), approve: t("v5.apps.mini.finance.approve"), review: t("v5.apps.mini.finance.review") } },
  { name: "Customer 360", category: t("v5.apps.cat.revenue"), ui: { healthScore: t("v5.apps.mini.customer.healthScore"), briefing: t("v5.apps.mini.customer.briefing") } },
  { name: "Knowledge Graph", category: t("v5.apps.cat.data"), ui: { customer: t("v5.apps.mini.graph.customer"), contract: t("v5.apps.mini.graph.contract"), product: t("v5.apps.mini.graph.product"), interaction: t("v5.apps.mini.graph.interaction") } },
  { name: "AI Control Center", category: t("v5.apps.cat.governance"), ui: { row1: t("v5.apps.mini.control.row1"), row2: t("v5.apps.mini.control.row2"), row3: t("v5.apps.mini.control.row3"), compliant: t("v5.apps.status.compliant"), reviewStatus: t("v5.apps.status.review") } },
  { name: "Inventory Planner", category: t("v5.apps.cat.supplyChain"), ui: {} },
  { name: "FlowPilot Workspace", category: t("v5.apps.cat.everyone"), ui: { prompt: t("v5.apps.mini.agent.prompt"), mail: t("v5.apps.mini.agent.mail"), data: t("v5.apps.mini.agent.data"), calendar: t("v5.apps.mini.agent.calendar") } },
  { name: "Field Service", category: t("v5.apps.cat.mobile"), ui: { nextVisit: t("v5.apps.mini.field.nextVisit"), startRoute: t("v5.apps.mini.field.startRoute") } },
];

const boardStrings = Object.fromEntries(BOARD_STRING_KEYS.map((key) => [key, t(key)])) as BoardStrings;

const scenarioIds: readonly BoardScenarioId[] = ["approval", "insight", "flowpilot"];
const descentData: DescentData = {
  strings: {
    kicker: t("v5.apps.sub.kicker"),
    h3: t("v5.apps.sub.h3"),
    sub: t("v5.apps.sub.p"),
    storeHeader: t("v5.apps.store.header"),
    storeCount: t("v5.apps.store.count"),
    cue: t("v5.apps.cue"),
    coreHeader: t("v5.apps.core.header"),
    processRunning: t("v5.apps.core.processRunning"),
    governed: t("v5.apps.core.governed"),
    ariaRail: t("v5.apps.aria.rail"),
    ariaSwitcher: t("v5.apps.aria.switcher"),
    ...boardStrings,
  },
  apps,
  arrivals: {
    approved: t("v5.apps.arrival.approved"),
    briefingReady: tList("v5.apps.flow.flowpilot.route").at(-1) ?? "",
    scheduled: t("v5.apps.cal.event"),
    live: t("v5.apps.state.live"),
    ready: t("v5.apps.state.ready"),
  },
  scenarios: scenarioIds.map((id) => ({
    label: t(`v5.apps.flow.${id}.label`),
    title: t(`v5.apps.flow.${id}.title`),
    detail: t(`v5.apps.flow.${id}.detail`),
    route: tList(`v5.apps.flow.${id}.route`),
  })),
  appFlowIndex: [1, 0, 2, 1, 2, 1, 2, 0],
  // Each story's hero is the app it lands in: Finance Approvals, the
  // Operations HQ dashboard, FlowPilot Workspace.
  scenarioAppIndex: [1, 0, 6],
};
const S = descentData.strings;
const dataJson = JSON.stringify(descentData).replace(/</g, "\\u003c");

const app0 = 0;
const scenario0 = descentData.appFlowIndex[app0];
const sc0 = descentData.scenarios[scenario0];

const esc = (s: string): string =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
// The brand never breaks at its hyphen.
const keepBrand = (s: string): string => esc(s).replace(/Flow-Like/g, '<span class="nobr">Flow-Like</span>');

// Static HTML faces of the app windows for the no-WebGL composition.
function miniApp(kind: AppKind, app: DescentApp): string {
  const ui = (key: string): string => esc(app.ui[key] ?? "");
  if (kind === "ops") {
    const labels = [ui("onTime"), ui("liveRuns"), ui("attention")];
    const tiles = FIXTURES.opsTiles.map((value, i) => `<span><b>${value}</b><small>${labels[i]}</small></span>`).join("");
    const bars = FIXTURES.opsBars.map((x) => `<i style="height:${x}%"></i>`).join("");
    return `<div class="mini ops-mini"><div class="metric-row">${tiles}</div><div class="bar-chart"><em>${ui("liveRuns")}</em>${bars}</div></div>`;
  }
  if (kind === "finance") {
    return `<div class="mini approval">${FIXTURES.financeRows
      .map((r, i) => `<div><span><b>${r[0]}</b><small>${ui("dept")}</small></span><em>${r[1]}</em><span class="btn${i === 1 ? " hot" : ""}">${i === 1 ? ui("approve") : ui("review")}</span></div>`)
      .join("")}</div>`;
  }
  if (kind === "customer") {
    const { initials, account, score } = FIXTURES.customer;
    return `<div class="mini customer"><aside><i></i><i></i><i></i><i></i></aside><section><div class="avatar">${initials}</div><span><b>${account}</b><small>${ui("healthScore")} · ${score}</small></span><div class="health"><i></i></div><p><em>✦</em>${ui("briefing")}</p></section></div>`;
  }
  if (kind === "graph") {
    const hub: [number, number] = [50, 52];
    const spokes: [string, number, number][] = [[ui("contract"), 24, 19.6], [ui("product"), 77, 17.2], [ui("interaction"), 72, 83.2]];
    const lines = spokes.map(([, x, y]) => `<line x1="${hub[0]}" y1="${hub[1]}" x2="${x}" y2="${y}" vector-effect="non-scaling-stroke"/>`).join("");
    const chips = spokes.map(([label, x, y]) => `<span class="g-node" style="left:${x}%;top:${y}%">${label}</span>`).join("");
    return `<div class="mini mini-graph"><svg viewBox="0 0 100 100" preserveAspectRatio="none">${lines}</svg><span class="g-node g1" style="left:${hub[0]}%;top:${hub[1]}%">${ui("customer")}</span>${chips}</div>`;
  }
  if (kind === "control") {
    const rows: [string, string, boolean][] = [[ui("row1"), ui("compliant"), false], [ui("row2"), ui("compliant"), false], [ui("row3"), ui("reviewStatus"), true]];
    return `<div class="mini control">${rows
      .map((r) => `<div${r[2] ? ' class="warn"' : ""}><i></i><b>${r[0]}</b><em>${r[1]}</em></div>`)
      .join("")}<span><i></i></span></div>`;
  }
  if (kind === "inventory") {
    return `<div class="mini inventory">${FIXTURES.inventoryRows
      .map((r, i) => `<div><b>${r[0]}</b><span><i${i === 2 ? ' class="hot"' : ""} style="width:${r[1]}%"></i></span><em>${r[2]}</em></div>`)
      .join("")}</div>`;
  }
  if (kind === "agent") {
    return `<div class="mini agent"><i class="orb">✦</i><p>${ui("prompt")}</p><div><span>${ui("mail")}</span><em>→</em><span>${ui("data")}</span><em>→</em><span class="hot">${ui("calendar")}</span></div></div>`;
  }
  const map = `<svg viewBox="0 0 116 104"><path class="road" d="M-18 78 134 30" stroke-width="9"/><path class="road" d="M8-10 94 114" stroke-width="7"/><path class="road" d="M-18 30 134 66" stroke-width="4"/><path class="trip" d="M14 90Q40 64 60.6 52"/><circle cx="64.6" cy="50" r="13"/><text x="64.6" y="54.5">${FIXTURES.field.stop}</text></svg>`;
  return `<div class="mini field"><header><i>${esc(app.name.charAt(0))}</i><b>${esc(app.name)}</b></header><div class="map">${map}</div><small>${ui("nextVisit")}</small><b>${FIXTURES.field.site}</b><span>${FIXTURES.field.eta}</span><em class="btn">${ui("startRoute")}</em></div>`;
}

// Two even rows of windows on wide screens: the operations row, then the data row.
const GALLERY_ORDER: readonly number[] = [0, 2, 1, 7, 3, 4, 5, 6];
const gallery = GALLERY_ORDER.map((index) => ({
  index,
  app: apps[index],
  spec: APP_SPECS[index],
  style: `--w:${APP_SPECS[index].w};--h:${APP_SPECS[index].h}`,
  html: miniApp(APP_SPECS[index].kind, apps[index]),
}));

// Static board: the board module's graph in the product's egui anatomy, as
// HTML cards over SVG wires. Rows keep the module's board units (y is scaled
// by --sy in CSS); columns are re-spaced for HTML type at 11px and stretch
// with the page (x in % of the board), and every wire is the module's egui
// curve between the re-spaced pins.
const estimateWidth: MeasureText = (text, font) => {
  const size = Number(/([\d.]+)px/.exec(font)?.[1] ?? 10);
  let em = 0;
  for (const ch of text) {
    const code = ch.codePointAt(0) ?? 0;
    em += code >= 0x2e80 ? 1 : ch === " " ? 0.3 : /[A-Z0-9]/.test(ch) ? 0.68 : 0.57;
  }
  return em * size;
};
const boardSpec = createBoard(boardStrings);
const boardLayout = layoutBoard(boardSpec, { measure: estimateWidth, fontFamily: "Inter" });
// The node each scenario's work lands on: where its last thread climbs back into an app.
const landingNode = (id: BoardScenarioId) => {
  const climbs = boardSpec.scenarios.find((entry) => entry.id === id)?.beats.flatMap((entry) => entry.threads).filter((hop) => hop.toApp);
  return boardSpec.threads.find((thread) => thread.id === climbs?.at(-1)?.id)?.node;
};
const BOARD_GUTTER = 40;
const labelNeed = (pin: PlacedPin) => estimateWidth(pin.label, "400 11px Inter") + 1;
const nodeNeed = (node: PlacedNode) => {
  const title = estimateWidth(node.title, "500 11px Inter");
  const rows = new Map<number, number>();
  for (const pin of node.pins) if (pin.label) rows.set(pin.y, (rows.get(pin.y) ?? 32) + labelNeed(pin));
  const needs = [150, 23 + title, ...rows.values()];
  if (node.pins.some((pin) => pin.kind === "reference")) needs.push(2 * (26 + title));
  return Math.max(...needs);
};
const nodeWidth = Math.min(264, 2 * Math.ceil(Math.max(...boardLayout.nodes.map(nodeNeed)) / 2));
const columnX = (column: number) => column * (nodeWidth + BOARD_GUTTER);
const pinX = (pin: PlacedPin) => (pin.kind === "reference" ? nodeWidth / 2 : pin.direction === "input" ? 0 : nodeWidth);
const pinPoint = (nodeId: PlacedNode["id"], pinId: string): readonly [Point, PlacedPin] => {
  const node = boardLayout.node(nodeId);
  const pin = node.pins.find((entry) => entry.id === pinId) ?? node.pins[0];
  return [[columnX(node.column) + pinX(pin), node.y + pin.y], pin];
};
const boardRight = Math.max(...boardLayout.nodes.map((node) => columnX(node.column) + nodeWidth));
const boardBottom = Math.max(...boardLayout.nodes.map((node) => node.y + node.height));
const pct = (x: number) => Math.round((x / boardRight) * 1e5) / 1e3;
const unit = (y: number) => Math.round(y * 100) / 100;
const onRoutes = (has: (route: BoardRoute) => boolean) =>
  scenarioIds.flatMap((id, i) => (has(boardLayout.routes[id]) ? [String(i)] : [])).join(" ");
const palette = BOARD_PALETTE_DARK;
const WHITE: RGBA = [255, 255, 255, 255];
const headerTint: Record<BoardNodeKind, RGBA> = {
  event: palette.primary,
  function: palette.function,
  pure: palette.tertiary,
  standard: palette.card,
};

const boardWires = boardLayout.edges.map((edge) => {
  const color = edgeColor(edge, palette);
  const [from, source] = pinPoint(edge.source.node, edge.source.pin);
  const [to, target] = pinPoint(edge.target.node, edge.target.pin);
  const points = boardCurve(
    { at: from, direction: source.direction, vertical: source.kind === "reference" },
    { at: to, direction: target.direction, vertical: target.kind === "reference" },
  );
  return {
    exec: edge.kind === "execution",
    on: onRoutes((route) => route.edges.includes(edge.id)),
    d: `M${points.map(([x, y]) => `${pct(x)} ${unit(y)}`).join("L")}`,
    style: `--wc:${css(color)};--wl:${css(mix(color, WHITE, 0.3))}`,
  };
});

const boardNodes = boardLayout.nodes.map((node) => {
  const labelled = node.pins.filter((pin) => pin.label);
  return {
    kind: node.kind,
    title: node.title,
    on: onRoutes((route) => route.nodes.includes(node.id)),
    land: scenarioIds.flatMap((id, i) => (landingNode(id) === node.id ? [String(i)] : [])).join(" "),
    hasRef: node.pins.some((pin) => pin.kind === "reference"),
    style: `left:${pct(columnX(node.column))}%;width:${pct(nodeWidth)}%;--y:${unit(node.y)};--h:${unit(node.height)};--tint:${css(headerTint[node.kind])}`,
    pins: node.pins.map((pin) => ({
      kind: pin.kind,
      side: pin.kind === "reference" ? "ref" : pin.direction === "input" ? "in" : "out",
      style: `--y:${unit(pin.y)};--pc:${css(pinColor(pin.kind, pin.type, palette))}`,
    })),
    // Two labels on one row split its spare room evenly, as layoutBoard's caps
    // do: each keeps its own need, so the longer label gets the wider cap.
    labels: labelled.map((pin) => {
      const other = labelled.find((entry) => entry.y === pin.y && entry.direction !== pin.direction);
      const shift = other ? `;--lw:${unit((labelNeed(pin) - labelNeed(other)) / 2)}` : "";
      return {
        text: pin.label,
        side: pin.direction === "input" ? "in" : "out",
        solo: !other,
        style: `--y:${unit(pin.y)}${shift}`,
      };
    }),
  };
});

const boardStyle = `--bh:${unit(boardBottom)};min-width:${Math.round(boardRight)}px;max-width:${Math.round(boardRight * 1.14)}px`;
---

<section id="apps" class="v5-apps apps" data-v5-apps data-scrollbar-surface="--apps-scrollbar" data-surface="light">
  <div class="section-head unified-head website-content-canvas">
    <span class="eyebrow">01 / {t("v5.apps.eyebrow")}</span>
    <div>
      <h2>{t("v5.apps.h2.l1")}<br />{t("v5.apps.h2.l2")}</h2>
      <p>{t("v5.apps.intro")}</p>
    </div>
  </div>

  <div class="apps-crew-rail" aria-hidden="true"><span data-bot-helper="apps" data-bot-travel="90" style="--helper-left:24px;--helper-right:auto"></span></div>
  <div class="descent" data-descent>
    <script is:inline>
      (function (track) {
        if (!track || typeof WebGL2RenderingContext === "undefined") return;
        var still = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        track.setAttribute("data-mode", still ? "pending-still" : "pending");
        window.addEventListener("load", function () {
          if (!track.hasAttribute("data-booted")) track.setAttribute("data-mode", "fallback");
        });
      })(document.currentScript && document.currentScript.parentNode);
    </script>
    <div class="stage" data-stage data-theme="light">
      <div class="scene-host" data-scene aria-hidden="true"></div>
      <div class="veil veil-top" data-veil-top aria-hidden="true"></div>
      <div class="veil veil-bottom" data-veil-bottom aria-hidden="true"></div>

      <div class="above" data-above>
        <div class="sub-head" data-sub-head>
          <span class="sub-kicker"><i></i> {S.kicker}</span>
          <h3>{S.h3}</h3>
          <p set:html={keepBrand(S.sub)} />
        </div>
        <div class="store-label"><i></i> {S.storeHeader} <b>{S.storeCount}</b></div>
        <div class="cue" data-cue aria-hidden="true"><i></i><span>{S.cue}</span></div>
      </div>

      <div class="fb-gallery" data-gallery aria-hidden="true" tabindex="-1">
        {gallery.map((win) => (
          <div class:list={["fb-win", `fb-win-${win.spec.kind}`]} style={win.style} data-app={win.index} data-selected={win.index === app0 ? "" : undefined}>
            {!win.spec.phone && (
              <header><i>{win.app.name.charAt(0)}</i><b>{win.app.name}</b><em>{win.app.category}</em></header>
            )}
            <div class="fb-body" set:html={win.html} />
          </div>
        ))}
      </div>

      <div class="dock" role="group" aria-label={S.ariaRail} data-dock>
        <div class="dock-rail" data-dock-rail>
          {ARC_ORDER.map((index) => (
            <button type="button" data-app={index} aria-pressed={index === app0 ? "true" : "false"} disabled>
              <i aria-hidden="true">{apps[index].name.charAt(0)}</i><b>{apps[index].name}</b><small>{apps[index].category}</small>
            </button>
          ))}
        </div>
      </div>

      <div class="scrim" data-scrim aria-hidden="true"></div>

      <div class="fb-board dark" data-board aria-hidden="true">
        <div class="fb-viewport" tabindex="-1">
          <div class="fb-graph" data-graph data-scenario={scenario0} style={boardStyle}>
            <svg class="fb-wires" viewBox={`0 0 100 ${unit(boardBottom)}`} preserveAspectRatio="none">
              {boardWires.map((wire) => wire.exec
                ? <path class="fb-w fb-w-exec" d={wire.d} data-on={wire.on} />
                : <g class="fb-w fb-w-data" data-on={wire.on} style={wire.style}><path d={wire.d} /><path d={wire.d} /></g>)}
            </svg>
            {boardNodes.map((node) => (
              <div class:list={["fb-node", node.hasRef && "fb-node-ref"]} data-on={node.on} data-land={node.land} style={node.style}>
                <header>
                  <svg class="fb-glyph" viewBox="6.5 4.5 7 7"><path d="M8.33 7.67V9l.67.67h1.33" /><rect x="7" y="5" width="2.67" height="2.67" rx=".67" /><rect x="10.33" y="8.33" width="2.67" height="2.67" rx=".67" /></svg>
                  <b>{node.title}</b>
                </header>
                {node.pins.map((pin) => <i class:list={["fb-pin", `fb-pin-${pin.kind}`, `fb-pin-${pin.side}`]} style={pin.style}></i>)}
                {node.labels.map((label) => <span class:list={["fb-lbl", `fb-lbl-${label.side}`, label.solo && "fb-lbl-solo"]} style={label.style}>{label.text}</span>)}
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="below dark" data-below>
        <div class="layer-head">
          <span class="layer-kicker"><span>{S.coreHeader}</span><span class="ls-status" data-role="status" data-state="done"><i></i><span>{S.governed}</span></span></span>
          <div class="scenarios" role="group" aria-label={S.ariaSwitcher} data-scenarios>
            {descentData.scenarios.map((item, index) => (
              <button type="button" aria-pressed={index === scenario0 ? "true" : "false"} disabled>
                <span class="sc-bar" aria-hidden="true"><i></i></span><i>0{index + 1}</i><b>{item.label}</b><small>{item.title}</small>
              </button>
            ))}
          </div>
        </div>
        <div class="layer-text" data-layer-text>
          <div class="layer-copy" aria-live="off" data-copy>
            <span class="layer-label" data-role="label">{apps[app0].name} / {sc0.label}</span>
            <h4 data-role="title">{sc0.title}</h4>
            <p data-role="detail">{sc0.detail}</p>
            <div class="route" data-role="route">
              {sc0.route.map((step, index) => (
                <>{index > 0 && <i aria-hidden="true">→</i>}<b data-lit>{step}</b></>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" is:inline data-v5-descent-data set:html={dataJson}></script>
</section>

<style>
  .eyebrow { font: 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .16em; color: var(--muted-foreground); }

  .apps { --mono: ui-monospace, SFMono-Regular, Menlo, monospace; --edge: var(--website-content-edge); --apps-scrollbar: var(--background); padding: 150px 0 0; background: var(--background); color: var(--foreground); overflow-x: clip; }
  .apps[data-surface="dark"] { --apps-scrollbar: #0c0e13; }
  .section-head { display: grid; grid-template-columns: 24% minmax(0, 1fr); padding: 0 clamp(22px, 6vw, 115px) 75px; }
  .apps .eyebrow { padding-top: 13px; color: var(--muted-foreground); }
  .section-head > div { display: flex; flex-direction: column; align-items: flex-start; gap: 34px; }
  .section-head h2 { margin: 0; font-size: clamp(54px, 6.1vw, 96px); line-height: .92; letter-spacing: -.065em; font-weight: 650; }
  .section-head p { align-self: flex-end; width: 380px; margin: 0; color: var(--muted-foreground); font-size: 15px; line-height: 1.55; }
  .unified-head { padding-bottom: 40px; }
  .section-head { position: relative; }
  .apps-crew-rail { position: relative; height: 1px; margin: 70px var(--website-content-edge) 0; background: var(--border); }
  .unified-head p { width: 440px; }
  .apps :is(h2, h3, h4):lang(ja) { word-break: auto-phrase; }
  .apps:lang(ja) { line-break: strict; }
  .apps :is(p, .layer-label, .scenarios b, .scenarios small):lang(ja) { word-break: auto-phrase; text-wrap: pretty; }
  .apps:lang(ko) { word-break: keep-all; overflow-wrap: break-word; }
  .apps :is(h2, h3, h4):lang(zh) { letter-spacing: -.01em; line-height: 1.08; }

  /* Descent. The base styles are the static composition (no JS, no WebGL, or a
     failed scene). The pinned modes put the stage over the WebGL scene; the
     still modes show one composed frame of it in normal flow. */
  .descent { position: relative; }
  .stage { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); padding-top: 110px; background: var(--background); color: var(--foreground); line-height: normal; }
  .scene-host, .veil, .scrim, .store-label, .cue { display: none; }
  .above { display: contents; }

  .sub-head { grid-row: 1; max-width: 560px; margin: 0 var(--edge) 10px; }
  .sub-kicker { display: inline-flex; align-items: center; gap: 9px; color: var(--primary); font: 11px/1 var(--mono); letter-spacing: .16em; text-transform: uppercase; }
  .sub-kicker > i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px color-mix(in oklab, var(--accent) 60%, transparent); }
  .sub-head h3 { margin: 14px 0 0; font-size: clamp(28px, 3vw, 42px); line-height: 1; letter-spacing: -.045em; font-weight: 650; }
  .sub-head p { margin: 14px 0 0; max-width: 430px; color: var(--muted-foreground); font-size: 15px; line-height: 1.55; }
  .store-label { align-items: center; gap: 10px; color: var(--muted-foreground); font: 11px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
  .store-label > i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px color-mix(in oklab, var(--accent) 60%, transparent); }
  .store-label b { color: var(--primary); font-weight: 600; }
  .cue { align-items: center; gap: 10px; color: var(--muted-foreground); font: 11px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; }
  .cue > i { position: relative; width: 1px; height: 26px; overflow: hidden; background: color-mix(in oklab, var(--muted-foreground) 35%, transparent); }
  .cue > i::after { content: ""; position: absolute; left: -1px; top: -8px; width: 3px; height: 8px; border-radius: 2px; background: var(--primary); animation: v5DescentCue 2.2s cubic-bezier(.6, 0, .3, 1) infinite; }
  @keyframes v5DescentCue { to { transform: translateY(42px); } }

  /* App dock: the accessible app selector. */
  .dock { grid-row: 3; position: relative; z-index: 3; display: flex; width: max-content; max-width: calc(100% - 24px); margin: 0 auto; overflow: hidden; border: 1px solid color-mix(in oklab, var(--border) 80%, transparent); border-radius: 16px; background: color-mix(in oklab, var(--card) 78%, transparent); backdrop-filter: blur(18px) saturate(1.2); box-shadow: 0 18px 50px rgb(18 18 22 / .08); transition: background .4s, border-color .4s, box-shadow .4s; }
  .dock-rail { position: relative; display: flex; flex: 1 1 auto; gap: 6px; min-width: 0; padding: 6px; overflow-x: auto; scrollbar-width: none; }
  .dock-rail::-webkit-scrollbar { display: none; }
  .dock[data-overflow] .dock-rail { padding-inline: 28px; scroll-padding-inline: 28px; mask-image: linear-gradient(90deg, transparent 2px, #000 28px, #000 calc(100% - 28px), transparent calc(100% - 2px)); }
  .dock button { flex: 0 0 auto; scroll-margin-block: 16px; display: grid; grid-template-columns: 26px auto; column-gap: 9px; align-items: center; min-height: 44px; padding: 6px 12px 6px 7px; border: 1px solid transparent; border-radius: 11px; background: transparent; color: var(--foreground); font: inherit; text-align: left; cursor: pointer; transition: background .25s, color .25s, border-color .25s; }
  .dock button > i { grid-row: span 2; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: linear-gradient(135deg, #ff7a45, var(--primary) 55%, #e2361d); color: #fff; font-size: 12px; font-weight: 700; font-style: normal; line-height: 1; }
  .dock button b { font-size: 12.5px; font-weight: 640; letter-spacing: -.01em; white-space: nowrap; }
  .dock button small { font-size: 11px; color: var(--muted-foreground); white-space: nowrap; }
  .dock button:hover { background: rgb(18 18 22 / .05); }
  .dock button[aria-pressed="true"] { background: var(--foreground); color: #fff; }
  .dock button[aria-pressed="true"] small { color: #b4b4bc; }
  .dock button:focus-visible, .scenarios button:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .dock[data-away] { pointer-events: none; }
  .dock[data-away] button { scroll-margin-block: 0; }

  /* Operating-layer copy: the band under the picture. No rules: air separates
     the head row (kicker, scenario tabs) from the copy. The label stays for
     screen readers; the selected window and the route say it on screen. */
  .below { grid-row: 5; padding: 0 var(--edge) 96px; background: var(--background); color: var(--foreground); }
  .layer-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 32px; margin-bottom: 18px; }
  .layer-kicker { display: flex; align-items: center; gap: 20px; min-width: 0; color: var(--muted-foreground); font: 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; white-space: nowrap; }
  .ls-status { display: inline-flex; align-items: center; gap: 8px; color: #8d929b; transition: color .35s; }
  .ls-status > i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .ls-status[data-state="running"] { color: var(--accent); }
  .ls-status[data-state="running"] > i { animation: v5DescentBeat 1.15s ease-in-out infinite; }
  @keyframes v5DescentBeat { 50% { opacity: .3; box-shadow: none; } }
  .layer-text { display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; }
  .layer-text > * { grid-area: 1 / 1; }
  .layer-ghost { visibility: hidden; pointer-events: none; }
  .layer-label, .scenarios small { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* A changed story's copy fades out while the old route dims, and back in with the new one. */
  .layer-copy { transition: opacity .24s ease; }
  .layer-copy[data-swap] { opacity: 0; transition-duration: .12s; }
  .layer-copy h4 { margin: 0; font-size: clamp(26px, 2.4vw, 34px); line-height: 1.02; letter-spacing: -.045em; font-weight: 640; }
  .layer-copy p { margin: 10px 0 0; max-width: 820px; color: #a9adb6; font-size: 15px; line-height: 1.5; }
  .route { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 16px; }
  /* Scenario tabs: the running scenario fills its tab instead of drawing a bar;
     the fill's leading edge is a soft gradient, never a seam. */
  .scenarios { display: flex; gap: 4px; margin-inline-start: auto; }
  .scenarios button { position: relative; display: inline-flex; align-items: baseline; gap: 8px; min-height: 34px; padding: 8px 14px; overflow: hidden; border: 0; border-radius: 999px; background: transparent; color: #8d929b; font: inherit; font-size: 13px; font-weight: 560; line-height: 1.3; white-space: nowrap; cursor: pointer; transition: color .25s, background .25s; }
  .scenarios button > :is(i, b) { position: relative; }
  .scenarios button > i { font: 10.5px/1 var(--mono); font-style: normal; letter-spacing: .08em; color: #8d929b; transition: color .25s; }
  .scenarios button > b { font-weight: inherit; }
  .scenarios button:hover { color: var(--foreground); }
  .scenarios button[aria-pressed="true"] { background: rgb(255 255 255 / .06); color: var(--foreground); }
  .scenarios button[aria-pressed="true"] > i { color: #ff8a6b; }
  .scenarios button > .sc-bar { --feather: 36px; position: absolute; inset: 0; display: block; overflow: hidden; border-radius: inherit; opacity: 0; pointer-events: none; }
  .scenarios button > .sc-bar > i { display: block; width: calc(100% + var(--feather)); height: 100%; background: linear-gradient(90deg, rgb(251 86 45 / .13) calc(100% - var(--feather)), rgb(251 86 45 / 0)); transform: translateX(-100%); }
  .scenarios button[aria-pressed="true"] > .sc-bar[data-on] { opacity: 1; transition: opacity .3s; }

  /* Static gallery of the app windows, at the scale the scene shows them. */
  .fb-gallery { position: relative; grid-row: 2; display: flex; flex-wrap: wrap; gap: 26px 18px; justify-content: center; align-items: flex-end; padding: 40px 24px 56px; background: radial-gradient(60% 46% at 50% 100%, #efe8e3, transparent 72%); }
  .fb-win { flex: 0 0 auto; width: calc(var(--w) * 1px); height: calc(var(--h) * 1px); overflow: hidden; border-radius: 13px; background: #f5f1ef; color: #121216; line-height: 1.2; box-shadow: 0 1px 0 #fff inset, 0 38px 64px rgb(42 30 24 / .14), 0 3px 10px rgb(42 30 24 / .08); transition: box-shadow .3s; }
  .fb-win[data-selected] { box-shadow: 0 0 0 2px var(--primary), 0 0 26px rgb(251 86 45 / .28), 0 38px 64px rgb(42 30 24 / .14); }
  .fb-win > header { display: flex; align-items: center; gap: 7px; height: 37px; padding: 0 10px; border-bottom: 1px solid #e2dad5; background: #fff; }
  .fb-win > header > i { flex: none; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 6px; background: linear-gradient(135deg, #ff7a45, var(--primary) 55%, #e2361d); color: #fff; font-size: 11px; font-weight: 750; font-style: normal; }
  .fb-win > header > b { flex: 1; min-width: 0; overflow: hidden; font-size: 13.5px; font-weight: 650; white-space: nowrap; text-overflow: ellipsis; }
  .fb-win > header > em { flex: none; padding: 3px 9px; border-radius: 10px; background: #efeae7; color: #666670; font-size: 11px; font-weight: 560; font-style: normal; white-space: nowrap; }
  .fb-win-agent { background: #13161b; color: #f3efec; }
  .fb-win-agent > header { border-color: #282c33; background: #171a20; }
  .fb-win-agent > header > em { background: #22252b; color: #999ea8; }
  .fb-win-field { border-radius: 20px; background: #fff; }
  .fb-body { height: calc(100% - 37px); }
  .fb-win-field .fb-body { height: 100%; }

  /* Static board of the operating layer, painted like the product's board. */
  .fb-board { --sy: 1.1; grid-row: 4; margin-top: 46px; padding: 44px var(--edge) 56px; border-top: 1px solid rgb(251 86 45 / .35); background: var(--background); box-shadow: 0 -1px 24px rgb(251 86 45 / .25); }
  .fb-viewport { margin: 0 -10px; padding: 34px 10px 12px; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-color: #2a2e35 transparent; scrollbar-width: thin; }
  .fb-graph { position: relative; height: calc(var(--sy) * var(--bh) * 1px); margin: 0 auto; color: #f3efec; }
  /* On wide screens the board is a supporting picture of about 64% of the
     stage, scaled whole so no label loses room; the band carries the copy. */
  @media (min-width: 1101px) { .fb-graph { zoom: .64; } }
  @media (min-width: 1400px) { .fb-graph { zoom: .7; } }
  .fb-wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .fb-w, .fb-w path { fill: none; stroke-linecap: butt; vector-effect: non-scaling-stroke; transition: opacity .3s; }
  .fb-w-exec { stroke: rgb(243 239 236 / .7); stroke-width: 2; }
  .fb-w-data path { stroke-dasharray: 1.65 4.4; }
  .fb-w-data path:first-child { stroke: var(--wc); stroke-opacity: .35; stroke-width: 1.5; }
  .fb-w-data path:last-child { stroke: var(--wl); stroke-opacity: .5; stroke-width: 1; }
  .fb-node { position: absolute; top: calc(var(--sy) * var(--y) * 1px); z-index: 1; height: calc(var(--sy) * var(--h) * 1px); border-radius: calc(var(--sy) * 4.4px); background: #13161b; box-shadow: inset 0 0 0 1px #282c33; transition: opacity .3s, box-shadow .3s; }
  .fb-node > header { position: absolute; top: 1px; left: 1px; right: 1px; height: calc(var(--sy) * 15px); border-radius: calc(var(--sy) * 3.4px) calc(var(--sy) * 3.4px) 0 0; border-bottom: 1px solid #282c33; background: linear-gradient(90deg, #13161b, var(--tint)); }
  .fb-glyph { position: absolute; top: calc(var(--sy) * 3.5px); left: calc(var(--sy) * 5.5px); width: calc(var(--sy) * 7px); height: calc(var(--sy) * 7px); fill: none; stroke: currentColor; stroke-width: .5; }
  .fb-node > header > b { position: absolute; top: 50%; left: calc(var(--sy) * 16px); right: 6px; overflow: hidden; font-size: 11px; font-weight: 500; line-height: 1.2; white-space: nowrap; text-overflow: ellipsis; transform: translateY(-50%); }
  .fb-node-ref > header > b { right: calc(50% + var(--sy) * 8px); }
  .fb-pin { position: absolute; top: calc(var(--sy) * var(--y) * 1px); z-index: 1; }
  .fb-pin-in { left: 0; }
  .fb-pin-out { left: 100%; }
  .fb-pin-ref { left: 50%; }
  .fb-pin-execution { width: calc(var(--sy) * 8px); height: calc(var(--sy) * 8px); background: var(--pc); transform: translate(-50%, -50%) rotate(45deg); }
  .fb-pin-data { width: calc(var(--sy) * 7px); height: calc(var(--sy) * 7px); border-radius: 50%; background: radial-gradient(circle at 35% 35%, color-mix(in srgb, var(--pc), #fff 20%), var(--pc) 72%); box-shadow: 0 0 0 calc(var(--sy) * .6px) var(--pc); transform: translate(-50%, -50%); }
  .fb-pin-reference { width: calc(var(--sy) * 12px); height: calc(var(--sy) * 12px); border-radius: calc(var(--sy) * 2.4px); background: var(--pc); box-shadow: inset 0 0 0 calc(var(--sy) * 1px) color-mix(in srgb, var(--pc), #fff 14%); transform: translate(-50%, -50%); }
  .fb-lbl { position: absolute; top: calc(var(--sy) * var(--y) * 1px); max-width: calc(50% - var(--sy) * 16px + var(--lw, 0) * 1px); overflow: hidden; font-size: 11px; line-height: 1.3; white-space: nowrap; text-overflow: ellipsis; transform: translateY(-50%); }
  .fb-lbl-in { left: calc(var(--sy) * 10px); }
  .fb-lbl-out { right: calc(var(--sy) * 10px); text-align: right; }
  .fb-lbl-solo { max-width: calc(100% - var(--sy) * 20px); }
  /* Only the scenario's story: the nodes off its route are a whisper and their wires are gone. */
  .fb-graph[data-scenario="0"] .fb-node:not([data-on~="0"]),
  .fb-graph[data-scenario="1"] .fb-node:not([data-on~="1"]),
  .fb-graph[data-scenario="2"] .fb-node:not([data-on~="2"]) { opacity: .12; color: #999ea8; }
  .fb-graph[data-scenario="0"] .fb-w:not([data-on~="0"]),
  .fb-graph[data-scenario="1"] .fb-w:not([data-on~="1"]),
  .fb-graph[data-scenario="2"] .fb-w:not([data-on~="2"]) { opacity: 0; }
  .fb-graph[data-scenario="0"] .fb-node[data-on~="0"],
  .fb-graph[data-scenario="1"] .fb-node[data-on~="1"],
  .fb-graph[data-scenario="2"] .fb-node[data-on~="2"] { box-shadow: inset 0 0 0 1.5px #fb562d; }
  .fb-graph[data-scenario="0"] .fb-w-exec[data-on~="0"],
  .fb-graph[data-scenario="1"] .fb-w-exec[data-on~="1"],
  .fb-graph[data-scenario="2"] .fb-w-exec[data-on~="2"] { stroke: rgb(243 239 236 / .9); stroke-width: 3; }
  .fb-graph[data-scenario="0"] .fb-w-data[data-on~="0"] path:first-child,
  .fb-graph[data-scenario="1"] .fb-w-data[data-on~="1"] path:first-child,
  .fb-graph[data-scenario="2"] .fb-w-data[data-on~="2"] path:first-child { stroke-opacity: .5; stroke-width: 2.5; }
  .fb-graph[data-scenario="0"] .fb-w-data[data-on~="0"] path:last-child,
  .fb-graph[data-scenario="1"] .fb-w-data[data-on~="1"] path:last-child,
  .fb-graph[data-scenario="2"] .fb-w-data[data-on~="2"] path:last-child { stroke-opacity: .8; stroke-width: 1.5; }

  /* Pinned stage for the WebGL scene (≈1.2 extra viewports of scroll). The
     stage is 100svh, so the track behind it shows under the stage while a
     phone's toolbar is hidden; it takes the dark ground with the scene. */
  .descent:is([data-mode="pending"], [data-mode="motion"]) { height: 220vh; height: 220svh; }
  .descent:has(> .stage[data-theme="dark"]) { background: #0c0e13; }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .stage { position: sticky; top: 0; display: block; height: 100vh; height: 100svh; padding: 0; overflow: hidden; isolation: isolate; }
  .descent[data-mode]:not([data-mode="fallback"]) :is(.fb-gallery, .fb-board) { display: none; }
  .descent[data-mode^="pending"] .below { visibility: hidden; }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .scene-host { display: block; position: absolute; inset: 0; z-index: 0; }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .veil { display: block; position: absolute; left: 0; right: 0; z-index: 1; pointer-events: none; }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .veil-top { top: 0; height: 120px; background: linear-gradient(var(--background), rgb(252 249 248 / 0)); }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .veil-bottom { bottom: 0; height: 26vh; background: linear-gradient(rgb(12 14 19 / 0), #0c0e13 92%); opacity: 0; }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .above { display: block; position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .sub-head { position: absolute; top: 108px; left: var(--edge); width: min(520px, calc(100% - 2 * var(--edge))); max-width: none; margin: 0; }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .store-label { display: flex; position: absolute; top: 116px; right: var(--edge); }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .cue { display: flex; position: absolute; right: var(--edge); bottom: 104px; }
  /* The scrim covers only the band, from a short lead-in above it (--scrim-h,
     measured by the controller), so the lit route keeps its brightness. */
  .scrim { --scrim-lead: 44px; }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .scrim { display: block; position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; height: var(--scrim-h, 34%); pointer-events: none; opacity: 0; background: linear-gradient(rgb(12 14 19 / 0), rgb(12 14 19 / .9) var(--scrim-lead), rgb(12 14 19 / .94)); }
  /* Beneath there is no dock: the band takes its place at the foot of the stage. */
  .descent { --band-foot: clamp(28px, 6.4svh, 60px); }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .below { position: absolute; z-index: 2; left: var(--edge); right: var(--edge); bottom: var(--band-foot); padding: 0; background: none; opacity: 0; pointer-events: none; }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .below.on { pointer-events: auto; }
  .descent:is([data-mode="pending"], [data-mode="motion"]) .dock { position: absolute; left: 50%; bottom: 26px; width: auto; max-width: calc(100% - 32px); margin: 0; transform: translateX(-50%); }

  /* Reduced motion: no pin. The sub-head sits in flow on the porcelain, a short
     gradient turns dark, and one composed still of the operating layer follows.
     The still is the view beneath, so the dock is there for keyboards only: its
     buttons ring their window on focus, and it sits at the still's top, where
     the windows are, so the browser's focus scroll lands on them. */
  .descent:is([data-mode="reduced"], [data-mode="pending-still"]) .stage { padding: 0; background: #0c0e13; }
  .descent:is([data-mode="reduced"], [data-mode="pending-still"]) .above { display: flex; grid-row: 1; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 18px 40px; padding: 110px var(--edge) 170px; background: linear-gradient(var(--background) calc(100% - 160px), color-mix(in oklab, var(--background), #0c0e13 8%) calc(100% - 128px), color-mix(in oklab, var(--background), #0c0e13 34%) calc(100% - 92px), color-mix(in oklab, var(--background), #0c0e13 72%) calc(100% - 52px), color-mix(in oklab, var(--background), #0c0e13 94%) calc(100% - 20px), #0c0e13); }
  .descent:is([data-mode="reduced"], [data-mode="pending-still"]) .sub-head { margin: 0; }
  .descent:is([data-mode="reduced"], [data-mode="pending-still"]) .store-label { display: flex; margin-top: 6px; }
  .descent:is([data-mode="reduced"], [data-mode="pending-still"]) :is(.scene-host, .veil-bottom, .scrim, .below, .dock) { grid-row: 2; grid-column: 1; }
  .descent:is([data-mode="reduced"], [data-mode="pending-still"]) .scene-host { display: block; position: relative; height: 100vh; height: 100svh; }
  .descent:is([data-mode="reduced"], [data-mode="pending-still"]) :is(.veil-bottom, .scrim) { display: block; align-self: end; position: relative; z-index: 1; pointer-events: none; }
  .descent:is([data-mode="reduced"], [data-mode="pending-still"]) .veil-bottom { height: 26vh; background: linear-gradient(rgb(12 14 19 / 0), #0c0e13 92%); }
  .descent:is([data-mode="reduced"], [data-mode="pending-still"]) .scrim { height: var(--scrim-h, 34%); background: linear-gradient(rgb(12 14 19 / 0), rgb(12 14 19 / .9) var(--scrim-lead), rgb(12 14 19 / .94)); }
  .descent:is([data-mode="reduced"], [data-mode="pending-still"]) .below { align-self: end; position: relative; z-index: 2; margin: 0 var(--edge) var(--band-foot); padding: 0; background: none; }
  .descent:is([data-mode="reduced"], [data-mode="pending-still"]) .dock { position: absolute; left: 0; top: 0; width: 1px; height: 1px; margin: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Where the kicker and the tabs no longer share a row, the tabs sit under
     the kicker, their labels on the copy's left edge. */
  @media (max-width: 1180px) {
    .layer-head { flex-direction: column; align-items: flex-start; gap: 10px; }
    .scenarios { margin-inline-start: -14px; }
  }

  @media (max-width: 1100px) {
    .fb-board { --sy: 1; padding-inline: 0; }
    .fb-viewport { margin: 0; padding-inline: 24px; scroll-padding-inline: 24px; mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent); }
    .descent:is([data-mode="pending"], [data-mode="motion"]) .store-label { display: none; }
  }

  @media (max-width: 1050px) {
    .section-head { grid-template-columns: 18% minmax(0, 1fr); }
    .section-head > div { gap: 30px; }
  }

  /* Short desktop viewports (a laptop with browser chrome): a tighter band
     leaves the scene more of the frame above it. */
  @media (min-width: 801px) and (max-height: 820px) {
    .layer-head { margin-bottom: 14px; }
    .layer-copy h4 { font-size: clamp(24px, 2.1vw, 30px); }
    .layer-copy p { margin-top: 7px; font-size: 14.5px; line-height: 1.45; }
    .route { margin-top: 12px; }
  }

  @media (max-width: 800px) {
    .apps { padding: 100px 0 0; }
    .section-head { display: block; padding: 0 22px 50px; }
    .section-head > .eyebrow { display: block; margin-bottom: 22px; }
    .section-head > div { display: block; }
    .section-head h2 { font-size: 55px; }
    /* Eight kana per line at phone widths, so the one compound too long for a
       line (オペレーティングシステム) breaks between its two words. */
    .section-head h2:lang(ja) { font-size: clamp(36px, 11.2vw, 55px); }
    /* Long compounds that must fit a phone line whole. */
    .section-head h2:lang(nl) { font-size: min(55px, 10.8vw); }
