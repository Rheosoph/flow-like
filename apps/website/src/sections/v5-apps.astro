  .v5-apps .mail-canvas > div > i { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: color-mix(in oklab, var(--primary) 8%, var(--card)); color: var(--primary); font: 7px ui-monospace, SFMono-Regular, Menlo, monospace; font-style: normal; }
  .v5-apps .mail-canvas > div > span { display: grid; }
  .v5-apps .mail-canvas b { font-size: 8px; }
  .v5-apps .mail-canvas small { color: var(--muted-foreground); font-size: 6px; }
  .v5-apps .mail-canvas em { color: var(--primary); font: 6px ui-monospace, SFMono-Regular, Menlo, monospace; font-style: normal; }

  .v5-apps .notes-canvas, .v5-apps .calendar-canvas { height: 62px; padding: 8px 10px; background: color-mix(in oklab, var(--muted) 70%, var(--background)); }
  .v5-apps .notes-canvas span { font-size: 7px; font-weight: 700; }
  .v5-apps .notes-canvas p { margin: 3px 0; color: var(--muted-foreground); font-size: 6px; line-height: 1.3; }
  .v5-apps .notes-canvas > i { color: var(--primary); font: 6px ui-monospace, SFMono-Regular, Menlo, monospace; font-style: normal; }
  .v5-apps .calendar-canvas { display: grid; grid-template-columns: auto 1fr; column-gap: 9px; align-items: center; }
  .v5-apps .calendar-canvas > span { grid-row: span 2; display: grid; place-items: center; width: 36px; height: 42px; border-radius: 6px; background: var(--foreground); color: var(--background); }
  .v5-apps .calendar-canvas > span b { font-size: 15px; line-height: 1; }
  .v5-apps .calendar-canvas > span small { font-size: 6px; }
  .v5-apps .calendar-canvas p { margin: 2px 0 0; font-size: 8px; font-weight: 700; }
  .v5-apps .calendar-canvas > i { color: var(--muted-foreground); font-size: 6px; font-style: normal; }
</style>

<script is:inline define:vars={{ carouselApps, appFlows, appFlowIndex, scenarioAppIndex, labels }}>
  function initV5Apps() {
    const root = document.querySelector("[data-v5-apps]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let selectedIndex = 0;
    let flowIndex = appFlowIndex[0];

    const cards = [...root.querySelectorAll("[data-app-card]")];
    const rail = root.querySelector("[data-rail]");
    const ecosystem = root.querySelector("[data-ecosystem]");
    const links = [...root.querySelectorAll("[data-link]")];
    const apps = [...root.querySelectorAll("[data-connected]")];
    const scenarios = [...root.querySelectorAll("[data-scenario]")];

    const bridgeLetter = root.querySelector("[data-role='bridge-letter']");
    const bridgeName = root.querySelector("[data-role='bridge-name']");
    const bridgeCat = root.querySelector("[data-role='bridge-cat']");
    const bridgeRight = root.querySelector("[data-role='bridge-right']");
    const coreLabel = root.querySelector("[data-role='core-label']");
    const coreTitle = root.querySelector("[data-role='core-title']");
    const coreDetail = root.querySelector("[data-role='core-detail']");
    const coreRoute = root.querySelector("[data-role='core-route']");

    const ecosystemAria = ecosystem ? ecosystem.getAttribute("aria-label") : null;

    const core = root.querySelector(".os-core");

    const centerIn = (el, originRect) => {
      const r = el.getBoundingClientRect();
      return [r.left + r.width / 2 - originRect.left, r.top + r.height / 2 - originRect.top];
    };

    const placeBar = (bar, ax, ay, bx, by) => {
      const [x1, y1, x2, y2] = ax <= bx ? [ax, ay, bx, by] : [bx, by, ax, ay];
      const dx = x2 - x1;
      const dy = y2 - y1;
      bar.style.left = `${x1}px`;
      bar.style.top = `${y1}px`;
      bar.style.width = `${Math.hypot(dx, dy)}px`;
      bar.style.transform = `rotate(${(Math.atan2(dy, dx) * 180) / Math.PI}deg)`;
    };

    const layoutConnectors = () => {
      if (ecosystem && core && ecosystem.clientWidth) {
        const originRect = ecosystem.getBoundingClientRect();
        const coreCenter = centerIn(core, originRect);
        links.forEach((link) => {
          if (getComputedStyle(link).display === "none") return;
          const card = root.querySelector(`[data-connected="${link.dataset.link}"]`);
          if (!card || !card.offsetWidth) return;
          const [x1, y1] = centerIn(card, originRect);
          placeBar(link, x1, y1, coreCenter[0], coreCenter[1]);
        });
      }

      root.querySelectorAll(".mini-graph").forEach((graph) => {
        if (!graph.clientWidth) return;
        const hub = graph.querySelector(".g1");
        if (!hub) return;
        const originRect = graph.getBoundingClientRect();
        const [hx, hy] = centerIn(hub, originRect);
        graph.querySelectorAll(".g-line").forEach((line, index) => {
          const target = graph.querySelector(`.g${index + 2}`);
          if (!target) return;
          const [tx, ty] = centerIn(target, originRect);
          placeBar(line, hx, hy, tx, ty);
        });
      });
    };

    const render = () => {
      const flow = appFlows[flowIndex];
      const selectedApp = carouselApps[selectedIndex];
      const active = (id) => flow.nodes.includes(id);

      cards.forEach((card, index) => {
        const on = index === selectedIndex;
        card.classList.toggle("selected", on);
        card.setAttribute("aria-pressed", String(on));
        const foot = card.querySelector("[data-card-footer-span]");
        const flag = card.querySelector("[data-card-footer-b]");
        if (foot) foot.textContent = on ? labels.connectedLayer : labels.builtWith;
        if (flag) flag.textContent = on ? labels.liveFlag : labels.selectApp;
      });

      if (ecosystem) {
        ecosystem.className = "ecosystem flow-" + flow.id;
        if (ecosystemAria) ecosystem.setAttribute("aria-label", ecosystemAria);
      }

      links.forEach((link) => link.classList.toggle("active", active(link.dataset.link)));

      apps.forEach((app) => {
        const on = active(app.dataset.connected);
        app.classList.toggle("active", on);
        const em = app.querySelector("[data-role='app-em']");
        const footSpan = app.querySelector("[data-role='app-foot-span']");
        const footB = app.querySelector("[data-role='app-foot-b']");
        if (em) em.textContent = on ? labels.live : labels.ready;
        if (footSpan) footSpan.textContent = on ? labels.exchanging : labels.connected;
        if (footB) footB.textContent = on ? "●" : "○";
      });

      if (bridgeLetter) bridgeLetter.textContent = selectedApp[0][0];
      if (bridgeName) bridgeName.textContent = selectedApp[0];
      if (bridgeCat) bridgeCat.textContent = selectedApp[1] + " " + labels.frontendSelected;
      if (bridgeRight) bridgeRight.textContent = flow.label;

      if (coreLabel) coreLabel.textContent = selectedApp[0] + " / " + flow.label;
      if (coreTitle) coreTitle.textContent = flow.title;
      if (coreDetail) coreDetail.textContent = flow.detail;
      if (coreRoute) {
        coreRoute.innerHTML = flow.route
          .map((step, index) => {
            const arrow = index < flow.route.length - 1 ? "<i>→</i>" : "";
            const safe = step.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            return "<span><b>" + safe + "</b>" + arrow + "</span>";
          })
          .join("");
      }

      scenarios.forEach((button, index) => {
        const on = index === flowIndex;
        button.classList.toggle("active", on);
        button.setAttribute("aria-pressed", String(on));
      });

      layoutConnectors();
    };

    const selectApp = (index) => {
      selectedIndex = index;
      flowIndex = appFlowIndex[index];
      render();
    };

    const selectScenario = (index) => {
      flowIndex = index;
      selectedIndex = scenarioAppIndex[index];
      render();
    };

    const moveRail = (direction) => {
      if (!rail) return;
      rail.scrollBy({ left: direction * 720, behavior: reduced ? "auto" : "smooth" });
    };

    cards.forEach((card, index) => {
      card.addEventListener("click", () => selectApp(index));
      card.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          selectApp(index);
        }
      });
    });

    root.querySelector("[data-rail-prev]")?.addEventListener("click", () => moveRail(-1));
    root.querySelector("[data-rail-next]")?.addEventListener("click", () => moveRail(1));

    scenarios.forEach((button, index) => {
      button.addEventListener("click", () => selectScenario(index));
    });

    let resizeRaf = 0;
    window.addEventListener("resize", () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(layoutConnectors);
    });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(layoutConnectors);

    render();
  }

  initV5Apps();
</script>
