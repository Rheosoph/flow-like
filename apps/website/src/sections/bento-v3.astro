<style>
  .bento-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
  }
  .bento-orb--blue {
    width: 500px;
    height: 500px;
    top: -80px;
    left: -100px;
    background: radial-gradient(circle, hsl(222 89% 60% / 0.1), transparent 70%);
  }
  .bento-orb--green {
    width: 400px;
    height: 400px;
    bottom: -60px;
    right: -80px;
    background: radial-gradient(circle, hsl(161 50% 45% / 0.08), transparent 70%);
  }

  .bento-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .bento-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .bento-tile {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .bento-tile:hover {
    transform: translateY(-4px) scale(1.01);
    box-shadow: 0 12px 32px -8px hsl(0 0% 0% / 0.12);
  }

  .bento-tile__svg {
    border-bottom: 1px solid hsl(0 0% 50% / 0.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-reveal {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .bento-tile {
      transition: none !important;
    }
    .bento-tile:hover {
      transform: none !important;
    }
  }
</style>

<script>
  function initBentoReveal() {
    const els = document.querySelectorAll(".bento-section .bento-reveal");
    if (!("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    els.forEach((el) => io.observe(el));
  }

  initBentoReveal();
</script>
