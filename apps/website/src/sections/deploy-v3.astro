<section class="deploy-section relative isolate overflow-hidden py-24 md:py-32">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="deploy-orb deploy-orb--blue"></div>
    <div class="deploy-orb deploy-orb--purple"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="deploy-reveal mx-auto max-w-3xl text-center mb-14 md:mb-18">
      <span class="inline-block rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-xs font-medium text-primary mb-6">
        {t("v3.deploy.label")}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight mb-6">
        {t("v3.deploy.headline")}
      </h2>
      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
        {t("v3.deploy.description")}
      </p>
    </div>

    <!-- Two-column feature cards -->
    <div class="deploy-reveal grid md:grid-cols-2 gap-6">

      <!-- Left card: Built for Developers -->
      <div class="deploy-card rounded-2xl border border-border/40 bg-card/60 backdrop-blur-sm p-7 flex flex-col gap-6">
        <div>
          <h3 class="text-xl font-semibold tracking-tight mb-1">{t("v3.dev.feature.langs")}</h3>
          <p class="text-sm text-muted-foreground">{t("v3.dev.feature.langs.desc")}</p>
        </div>

        <ul class="flex flex-col gap-3">
          {devBullets.map((bullet) => (
            <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
              <svg class="mt-0.5 shrink-0 text-primary" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
                <path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>

        <div class="mt-auto">
          <p class="text-xs font-medium text-muted-foreground/60 uppercase tracking-widest mb-3">Supported languages and frameworks</p>
          <div class="flex flex-wrap gap-2">
            {langIcons.map((icon) => (
              <div
                class="flex items-center justify-center rounded-lg border border-border/40 bg-background/50 w-9 h-9 hover:border-primary/40 hover:bg-primary/5 transition-colors"
                title={icon.label}
                aria-label={icon.label}
                set:html={icon.svg}
              />
            ))}
          </div>
        </div>
      </div>

      <!-- Right card: Runs everywhere -->
      <div class="deploy-card rounded-2xl border border-border/40 bg-card/60 backdrop-blur-sm p-7 flex flex-col gap-6">
        <div>
          <h3 class="text-xl font-semibold tracking-tight mb-1">Runs everywhere</h3>
          <p class="text-sm text-muted-foreground">Build once, deploy anywhere — from a single binary to a full cloud cluster.</p>
        </div>

        <div class="grid grid-cols-3 gap-3 flex-1">
          {cloudTargets.map((target) => (
            <div
              class="deploy-cloud-tile flex flex-col items-center justify-center gap-2 rounded-xl border border-border/40 bg-background/50 py-4 px-2 hover:border-primary/30 hover:bg-primary/5 transition-all duration-200 cursor-default"
              aria-label={target.label}
            >
              <div set:html={target.svg} />
              <span class="text-xs font-medium text-muted-foreground/80 text-center leading-tight">{target.label}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .deploy-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.35;
  }
  .deploy-orb--blue {
    width: 500px;
    height: 500px;
    top: -80px;
    left: -100px;
    background: radial-gradient(circle, hsl(222 89% 60% / 0.12), transparent 70%);
  }
  .deploy-orb--purple {
    width: 400px;
    height: 400px;
    bottom: -80px;
    right: -80px;
    background: radial-gradient(circle, hsl(270 80% 60% / 0.08), transparent 70%);
  }

  .deploy-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .deploy-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .deploy-card {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .deploy-card:hover {
    border-color: color-mix(in oklch, var(--primary) 25%, transparent);
    box-shadow: 0 0 0 1px color-mix(in oklch, var(--primary) 10%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .deploy-reveal {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  function initDeployReveal() {
    const els = document.querySelectorAll(".deploy-section .deploy-reveal");
    if (!("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    els.forEach((el) => io.observe(el));
  }

  initDeployReveal();
</script>
