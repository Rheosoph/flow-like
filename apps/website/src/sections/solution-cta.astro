---
import type { Lang, TranslationKey } from "../i18n";
import { translations, defaultLang } from "../i18n";

interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = (key: TranslationKey): string => {
  const l = translations[lang] as Record<string, string>;
  const e = translations.en as Record<string, string>;
  return l?.[key] ?? e[key] ?? key;
};

import { LuArrowRight } from "react-icons/lu";
---

<section class="relative py-16 md:py-20 overflow-hidden">
  <div class="mx-auto max-w-5xl px-4 lg:px-8">
    <div class="sc-reveal">
      <div class="sc-cta relative rounded-3xl overflow-hidden">
        <div class="absolute inset-0 rounded-3xl sc-glow pointer-events-none" aria-hidden="true"></div>

        <div class="relative rounded-3xl m-px bg-background/95 backdrop-blur-sm overflow-hidden">
          <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
            <div class="absolute top-0 left-1/4 w-72 h-72 rounded-full bg-primary/4 blur-3xl"></div>
            <div class="absolute bottom-0 right-1/4 w-56 h-56 rounded-full bg-amber-500/4 blur-3xl"></div>
          </div>

          <div class="relative px-8 py-10 sm:px-12 sm:py-14">
            <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-16">
              <div class="flex-1 text-center lg:text-left">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/8 px-3 py-1 text-xs font-semibold text-primary mb-4">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                  {t("v2.who.cta.label")}
                </span>
                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight mb-3">{t("v2.who.cta.heading")}</h3>
                <p class="text-base text-muted-foreground leading-relaxed max-w-lg">
                  {t("v2.who.cta.desc")}
                </p>
              </div>

              <div class="shrink-0 flex flex-col items-center lg:items-end gap-3">
                <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">{t("v2.who.cta.from")}</span>
                <span class="text-5xl sm:text-6xl font-extrabold tracking-tight text-foreground">€1,999</span>
                <a href="/24-hour-solution" class="group inline-flex items-center gap-2 rounded-full bg-foreground text-background px-8 py-3.5 text-base font-semibold transition-all duration-200 hover:bg-foreground/90 hover:scale-[1.02] hover:shadow-xl active:scale-[0.98]">
                  {t("v2.who.cta.label")}
                  <LuArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sc-glow {
    background: conic-gradient(from 0deg, transparent 0%, hsl(var(--primary)) 25%, transparent 50%, hsl(var(--primary)) 75%, transparent 100%);
    opacity: .25;
    animation: sc-spin 8s linear infinite;
  }
  @keyframes sc-spin {
    to { transform: rotate(360deg); }
  }

  .sc-reveal { opacity: 0; transform: translateY(20px); transition: opacity .5s ease, transform .5s ease; }
  .sc-reveal.is-visible { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    .sc-reveal { transition: none !important; transform: none !important; opacity: 1 !important; }
    .sc-glow { animation: none !important; }
  }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>(".sc-reveal");
  if (els.length) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
      }
    }, { threshold: 0.1 });
    for (const el of els) io.observe(el);
  }
</script>
