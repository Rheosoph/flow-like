<style>
  .pr-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
  }
  .pr-orb--violet {
    width: 450px;
    height: 450px;
    top: -60px;
    left: -80px;
    background: radial-gradient(circle, hsl(280 60% 55% / 0.1), transparent 70%);
  }
  .pr-orb--blue {
    width: 400px;
    height: 400px;
    bottom: -60px;
    right: -60px;
    background: radial-gradient(circle, hsl(222 89% 60% / 0.08), transparent 70%);
  }

  .pr-card {
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  .pr-card:hover {
    border-color: color-mix(in oklch, var(--primary) 25%, transparent);
    box-shadow: 0 8px 24px color-mix(in oklch, var(--foreground) 6%, transparent);
    transform: translateY(-2px);
  }

  .pr-card__art {
    border-bottom: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
  }
  .pr-card--it .pr-card__art   { background: linear-gradient(160deg, hsl(222 89% 60% / 0.06), hsl(222 89% 60% / 0.01)); }
  .pr-card--data .pr-card__art { background: linear-gradient(160deg, hsl(45 80% 50% / 0.06), hsl(45 80% 50% / 0.01)); }
  .pr-card--ai .pr-card__art   { background: linear-gradient(160deg, hsl(280 60% 55% / 0.06), hsl(280 60% 55% / 0.01)); }
  .pr-card--apps .pr-card__art { background: linear-gradient(160deg, hsl(161 50% 45% / 0.06), hsl(161 50% 45% / 0.01)); }
  .pr-card--home .pr-card__art { background: linear-gradient(160deg, hsl(25 80% 52% / 0.06), hsl(25 80% 52% / 0.01)); }
  .pr-card--gov .pr-card__art  { background: linear-gradient(160deg, hsl(215 30% 50% / 0.07), hsl(215 30% 50% / 0.01)); }

  .pr-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: var(--stagger, 0ms);
  }
  .pr-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .pr-reveal {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .pr-card,
    .pr-card:hover {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  function initPrReveal() {
    const els = document.querySelectorAll(".pr-section .pr-reveal");
    if (!("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    els.forEach((el) => io.observe(el));
  }
  initPrReveal();

  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document
      .querySelectorAll<SVGSVGElement>(".pr-section .pr-card__art svg")
      .forEach((svg) => {
        try {
          svg.pauseAnimations();
        } catch {}
      });
  }

  (function () {
    const CACHE_KEY = "gh_stars";
    const CACHE_TTL = 3600000;
    const countEl = document.getElementById("pr-star-count");
    if (!countEl) return;

    function show(count: number) {
      countEl!.textContent = count >= 1000 ? `${(count / 1000).toFixed(1)}k` : String(count);
    }

    try {
      const cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) {
        const { count, ts } = JSON.parse(cached);
        if (Date.now() - ts < CACHE_TTL) { show(count); return; }
      }
    } catch {}

    fetch("https://api.github.com/repos/Rheosoph/flow-like", {
      headers: { Accept: "application/vnd.github.v3+json" },
    })
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((data) => {
        const count = data?.stargazers_count;
        if (typeof count === "number" && count > 0) {
          show(count);
          try { sessionStorage.setItem(CACHE_KEY, JSON.stringify({ count, ts: Date.now() })); } catch {}
        }
      })
      .catch(() => {});
  })();
</script>
