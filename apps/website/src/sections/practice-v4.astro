      <span class="inline-block rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-xs font-medium text-primary mb-4">
        {t("v4.practice.kicker")}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-foreground">
        {t("v4.practice.headline")}
      </h2>
      <p class="mt-3 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-muted-foreground/60">
        {t("v4.practice.scenariosLabel")}
      </p>
      <p class="mt-4 text-base sm:text-lg text-muted-foreground leading-relaxed">
        {t("v4.practice.body")}
      </p>
    </div>

    <!-- Card grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
