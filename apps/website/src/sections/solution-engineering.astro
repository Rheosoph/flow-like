<style>
  .se-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
  }
  .se-orb--blue {
    width: 500px;
    height: 500px;
    top: -100px;
    right: -100px;
    background: radial-gradient(circle, hsl(222 89% 60% / 0.1), transparent 70%);
  }
  .se-orb--green {
    width: 400px;
    height: 400px;
    bottom: -80px;
    left: -80px;
    background: radial-gradient(circle, hsl(161 50% 45% / 0.08), transparent 70%);
  }

  .se-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .se-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .se-slider {
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    cursor: ew-resize;
  }

  .se-slider__before,
  .se-slider__after {
    will-change: clip-path;
  }

  .se-slider__divider {
    will-change: left, transform;
    touch-action: none;
    transform: translateX(-50%);
  }

  .se-slider__handle {
    touch-action: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .se-reveal {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .se-slider__before,
    .se-slider__after {
      will-change: auto;
    }
    .se-slider__divider {
      will-change: auto;
    }
  }
</style>

<script>
  function initSESlider() {
    const slider = document.getElementById("se-slider");
    const divider = document.getElementById("se-slider-divider");
    if (!slider || !divider) return;

    const afterLayer = slider.querySelector<HTMLDivElement>(".se-slider__after");
    const beforeLayer = slider.querySelector<HTMLDivElement>(".se-slider__before");
    if (!afterLayer || !beforeLayer) return;

    let isDragging = false;

    function getPercent(clientX: number): number {
      const rect = slider!.getBoundingClientRect();
      const raw = ((clientX - rect.left) / rect.width) * 100;
      return Math.min(Math.max(raw, 0), 100);
    }

    function update(percent: number) {
      divider!.style.left = `${percent}%`;
      beforeLayer!.style.clipPath = `inset(0 ${100 - percent}% 0 0)`;
      afterLayer!.style.clipPath = `inset(0 0 0 ${percent}%)`;
    }

    function onPointerDown(e: PointerEvent) {
      e.preventDefault();
      isDragging = true;
      slider!.setPointerCapture(e.pointerId);
      update(getPercent(e.clientX));
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDragging) return;
      e.preventDefault();
      update(getPercent(e.clientX));
    }

    function onPointerUp() {
      isDragging = false;
    }

    slider.addEventListener("pointerdown", onPointerDown);
    slider.addEventListener("pointermove", onPointerMove);
    slider.addEventListener("pointerup", onPointerUp);
    slider.addEventListener("pointercancel", onPointerUp);

    divider.addEventListener("keydown", (e: KeyboardEvent) => {
      const step = 2;
      const current = parseFloat(divider!.style.left) || 50;
      if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
        e.preventDefault();
        update(Math.max(0, current - step));
      } else if (e.key === "ArrowRight" || e.key === "ArrowUp") {
        e.preventDefault();
        update(Math.min(100, current + step));
      }
    });
  }

  function initSEReveal() {
    const els = document.querySelectorAll(".se-section .se-reveal");
    if (!("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    els.forEach((el) => io.observe(el));
  }

  initSEReveal();
  initSESlider();
</script>
