---
import type { Lang, TranslationKey } from "../i18n";
import { translations, defaultLang } from "../i18n";

interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = (key: TranslationKey): string => {
  const l = translations[lang] as Record<string, string>;
  const e = translations.en as Record<string, string>;
  return l?.[key] ?? e[key] ?? key;
};
---

<section class="how-section relative isolate overflow-hidden py-24 md:py-32">
  <!-- Background orbs -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="how-orb how-orb--blue"></div>
    <div class="how-orb how-orb--green"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="how-reveal mx-auto max-w-3xl text-center mb-16 md:mb-24">
      <span class="inline-block rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-xs font-medium text-primary mb-4">
        {t("v3.how.label")}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight mb-4">
        {t("v3.how.headline")}
      </h2>
      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
        {t("v3.how.description")}
      </p>
    </div>

    <!-- Block 1: Visual Workflow Editor — text left, visual right -->
    <div class="how-reveal grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center mb-24 md:mb-32">
      <!-- Text -->
      <div class="order-2 lg:order-1">
        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2">
          {t("v3.how.canvas.title")}
        </h3>
        <p class="text-sm font-medium text-primary mb-4">{t("v3.how.canvas.subtitle")}</p>
        <p class="text-muted-foreground leading-relaxed mb-3">{t("v3.how.canvas.p1")}</p>
        <p class="text-muted-foreground leading-relaxed mb-4">{t("v3.how.canvas.p2")}</p>
        <p class="text-sm italic text-muted-foreground/80 border-l-2 border-primary/30 pl-4">
          {t("v3.how.canvas.quote")}
        </p>
      </div>
      <!-- Visual: workflow editor video -->
      <div class="order-1 lg:order-2">
        <div class="rounded-xl border border-border/40 bg-background/80 backdrop-blur-sm shadow-2xl shadow-black/10 overflow-hidden">
          <video
            autoplay
            muted
            loop
            playsinline
            class="w-full aspect-video object-cover"
          >
            <source src="/posts/rapid-prototyping.webm" type="video/webm" />
          </video>
        </div>
      </div>
    </div>

    <!-- Block 2: FlowPilot — visual left, text right -->
    <div class="how-reveal grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center mb-24 md:mb-32">
      <!-- Visual: chat micro-demo -->
      <div class="order-1">
        <div class="how-pilot-demo rounded-xl border border-border/40 bg-background/80 backdrop-blur-sm shadow-2xl shadow-black/10 overflow-hidden" data-how-anim="pilot">
          <svg class="w-full" viewBox="0 0 560 400" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="how-pilot-bg" x1="0" y1="0" x2="560" y2="400" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="hsl(280 60% 55% / 0.04)"/>
                <stop offset="100%" stop-color="hsl(222 89% 60% / 0.04)"/>
              </linearGradient>
            </defs>
            <rect width="560" height="400" fill="url(#how-pilot-bg)"/>

            <!-- Window chrome -->
            <rect width="560" height="28" rx="8" fill="hsl(0 0% 50% / 0.05)"/>
            <circle cx="16" cy="14" r="4" fill="hsl(0 60% 55% / 0.35)"/>
            <circle cx="28" cy="14" r="4" fill="hsl(45 80% 55% / 0.35)"/>
            <circle cx="40" cy="14" r="4" fill="hsl(161 50% 45% / 0.35)"/>
            <text x="60" y="18" fill="hsl(0 0% 55% / 0.4)" font-size="9" font-family="monospace">FlowPilot</text>

            <!-- User message -->
            <g class="how-pilot-user" opacity="0">
              <rect x="140" y="46" width="400" height="60" rx="12" fill="hsl(222 89% 60% / 0.08)" stroke="hsl(222 89% 60% / 0.2)" stroke-width="1"/>
              <text x="152" y="62" fill="hsl(0 0% 55% / 0.4)" font-size="8" font-family="system-ui">You</text>
              <text x="152" fill="hsl(0 0% 70%)" font-size="10" font-family="system-ui" class="how-pilot-user-text">
                <tspan x="152" y="78">{t("v3.how.pilot.user.l1" as TranslationKey)}</tspan>
                <tspan x="152" y="92">{t("v3.how.pilot.user.l2" as TranslationKey)}</tspan>
              </text>
            </g>

            <!-- Typing indicator -->
            <g class="how-pilot-typing" opacity="0">
              <rect x="20" y="120" width="60" height="28" rx="14" fill="hsl(280 60% 55% / 0.06)" stroke="hsl(280 60% 55% / 0.15)" stroke-width="0.8"/>
              <circle cx="36" cy="134" r="3" fill="hsl(280 60% 55% / 0.3)" class="how-dot how-dot-1"/>
              <circle cx="48" cy="134" r="3" fill="hsl(280 60% 55% / 0.3)" class="how-dot how-dot-2"/>
              <circle cx="60" cy="134" r="3" fill="hsl(280 60% 55% / 0.3)" class="how-dot how-dot-3"/>
            </g>

            <!-- FlowPilot response -->
            <g class="how-pilot-response" opacity="0">
              <rect x="20" y="120" width="420" height="60" rx="12" fill="hsl(280 60% 55% / 0.06)" stroke="hsl(280 60% 55% / 0.2)" stroke-width="1"/>
              <text x="32" y="136" fill="hsl(280 60% 55% / 0.6)" font-size="8" font-family="system-ui" font-weight="600">FlowPilot</text>
              <text x="32" fill="hsl(0 0% 65%)" font-size="10" font-family="system-ui" class="how-pilot-resp-text">
                <tspan x="32" y="152">{t("v3.how.pilot.resp.l1" as TranslationKey)}</tspan>
                <tspan x="32" y="166">{t("v3.how.pilot.resp.l2" as TranslationKey)}</tspan>
              </text>
            </g>

            <!-- Mini workflow materializing -->
            <g class="how-pilot-flow" opacity="0" transform="translate(40, 196)">
              <rect width="480" height="80" rx="10" fill="hsl(222 89% 60% / 0.03)" stroke="hsl(222 89% 60% / 0.1)" stroke-width="1"/>

              <!-- 5 mini nodes -->
              <g class="how-flow-node how-flow-n1">
                <rect x="16" y="22" width="70" height="36" rx="8" fill="hsl(222 89% 60% / 0.08)" stroke="hsl(222 89% 60% / 0.25)" stroke-width="1"/>
                <text x="51" y="44" text-anchor="middle" fill="hsl(222 89% 60% / 0.6)" font-size="8" font-family="system-ui">Postgres</text>
              </g>
              <g class="how-flow-node how-flow-n2">
                <rect x="110" y="22" width="70" height="36" rx="8" fill="hsl(280 60% 55% / 0.08)" stroke="hsl(280 60% 55% / 0.25)" stroke-width="1"/>
                <text x="145" y="44" text-anchor="middle" fill="hsl(280 60% 55% / 0.6)" font-size="8" font-family="system-ui">Null Filter</text>
              </g>
              <g class="how-flow-node how-flow-n3">
                <rect x="204" y="22" width="70" height="36" rx="8" fill="hsl(45 80% 50% / 0.08)" stroke="hsl(45 80% 50% / 0.25)" stroke-width="1"/>
                <text x="239" y="44" text-anchor="middle" fill="hsl(45 80% 50% / 0.6)" font-size="8" font-family="system-ui">Aggregator</text>
              </g>
              <g class="how-flow-node how-flow-n4">
                <rect x="298" y="22" width="70" height="36" rx="8" fill="hsl(161 50% 45% / 0.08)" stroke="hsl(161 50% 45% / 0.25)" stroke-width="1"/>
                <text x="333" y="44" text-anchor="middle" fill="hsl(161 50% 45% / 0.6)" font-size="8" font-family="system-ui">Validator</text>
              </g>
              <g class="how-flow-node how-flow-n5">
                <rect x="392" y="22" width="70" height="36" rx="8" fill="hsl(222 89% 60% / 0.08)" stroke="hsl(222 89% 60% / 0.25)" stroke-width="1"/>
                <text x="427" y="44" text-anchor="middle" fill="hsl(222 89% 60% / 0.6)" font-size="8" font-family="system-ui">Dashboard</text>
              </g>

              <!-- Connections between mini nodes -->
              <line class="how-flow-c1" x1="86" y1="40" x2="110" y2="40" stroke="hsl(222 89% 60% / 0.3)" stroke-width="1.5" stroke-dasharray="24" stroke-dashoffset="24"/>
              <line class="how-flow-c2" x1="180" y1="40" x2="204" y2="40" stroke="hsl(280 60% 55% / 0.3)" stroke-width="1.5" stroke-dasharray="24" stroke-dashoffset="24"/>
              <line class="how-flow-c3" x1="274" y1="40" x2="298" y2="40" stroke="hsl(45 80% 50% / 0.3)" stroke-width="1.5" stroke-dasharray="24" stroke-dashoffset="24"/>
              <line class="how-flow-c4" x1="368" y1="40" x2="392" y2="40" stroke="hsl(161 50% 45% / 0.3)" stroke-width="1.5" stroke-dasharray="24" stroke-dashoffset="24"/>
            </g>

            <!-- Follow-up message -->
            <g class="how-pilot-followup" opacity="0">
              <rect x="20" y="296" width="260" height="36" rx="12" fill="hsl(280 60% 55% / 0.06)" stroke="hsl(280 60% 55% / 0.2)" stroke-width="1"/>
              <text x="32" y="312" fill="hsl(280 60% 55% / 0.6)" font-size="8" font-family="system-ui" font-weight="600">FlowPilot</text>
              <text x="32" y="324" fill="hsl(0 0% 65%)" font-size="10" font-family="system-ui">{t("v3.how.pilot.followup")}</text>
            </g>

            <!-- Input bar -->
            <rect x="20" y="350" width="520" height="40" rx="20" fill="hsl(0 0% 50% / 0.04)" stroke="hsl(0 0% 50% / 0.12)" stroke-width="1"/>
            <text x="40" y="374" fill="hsl(0 0% 50% / 0.3)" font-size="10" font-family="system-ui">Ask FlowPilot anything…</text>
          </svg>
        </div>
      </div>
      <!-- Text -->
      <div class="order-2">
        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2">
          {t("v3.how.pilot.title")}
        </h3>
        <p class="text-sm font-medium text-primary mb-4">{t("v3.how.pilot.subtitle")}</p>
        <p class="text-muted-foreground leading-relaxed mb-3">{t("v3.how.pilot.p1")}</p>
        <p class="text-muted-foreground leading-relaxed mb-4">{t("v3.how.pilot.p2")}</p>
        <p class="text-sm italic text-muted-foreground/80 border-l-2 border-primary/30 pl-4">
          {t("v3.how.pilot.quote")}
        </p>
      </div>
    </div>

    <!-- Block 3: Rust Engine — text left, visual right -->
    <div class="how-reveal grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Text -->
      <div class="order-2 lg:order-1">
        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2">
          {t("v3.how.engine.title")}
        </h3>
        <p class="text-sm font-medium text-primary mb-4">{t("v3.how.engine.subtitle")}</p>
        <p class="text-muted-foreground leading-relaxed mb-3">{t("v3.how.engine.p1")}</p>
        <p class="text-muted-foreground leading-relaxed mb-3">{t("v3.how.engine.p2")}</p>
        <p class="text-muted-foreground leading-relaxed mb-4">{t("v3.how.engine.p3")}</p>
        <a href="#architecture" class="inline-block text-sm font-medium text-primary hover:text-primary/80 transition-colors mb-5">
          {t("v3.how.engine.deepdive")}
        </a>
        <div class="flex flex-wrap gap-2">
          <span class="rounded-full border border-border/50 bg-muted/30 px-3 py-1 text-xs font-medium text-muted-foreground">{t("v3.how.engine.badge1")}</span>
          <span class="rounded-full border border-border/50 bg-muted/30 px-3 py-1 text-xs font-medium text-muted-foreground">{t("v3.how.engine.badge2")}</span>
          <span class="rounded-full border border-border/50 bg-muted/30 px-3 py-1 text-xs font-medium text-muted-foreground">{t("v3.how.engine.badge3")}</span>
          <span class="rounded-full border border-border/50 bg-muted/30 px-3 py-1 text-xs font-medium text-muted-foreground">{t("v3.how.engine.badge4")}</span>
        </div>
      </div>
      <!-- Visual: monitoring panel -->
      <div class="order-1 lg:order-2">
        <div class="how-engine-demo rounded-xl border border-border/40 bg-background/80 backdrop-blur-sm shadow-2xl shadow-black/10 overflow-hidden" data-how-anim="engine">
          <svg class="w-full" viewBox="0 0 560 420" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="how-engine-bg" x1="0" y1="0" x2="560" y2="420" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="hsl(222 89% 60% / 0.03)"/>
                <stop offset="100%" stop-color="hsl(161 50% 45% / 0.03)"/>
              </linearGradient>
            </defs>
            <rect width="560" height="420" fill="url(#how-engine-bg)"/>

            <!-- Window chrome -->
            <rect width="560" height="28" rx="8" fill="hsl(0 0% 50% / 0.05)"/>
            <circle cx="16" cy="14" r="4" fill="hsl(0 60% 55% / 0.35)"/>
            <circle cx="28" cy="14" r="4" fill="hsl(45 80% 55% / 0.35)"/>
            <circle cx="40" cy="14" r="4" fill="hsl(161 50% 45% / 0.35)"/>
            <text x="60" y="18" fill="hsl(0 0% 55% / 0.4)" font-size="9" font-family="monospace">engine-monitor</text>

            <!-- Two large counters -->
            <g>
              <!-- Latency counter -->
              <rect x="30" y="45" width="240" height="90" rx="12" fill="hsl(161 50% 45% / 0.04)" stroke="hsl(161 50% 45% / 0.15)" stroke-width="1"/>
              <text x="50" y="68" fill="hsl(0 0% 55% / 0.5)" font-size="10" font-family="system-ui">Avg Latency</text>
              <text x="50" y="110" fill="hsl(161 50% 45% / 0.8)" font-size="36" font-family="system-ui" font-weight="700" class="how-counter-latency">~0.6<tspan font-size="16" dy="-4">ms</tspan></text>
            </g>
            <g>
              <!-- Throughput counter -->
              <rect x="290" y="45" width="240" height="90" rx="12" fill="hsl(222 89% 60% / 0.04)" stroke="hsl(222 89% 60% / 0.15)" stroke-width="1"/>
              <text x="310" y="68" fill="hsl(0 0% 55% / 0.5)" font-size="10" font-family="system-ui">Throughput</text>
              <text x="310" y="110" fill="hsl(222 89% 60% / 0.8)" font-size="36" font-family="system-ui" font-weight="700" class="how-counter-throughput">244k<tspan font-size="16" dy="-4">evt/s</tspan></text>
            </g>

            <!-- Sparkline chart -->
            <g transform="translate(30, 155)">
              <rect width="500" height="80" rx="8" fill="hsl(0 0% 50% / 0.02)" stroke="hsl(0 0% 50% / 0.08)" stroke-width="1"/>
              <text x="12" y="18" fill="hsl(0 0% 55% / 0.4)" font-size="9" font-family="system-ui">Latency (ms) — last 60s</text>
              <!-- Horizontal grid lines -->
              <line x1="12" y1="35" x2="488" y2="35" stroke="hsl(0 0% 50% / 0.06)" stroke-width="0.5"/>
              <line x1="12" y1="50" x2="488" y2="50" stroke="hsl(0 0% 50% / 0.06)" stroke-width="0.5"/>
              <line x1="12" y1="65" x2="488" y2="65" stroke="hsl(0 0% 50% / 0.06)" stroke-width="0.5"/>
              <!-- Sparkline that draws -->
              <polyline
                class="how-sparkline"
                points="20,55 40,50 60,52 80,48 100,53 120,47 140,50 160,45 180,52 200,48 220,50 240,46 260,52 280,49 300,47 320,53 340,48 360,50 380,46 400,52 420,48 440,50 460,47 480,50"
                stroke="hsl(161 50% 45% / 0.5)"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-dasharray="800"
                stroke-dashoffset="800"
              />
              <!-- area fill -->
              <polygon
                class="how-sparkline-fill"
                points="20,55 40,50 60,52 80,48 100,53 120,47 140,50 160,45 180,52 200,48 220,50 240,46 260,52 280,49 300,47 320,53 340,48 360,50 380,46 400,52 420,48 440,50 460,47 480,50 480,70 20,70"
                fill="hsl(161 50% 45% / 0.06)"
                opacity="0"
              />
            </g>

            <!-- Benchmark bars -->
            <g transform="translate(30, 255)">
              <rect width="500" height="120" rx="8" fill="hsl(0 0% 50% / 0.02)" stroke="hsl(0 0% 50% / 0.08)" stroke-width="1"/>
              <text x="12" y="18" fill="hsl(0 0% 55% / 0.4)" font-size="9" font-family="system-ui">Benchmark — avg execution time (lower is better)</text>

              <!-- Flow-Like bar -->
              <text x="12" y="42" fill="hsl(161 50% 45% / 0.7)" font-size="10" font-family="system-ui" font-weight="500">Flow-Like (Rust)</text>
              <rect class="how-bar how-bar-1" x="160" y="32" width="0" height="16" rx="4" fill="hsl(161 50% 45% / 0.35)"/>
              <text class="how-bar-label how-bar-label-1" x="165" y="44" fill="hsl(161 50% 45% / 0.7)" font-size="9" font-family="system-ui" font-weight="600" opacity="0">0.6ms</text>

              <!-- Tool A bar -->
              <text x="12" y="72" fill="hsl(45 80% 50% / 0.7)" font-size="10" font-family="system-ui" font-weight="500">Tool A (Node.js)</text>
              <rect class="how-bar how-bar-2" x="160" y="62" width="0" height="16" rx="4" fill="hsl(45 80% 50% / 0.3)"/>
              <text class="how-bar-label how-bar-label-2" x="165" y="74" fill="hsl(45 80% 50% / 0.6)" font-size="9" font-family="system-ui" font-weight="600" opacity="0">580ms</text>

              <!-- Tool B bar -->
              <text x="12" y="102" fill="hsl(0 60% 50% / 0.7)" font-size="10" font-family="system-ui" font-weight="500">Tool B (Python)</text>
              <rect class="how-bar how-bar-3" x="160" y="92" width="0" height="16" rx="4" fill="hsl(0 60% 50% / 0.3)"/>
              <text class="how-bar-label how-bar-label-3" x="165" y="104" fill="hsl(0 60% 50% / 0.6)" font-size="9" font-family="system-ui" font-weight="600" opacity="0">1,200ms</text>
            </g>

            <!-- Tech badges row -->
            <g transform="translate(30, 392)">
              <rect x="0" y="0" width="80" height="22" rx="11" fill="hsl(161 50% 45% / 0.06)" stroke="hsl(161 50% 45% / 0.15)" stroke-width="0.8"/>
              <text x="40" y="15" text-anchor="middle" fill="hsl(161 50% 45% / 0.6)" font-size="8" font-family="system-ui" font-weight="500">Rust</text>
              <rect x="90" y="0" width="80" height="22" rx="11" fill="hsl(222 89% 60% / 0.06)" stroke="hsl(222 89% 60% / 0.15)" stroke-width="0.8"/>
              <text x="130" y="15" text-anchor="middle" fill="hsl(222 89% 60% / 0.6)" font-size="8" font-family="system-ui" font-weight="500">Protobuf</text>
              <rect x="180" y="0" width="80" height="22" rx="11" fill="hsl(280 60% 55% / 0.06)" stroke="hsl(280 60% 55% / 0.15)" stroke-width="0.8"/>
              <text x="220" y="15" text-anchor="middle" fill="hsl(280 60% 55% / 0.6)" font-size="8" font-family="system-ui" font-weight="500">WASM</text>
              <rect x="270" y="0" width="100" height="22" rx="11" fill="hsl(45 80% 50% / 0.06)" stroke="hsl(45 80% 50% / 0.15)" stroke-width="0.8"/>
              <text x="320" y="15" text-anchor="middle" fill="hsl(45 80% 50% / 0.6)" font-size="8" font-family="system-ui" font-weight="500">Object Store</text>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Background orbs */
  .how-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
  }
  .how-orb--blue {
    width: 500px;
    height: 500px;
    top: -150px;
    right: -100px;
    background: radial-gradient(circle, hsl(222 89% 60% / 0.1), transparent 70%);
  }
  .how-orb--green {
    width: 400px;
    height: 400px;
    bottom: -80px;
    left: -80px;
    background: radial-gradient(circle, hsl(161 50% 45% / 0.08), transparent 70%);
  }

  /* Scroll reveal */
  .how-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .how-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --------------- Block 1: Canvas animations --------------- */
  .how-node-a,
  .how-node-b {
    opacity: 0;
  }

  .is-playing .how-node-a {
    animation: how-slide-left 0.5s ease-out forwards;
  }
  .is-playing .how-node-b {
    animation: how-slide-right 0.5s 0.3s ease-out forwards;
  }
  .is-playing .how-conn-ab {
    animation: how-draw 0.4s 0.7s ease-out forwards;
  }
  .is-playing .how-conn-ab-ok {
    animation: how-fade-in 0.2s 1.1s ease-out forwards;
  }

  /* Node C bad appears */
  .how-node-c-bad {
    opacity: 0;
  }
  .is-playing .how-node-c-bad {
    animation: how-fade-in 0.3s 1.3s ease-out forwards, how-fade-out 0.25s 2.3s ease-out forwards;
  }
  .is-playing .how-conn-bc-bad {
    animation: how-draw-short 0.3s 1.5s ease-out forwards, how-fade-out 0.25s 2.3s ease-out forwards;
  }
  .is-playing .how-mismatch-tip {
    animation: how-fade-in 0.2s 1.7s ease-out forwards, how-fade-out 0.25s 2.3s ease-out forwards;
  }

  /* Node C good replaces bad */
  .is-playing .how-node-c-good {
    animation: how-swap-in 0.4s 2.6s ease-out forwards;
  }
  .is-playing .how-conn-bc-good {
    animation: how-draw-short-visible 0.3s 2.9s ease-out forwards;
  }

  /* Valid badges + status bar */
  .is-playing .how-valid-badges {
    animation: how-fade-in 0.3s 3.2s ease-out forwards;
  }
  .is-playing .how-status-bar {
    animation: how-fade-in 0.3s 3.4s ease-out forwards;
  }

  @keyframes how-slide-left {
    from { opacity: 0; transform: translateX(-40px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes how-slide-right {
    from { opacity: 0; transform: translateX(40px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes how-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes how-draw-short {
    to { stroke-dashoffset: 0; }
  }
  @keyframes how-draw-short-visible {
    from { stroke-dashoffset: 30; opacity: 1; }
    to { stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes how-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes how-fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes how-swap-in {
    0% { opacity: 0; transform: scale(0.8) rotate(-5deg); }
    60% { opacity: 1; transform: scale(1.05) rotate(1deg); }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  /* --------------- Block 2: Pilot chat animations --------------- */
  .is-playing .how-pilot-user {
    animation: how-fade-in 0.4s 0.2s ease-out forwards;
  }
  .is-playing .how-pilot-typing {
    animation: how-fade-in 0.2s 0.8s ease-out forwards, how-fade-out 0.2s 1.5s ease-out forwards;
  }
  .how-dot { animation: how-dot-bounce 1.2s infinite; }
  .how-dot-2 { animation-delay: 0.15s; }
  .how-dot-3 { animation-delay: 0.3s; }
  @keyframes how-dot-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.3; }
    30% { transform: translateY(-4px); opacity: 0.7; }
  }

  .is-playing .how-pilot-response {
    animation: how-fade-in 0.4s 1.6s ease-out forwards;
  }

  /* Mini flow nodes appear sequentially */
  .how-flow-node { opacity: 0; }
  .is-playing .how-pilot-flow {
    animation: how-fade-in 0.3s 2.1s ease-out forwards;
  }
  .is-playing .how-flow-n1 { animation: how-fade-in 0.25s 2.2s ease-out forwards; }
  .is-playing .how-flow-n2 { animation: how-fade-in 0.25s 2.35s ease-out forwards; }
  .is-playing .how-flow-n3 { animation: how-fade-in 0.25s 2.5s ease-out forwards; }
  .is-playing .how-flow-n4 { animation: how-fade-in 0.25s 2.65s ease-out forwards; }
  .is-playing .how-flow-n5 { animation: how-fade-in 0.25s 2.8s ease-out forwards; }
  .is-playing .how-flow-c1 { animation: how-draw 0.2s 2.4s ease-out forwards; }
  .is-playing .how-flow-c2 { animation: how-draw 0.2s 2.55s ease-out forwards; }
  .is-playing .how-flow-c3 { animation: how-draw 0.2s 2.7s ease-out forwards; }
  .is-playing .how-flow-c4 { animation: how-draw 0.2s 2.85s ease-out forwards; }

  .is-playing .how-pilot-followup {
    animation: how-fade-in 0.4s 3.2s ease-out forwards;
  }

  /* --------------- Block 3: Engine animations --------------- */
  .is-playing .how-sparkline {
    animation: how-sparkline-draw 1.5s 0.3s ease-out forwards;
  }
  .is-playing .how-sparkline-fill {
    animation: how-fade-in 0.5s 1.6s ease-out forwards;
  }
  @keyframes how-sparkline-draw {
    to { stroke-dashoffset: 0; }
  }

  /* Benchmark bars grow */
  .is-playing .how-bar-1 {
    animation: how-bar-grow-1 0.6s 0.5s ease-out forwards;
  }
  .is-playing .how-bar-2 {
    animation: how-bar-grow-2 0.8s 0.7s ease-out forwards;
  }
  .is-playing .how-bar-3 {
    animation: how-bar-grow-3 1s 0.9s ease-out forwards;
  }
  .is-playing .how-bar-label-1 {
    animation: how-fade-in 0.3s 1.1s ease-out forwards;
  }
  .is-playing .how-bar-label-2 {
    animation: how-fade-in 0.3s 1.5s ease-out forwards;
  }
  .is-playing .how-bar-label-3 {
    animation: how-fade-in 0.3s 1.9s ease-out forwards;
  }

  /* Bar widths proportional: 0.6 / 1200 scale; max bar = 320px */
  @keyframes how-bar-grow-1 {
    to { width: 5px; }
  }
  @keyframes how-bar-grow-2 {
    to { width: 155px; }
  }
  @keyframes how-bar-grow-3 {
    to { width: 320px; }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .how-reveal {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .how-node-a, .how-node-b, .how-node-c-bad, .how-flow-node {
      opacity: 1 !important;
    }
    .how-conn-ab, .how-conn-bc-bad, .how-conn-bc-good,
    .how-flow-c1, .how-flow-c2, .how-flow-c3, .how-flow-c4 {
      stroke-dashoffset: 0 !important;
    }
    .how-pilot-user, .how-pilot-response, .how-pilot-flow,
    .how-pilot-followup, .how-node-c-good, .how-conn-ab-ok,
    .how-valid-badges, .how-status-bar, .how-sparkline,
    .how-sparkline-fill, .how-mismatch-tip {
      opacity: 1 !important;
    }
    .how-conn-bc-good { opacity: 1 !important; stroke-dashoffset: 0 !important; }
    .how-bar-1 { width: 5px !important; }
    .how-bar-2 { width: 155px !important; }
    .how-bar-3 { width: 320px !important; }
    .how-bar-label { opacity: 1 !important; }
  }
</style>

<script>
  function initHowReveals() {
    const els = document.querySelectorAll(".how-section .how-reveal");
    if (!("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    els.forEach((el) => io.observe(el));
  }

  function initHowAnimations() {
    const demos = document.querySelectorAll<HTMLElement>("[data-how-anim]");
    if (!("IntersectionObserver" in window)) {
      demos.forEach((d) => d.classList.add("is-playing"));
      return;
    }

    const LOOP_DELAY: Record<string, number> = {
      canvas: 4200,
      pilot: 4000,
      engine: 3000,
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          const type = el.dataset.howAnim || "";
          if (entry.isIntersecting) {
            el.classList.add("is-playing");
            const delay = LOOP_DELAY[type] ?? 4000;
            const timer = setInterval(() => {
              el.classList.remove("is-playing");
              void el.offsetWidth; // reflow
              el.classList.add("is-playing");
            }, delay);
            el.dataset.howTimer = String(timer);
          } else {
            el.classList.remove("is-playing");
            if (el.dataset.howTimer) {
              clearInterval(Number(el.dataset.howTimer));
              delete el.dataset.howTimer;
            }
          }
        }
      },
      { rootMargin: "0px 0px -5% 0px", threshold: 0.3 },
    );

    demos.forEach((d) => io.observe(d));
  }

  initHowReveals();
  initHowAnimations();
</script>
