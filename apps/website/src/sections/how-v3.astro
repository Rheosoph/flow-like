---
import type { Lang, TranslationKey } from "../i18n";
import { defaultLang, translations } from "../i18n";
import InlineFlowPilot from "../components/showcase/inline-flowpilot";
import LiveShowcase from "../components/showcase/LiveShowcase.astro";

interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = (key: TranslationKey): string => {
  const localized = translations[lang] as Record<string, string>;
  const english = translations.en as Record<string, string>;
  return localized?.[key] ?? english[key] ?? key;
};

const pilotPrompt = `${t("v3.how.pilot.user.l1" as TranslationKey)} ${t("v3.how.pilot.user.l2" as TranslationKey)}`;
const pilotReply = `${t("v3.how.pilot.resp.l1" as TranslationKey)} ${t("v3.how.pilot.resp.l2" as TranslationKey)}\n\n${t("v3.how.pilot.followup" as TranslationKey)}`;
---

<section class="how-section relative isolate overflow-hidden py-24 md:py-32">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="how-orb how-orb--blue"></div>
    <div class="how-orb how-orb--green"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <header class="how-reveal mx-auto mb-16 max-w-3xl text-center md:mb-24">
      <span class="mb-4 inline-block rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-xs font-medium text-primary">
        {t("v3.how.label")}
      </span>
      <h2 class="mb-4 text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
        {t("v3.how.headline")}
      </h2>
      <p class="text-base leading-relaxed text-muted-foreground sm:text-lg">
        {t("v3.how.description")}
      </p>
    </header>

    <div class="how-reveal mb-24 grid grid-cols-1 items-center gap-10 md:mb-32 lg:grid-cols-2 lg:gap-16">
      <div class="order-2 lg:order-1">
        <h3 class="mb-2 text-2xl font-bold tracking-tight sm:text-3xl">
          {t("v3.how.canvas.title")}
        </h3>
        <p class="mb-4 text-sm font-medium text-primary">{t("v3.how.canvas.subtitle")}</p>
        <p class="mb-3 leading-relaxed text-muted-foreground">{t("v3.how.canvas.p1")}</p>
        <p class="mb-4 leading-relaxed text-muted-foreground">{t("v3.how.canvas.p2")}</p>
        <p class="border-l-2 border-primary/30 pl-4 text-sm italic text-muted-foreground/80">
          {t("v3.how.canvas.quote")}
        </p>
      </div>
      <div class="order-1 lg:order-2">
        <LiveShowcase
          variant="workflow"
          presentation="embedded"
          posterAlt="Interactive Flow-Like workflow canvas"
          posterWidth={16}
          posterHeight={9}
        />
      </div>
    </div>

    <div class="how-reveal mb-24 grid grid-cols-1 items-center gap-10 md:mb-32 lg:grid-cols-2 lg:gap-16">
      <div class="order-1">
        <div class="dark h-[25rem] overflow-hidden rounded-xl border border-white/10 bg-neutral-950 shadow-2xl shadow-black/25">
          <InlineFlowPilot
            client:only="react"
            prompt={pilotPrompt}
            reply={pilotReply}
            className="h-full min-h-0 rounded-none border-0 shadow-none"
          />
        </div>
      </div>
      <div class="order-2">
        <h3 class="mb-2 text-2xl font-bold tracking-tight sm:text-3xl">
          {t("v3.how.pilot.title")}
        </h3>
        <p class="mb-4 text-sm font-medium text-primary">{t("v3.how.pilot.subtitle")}</p>
        <p class="mb-3 leading-relaxed text-muted-foreground">{t("v3.how.pilot.p1")}</p>
        <p class="mb-4 leading-relaxed text-muted-foreground">{t("v3.how.pilot.p2")}</p>
        <p class="border-l-2 border-primary/30 pl-4 text-sm italic text-muted-foreground/80">
          {t("v3.how.pilot.quote")}
        </p>
      </div>
    </div>

    <div class="how-reveal grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="order-2 lg:order-1">
        <h3 class="mb-2 text-2xl font-bold tracking-tight sm:text-3xl">
          {t("v3.how.engine.title")}
        </h3>
        <p class="mb-4 text-sm font-medium text-primary">{t("v3.how.engine.subtitle")}</p>
        <p class="mb-3 leading-relaxed text-muted-foreground">{t("v3.how.engine.p1")}</p>
        <p class="mb-3 leading-relaxed text-muted-foreground">{t("v3.how.engine.p2")}</p>
        <p class="mb-4 leading-relaxed text-muted-foreground">{t("v3.how.engine.p3")}</p>
        <a href="#architecture" class="mb-5 inline-block text-sm font-medium text-primary transition-colors hover:text-primary/80">
          {t("v3.how.engine.deepdive")}
        </a>
        <div class="flex flex-wrap gap-2">
          {[1, 2, 3, 4].map((index) => (
            <span class="rounded-full border border-border/50 bg-muted/30 px-3 py-1 text-xs font-medium text-muted-foreground">
              {t(`v3.how.engine.badge${index}` as TranslationKey)}
            </span>
          ))}
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <LiveShowcase
          variant="runs"
          presentation="embedded"
          posterAlt="Interactive Flow-Like run monitor"
          posterWidth={4}
          posterHeight={3}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .how-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: .35;
  }
  .how-orb--blue {
    top: -150px;
    right: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, hsl(222 89% 60% / .1), transparent 70%);
  }
  .how-orb--green {
    bottom: -80px;
    left: -80px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, hsl(161 50% 45% / .08), transparent 70%);
  }
  .how-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .6s ease, transform .6s ease;
  }
  .how-reveal.is-visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .how-reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  function initHowReveals() {
    const elements = document.querySelectorAll(".how-section .how-reveal:not(.is-visible)");
    if (!("IntersectionObserver" in window)) {
      elements.forEach((element) => element.classList.add("is-visible"));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      }
    }, { rootMargin: "0px 0px -10% 0px", threshold: .1 });
    elements.forEach((element) => observer.observe(element));
  }
  initHowReveals();
</script>
