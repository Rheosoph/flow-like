            <h3 class="text-lg sm:text-xl font-bold text-foreground">{t("v3.showcase.tools.title")}</h3>
            <p class="text-xs text-muted-foreground/70 mt-0.5">{t("v3.showcase.tools.subtitle")}</p>
            <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{t("v3.showcase.tools.scenario")}</p>
          </div>
          <div class="sc-panel__col sc-panel__col--center">
            <ul class="sc-pros">
              <li><span class="sc-pro-mark">+</span>{t("v3.showcase.tools.pro1")}</li>
              <li><span class="sc-pro-mark">+</span>{t("v3.showcase.tools.pro2")}</li>
              <li><span class="sc-pro-mark">+</span>{t("v3.showcase.tools.pro3")}</li>
            </ul>
          </div>
          <div class="sc-panel__col sc-panel__col--right">
            <div class="sc-note">
              <span class="sc-note__label">Good to know</span>
              <p>{t("v3.showcase.tools.note")}</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Dot Indicator -->
    <div class="sc-dots" id="sc-dots" role="tablist" aria-label="Panel navigation">
      {panels.map((p, i) => (
        <button
          class:list={["sc-dot-btn", { "is-active": i === 0 }]}
          data-index={i}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-label={t(`v3.showcase.${p.id}.title` as TranslationKey)}
          type="button"
        />
      ))}
    </div>
  </div>
</section>

<style>
  .sc-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.3;
    pointer-events: none;
    animation: drift 20s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }
  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(2%, 4%) scale(1.05); }
    100% { transform: translate(-2%, -2%) scale(0.95); }
  }
  .sc-orb--1 {
    width: 600px;
    height: 600px;
    top: -200px;
    left: -150px;
    background: radial-gradient(circle, hsl(222 89% 60% / 0.08), transparent 70%);
  }
  .sc-orb--2 {
    width: 500px;
    height: 500px;
    bottom: -150px;
    right: -100px;
    background: radial-gradient(circle, hsl(161 50% 45% / 0.06), transparent 70%);
  }

  .sc-reveal {
    opacity: 0;
    transform: translateY(32px) scale(0.98);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sc-reveal.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Theater */
  .sc-theater {
    position: relative;
    width: 100%;
  }

  .sc-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    outline: none;
  }
  .sc-track::-webkit-scrollbar {
    display: none;
  }

  /* Panels */
  .sc-panel {
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .sc-panel {
      padding: 0 2rem;
    }
  }
  @media (min-width: 1024px) {
    .sc-panel {
      padding: 0 4rem;
    }
  }

  .sc-panel__canvas {
    flex: 0 0 auto;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
  }

  .sc-svg {
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid hsl(0 0% 50% / 0.1);
  }

  .sc-panel__info {
    flex: 0 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 900px;
    width: 100%;
    margin: 2rem auto 0;
    padding: 1.25rem;
    padding-bottom: 1.25rem;
    border-radius: 12px;
    border: 1px solid hsl(0 0% 50% / 0.1);
    background: hsl(0 0% 50% / 0.02);
  }

  @media (min-width: 768px) {
    .sc-panel__info {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2rem;
      padding: 1.5rem 2rem;
    }
  }

  .sc-panel__col--left h3 {
    line-height: 1.3;
  }

  .sc-pros {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .sc-pros li {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .sc-pro-mark {
    flex-shrink: 0;
    font-weight: 700;
    color: hsl(161 50% 45%);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .sc-note {
    border-radius: 10px;
    border: 1px solid hsl(0 0% 50% / 0.12);
    background: hsl(0 0% 50% / 0.04);
    padding: 0.875rem 1rem;
  }
  .sc-note__label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: hsl(0 0% 55% / 0.7);
    margin-bottom: 0.5rem;
  }
  .sc-note p {
    font-size: 0.8rem;
    line-height: 1.6;
    color: hsl(0 0% 60% / 0.8);
    margin: 0;
  }

  /* Arrows */
  .sc-arrow {
    position: absolute;
    top: 140px;
    z-index: 30;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid hsl(0 0% 50% / 0.15);
    background: hsl(0 0% 50% / 0.05);
    backdrop-filter: blur(8px);
    color: hsl(0 0% 50% / 0.6);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sc-arrow:hover {
    border-color: hsl(222 89% 60% / 0.3);
    color: hsl(222 89% 60% / 0.8);
    background: hsl(222 89% 60% / 0.1);
    transform: scale(1.05);
  }
  .sc-arrow:active {
    transform: scale(0.95);
  }
  .sc-arrow--left {
    left: 8px;
  }
  .sc-arrow--right {
    right: 8px;
  }

  /* Tabs */
  .sc-tabs {
    scrollbar-width: none;
  }
  .sc-tabs::-webkit-scrollbar {
    display: none;
  }

  /* Dots */
  .sc-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 1.25rem 0 0.5rem;
  }

  .sc-dot-btn {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid hsl(0 0% 50% / 0.25);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sc-dot-btn:hover {
    border-color: hsl(222 89% 60% / 0.5);
    transform: scale(1.1);
  }
  .sc-dot-btn.is-active {
    background: hsl(222 89% 60% / 0.7);
    border-color: hsl(222 89% 60% / 0.7);
    transform: scale(1.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-reveal {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  function initShowcase() {
    const track = document.getElementById("sc-track");
    const dots = document.querySelectorAll<HTMLButtonElement>("#sc-dots .sc-dot-btn");
    const tabs = document.querySelectorAll<HTMLButtonElement>("#sc-tabs .sc-tab-btn");
    const arrowL = document.getElementById("sc-arrow-left");
    const arrowR = document.getElementById("sc-arrow-right");
    if (!track || dots.length === 0) return;

    const panels = track.querySelectorAll<HTMLDivElement>(".sc-panel");
    const total = panels.length;
    let current = 0;

    function scrollToPanel(idx: number) {
      if (idx < 0 || idx >= total) return;
      const panelWidth = track!.clientWidth;
      track!.scrollTo({ left: idx * panelWidth, behavior: "smooth" });
    }

    function setActive(idx: number) {
      current = idx;
      dots.forEach((d, i) => {
        const active = i === idx;
        d.classList.toggle("is-active", active);
        d.setAttribute("aria-selected", active ? "true" : "false");
      });
      tabs.forEach((t, i) => {
        const active = i === idx;
        t.classList.toggle("text-foreground", active);
        t.classList.toggle("bg-muted/50", active);
        t.classList.toggle("text-muted-foreground", !active);
        t.setAttribute("aria-selected", active ? "true" : "false");
      });
    }

    // Scroll observer
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.intersectionRatio > 0.5) {
            const idx = Array.from(panels).indexOf(entry.target as HTMLDivElement);
            if (idx >= 0) setActive(idx);
          }
        }
      },
      { root: track, threshold: 0.5 },
    );
    panels.forEach((p) => io.observe(p));

    // Dot clicks
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = parseInt(dot.dataset.index ?? "0", 10);
        scrollToPanel(idx);
      });
    });

    // Tab clicks
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const idx = parseInt(tab.dataset.index ?? "0", 10);
        scrollToPanel(idx);
      });
    });

    // Arrow clicks
    arrowL?.addEventListener("click", () => scrollToPanel(current - 1));
    arrowR?.addEventListener("click", () => scrollToPanel(current + 1));

    // Keyboard
    track.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        scrollToPanel(current - 1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        scrollToPanel(current + 1);
      }
    });
  }

  function initShowcaseReveal() {
    const els = document.querySelectorAll(".sc-section .sc-reveal");
    if (!("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    els.forEach((el) => io.observe(el));
  }

  initShowcaseReveal();
  initShowcase();
</script>
