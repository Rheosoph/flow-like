---
import type { Lang, TranslationKey } from "../i18n";
import { translations, defaultLang } from "../i18n";

interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = (key: TranslationKey): string => {
  const l = translations[lang] as Record<string, string>;
  const e = translations.en as Record<string, string>;
  return l?.[key] ?? e[key] ?? key;
};

const panels = [
  { id: "it",     hue: "222 89% 60%",  accent: "blue"   },
  { id: "data",   hue: "45 80% 50%",   accent: "amber"  },
  { id: "ai",     hue: "280 60% 55%",  accent: "purple" },
  { id: "nocode", hue: "161 50% 45%",  accent: "green"  },
  { id: "maker",  hue: "25 80% 52%",   accent: "orange" },
  { id: "tools",  hue: "340 65% 50%",  accent: "rose"   },
] as const;
---

<section class="sc-section relative isolate overflow-hidden py-20 md:py-28">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="sc-orb sc-orb--1"></div>
    <div class="sc-orb sc-orb--2"></div>
  </div>

  <!-- Header -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 mb-12 md:mb-16">
    <div class="sc-reveal mx-auto max-w-3xl text-center">
      <span class="inline-block rounded-full border border-border/50 bg-muted/40 px-4 py-1.5 text-xs font-medium tracking-wide text-muted-foreground uppercase mb-6">
        {t("v3.showcase.label")}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-foreground">
        {t("v3.showcase.headline")}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto">
        {t("v3.showcase.description")}
      </p>
    </div>
  </div>

  <!-- Tab Navigation -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 mb-6">
    <div class="sc-tabs flex items-center gap-1.5 sm:gap-2 mx-auto w-fit max-w-full overflow-x-auto px-2 py-1.5 rounded-xl border border-border/40 bg-background/70 backdrop-blur-sm" id="sc-tabs" role="tablist" aria-label="Use case navigation">
      {panels.map((p, i) => (
        <button
          class:list={[
            "sc-tab-btn relative whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium transition-all duration-300 ease-out hover:scale-[1.02] active:scale-95",
            i === 0
              ? "text-foreground bg-muted/50 shadow-sm"
              : "text-muted-foreground hover:text-foreground hover:bg-muted/30",
          ]}
          data-index={i}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          type="button"
        >
          {t(`v3.showcase.${p.id}.title` as TranslationKey)}
        </button>
      ))}
    </div>
  </div>

  <!-- Scroll Theater -->
  <div class="sc-theater relative" id="sc-theater">
    <!-- Arrow Left -->
    <button
      class="sc-arrow sc-arrow--left hidden md:flex"
      id="sc-arrow-left"
      aria-label="Previous panel"
      type="button"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4L6 10L12 16"/>
      </svg>
    </button>

    <!-- Arrow Right -->
    <button
      class="sc-arrow sc-arrow--right hidden md:flex"
      id="sc-arrow-right"
      aria-label="Next panel"
      type="button"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 4L14 10L8 16"/>
      </svg>
    </button>

    <!-- Scroll Container -->
    <div class="sc-track" id="sc-track" role="region" aria-label="Use case showcase" tabindex="0">

      <!-- Panel: IT -->
      <div class="sc-panel" data-panel="it">
        <div class="sc-panel__canvas">
          <svg class="sc-svg" viewBox="0 0 900 340" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="sc-it-bg" x1="0" y1="0" x2="900" y2="340" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="hsl(222 89% 60% / 0.04)"/>
                <stop offset="100%" stop-color="hsl(222 89% 60% / 0.01)"/>
              </linearGradient>
            </defs>
            <rect width="900" height="340" rx="16" fill="url(#sc-it-bg)"/>

            <!-- Pulse rings from center -->
            <circle cx="450" cy="145" r="80" stroke="hsl(222 89% 60% / 0.08)" stroke-width="1" fill="none">
              <animate attributeName="r" values="80;140" dur="3s" repeatCount="indefinite" calcMode="spline" keyTimes="0;1" keySplines="0.16 1 0.3 1"/>
              <animate attributeName="opacity" values="0.3;0" dur="3s" repeatCount="indefinite" calcMode="spline" keyTimes="0;1" keySplines="0.16 1 0.3 1"/>
            </circle>
            <circle cx="450" cy="145" r="80" stroke="hsl(222 89% 60% / 0.06)" stroke-width="1" fill="none">
              <animate attributeName="r" values="80;140" dur="3s" begin="1s" repeatCount="indefinite" calcMode="spline" keyTimes="0;1" keySplines="0.16 1 0.3 1"/>
              <animate attributeName="opacity" values="0.2;0" dur="3s" begin="1s" repeatCount="indefinite" calcMode="spline" keyTimes="0;1" keySplines="0.16 1 0.3 1"/>
            </circle>

            <!-- Connection lines from hub to spoke nodes -->
            <line x1="402" y1="131" x2="250" y2="87" stroke="hsl(222 89% 60% / 0.15)" stroke-width="1.5" stroke-dasharray="4 4">
              <animate attributeName="stroke-dashoffset" values="0;-8" dur="1s" repeatCount="indefinite"/>
            </line>
            <line x1="498" y1="131" x2="650" y2="87" stroke="hsl(200 70% 50% / 0.15)" stroke-width="1.5" stroke-dasharray="4 4">
              <animate attributeName="stroke-dashoffset" values="0;-8" dur="1.2s" repeatCount="indefinite"/>
            </line>
            <line x1="402" y1="158" x2="220" y2="205" stroke="hsl(210 70% 50% / 0.15)" stroke-width="1.5" stroke-dasharray="4 4">
              <animate attributeName="stroke-dashoffset" values="0;-8" dur="1.4s" repeatCount="indefinite"/>
            </line>
            <line x1="498" y1="158" x2="680" y2="205" stroke="hsl(280 60% 55% / 0.15)" stroke-width="1.5" stroke-dasharray="4 4">
              <animate attributeName="stroke-dashoffset" values="0;-8" dur="1.1s" repeatCount="indefinite"/>
            </line>
            <line x1="450" y1="195" x2="450" y2="260" stroke="hsl(161 50% 45% / 0.15)" stroke-width="1.5" stroke-dasharray="4 4">
              <animate attributeName="stroke-dashoffset" values="0;-8" dur="1.3s" repeatCount="indefinite"/>
            </line>

            <!-- Data packets traveling on lines -->
            <circle r="4" fill="hsl(222 89% 60% / 0.6)">
              <animateMotion dur="2s" repeatCount="indefinite" path="M402,131 L250,87"/>
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.2;0.8;1" dur="2s" repeatCount="indefinite"/>
            </circle>
            <circle r="4" fill="hsl(200 70% 50% / 0.6)">
              <animateMotion dur="2.4s" repeatCount="indefinite" path="M498,131 L650,87"/>
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.2;0.8;1" dur="2.4s" repeatCount="indefinite"/>
            </circle>
            <circle r="4" fill="hsl(210 70% 50% / 0.6)">
              <animateMotion dur="2.8s" repeatCount="indefinite" path="M402,158 L220,205"/>
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.2;0.8;1" dur="2.8s" repeatCount="indefinite"/>
            </circle>
            <circle r="4" fill="hsl(280 60% 55% / 0.6)">
              <animateMotion dur="2.2s" repeatCount="indefinite" path="M498,158 L680,205"/>
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.2;0.8;1" dur="2.2s" repeatCount="indefinite"/>
            </circle>
            <circle r="4" fill="hsl(161 50% 45% / 0.6)">
              <animateMotion dur="2.6s" repeatCount="indefinite" path="M450,195 L450,260"/>
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.2;0.8;1" dur="2.6s" repeatCount="indefinite"/>
            </circle>

            <!-- Central Hub -->
            <circle cx="450" cy="145" r="50" fill="hsl(222 89% 60% / 0.06)" stroke="hsl(222 89% 60% / 0.3)" stroke-width="2"/>
            <text x="450" y="138" text-anchor="middle" fill="hsl(222 89% 60% / 0.8)" font-size="13" font-family="system-ui" font-weight="700">Flow-Like</text>
            <text x="450" y="157" text-anchor="middle" fill="hsl(222 89% 60% / 0.4)" font-size="9" font-family="system-ui">orchestrator</text>

            <!-- Spoke: Azure AD -->
            <rect x="130" y="44" width="120" height="52" rx="12" fill="hsl(222 89% 60% / 0.07)" stroke="hsl(222 89% 60% / 0.3)" stroke-width="1.5"/>
            <circle cx="155" cy="70" r="10" fill="hsl(222 89% 60% / 0.12)" stroke="hsl(222 89% 60% / 0.3)" stroke-width="1"/>
            <path d="M151 73 L155 67 L159 73" stroke="hsl(222 89% 60% / 0.6)" stroke-width="1.2" fill="none"/>
            <text x="175" y="74" fill="hsl(222 89% 60% / 0.8)" font-size="11" font-family="system-ui" font-weight="500">Azure AD</text>

            <!-- Spoke: Jira -->
            <rect x="650" y="44" width="120" height="52" rx="12" fill="hsl(200 70% 50% / 0.07)" stroke="hsl(200 70% 50% / 0.3)" stroke-width="1.5"/>
            <circle cx="675" cy="70" r="10" fill="hsl(200 70% 50% / 0.12)" stroke="hsl(200 70% 50% / 0.3)" stroke-width="1"/>
            <rect x="670" y="65" width="10" height="10" rx="2" stroke="hsl(200 70% 50% / 0.6)" stroke-width="1" fill="none"/>
            <text x="695" y="74" fill="hsl(200 70% 50% / 0.8)" font-size="11" font-family="system-ui" font-weight="500">Jira Board</text>

            <!-- Spoke: LDAP -->
            <rect x="100" y="194" width="120" height="52" rx="12" fill="hsl(210 70% 50% / 0.07)" stroke="hsl(210 70% 50% / 0.3)" stroke-width="1.5"/>
            <circle cx="125" cy="220" r="10" fill="hsl(210 70% 50% / 0.12)" stroke="hsl(210 70% 50% / 0.3)" stroke-width="1"/>
            <path d="M121 217 L125 213 L129 217 M121 223 L125 227 L129 223" stroke="hsl(210 70% 50% / 0.6)" stroke-width="1" fill="none"/>
            <text x="145" y="224" fill="hsl(210 70% 50% / 0.8)" font-size="11" font-family="system-ui" font-weight="500">LDAP Sync</text>

            <!-- Spoke: Slack -->
            <rect x="680" y="194" width="120" height="52" rx="12" fill="hsl(280 60% 55% / 0.07)" stroke="hsl(280 60% 55% / 0.3)" stroke-width="1.5"/>
            <circle cx="705" cy="220" r="10" fill="hsl(280 60% 55% / 0.12)" stroke="hsl(280 60% 55% / 0.3)" stroke-width="1"/>
            <path d="M701 216 L705 220 L709 216 M701 224 L705 220 L709 224" stroke="hsl(280 60% 55% / 0.6)" stroke-width="1.2" fill="none"/>
            <text x="725" y="224" fill="hsl(280 60% 55% / 0.8)" font-size="11" font-family="system-ui" font-weight="500">Slack</text>

            <!-- Spoke: Email -->
            <rect x="390" y="260" width="120" height="52" rx="12" fill="hsl(161 50% 45% / 0.07)" stroke="hsl(161 50% 45% / 0.3)" stroke-width="1.5"/>
            <circle cx="415" cy="286" r="10" fill="hsl(161 50% 45% / 0.12)" stroke="hsl(161 50% 45% / 0.3)" stroke-width="1"/>
            <rect x="409" y="281" width="12" height="9" rx="2" stroke="hsl(161 50% 45% / 0.6)" stroke-width="1" fill="none"/>
            <path d="M409 282 L415 287 L421 282" stroke="hsl(161 50% 45% / 0.5)" stroke-width="0.8" fill="none"/>
            <text x="435" y="290" fill="hsl(161 50% 45% / 0.8)" font-size="11" font-family="system-ui" font-weight="500">Notify Mgr</text>

            <!-- Pipeline label -->
            <rect x="40" y="295" width="200" height="28" rx="14" fill="hsl(222 89% 60% / 0.06)" stroke="hsl(222 89% 60% / 0.15)" stroke-width="1"/>
            <text x="140" y="314" text-anchor="middle" fill="hsl(222 89% 60% / 0.5)" font-size="10" font-family="system-ui" font-weight="500">Employee Onboarding Hub</text>
          </svg>
        </div>
        <div class="sc-panel__info">
          <div class="sc-panel__col sc-panel__col--left">
            <h3 class="text-lg sm:text-xl font-bold text-foreground">{t("v3.showcase.it.title")}</h3>
            <p class="text-xs text-muted-foreground/70 mt-0.5">{t("v3.showcase.it.subtitle")}</p>
            <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{t("v3.showcase.it.scenario")}</p>
          </div>
          <div class="sc-panel__col sc-panel__col--center">
            <ul class="sc-pros">
              <li><span class="sc-pro-mark">+</span>{t("v3.showcase.it.pro1")}</li>
              <li><span class="sc-pro-mark">+</span>{t("v3.showcase.it.pro2")}</li>
              <li><span class="sc-pro-mark">+</span>{t("v3.showcase.it.pro3")}</li>
            </ul>
          </div>
          <div class="sc-panel__col sc-panel__col--right">
            <div class="sc-note">
              <span class="sc-note__label">Good to know</span>
              <p>{t("v3.showcase.it.note")}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel: Data -->
      <div class="sc-panel" data-panel="data">
        <div class="sc-panel__canvas">
          <svg class="sc-svg" viewBox="0 0 900 340" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="sc-data-bg" x1="0" y1="0" x2="900" y2="340" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="hsl(45 80% 50% / 0.04)"/>
                <stop offset="100%" stop-color="hsl(45 80% 50% / 0.01)"/>
              </linearGradient>
            </defs>
            <rect width="900" height="340" rx="16" fill="url(#sc-data-bg)"/>

            <!-- Source layer: 3 database icons at top -->
            <rect x="80" y="40" width="130" height="55" rx="10" fill="hsl(210 60% 50% / 0.07)" stroke="hsl(210 60% 50% / 0.3)" stroke-width="1.5"/>
            <ellipse cx="110" cy="58" rx="10" ry="5" fill="hsl(210 60% 50% / 0.15)" stroke="hsl(210 60% 50% / 0.4)" stroke-width="1"/>
            <line x1="100" y1="58" x2="100" y2="72" stroke="hsl(210 60% 50% / 0.4)" stroke-width="1"/>
            <line x1="120" y1="58" x2="120" y2="72" stroke="hsl(210 60% 50% / 0.4)" stroke-width="1"/>
            <ellipse cx="110" cy="72" rx="10" ry="5" stroke="hsl(210 60% 50% / 0.4)" stroke-width="1" fill="none"/>
            <text x="140" y="72" fill="hsl(210 60% 50% / 0.8)" font-size="11" font-family="system-ui" font-weight="500">Postgres</text>

            <rect x="385" y="40" width="130" height="55" rx="10" fill="hsl(161 50% 45% / 0.07)" stroke="hsl(161 50% 45% / 0.3)" stroke-width="1.5"/>
            <path d="M410 55 L425 55 L420 75 L410 75 Z" stroke="hsl(161 50% 45% / 0.4)" stroke-width="1" fill="hsl(161 50% 45% / 0.1)"/>
            <text x="440" y="72" fill="hsl(161 50% 45% / 0.8)" font-size="11" font-family="system-ui" font-weight="500">Kafka</text>

            <rect x="690" y="40" width="130" height="55" rx="10" fill="hsl(250 60% 55% / 0.07)" stroke="hsl(250 60% 55% / 0.3)" stroke-width="1.5"/>
            <text x="715" y="62" fill="hsl(250 60% 55% / 0.5)" font-size="9" font-family="monospace">{`{}`}</text>
            <text x="740" y="72" fill="hsl(250 60% 55% / 0.8)" font-size="11" font-family="system-ui" font-weight="500">REST API</text>

            <!-- Converging streams (animated dashed lines going down) -->
            <path d="M145 95 C145 130, 350 130, 400 155" stroke="hsl(210 60% 50% / 0.2)" stroke-width="1.5" stroke-dasharray="5 4">
              <animate attributeName="stroke-dashoffset" values="0;-18" dur="2s" repeatCount="indefinite"/>
            </path>
            <path d="M450 95 L450 155" stroke="hsl(161 50% 45% / 0.2)" stroke-width="1.5" stroke-dasharray="5 4">
              <animate attributeName="stroke-dashoffset" values="0;-18" dur="1.8s" repeatCount="indefinite"/>
            </path>
            <path d="M755 95 C755 130, 550 130, 500 155" stroke="hsl(250 60% 55% / 0.2)" stroke-width="1.5" stroke-dasharray="5 4">
              <animate attributeName="stroke-dashoffset" values="0;-18" dur="2.2s" repeatCount="indefinite"/>
            </path>

            <!-- Animated data particles on streams -->
            <circle r="3" fill="hsl(210 60% 50% / 0.6)">
              <animateMotion dur="2.5s" repeatCount="indefinite" path="M145,95 C145,130 350,130 400,155"/>
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.2;0.8;1" dur="2.5s" repeatCount="indefinite"/>
            </circle>
            <circle r="3" fill="hsl(161 50% 45% / 0.6)">
              <animateMotion dur="2s" repeatCount="indefinite" path="M450,95 L450,155"/>
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.2;0.8;1" dur="2s" repeatCount="indefinite"/>
            </circle>
            <circle r="3" fill="hsl(250 60% 55% / 0.6)">
              <animateMotion dur="2.8s" repeatCount="indefinite" path="M755,95 C755,130 550,130 500,155"/>
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.2;0.8;1" dur="2.8s" repeatCount="indefinite"/>
            </circle>

            <!-- Transform funnel -->
            <path d="M320 155 L580 155 L540 205 L360 205 Z" fill="hsl(45 80% 50% / 0.06)" stroke="hsl(45 80% 50% / 0.25)" stroke-width="1.5" stroke-linejoin="round"/>
            <text x="450" y="175" text-anchor="middle" fill="hsl(45 80% 50% / 0.7)" font-size="11" font-family="system-ui" font-weight="600">Clean + Validate + Deduplicate</text>
            <text x="450" y="195" text-anchor="middle" fill="hsl(45 80% 50% / 0.4)" font-size="9" font-family="system-ui">schema enforcement</text>

            <!-- Row count badges on funnel -->
            <rect x="590" y="148" width="60" height="20" rx="10" fill="hsl(0 60% 50% / 0.08)" stroke="hsl(0 60% 50% / 0.2)" stroke-width="0.5"/>
            <text x="620" y="162" text-anchor="middle" fill="hsl(0 60% 50% / 0.6)" font-size="8" font-family="monospace">1.2M rows</text>
            <rect x="550" y="198" width="55" height="20" rx="10" fill="hsl(161 50% 45% / 0.08)" stroke="hsl(161 50% 45% / 0.2)" stroke-width="0.5"/>
            <text x="577" y="212" text-anchor="middle" fill="hsl(161 50% 45% / 0.6)" font-size="8" font-family="monospace">980K rows</text>

            <!-- Output stream -->
            <path d="M450 205 L450 245" stroke="hsl(45 80% 50% / 0.2)" stroke-width="2" stroke-dasharray="5 4">
              <animate attributeName="stroke-dashoffset" values="0;-18" dur="1.5s" repeatCount="indefinite"/>
            </path>

            <!-- Output: Data warehouse -->
            <rect x="370" y="245" width="160" height="60" rx="12" fill="hsl(45 80% 50% / 0.08)" stroke="hsl(45 80% 50% / 0.3)" stroke-width="2"/>
            <text x="450" y="272" text-anchor="middle" fill="hsl(45 80% 50% / 0.8)" font-size="13" font-family="system-ui" font-weight="700">Data Lake</text>
            <text x="450" y="292" text-anchor="middle" fill="hsl(45 80% 50% / 0.4)" font-size="9" font-family="system-ui">parquet / iceberg</text>

            <!-- Mini chart in corner -->
            <rect x="710" y="225" width="150" height="85" rx="10" fill="hsl(0 0% 50% / 0.03)" stroke="hsl(0 0% 50% / 0.1)" stroke-width="1"/>
            <text x="725" y="245" fill="hsl(0 0% 60% / 0.5)" font-size="8" font-family="system-ui" font-weight="600">Throughput</text>
            <rect x="725" y="275" width="12" height="25" rx="2" fill="hsl(45 80% 50% / 0.2)"/>
            <rect x="745" y="260" width="12" height="40" rx="2" fill="hsl(45 80% 50% / 0.3)"/>
            <rect x="765" y="268" width="12" height="32" rx="2" fill="hsl(45 80% 50% / 0.25)"/>
            <rect x="785" y="252" width="12" height="48" rx="2" fill="hsl(45 80% 50% / 0.35)"/>
            <rect x="805" y="255" width="12" height="45" rx="2" fill="hsl(45 80% 50% / 0.4)"/>
            <rect x="825" y="248" width="12" height="52" rx="2" fill="hsl(161 50% 45% / 0.4)"/>

            <rect x="40" y="285" width="170" height="28" rx="14" fill="hsl(45 80% 50% / 0.06)" stroke="hsl(45 80% 50% / 0.15)" stroke-width="1"/>
            <text x="125" y="304" text-anchor="middle" fill="hsl(45 80% 50% / 0.5)" font-size="10" font-family="system-ui" font-weight="500">Sales ETL Pipeline</text>
          </svg>
        </div>
        <div class="sc-panel__info">
          <div class="sc-panel__col sc-panel__col--left">
            <h3 class="text-lg sm:text-xl font-bold text-foreground">{t("v3.showcase.data.title")}</h3>
            <p class="text-xs text-muted-foreground/70 mt-0.5">{t("v3.showcase.data.subtitle")}</p>
            <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{t("v3.showcase.data.scenario")}</p>
          </div>
          <div class="sc-panel__col sc-panel__col--center">
            <ul class="sc-pros">
              <li><span class="sc-pro-mark">+</span>{t("v3.showcase.data.pro1")}</li>
              <li><span class="sc-pro-mark">+</span>{t("v3.showcase.data.pro2")}</li>
              <li><span class="sc-pro-mark">+</span>{t("v3.showcase.data.pro3")}</li>
            </ul>
          </div>
          <div class="sc-panel__col sc-panel__col--right">
            <div class="sc-note">
              <span class="sc-note__label">Good to know</span>
              <p>{t("v3.showcase.data.note")}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel: AI -->
      <div class="sc-panel" data-panel="ai">
        <div class="sc-panel__canvas">
          <svg class="sc-svg" viewBox="0 0 900 340" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
