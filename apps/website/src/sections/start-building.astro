---
import type { Lang, TranslationKey } from "../i18n";
import { translations, defaultLang } from "../i18n";

interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = (key: TranslationKey): string => {
  const l = translations[lang] as Record<string, string>;
  const e = translations.en as Record<string, string>;
  return l?.[key] ?? e[key] ?? key;
};

import { LuDownload, LuGlobe, LuBuilding, LuCode, LuArrowRight } from "react-icons/lu";
const github = "https://github.com/Rheosoph/flow-like";
const webAppUrl = "https://app.flow-like.com";
const docs = "https://docs.flow-like.com";
---

<section class="relative py-20 md:py-28 overflow-hidden" data-c1="hsl(222 89% 60% / .08)" data-c2="hsl(268 84% 62% / .08)">
  <!-- Gradient glow BG -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_0%,hsl(var(--primary)/.12),transparent)]"></div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-border/40 to-transparent"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 lg:px-8">
    <!-- Headline -->
    <div class="sb-reveal text-center mb-14">
      <h2 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">
        {t("v2.start.heading.start")} <span class="bg-gradient-to-r from-primary via-violet-500 to-primary bg-clip-text text-transparent">{t("v2.start.heading.building")}</span>
      </h2>
      <p class="text-base sm:text-lg text-muted-foreground max-w-xl mx-auto">
        {t("v2.start.sub")}
      </p>
    </div>

    <!-- Audience cards -->
    <div class="sb-reveal grid sm:grid-cols-2 gap-5 mb-12">
      <!-- Individuals -->
      <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex items-center justify-center size-9 rounded-lg bg-primary/10">
            <LuDownload className="w-4.5 h-4.5 text-primary" />
          </div>
          <p class="text-sm font-semibold text-foreground">{t("v2.start.individuals.title")}</p>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed mb-4">
          {t("v2.start.individuals.desc")}
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/download" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
            <LuArrowRight className="w-3 h-3" /> macOS
          </a>
          <a href="/download" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
            Windows
          </a>
          <a href="/download" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
            Linux
          </a>
        </div>
      </div>

      <!-- Teams -->
      <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-violet-500/30 hover:shadow-lg hover:shadow-violet-500/5">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex items-center justify-center size-9 rounded-lg bg-violet-500/10">
            <LuGlobe className="w-4.5 h-4.5 text-violet-500" />
          </div>
          <p class="text-sm font-semibold text-foreground">{t("v2.start.teams.title")}</p>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed mb-4">
          {t("v2.start.teams.desc")}
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={webAppUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
            <LuArrowRight className="w-3 h-3" /> {t("v2.start.teams.webapp")}
          </a>
          <a href={`${docs}/self-hosting`} target="_blank" rel="noreferrer" class="text-sm font-medium text-primary hover:text-primary/80 transition-colors">
            {t("v2.start.teams.selfhost")}
          </a>
        </div>
      </div>

      <!-- Enterprise -->
      <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-emerald-500/30 hover:shadow-lg hover:shadow-emerald-500/5">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex items-center justify-center size-9 rounded-lg bg-emerald-500/10">
            <LuBuilding className="w-4.5 h-4.5 text-emerald-500" />
          </div>
          <p class="text-sm font-semibold text-foreground">{t("v2.start.enterprise.title")}</p>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed mb-4">
          {t("v2.start.enterprise.desc")}
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="mailto:enterprise@flow-like.com" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
            <LuArrowRight className="w-3 h-3" /> {t("v2.start.enterprise.contact")}
          </a>
        </div>
      </div>

      <!-- Developers -->
      <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-amber-500/30 hover:shadow-lg hover:shadow-amber-500/5">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex items-center justify-center size-9 rounded-lg bg-amber-500/10">
            <LuCode className="w-4.5 h-4.5 text-amber-500" />
          </div>
          <p class="text-sm font-semibold text-foreground">{t("v2.start.dev.title")}</p>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed mb-4">
          {t("v2.start.dev.desc")}
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={github} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
            <LuArrowRight className="w-3 h-3" /> {t("v2.start.dev.source")}
          </a>
          <a href={docs} target="_blank" rel="noreferrer" class="text-sm font-medium text-primary hover:text-primary/80 transition-colors">
            {t("v2.start.dev.docs")}
          </a>
        </div>
      </div>
    </div>

    <!-- Footer line -->
    <p class="sb-reveal text-sm text-muted-foreground text-center">
      {t("v2.start.footer")}
      <a href={github} target="_blank" rel="noreferrer" class="text-primary hover:text-primary/80 transition-colors">{t("v2.start.footer.link")}</a>
    </p>
  </div>
</section>

<style>
  .sb-reveal { opacity: 0; transform: translateY(24px); transition: opacity .6s ease, transform .6s ease; }
  .sb-reveal.is-visible { opacity: 1; transform: translateY(0); }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>(".sb-reveal");
  if (els.length) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
      }
    }, { threshold: 0.15 });
    for (const el of els) io.observe(el);
  }
</script>
