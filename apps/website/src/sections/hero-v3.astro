<style>
  /* ═════════════════════════════════════════════
     Root section
     ═════════════════════════════════════════════ */
  .hero-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100dvh;
    background-color: var(--background);
  }

  /* ═════════════════════════════════════════════
     Background Elements
     ═════════════════════════════════════════════ */
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1000px;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-wave-bg {
    width: 100%;
    height: 100%;
    opacity: 0.78;
  }

  /* ═════════════════════════════════════════════
     Content layout
     ═════════════════════════════════════════════ */
  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    margin: 0 auto;
    padding: 7rem 1.5rem 4rem;
  }

  @media (min-width: 768px) {
    .hero-content { padding: 9rem 2rem 5rem; }
  }

  .hero-content__inner {
    max-width: 52rem;
    margin: 0 auto;
    text-align: center;
  }

  /* ═════════════════════════════════════════════
     Entrance animation
     ═════════════════════════════════════════════ */
  .hero-reveal {
    opacity: 0;
    transform: translateY(32px);
    filter: blur(6px);
  }

  .hero-reveal.is-visible {
    animation: hero-enter 1s cubic-bezier(0.16, 1, 0.3, 1) var(--delay, 0s) forwards;
  }

  @keyframes hero-enter {
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* ═════════════════════════════════════════════
     Badge
     ═════════════════════════════════════════════ */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 1rem 0.375rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklch, var(--primary) 30%, transparent);
    background: color-mix(in oklch, var(--primary) 6%, transparent);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--primary);
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }

  .hero-badge:hover {
    background: color-mix(in oklch, var(--primary) 12%, transparent);
    border-color: color-mix(in oklch, var(--primary) 50%, transparent);
  }

  .hero-badge__live {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary);
    flex-shrink: 0;
  }

  .hero-badge__live::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    background: color-mix(in oklch, var(--primary) 50%, transparent);
    animation: badge-pulse 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes badge-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(2.5); opacity: 0; }
  }

  .hero-badge__arrow {
    width: 12px;
    height: 12px;
    transition: transform 0.2s;
  }

  .hero-badge:hover .hero-badge__arrow {
    transform: translateX(2px);
  }

  /* ═════════════════════════════════════════════
     Headline
     ═════════════════════════════════════════════ */
  .hero-headline {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-top: 1.5rem;
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .hero-gradient {
    background: linear-gradient(
      135deg,
      var(--primary) 0%,
      var(--foreground) 20%,
      var(--foreground) 40%,
      hsl(350 65% 50%) 60%,
      hsl(25 90% 55%) 80%,
      var(--foreground) 100%
    );
    background-size: 250% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: headline-gradient 6s ease infinite;
  }

  @keyframes headline-gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* ═════════════════════════════════════════════
     Subtitle
     ═════════════════════════════════════════════ */
  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    max-width: 38rem;
    margin: 0 auto 2rem;
  }

  @media (min-width: 640px) {
    .hero-subtitle { font-size: 1.25rem; }
  }

  /* ═════════════════════════════════════════════
     CTAs
     ═════════════════════════════════════════════ */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .hero-btn-primary {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: white;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.3s;
    box-shadow:
      0 0 0 1px hsl(12 80% 50% / 0.3),
      0 4px 24px -4px hsl(12 80% 50% / 0.4),
      0 8px 48px -12px hsl(350 65% 50% / 0.2);
  }

  .hero-btn-primary__bg {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, hsl(12 80% 50%), hsl(350 65% 45%), hsl(25 85% 50%));
    background-size: 200% 200%;
    animation: btn-bg-shift 4s ease infinite;
  }

  @keyframes btn-bg-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hero-btn-primary__shimmer {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, transparent 0%, hsl(0 0% 100% / 0.2) 50%, transparent 100%);
    transform: translateX(-100%);
    animation: btn-shimmer 3s ease-in-out 1.5s infinite;
  }

  @keyframes btn-shimmer {
    0% { transform: translateX(-100%); }
    60%, 100% { transform: translateX(100%); }
  }

  .hero-btn-primary__text {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
  }

  .hero-btn-primary:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow:
      0 0 0 1px hsl(12 80% 50% / 0.4),
      0 8px 32px -4px hsl(12 80% 50% / 0.5),
      0 16px 64px -12px hsl(350 65% 50% / 0.3);
