---
import type { Lang, TranslationKey } from "../i18n";
import { translations, defaultLang } from "../i18n";

interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = (key: TranslationKey): string => {
  const l = translations[lang] as Record<string, string>;
  const e = translations.en as Record<string, string>;
  return l?.[key] ?? e[key] ?? key;
};

const github = "https://github.com/TM9657/flow-like";
const webAppUrl = "https://app.flow-like.com";



const tabs = [
  { key: "automation", translation: "v3.hero.tab.automation" as TranslationKey },
  { key: "aiAgent", translation: "v3.hero.tab.aiAgent" as TranslationKey },
  { key: "dashboard", translation: "v3.hero.tab.dashboard" as TranslationKey },
  { key: "dataPipeline", translation: "v3.hero.tab.dataPipeline" as TranslationKey },
  { key: "app", translation: "v3.hero.tab.app" as TranslationKey },
] as const;

const trustPills = [
  "v3.hero.trust.free",
  "v3.hero.trust.noAccount",
  "v3.hero.trust.noCode",
  "v3.hero.trust.offline",
  "v3.hero.trust.openSource",
  "v3.hero.trust.onPrem",
] as const;
---

<section class="hero-section" id="hero-section">
  <div class="hero-bg" aria-hidden="true">

    <svg class="hero-wave-bg" id="wave-wrap" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMin slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="grad-w1" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="hsl(350 65% 50% / 0.8)" />
          <stop offset="50%" stop-color="hsl(25 90% 55% / 0.6)" />
          <stop offset="100%" stop-color="hsl(12 80% 55% / 0.8)" />
        </linearGradient>
        <linearGradient id="grad-w2" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="hsl(12 80% 55% / 0.7)" />
          <stop offset="50%" stop-color="hsl(350 65% 50% / 0.5)" />
          <stop offset="100%" stop-color="hsl(25 90% 55% / 0.7)" />
        </linearGradient>
        <linearGradient id="grad-w3" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="hsl(25 90% 55% / 0.8)" />
          <stop offset="50%" stop-color="hsl(12 80% 55% / 0.5)" />
          <stop offset="100%" stop-color="hsl(350 65% 50% / 0.8)" />
        </linearGradient>
      </defs>
      <g id="strands-group"></g>
    </svg>
  </div>

  <div class="hero-content">
    <div class="hero-content__inner">

      <div class="hero-reveal" style="--delay: 0s">
        <a href="#hero-showcase" class="hero-badge">
          <span class="hero-badge__live"></span>
          {t("v3.hero.badge")}
          <svg class="hero-badge__arrow" viewBox="0 0 12 12" fill="none"><path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <h1 class="hero-headline hero-reveal" style="--delay: 0.1s">
        <span class="hero-gradient">{t("v3.hero.headline")}</span>
      </h1>

      <p class="hero-reveal hero-subtitle" style="--delay: 0.5s">
        {t("v3.hero.subtitle")}
      </p>

      <div class="hero-reveal hero-ctas" style="--delay: 0.65s">
        <a href="/download" class="hero-btn-primary group">
          <span class="hero-btn-primary__bg"></span>
          <span class="hero-btn-primary__shimmer"></span>
          <span class="hero-btn-primary__text">
            {t("v3.hero.cta.download")}
            <svg class="inline-block w-4 h-4 ml-1 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
        <a href={webAppUrl} target="_blank" rel="noreferrer" class="hero-btn-secondary">
          {t("v3.hero.cta.web")}
        </a>
        <a href={github} target="_blank" rel="noreferrer" class="hero-btn-ghost">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          {t("v3.hero.cta.github")}
          <span id="hero-star-badge" class="hero-star-badge">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span id="hero-star-count">600+</span>
          </span>
        </a>
      </div>

      <div class="hero-reveal hero-trust" style="--delay: 0.8s" id="hero-trust-pills">
        {trustPills.map((key) => (
          <span class="hero-pill">
            <span class="hero-pill__dot"></span>
            {t(key)}
          </span>
        ))}
      </div>
    </div>

    <div class="hero-reveal hero-showcase-wrap" style="--delay: 0.9s" id="hero-showcase">
      <div class="hero-tabbar" role="tablist" aria-label="Product showcase">
        {tabs.map((tab, i) => (
          <button
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`hero-panel-${tab.key}`}
            data-tab={tab.key}
            class:list={["hero-tab", i === 0 && "is-active"]}
          >
            {t(tab.translation)}
            <span class="hero-tab__progress"></span>
          </button>
        ))}
      </div>

      <div class="hero-tilt" id="hero-tilt">
        <div class="hero-frame">
          <div class="hero-frame__card">
            <div class="hero-chrome">
              <span class="hero-chrome__dot hero-chrome__dot--r"></span>
              <span class="hero-chrome__dot hero-chrome__dot--y"></span>
              <span class="hero-chrome__dot hero-chrome__dot--g"></span>
              <span class="hero-chrome__title">Flow-Like Studio</span>
            </div>

            <div class="hero-panels">

              <div id="hero-panel-automation" role="tabpanel" data-panel="automation" class="hero-panel is-active">
                <svg class="w-full h-full" viewBox="0 0 800 450" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="auto-grad" x1="0" y1="0" x2="800" y2="450" gradientUnits="userSpaceOnUse">
                      <stop offset="0%" stop-color="hsl(12 80% 55% / 0.05)"/>
                      <stop offset="100%" stop-color="hsl(25 85% 55% / 0.05)"/>
                    </linearGradient>
                  </defs>
                  <rect width="800" height="450" fill="url(#auto-grad)"/>
                  <path d="M200 150 C260 150, 280 225, 340 225" stroke="hsl(12 80% 55% / 0.4)" stroke-width="2" stroke-dasharray="6 4"/>
                  <path d="M200 300 C260 300, 280 225, 340 225" stroke="hsl(25 85% 55% / 0.4)" stroke-width="2" stroke-dasharray="6 4"/>
                  <path d="M440 225 C500 225, 520 150, 580 150" stroke="hsl(12 80% 55% / 0.4)" stroke-width="2" stroke-dasharray="6 4"/>
                  <path d="M440 225 C500 225, 520 300, 580 300" stroke="hsl(25 85% 55% / 0.4)" stroke-width="2" stroke-dasharray="6 4"/>
                  <rect x="100" y="120" width="100" height="60" rx="12" fill="hsl(12 80% 55% / 0.08)" stroke="hsl(12 80% 55% / 0.3)" stroke-width="1.5"/>
                  <text x="150" y="147" text-anchor="middle" fill="hsl(12 80% 55% / 0.7)" font-size="11" font-family="system-ui">Trigger</text>
                  <text x="150" y="165" text-anchor="middle" fill="hsl(12 80% 55% / 0.4)" font-size="9" font-family="system-ui">on schedule</text>
                  <rect x="100" y="270" width="100" height="60" rx="12" fill="hsl(25 85% 55% / 0.08)" stroke="hsl(25 85% 55% / 0.3)" stroke-width="1.5"/>
                  <text x="150" y="297" text-anchor="middle" fill="hsl(25 85% 55% / 0.7)" font-size="11" font-family="system-ui">Fetch Data</text>
                  <text x="150" y="315" text-anchor="middle" fill="hsl(25 85% 55% / 0.4)" font-size="9" font-family="system-ui">REST API</text>
                  <rect x="340" y="195" width="100" height="60" rx="12" fill="hsl(350 65% 50% / 0.08)" stroke="hsl(350 65% 50% / 0.3)" stroke-width="1.5"/>
                  <text x="390" y="222" text-anchor="middle" fill="hsl(350 65% 50% / 0.7)" font-size="11" font-family="system-ui">Transform</text>
                  <text x="390" y="240" text-anchor="middle" fill="hsl(350 65% 50% / 0.4)" font-size="9" font-family="system-ui">map + filter</text>
                  <rect x="580" y="120" width="100" height="60" rx="12" fill="hsl(12 80% 55% / 0.08)" stroke="hsl(12 80% 55% / 0.3)" stroke-width="1.5"/>
                  <text x="630" y="147" text-anchor="middle" fill="hsl(12 80% 55% / 0.7)" font-size="11" font-family="system-ui">Store</text>
                  <text x="630" y="165" text-anchor="middle" fill="hsl(12 80% 55% / 0.4)" font-size="9" font-family="system-ui">database</text>
                  <rect x="580" y="270" width="100" height="60" rx="12" fill="hsl(25 85% 55% / 0.08)" stroke="hsl(25 85% 55% / 0.3)" stroke-width="1.5"/>
                  <text x="630" y="297" text-anchor="middle" fill="hsl(25 85% 55% / 0.7)" font-size="11" font-family="system-ui">Notify</text>
                  <text x="630" y="315" text-anchor="middle" fill="hsl(25 85% 55% / 0.4)" font-size="9" font-family="system-ui">webhook</text>
                  <rect x="330" y="370" width="140" height="34" rx="17" fill="hsl(25 85% 55% / 0.12)" stroke="hsl(25 85% 55% / 0.3)" stroke-width="1"/>
                  <text x="400" y="392" text-anchor="middle" fill="hsl(25 85% 55% / 0.8)" font-size="12" font-family="system-ui" font-weight="600">&#x2713; All Steps Executed</text>
                </svg>
              </div>

              <div id="hero-panel-aiAgent" role="tabpanel" data-panel="aiAgent" class="hero-panel">
                <svg class="w-full h-full" viewBox="0 0 800 450" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="ai-grad" x1="0" y1="0" x2="800" y2="450" gradientUnits="userSpaceOnUse">
                      <stop offset="0%" stop-color="hsl(350 65% 50% / 0.05)"/>
                      <stop offset="100%" stop-color="hsl(12 80% 55% / 0.05)"/>
                    </linearGradient>
                  </defs>
                  <rect width="800" height="450" fill="url(#ai-grad)"/>
                  <rect x="40" y="30" width="200" height="390" rx="12" fill="hsl(0 0% 50% / 0.04)" stroke="hsl(0 0% 50% / 0.15)" stroke-width="1"/>
                  <text x="60" y="60" fill="hsl(0 0% 60% / 0.7)" font-size="11" font-family="system-ui" font-weight="600">Model Selector</text>
                  <rect x="55" y="78" width="170" height="32" rx="8" fill="hsl(350 65% 50% / 0.1)" stroke="hsl(350 65% 50% / 0.3)" stroke-width="1"/>
                  <text x="70" y="99" fill="hsl(350 65% 50% / 0.8)" font-size="10" font-family="system-ui">&#x25CF; GPT-4o</text>
                  <rect x="55" y="120" width="170" height="32" rx="8" fill="hsl(0 0% 50% / 0.04)" stroke="hsl(0 0% 50% / 0.12)" stroke-width="1"/>
                  <text x="70" y="141" fill="hsl(0 0% 60% / 0.5)" font-size="10" font-family="system-ui">&#x25CB; Claude 3.5</text>
                  <rect x="55" y="162" width="170" height="32" rx="8" fill="hsl(0 0% 50% / 0.04)" stroke="hsl(0 0% 50% / 0.12)" stroke-width="1"/>
                  <text x="70" y="183" fill="hsl(0 0% 60% / 0.5)" font-size="10" font-family="system-ui">&#x25CB; Llama 3</text>
                  <text x="60" y="225" fill="hsl(0 0% 60% / 0.7)" font-size="11" font-family="system-ui" font-weight="600">Parameters</text>
                  <rect x="55" y="240" width="170" height="24" rx="6" fill="hsl(0 0% 50% / 0.04)" stroke="hsl(0 0% 50% / 0.12)" stroke-width="1"/>
                  <text x="65" y="257" fill="hsl(0 0% 60% / 0.4)" font-size="9" font-family="system-ui">temp: 0.7 &#xB7; top_p: 0.9</text>
                  <path d="M340 100 C380 100, 380 180, 420 180" stroke="hsl(350 65% 50% / 0.4)" stroke-width="2" stroke-dasharray="6 4"/>
                  <path d="M520 180 C560 180, 560 100, 600 100" stroke="hsl(12 80% 55% / 0.4)" stroke-width="2" stroke-dasharray="6 4"/>
                  <path d="M520 180 C560 180, 560 260, 600 260" stroke="hsl(25 85% 55% / 0.4)" stroke-width="2" stroke-dasharray="6 4"/>
                  <rect x="270" y="70" width="80" height="60" rx="12" fill="hsl(350 65% 50% / 0.08)" stroke="hsl(350 65% 50% / 0.3)" stroke-width="1.5"/>
                  <text x="310" y="97" text-anchor="middle" fill="hsl(350 65% 50% / 0.7)" font-size="11" font-family="system-ui">Prompt</text>
                  <text x="310" y="115" text-anchor="middle" fill="hsl(350 65% 50% / 0.4)" font-size="9" font-family="system-ui">system + user</text>
                  <rect x="420" y="150" width="100" height="60" rx="12" fill="hsl(12 80% 55% / 0.08)" stroke="hsl(12 80% 55% / 0.3)" stroke-width="1.5"/>
                  <text x="470" y="177" text-anchor="middle" fill="hsl(12 80% 55% / 0.7)" font-size="11" font-family="system-ui">LLM Call</text>
                  <text x="470" y="195" text-anchor="middle" fill="hsl(12 80% 55% / 0.4)" font-size="9" font-family="system-ui">GPT-4o</text>
                  <rect x="600" y="70" width="80" height="60" rx="12" fill="hsl(25 85% 55% / 0.08)" stroke="hsl(25 85% 55% / 0.3)" stroke-width="1.5"/>
                  <text x="640" y="97" text-anchor="middle" fill="hsl(25 85% 55% / 0.7)" font-size="11" font-family="system-ui">Tool Call</text>
                  <text x="640" y="115" text-anchor="middle" fill="hsl(25 85% 55% / 0.4)" font-size="9" font-family="system-ui">search()</text>
                  <rect x="600" y="230" width="80" height="60" rx="12" fill="hsl(12 80% 55% / 0.08)" stroke="hsl(12 80% 55% / 0.3)" stroke-width="1.5"/>
                  <text x="640" y="257" text-anchor="middle" fill="hsl(12 80% 55% / 0.7)" font-size="11" font-family="system-ui">Response</text>
                  <text x="640" y="275" text-anchor="middle" fill="hsl(12 80% 55% / 0.4)" font-size="9" font-family="system-ui">structured</text>
                  <rect x="270" y="310" width="440" height="110" rx="10" fill="hsl(0 0% 50% / 0.04)" stroke="hsl(0 0% 50% / 0.12)" stroke-width="1"/>
                  <text x="290" y="336" fill="hsl(0 0% 60% / 0.7)" font-size="10" font-family="system-ui" font-weight="600">Execution Trace</text>
                  <text x="290" y="358" fill="hsl(25 85% 55% / 0.6)" font-size="9" font-family="monospace">&#x2713; prompt_built     12ms</text>
                  <text x="290" y="376" fill="hsl(25 85% 55% / 0.6)" font-size="9" font-family="monospace">&#x2713; llm_called       847ms</text>
                  <text x="290" y="394" fill="hsl(12 80% 55% / 0.6)" font-size="9" font-family="monospace">&#x21BB; tool_executed    203ms</text>
                  <text x="290" y="412" fill="hsl(0 0% 50% / 0.4)" font-size="9" font-family="monospace">&#x25E6; response_built   pending</text>
                </svg>
              </div>

              <div id="hero-panel-dashboard" role="tabpanel" data-panel="dashboard" class="hero-panel">
                <svg class="w-full h-full" viewBox="0 0 800 450" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="dash-grad" x1="0" y1="0" x2="800" y2="450" gradientUnits="userSpaceOnUse">
                      <stop offset="0%" stop-color="hsl(25 85% 55% / 0.05)"/>
                      <stop offset="100%" stop-color="hsl(12 80% 55% / 0.03)"/>
                    </linearGradient>
                  </defs>
                  <rect width="800" height="450" fill="url(#dash-grad)"/>
                  <rect x="40" y="30" width="170" height="80" rx="10" fill="hsl(12 80% 55% / 0.06)" stroke="hsl(12 80% 55% / 0.2)" stroke-width="1"/>
                  <text x="60" y="56" fill="hsl(0 0% 60% / 0.5)" font-size="10" font-family="system-ui">Total Runs</text>
                  <text x="60" y="86" fill="hsl(12 80% 55% / 0.8)" font-size="24" font-family="system-ui" font-weight="700">12,847</text>
                  <rect x="230" y="30" width="170" height="80" rx="10" fill="hsl(25 85% 55% / 0.06)" stroke="hsl(25 85% 55% / 0.2)" stroke-width="1"/>
                  <text x="250" y="56" fill="hsl(0 0% 60% / 0.5)" font-size="10" font-family="system-ui">Success Rate</text>
                  <text x="250" y="86" fill="hsl(25 85% 55% / 0.8)" font-size="24" font-family="system-ui" font-weight="700">99.2%</text>
                  <rect x="420" y="30" width="170" height="80" rx="10" fill="hsl(350 65% 50% / 0.06)" stroke="hsl(350 65% 50% / 0.2)" stroke-width="1"/>
                  <text x="440" y="56" fill="hsl(0 0% 60% / 0.5)" font-size="10" font-family="system-ui">Avg Latency</text>
                  <text x="440" y="86" fill="hsl(350 65% 50% / 0.8)" font-size="24" font-family="system-ui" font-weight="700">142ms</text>
                  <rect x="610" y="30" width="170" height="80" rx="10" fill="hsl(30 80% 55% / 0.06)" stroke="hsl(30 80% 55% / 0.2)" stroke-width="1"/>
                  <text x="630" y="56" fill="hsl(0 0% 60% / 0.5)" font-size="10" font-family="system-ui">Active Flows</text>
                  <text x="630" y="86" fill="hsl(30 80% 55% / 0.8)" font-size="24" font-family="system-ui" font-weight="700">34</text>
                  <rect x="40" y="130" width="460" height="200" rx="10" fill="hsl(0 0% 50% / 0.03)" stroke="hsl(0 0% 50% / 0.1)" stroke-width="1"/>
                  <text x="60" y="158" fill="hsl(0 0% 60% / 0.6)" font-size="10" font-family="system-ui" font-weight="600">Execution Volume</text>
                  <rect x="80" y="250" width="30" height="60" rx="4" fill="hsl(12 80% 55% / 0.25)"/>
                  <rect x="125" y="220" width="30" height="90" rx="4" fill="hsl(12 80% 55% / 0.3)"/>
                  <rect x="170" y="200" width="30" height="110" rx="4" fill="hsl(12 80% 55% / 0.35)"/>
                  <rect x="215" y="240" width="30" height="70" rx="4" fill="hsl(12 80% 55% / 0.25)"/>
                  <rect x="260" y="190" width="30" height="120" rx="4" fill="hsl(12 80% 55% / 0.4)"/>
                  <rect x="305" y="175" width="30" height="135" rx="4" fill="hsl(12 80% 55% / 0.5)"/>
                  <rect x="350" y="210" width="30" height="100" rx="4" fill="hsl(12 80% 55% / 0.35)"/>
                  <rect x="395" y="185" width="30" height="125" rx="4" fill="hsl(25 85% 55% / 0.4)"/>
                  <rect x="440" y="170" width="30" height="140" rx="4" fill="hsl(25 85% 55% / 0.5)"/>
                  <rect x="520" y="130" width="250" height="200" rx="10" fill="hsl(0 0% 50% / 0.03)" stroke="hsl(0 0% 50% / 0.1)" stroke-width="1"/>
                  <text x="540" y="158" fill="hsl(0 0% 60% / 0.6)" font-size="10" font-family="system-ui" font-weight="600">Connected Workflow</text>
                  <path d="M590 200 L680 200" stroke="hsl(12 80% 55% / 0.3)" stroke-width="1.5" stroke-dasharray="4 3"/>
                  <path d="M680 200 L720 250" stroke="hsl(25 85% 55% / 0.3)" stroke-width="1.5" stroke-dasharray="4 3"/>
                  <rect x="560" y="180" width="60" height="40" rx="8" fill="hsl(12 80% 55% / 0.08)" stroke="hsl(12 80% 55% / 0.25)" stroke-width="1"/>
                  <text x="590" y="205" text-anchor="middle" fill="hsl(12 80% 55% / 0.6)" font-size="9" font-family="system-ui">Query</text>
                  <rect x="650" y="180" width="60" height="40" rx="8" fill="hsl(350 65% 50% / 0.08)" stroke="hsl(350 65% 50% / 0.25)" stroke-width="1"/>
                  <text x="680" y="205" text-anchor="middle" fill="hsl(350 65% 50% / 0.6)" font-size="9" font-family="system-ui">Agg</text>
                  <rect x="690" y="235" width="60" height="40" rx="8" fill="hsl(25 85% 55% / 0.08)" stroke="hsl(25 85% 55% / 0.25)" stroke-width="1"/>
                  <text x="720" y="260" text-anchor="middle" fill="hsl(25 85% 55% / 0.6)" font-size="9" font-family="system-ui">Render</text>
                  <rect x="40" y="350" width="740" height="80" rx="10" fill="hsl(0 0% 50% / 0.03)" stroke="hsl(0 0% 50% / 0.1)" stroke-width="1"/>
                  <text x="60" y="378" fill="hsl(0 0% 60% / 0.6)" font-size="10" font-family="system-ui" font-weight="600">Recent Activity</text>
                  <text x="60" y="400" fill="hsl(25 85% 55% / 0.5)" font-size="9" font-family="monospace">&#x2713; data-sync 2m  &#x2713; report-gen 5m  &#x2713; etl-daily 12m  &#x26A0; alert-check 18m</text>
                  <text x="60" y="418" fill="hsl(25 85% 55% / 0.5)" font-size="9" font-family="monospace">&#x2713; user-onboard 23m  &#x2713; cache-refresh 31m  &#x2713; backup 45m  &#x2713; health 1h</text>
