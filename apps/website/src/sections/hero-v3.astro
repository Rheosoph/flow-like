  .hero-btn-primary:active {
    transform: translateY(0) scale(0.98);
  }

  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.75rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklch, var(--border) 80%, transparent);
    background: color-mix(in oklch, var(--background) 60%, transparent);
    backdrop-filter: blur(12px);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--foreground);
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .hero-btn-secondary:hover {
    background: color-mix(in oklch, var(--muted) 60%, transparent);
    border-color: var(--border);
    transform: translateY(-1px);
  }

  .hero-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 0.2s;
  }

  .hero-btn-ghost:hover {
    color: var(--foreground);
  }

  .hero-star-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.5rem 0.125rem 0.375rem;
    border-radius: 9999px;
    background: hsl(var(--muted) / 0.5);
    border: 1px solid var(--border);
    font-size: 0.6875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
    line-height: 1;
  }

  /* ═════════════════════════════════════════════
     Trust pills
     ═════════════════════════════════════════════ */
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
    background: color-mix(in oklch, var(--background) 60%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .hero-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: hsl(25 85% 50%);
    flex-shrink: 0;
  }

  /* ═════════════════════════════════════════════
     Showcase wrapper
     ═════════════════════════════════════════════ */
  .hero-showcase-wrap {
    margin-top: 3rem;
  }

  @media (min-width: 768px) {
    .hero-showcase-wrap { margin-top: 5rem; }
  }

  /* ═════════════════════════════════════════════
     Tabs
     ═════════════════════════════════════════════ */
  .hero-tabbar {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0 auto 1.5rem; /* Increased bottom margin slightly */
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    padding: 0.375rem; /* Slightly more padding */
    border-radius: 1rem; /* Rounder edges */
    border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);

    /* Make it 95% solid background instead of 80% */
    background: color-mix(in oklch, var(--background) 95%, transparent);

    /* Double the blur to wash out the lines behind it */
    backdrop-filter: blur(24px);

    /* Add a soft shadow to lift it off the canvas */
    box-shadow: 0 4px 24px -6px hsl(0 0% 0% / 0.08);
    scrollbar-width: none;
  }

  .hero-tabbar::-webkit-scrollbar { display: none; }

  .hero-tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600; /* Bumped from 500 to 600 for better contrast */
    color: var(--muted-foreground);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  .hero-tab:hover {
    color: var(--foreground);
    background: hsl(0 0% 50% / 0.06);
  }

  .hero-tab.is-active {
    color: var(--foreground);
    background: hsl(0 0% 50% / 0.1);
  }

  .hero-tab__progress {
    position: absolute;
    bottom: 0;
    left: 0.5rem;
    right: 0.5rem;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--primary), hsl(25 90% 55% / 0.6));
    transform-origin: left;
    transform: scaleX(0);
  }

  .hero-tab.is-active .hero-tab__progress {
    transition: transform 5s linear;
    transform: scaleX(1);
  }

  /* ═════════════════════════════════════════════
     3D Tilt container
     ═════════════════════════════════════════════ */
  .hero-tilt {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.03, 0.98, 0.52, 0.99);
    will-change: transform;
  }

  /* ═════════════════════════════════════════════
     Frame (Lean & Professional)
     ═════════════════════════════════════════════ */
  .hero-frame {
    position: relative;
    width: 100%;
  }

  @media (min-width: 768px) {
    .hero-frame { width: 90%; margin: 0 auto; }
  }

  @media (min-width: 1024px) {
    .hero-frame { width: 65vw; max-width: 1000px; }
  }

  .hero-frame__card {
    border-radius: 14px;
    overflow: hidden;
    /* Cleaner, slightly more opaque glass effect */
    background: color-mix(in oklch, var(--background) 95%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    /* Subtle inner highlight to make the glass pop */
    box-shadow: inset 0 1px 0 0 hsl(0 0% 100% / 0.4);
  }

  /* Window chrome */
  .hero-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
    background: color-mix(in oklch, var(--muted) 20%, transparent);
  }

  .hero-chrome__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .hero-chrome__dot--r { background: hsl(0 70% 60% / 0.7); }
  .hero-chrome__dot--y { background: hsl(45 80% 55% / 0.7); }
  .hero-chrome__dot--g { background: hsl(25 85% 50% / 0.7); }

  .hero-chrome__title {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    color: var(--muted-foreground);
    opacity: 0.5;
  }

  /* Panels */
  .hero-panels {
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .hero-panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 0;
    transition: opacity 400ms ease;
  }

  .hero-panel.is-active {
    opacity: 1;
    z-index: 10;
  }

  /* Mobile dots */
  .hero-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  @media (min-width: 640px) {
    .hero-dots { display: none; }
  }

  .hero-dot {
    height: 8px;
    width: 8px;
    border-radius: 9999px;
    border: none;
    background: color-mix(in oklch, var(--muted-foreground) 30%, transparent);
    cursor: pointer;
    padding: 0;
    transition: all 0.3s;
  }

  .hero-dot.is-active {
    width: 24px;
    background: var(--primary);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      animation: none !important;
    }
    .hero-reveal.is-visible { animation: none !important; }
    .hero-btn-primary__bg,
    .hero-btn-primary__shimmer,
    .hero-badge__live::after {
      animation: none !important;
    }
    .hero-panel { transition: none !important; }
    .hero-tab__progress { transition: none !important; }
  }
</style>

<script>
  interface StrandPoint {
    baseX: number;
    baseY: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    phase: number;
    speed: number;
  }

  interface Strand {
    el: SVGPathElement;
    points: StrandPoint[];
  }

  function initHero() {
    const section = document.getElementById("hero-section");
    if (!section) return;
    const showcase = document.getElementById("hero-showcase");
    if (!showcase) return;

    const tabs = showcase.querySelectorAll<HTMLButtonElement>(".hero-tab");
    const panels = showcase.querySelectorAll<HTMLDivElement>(".hero-panel");
    const dots = document.querySelectorAll<HTMLButtonElement>(".hero-dot");
    const INTERVAL = 5000;
    let active = 0;
    let timer: ReturnType<typeof setTimeout> | null = null;
    let paused = false;

    function activate(i: number) {
      active = i;
      tabs.forEach((t, j) => {
        const on = j === i;
        t.classList.toggle("is-active", on);
        t.setAttribute("aria-selected", String(on));
        const bar = t.querySelector<HTMLSpanElement>(".hero-tab__progress");
        if (bar) {
          bar.style.transition = "none";
          bar.style.transform = "scaleX(0)";
          if (on) {
            void bar.offsetWidth;
            bar.style.transition = `transform ${INTERVAL}ms linear`;
            bar.style.transform = "scaleX(1)";
          }
        }
      });
      panels.forEach((p, j) => {
        p.classList.toggle("is-active", j === i);
      });
      dots.forEach((d, j) => d.classList.toggle("is-active", j === i));
    }

    function startAuto() {
      stopAuto();
      if (!paused) {
        timer = setTimeout(() => {
          activate((active + 1) % tabs.length);
          startAuto();
        }, INTERVAL);
      }
    }

    function stopAuto() {
      if (timer) { clearTimeout(timer); timer = null; }
    }

    tabs.forEach((t, i) => t.addEventListener("click", () => { activate(i); paused = false; startAuto(); }));
    dots.forEach((d, i) => d.addEventListener("click", () => { activate(i); paused = false; startAuto(); }));

    const hoverTargets = [showcase.querySelector(".hero-frame"), showcase.querySelector(".hero-tabbar")];
    for (const el of hoverTargets) {
      if (!el) continue;
      el.addEventListener("mouseenter", () => { paused = true; stopAuto(); });
      el.addEventListener("mouseleave", () => { paused = false; startAuto(); });
      el.addEventListener("focusin", () => { paused = true; stopAuto(); });
      el.addEventListener("focusout", () => { paused = false; startAuto(); });
    }

    activate(0);
    startAuto();
  }

  function initTilt() {
    const el = document.getElementById("hero-tilt");
    if (!el || !matchMedia("(pointer: fine)").matches) return;

    el.addEventListener("mousemove", (e) => {
      const r = el.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      el.style.transition = "transform 0.15s ease-out";
      el.style.transform = `perspective(1200px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg)`;
    });

    el.addEventListener("mouseleave", () => {
      el.style.transition = "transform 0.6s cubic-bezier(0.03, 0.98, 0.52, 0.99)";
      el.style.transform = "perspective(1200px) rotateY(0deg) rotateX(0deg)";
    });
  }

  function initInteractiveWaves() {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!matchMedia("(pointer: fine)").matches) return;

    const section = document.getElementById("hero-section");
    const group = document.getElementById("strands-group");
    const svgBg = document.getElementById("wave-wrap");

    if (!section || !group || !svgBg) return;

    let mouseX = -1000;
    let mouseY = -1000;

    section.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    section.addEventListener("mouseleave", () => {
      mouseX = -1000;
      mouseY = -1000;
    });

    const svgWidth = 1440;
    const svgHeight = 900;
    const numStrands = 7;
    const pointsPerStrand = 18;
    const pullRadius = 250;
    const stiffness = 0.05;
    const damping = 0.85;
    let svgBounds = svgBg.getBoundingClientRect();
    let frameId: number | null = null;
    let isPageVisible = document.visibilityState === "visible";
    let isSectionVisible = true;

    const updateSvgBounds = () => {
      svgBounds = svgBg.getBoundingClientRect();
    };

    updateSvgBounds();
    window.addEventListener("resize", updateSvgBounds, { passive: true });
    window.addEventListener("scroll", updateSvgBounds, { passive: true });

    // Helper to generate a U-shape looping under the Trust Pills
    function createStrands() {
      const strands: Strand[] = [];
      const gradients = ["grad-w1", "grad-w2", "grad-w3"];

      for (let i = 0; i < numStrands; i++) {
        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        const grad = gradients[i % gradients.length];
        path.setAttribute("stroke", `url(#${grad})`);
        path.setAttribute("stroke-width", (Math.random() * 3 + 2).toString());
        path.setAttribute("fill", "none");
        path.setAttribute("stroke-linecap", "round");
        group!.appendChild(path);

        // Calculate a dynamically dipped U-shape
        const dipY = 650 + Math.random() * 150; // Dips beneath the pills
        const startY = Math.random() * 300 - 100; // Top Left Start
        const endY = Math.random() * 300 - 100; // Top Right End

        // Quadratic bezier calculation
        const controlY = 2 * dipY - 0.5 * startY - 0.5 * endY;

        const points: StrandPoint[] = [];
        for (let j = 0; j < pointsPerStrand; j++) {
          const t = j / (pointsPerStrand - 1);
          const baseX = -100 + t * (svgWidth + 200); // Stretch off screen
          const baseY = Math.pow(1-t, 2) * startY + 2*(1-t)*t * controlY + Math.pow(t, 2) * endY;

          points.push({
            baseX,
            baseY,
            x: baseX,
            y: baseY,
            vx: 0,
            vy: 0,
            phase: Math.random() * Math.PI * 2,
            speed: Math.random() * 0.4 + 0.3
          });
        }
        strands.push({ el: path, points });
      }
      return strands;
    }

    const strands = createStrands();

    // Quadratic bezier curve builder for path segments
    function generateSmoothPath(points: StrandPoint[]) {
      let d = `M ${points[0].x} ${points[0].y}`;
      for (let i = 0; i < points.length - 1; i++) {
        const xc = (points[i].x + points[i + 1].x) / 2;
        const yc = (points[i].y + points[i + 1].y) / 2;
        d += ` Q ${points[i].x} ${points[i].y}, ${xc} ${yc}`;
      }
      d += ` T ${points[points.length - 1].x} ${points[points.length - 1].y}`;
      return d;
    }

    function syncWaveLoop() {
      const shouldAnimate = isPageVisible && isSectionVisible;
      if (shouldAnimate && frameId === null) {
        frameId = requestAnimationFrame(renderWaves);
      }
      if (!shouldAnimate && frameId !== null) {
        cancelAnimationFrame(frameId);
        frameId = null;
      }
    }

    function renderWaves() {
      frameId = null;
      if (!isPageVisible || !isSectionVisible) return;

      const time = Date.now() * 0.001;

      // Localize mouse to SVG internal viewBox mapping
      const localMouseX = (mouseX - svgBounds.left) * (svgWidth / svgBounds.width);
      const localMouseY = (mouseY - svgBounds.top) * (svgHeight / svgBounds.height);

      strands.forEach((strand) => {
        strand.points.forEach((point, j) => {
          // Less movement near the anchors, high movement at the dip
          const edgeFactor = Math.sin((j / (pointsPerStrand - 1)) * Math.PI);

          const waveX = point.baseX + Math.sin(time * point.speed + point.phase + j * 0.2) * 20 * edgeFactor;
          const waveY = point.baseY + Math.cos(time * point.speed + point.phase + j * 0.2) * 30 * edgeFactor;

          let targetX = waveX;
          let targetY = waveY;

          // Mouse interaction (repel/bend)
          const dx = waveX - localMouseX;
          const dy = waveY - localMouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist > 0 && dist < pullRadius) {
            const force = Math.pow((pullRadius - dist) / pullRadius, 2);
            targetX += (dx / dist) * force * 120 * edgeFactor;
            targetY += (dy / dist) * force * 120 * edgeFactor;
          }

          // Spring physics
          point.vx += (targetX - point.x) * stiffness;
          point.vx *= damping;
          point.x += point.vx;

          point.vy += (targetY - point.y) * stiffness;
          point.vy *= damping;
          point.y += point.vy;
        });
        strand.el.setAttribute("d", generateSmoothPath(strand.points));
      });

      frameId = requestAnimationFrame(renderWaves);
    }

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          isSectionVisible = entries.some((entry) => entry.isIntersecting);
          if (isSectionVisible) updateSvgBounds();
          syncWaveLoop();
        },
        { threshold: 0 },
      );

      observer.observe(section);
    }

    document.addEventListener("visibilitychange", () => {
      isPageVisible = document.visibilityState === "visible";
      if (isPageVisible) updateSvgBounds();
      syncWaveLoop();
    });

    syncWaveLoop();
  }

  function initReveal() {
    const els = document.querySelectorAll<HTMLElement>("#hero-section .hero-reveal");
    if (!("IntersectionObserver" in window)) {
      els.forEach(el => el.classList.add("is-visible"));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -5% 0px", threshold: 0.05 },
    );

    els.forEach(el => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add("is-visible");
      } else {
        io.observe(el);
      }
    });
  }

  initReveal();
  initHero();
  initTilt();
  initInteractiveWaves();

  // Fetch GitHub stars (fallback "600+" baked into HTML)
  (function() {
    const CACHE_KEY = "gh_stars";
    const CACHE_TTL = 3600000;
    const countEl = document.getElementById("hero-star-count");
    if (!countEl) return;

    function show(count: number) {
      countEl!.textContent = count >= 1000 ? `${(count / 1000).toFixed(1)}k` : String(count);
    }

    try {
      const cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) {
        const { count, ts } = JSON.parse(cached);
        if (Date.now() - ts < CACHE_TTL) { show(count); return; }
      }
    } catch {}

    fetch("https://api.github.com/repos/TM9657/flow-like", {
      headers: { Accept: "application/vnd.github.v3+json" },
    })
      .then(r => r.ok ? r.json() : Promise.reject())
      .then(data => {
        const count = data?.stargazers_count;
        if (typeof count === "number" && count > 0) {
          show(count);
          try { sessionStorage.setItem(CACHE_KEY, JSON.stringify({ count, ts: Date.now() })); } catch {}
        }
      })
      .catch(() => {});
  })();
</script>