---
import type { Lang, TranslationKey } from "../i18n";
import { translations, defaultLang } from "../i18n";

interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = (key: TranslationKey): string => {
  const l = translations[lang] as Record<string, string>;
  const e = translations.en as Record<string, string>;
  return l?.[key] ?? e[key] ?? key;
};

const row1 = [
  { i: 1, accent: "from-indigo-500/20 to-indigo-500/5" },
  { i: 3, accent: "from-emerald-500/20 to-emerald-500/5" },
  { i: 6, accent: "from-purple-500/20 to-purple-500/5" },
  { i: 4, accent: "from-cyan-500/20 to-cyan-500/5" },
] as const;

const row2 = [
  { i: 2, accent: "from-yellow-500/20 to-yellow-500/5" },
  { i: 7, accent: "from-red-500/20 to-red-500/5" },
  { i: 5, accent: "from-indigo-500/20 to-indigo-500/5" },
  { i: 8, accent: "from-emerald-500/20 to-emerald-500/5" },
] as const;

function buildCard(i: number, accent: string) {
  const role = t(`v3.testimonials.${i}.role` as TranslationKey);
  const story = t(`v3.testimonials.${i}.story` as TranslationKey);
  const tags = t(`v3.testimonials.${i}.tags` as TranslationKey).split(",").map(s => s.trim()).filter(Boolean);
  return { role, story, tags, accent };
}

const r1Cards = row1.map(c => buildCard(c.i, c.accent));
const r2Cards = row2.map(c => buildCard(c.i, c.accent));

const communityItems = [
  { key: "v3.testimonials.community.stars" as TranslationKey, icon: "star" },
  { key: "v3.testimonials.community.discord" as TranslationKey, icon: "discord" },
  { key: "v3.testimonials.community.opensource" as TranslationKey, icon: "opensource" },
] as const;
---

<section class="tm-section relative isolate overflow-hidden py-24 md:py-32">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="tm-orb tm-orb--purple"></div>
    <div class="tm-orb tm-orb--blue"></div>
  </div>

  <!-- Headline — constrained width -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="tm-reveal mx-auto max-w-3xl text-center mb-12 md:mb-16">
      <span class="inline-block rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-xs font-medium text-primary mb-4">
        {t("v3.testimonials.label")}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight">
        {t("v3.testimonials.headline")}
      </h2>
    </div>
  </div>

  <!-- Marquee rows — full bleed, no horizontal overflow on body -->
  <div class="tm-reveal tm-marquee-wrap" style="--stagger: 100ms">
    <!-- Row 1 — scrolls left -->
    <div class="tm-marquee" aria-label="Testimonial row 1">
      <div class="tm-track tm-track--left">
        {/* Duplicate cards for seamless loop */}
        {[...r1Cards, ...r1Cards].map(({ role, story, tags, accent }) => (
          <article class="tm-card group">
            <div class={`tm-card__accent bg-gradient-to-r ${accent}`} />
            <div class="tm-card__body">
              <p class="text-[13px] text-foreground/80 leading-relaxed mb-3 flex-1">
                {story}
              </p>
              <div class="border-t border-border/40 pt-3 mt-auto">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground leading-snug">{role}</p>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {tags.map(tag => (
                    <span class="inline-block rounded-full border border-border/30 bg-muted/50 px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Row 2 — scrolls right -->
    <div class="tm-marquee mt-4" aria-label="Testimonial row 2">
      <div class="tm-track tm-track--right">
        {[...r2Cards, ...r2Cards].map(({ role, story, tags, accent }) => (
          <article class="tm-card group">
            <div class={`tm-card__accent bg-gradient-to-r ${accent}`} />
            <div class="tm-card__body">
              <p class="text-[13px] text-foreground/80 leading-relaxed mb-3 flex-1">
                {story}
              </p>
              <div class="border-t border-border/40 pt-3 mt-auto">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground leading-snug">{role}</p>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {tags.map(tag => (
                    <span class="inline-block rounded-full border border-border/30 bg-muted/50 px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- Community Stats -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="tm-reveal mt-14 md:mt-20 flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-10" style="--stagger: 400ms">
      {communityItems.map(({ key, icon }) => (
        <div class="flex items-center gap-2.5 text-muted-foreground">
          {icon === "star" && (
            <svg class="w-5 h-5 text-yellow-500/70" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          )}
          {icon === "discord" && (
            <svg class="w-5 h-5 text-indigo-400/70" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
          )}
          {icon === "opensource" && (
            <svg class="w-5 h-5 text-emerald-500/70" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.164 6.839 9.49.5.09.682-.218.682-.484 0-.236-.009-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
          )}
          <span class="text-sm font-medium" {...(icon === "star" ? { "data-github-stars": true } : {})}>{t(key)}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tm-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
  }
  .tm-orb--purple {
    width: 450px;
    height: 450px;
    top: -60px;
    left: -80px;
    background: radial-gradient(circle, hsl(280 60% 55% / 0.1), transparent 70%);
  }
  .tm-orb--blue {
    width: 400px;
    height: 400px;
    bottom: -60px;
    right: -60px;
    background: radial-gradient(circle, hsl(222 89% 60% / 0.08), transparent 70%);
  }

  /* ── Marquee ── */
  .tm-marquee-wrap {
    /* Edge fade so cards don't feel clipped */
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }

  .tm-marquee {
    overflow: hidden;
    width: 100%;
  }

  .tm-track {
    display: flex;
    gap: 1rem;
    width: max-content;
  }

  .tm-track--left {
    animation: tm-scroll-left 60s linear infinite;
  }
  .tm-track--right {
    animation: tm-scroll-right 60s linear infinite;
  }

  /* Pause on hover */
  .tm-marquee:hover .tm-track {
    animation-play-state: paused;
  }

  @keyframes tm-scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @keyframes tm-scroll-right {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  /* ── Card ── */
  .tm-card {
    flex-shrink: 0;
    width: 340px;
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--card);
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .tm-card:hover {
    border-color: color-mix(in oklch, var(--primary) 25%, transparent);
    box-shadow: 0 8px 24px color-mix(in oklch, var(--foreground) 6%, transparent);
  }

  .tm-card__accent {
    height: 3px;
    flex-shrink: 0;
  }

  .tm-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.25rem 1rem;
  }

  /* ── Reveal ── */
  .tm-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: var(--stagger, 0ms);
  }
  .tm-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .tm-reveal {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .tm-track--left,
    .tm-track--right {
      animation: none !important;
    }
  }
</style>

<script>
  function initTMReveal() {
    const els = document.querySelectorAll(".tm-section .tm-reveal");
    if (!("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    els.forEach((el) => io.observe(el));
  }
  initTMReveal();
</script>
