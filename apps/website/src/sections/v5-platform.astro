---
import { FlowPilotBubbleOrb } from "@flow-like/flow-like-ui/components/global-chat/flowpilot-bubble-orb";
const features = [
  {
    id: "builder",
    no: "01",
    title: "App Builder",
    kicker: "FROM INTENT TO SOFTWARE",
    text: "Describe the outcome. FlowPilot assembles the interface, logic, data model, and permissions into a production-ready app.",
    tags: ["Prompt to app", "Human editable", "Production ready"],
  },
  {
    id: "workflow",
    no: "02",
    title: "Workflow Core",
    kicker: "ORCHESTRATE ANYTHING",
    text: "Design reliable processes visually, then drop into real code wherever you need complete control.",
    tags: ["JavaScript", "Python", "Rust", "Java", "C++"],
  },
  {
    id: "frontend",
    no: "03",
    title: "Frontend Builder",
    kicker: "INTERFACES WITHOUT LIMITS",
    text: "Compose polished experiences visually or bring your preferred framework and engineering workflow.",
    tags: ["React", "Next.js", "Angular", "Components"],
  },
  {
    id: "data",
    no: "04",
    title: "Data Studio",
    kicker: "A SHARED COMPANY LANGUAGE",
    text: "Build ontologies, connect operational data, and query terabytes from the same environment your apps use.",
    tags: ["Ontologies", "Semantic layer", "TB-scale"],
  },
  {
    id: "store",
    no: "05",
    title: "App Store",
    kicker: "ONE APP BECOMES A CAPABILITY",
    text: "Publish, discover, reuse, and manage every company application from one trusted place.",
    tags: ["Private catalogue", "Versioned", "Reusable"],
  },
  {
    id: "governance",
    no: "06",
    title: "Governance",
    kicker: "EVERY ACTION. ONE CONTROL PLANE.",
    text: "See every process, app, agent interaction, permission, and log—ready for policy reviews and the EU AI Act.",
    tags: ["Audit trails", "Policy controls", "EU AI Act"],
  },
  {
    id: "pilot",
    no: "07",
    title: "FlowPilot",
    kicker: "YOUR COMPANY, IN MOTION",
    text: "FlowPilot builds with your tools and uses them for you—combining apps, data, and workflows in a single request.",
    tags: ["Builds", "Reasons", "Acts", "Learns"],
  },
];

const steps = [
  ["01", "Every 15 min", "Schedule"],
  ["02", "Query suppliers", "Data Studio"],
  ["03", "Score risk", "FlowScript"],
  ["04", "High risk?", "Condition"],
  ["05", "Notify owner", "Mail + Teams"],
];

const auditRows = [
  ["Contract intelligence", "Legal", "Limited", "Compliant"],
  ["Customer health agent", "Revenue", "Minimal", "Compliant"],
  ["Candidate screening", "People", "High", "Review due"],
  ["Invoice processing", "Finance", "Minimal", "Compliant"],
];

const execSteps = [
  ["01", "Customer 360", "Found account, renewal, and open risks"],
  ["02", "Email", "Reviewed 18 relevant conversations"],
  ["03", "Notes", "Summarized the last two meetings"],
  ["04", "Calendar", "Added briefing and proposed agenda"],
];

const previewBars = [45, 59, 51, 73, 66, 89, 78];
const marketBars = [42, 55, 48, 72, 65, 88];
const components = ["Layout", "Table", "Chart", "Input", "FlowPilot"];
const storeApps = ["Deal Desk", "People Hub", "Incident OS", "Research", "Vendor Risk", "Field Ops"];
const MAX_TAGS = 5;
const first = features[0];
const featuresJson = JSON.stringify(
  features.map((f) => ({ kicker: f.kicker, title: f.title, text: f.text, tags: f.tags })),
);
---

<section id="platform" class="dark v5-platform" style="color-scheme:dark">
  <div class="story" data-v5-story data-features={featuresJson}>
    <div class="story-sticky">
      <header class="story-top">
        <span class="eyebrow">02 / PLATFORM</span>
        <i><b data-progress style="width:0%"></b></i>
        <span data-counter>01 — 07</span>
      </header>
      <h2><span>Build</span><span>the whole</span><span>system.</span></h2>
      <nav>
        {features.map((f, i) => (
          <button class={i === 0 ? "active" : ""} data-nav={i} type="button"><i>{f.no}</i><span>{f.title}</span></button>
        ))}
      </nav>
      <div class="stage">
        {features.map((f, i) => (
          <div class:list={["stage-item", i === 0 && "is-active"]} data-mock={i}>
            {f.id === "builder" && (
              <div class="mock builder">
                <aside><label>FLOWPILOT</label><p>Build a supplier control tower with live risk alerts.</p><div class="building"><i></i><span><b>Building your app</b><small>Connecting ontology and workflows</small></span></div><ul><li>✓ Data model</li><li>✓ 4 workflows</li><li>✓ Access policies</li></ul></aside>
                <section class="app-preview light-screen"><header><b>SupplyOS</b><span>Overview &nbsp; Suppliers &nbsp; Alerts</span><i>FL</i></header><main><label>SUPPLY NETWORK / LIVE</label><h4>Good morning, Felix.</h4><div class="preview-metrics"><span><b>214</b><small>Suppliers</small></span><span><b>96.8%</b><small>On time</small></span><span><b>8</b><small>At risk</small></span></div><div class="preview-bars">{previewBars.map((x) => (<i style={`height:${x}%`}></i>))}</div></main></section>
              </div>
            )}
            {f.id === "workflow" && (
              <div class="mock workflow">
                <header><b>Supplier risk monitor</b><span>LIVE</span></header>
                <div class="workflow-canvas">{steps.map((s, i) => (<div class={`flow-step fs${i + 1}`}><i>{s[0]}</i><span><b>{s[1]}</b><small>{s[2]}</small></span></div>))}<div class="wires" data-connect data-links="fs1-fs2,fs1-fs3,fs2-fs4,fs4-fs5"></div></div>
                <div class="code"><header><span>score_risk.flow</span><em>FlowScript</em></header><pre><span class="fn">onSchedule</span>() &#123;
  <span class="k">const</span> signals = <span class="fn">ontologySignals</span>(&#123; <span class="pr">supplier</span> &#125;)
  <span class="k">const</span> score = <span class="fn">modelPredict</span>(&#123; <span class="pr">model</span>: <span class="st">"risk-v3"</span>, <span class="pr">signals</span> &#125;)
  <span class="fn">log</span>(&#123; <span class="pr">text</span>: score.risk &#125;)
&#125;</pre></div>
              </div>
            )}
            {f.id === "frontend" && (
              <div class="mock frontend">
                <aside><label>COMPONENTS</label>{components.map((x) => (<span><i></i>{x}<b>＋</b></span>))}</aside>
                <section class="light-screen"><header><b>Northstar</b><span>Portfolio &nbsp; Risk &nbsp; Reports</span><i>NS</i></header><main><label>PORTFOLIO VALUE</label><div><h4>€84.2M</h4><em>↗ 12.4%</em></div><section><i class="donut"></i><div class="market-bars">{marketBars.map((x) => (<i style={`height:${x}%`}></i>))}</div></section></main></section>
                <footer><span>Visual</span><b>React</b><b>Next.js</b><b>Angular</b></footer>
              </div>
            )}
            {f.id === "data" && (
              <div class="mock data">
                <header><b>Company Ontology</b><span>42 objects · 128 relations</span><em>QUERY</em></header>
                <div class="ontology"><div class="object o1"><i>CO</i><span><b>Company</b><small>12.4k records</small></span></div><div class="object o2"><i>PE</i><span><b>Person</b><small>84.2k records</small></span></div><div class="object o3"><i>CT</i><span><b>Contract</b><small>31.8k records</small></span></div><div class="object o4"><i>PR</i><span><b>Product</b><small>4.2k records</small></span></div><div class="object o5"><i>EV</i><span><b>Interaction</b><small>2.8B events</small></span></div><div class="rels" data-connect data-links="o1-o2,o1-o3,o1-o4,o1-o5"></div></div>
                <footer><label>ASK YOUR ONTOLOGY</label><p>Which strategic accounts have declining engagement and renew this quarter?</p><b>⌘ ↵</b></footer>
              </div>
            )}
            {f.id === "store" && (
              <div class="mock store light-screen">
                <header><b>Company App Store</b><div>Search 146 apps...</div><span>My apps</span></header>
                <main><section class="dark"><span><label>FEATURED</label><b>Quarterly Business Review</b><p>Everything your account team needs, assembled by FlowPilot.</p><em>Open app ↗</em></span><i>Q3</i></section><div class="store-grid">{storeApps.map((x, i) => (<article><i>{x[0]}</i><span><b>{x}</b><small>{12 + i * 7} users</small></span><em>↗</em></article>))}</div></main>
              </div>
            )}
            {f.id === "governance" && (
              <div class="mock governance light-screen">
                <header><span><label>GOVERNANCE</label><b>Company control plane</b></span><em>All systems operational</em></header>
                <div class="gov-metrics"><span><small>AI systems</small><b>84</b><i>+6 this month</i></span><span><small>Policy coverage</small><b>98.7%</b><i>2 reviews due</i></span><span><small>Agent actions</small><b>1.2M</b><i>Last 30 days</i></span></div>
                <div class="audit"><header><span>System</span><span>Owner</span><span>Risk</span><span>Status</span></header>{auditRows.map((r) => (<div>{r.map((x) => (<span>{x}</span>))}</div>))}</div>
              </div>
            )}
            {f.id === "pilot" && (
              <div class="mock pilot">
                <div class="pilot-command"><FlowPilotBubbleOrb client:only="react" aria-label="FlowPilot" className="size-9 shrink-0" /><p>Prepare me for the Acme renewal meeting tomorrow. Include risks, recent conversations, and a proposed agenda.</p><span>FlowPilot · Company access</span></div>
                <div class="execution">{execSteps.map((s) => (<div><i>{s[0]}</i><span><b>{s[1]}</b><small>{s[2]}</small></span><em>Done ✓</em></div>))}</div>
                <div class="pilot-result light-screen"><label>BRIEFING READY</label><b>Acme Renewal · €1.2M ARR</b><p>Three expansion signals, one adoption risk, and a clear path to renewal.</p><button>Open briefing ↗</button></div>
              </div>
            )}
          </div>
        ))}
      </div>
      <aside class="story-copy">
        <label data-copy-label>{first.kicker}</label>
        <h3 data-copy-title>{first.title}</h3>
        <p data-copy-text>{first.text}</p>
        <div data-copy-tags>
          {Array.from({ length: MAX_TAGS }).map((_, i) => (
            <em data-tag={i} style={i >= first.tags.length ? "display:none" : ""}>{first.tags[i] ?? ""}</em>
          ))}
        </div>
      </aside>
    </div>
  </div>

  <div class="mobile-story">
    <header><span class="eyebrow">02 / PLATFORM</span><h2>Build the whole system.</h2></header>
    {features.map((f) => (
      <article>
        <div><label>{f.no} / {f.kicker}</label><h3>{f.title}</h3><p>{f.text}</p></div>
        {f.id === "builder" && (
          <div class="mock builder">
            <aside><label>FLOWPILOT</label><p>Build a supplier control tower with live risk alerts.</p><div class="building"><i></i><span><b>Building your app</b><small>Connecting ontology and workflows</small></span></div><ul><li>✓ Data model</li><li>✓ 4 workflows</li><li>✓ Access policies</li></ul></aside>
            <section class="app-preview light-screen"><header><b>SupplyOS</b><span>Overview &nbsp; Suppliers &nbsp; Alerts</span><i>FL</i></header><main><label>SUPPLY NETWORK / LIVE</label><h4>Good morning, Felix.</h4><div class="preview-metrics"><span><b>214</b><small>Suppliers</small></span><span><b>96.8%</b><small>On time</small></span><span><b>8</b><small>At risk</small></span></div><div class="preview-bars">{previewBars.map((x) => (<i style={`height:${x}%`}></i>))}</div></main></section>
          </div>
        )}
        {f.id === "workflow" && (
          <div class="mock workflow">
            <header><b>Supplier risk monitor</b><span>LIVE</span></header>
            <div class="workflow-canvas">{steps.map((s, i) => (<div class={`flow-step fs${i + 1}`}><i>{s[0]}</i><span><b>{s[1]}</b><small>{s[2]}</small></span></div>))}<div class="wires" data-connect data-links="fs1-fs2,fs1-fs3,fs2-fs4,fs4-fs5"></div></div>
            <div class="code"><header><span>score_risk.flow</span><em>FlowScript</em></header><pre><span class="fn">onSchedule</span>() &#123;
  <span class="k">const</span> signals = <span class="fn">ontologySignals</span>(&#123; <span class="pr">supplier</span> &#125;)
  <span class="k">const</span> score = <span class="fn">modelPredict</span>(&#123; <span class="pr">model</span>: <span class="st">"risk-v3"</span>, <span class="pr">signals</span> &#125;)
  <span class="fn">log</span>(&#123; <span class="pr">text</span>: score.risk &#125;)
&#125;</pre></div>
          </div>
        )}
        {f.id === "frontend" && (
          <div class="mock frontend">
            <aside><label>COMPONENTS</label>{components.map((x) => (<span><i></i>{x}<b>＋</b></span>))}</aside>
            <section class="light-screen"><header><b>Northstar</b><span>Portfolio &nbsp; Risk &nbsp; Reports</span><i>NS</i></header><main><label>PORTFOLIO VALUE</label><div><h4>€84.2M</h4><em>↗ 12.4%</em></div><section><i class="donut"></i><div class="market-bars">{marketBars.map((x) => (<i style={`height:${x}%`}></i>))}</div></section></main></section>
            <footer><span>Visual</span><b>React</b><b>Next.js</b><b>Angular</b></footer>
          </div>
        )}
        {f.id === "data" && (
          <div class="mock data">
            <header><b>Company Ontology</b><span>42 objects · 128 relations</span><em>QUERY</em></header>
            <div class="ontology"><div class="object o1"><i>CO</i><span><b>Company</b><small>12.4k records</small></span></div><div class="object o2"><i>PE</i><span><b>Person</b><small>84.2k records</small></span></div><div class="object o3"><i>CT</i><span><b>Contract</b><small>31.8k records</small></span></div><div class="object o4"><i>PR</i><span><b>Product</b><small>4.2k records</small></span></div><div class="object o5"><i>EV</i><span><b>Interaction</b><small>2.8B events</small></span></div><div class="rels" data-connect data-links="o1-o2,o1-o3,o1-o4,o1-o5"></div></div>
            <footer><label>ASK YOUR ONTOLOGY</label><p>Which strategic accounts have declining engagement and renew this quarter?</p><b>⌘ ↵</b></footer>
          </div>
        )}
        {f.id === "store" && (
          <div class="mock store light-screen">
            <header><b>Company App Store</b><div>Search 146 apps...</div><span>My apps</span></header>
            <main><section class="dark"><span><label>FEATURED</label><b>Quarterly Business Review</b><p>Everything your account team needs, assembled by FlowPilot.</p><em>Open app ↗</em></span><i>Q3</i></section><div class="store-grid">{storeApps.map((x, i) => (<article><i>{x[0]}</i><span><b>{x}</b><small>{12 + i * 7} users</small></span><em>↗</em></article>))}</div></main>
          </div>
        )}
        {f.id === "governance" && (
          <div class="mock governance light-screen">
            <header><span><label>GOVERNANCE</label><b>Company control plane</b></span><em>All systems operational</em></header>
            <div class="gov-metrics"><span><small>AI systems</small><b>84</b><i>+6 this month</i></span><span><small>Policy coverage</small><b>98.7%</b><i>2 reviews due</i></span><span><small>Agent actions</small><b>1.2M</b><i>Last 30 days</i></span></div>
            <div class="audit"><header><span>System</span><span>Owner</span><span>Risk</span><span>Status</span></header>{auditRows.map((r) => (<div>{r.map((x) => (<span>{x}</span>))}</div>))}</div>
          </div>
        )}
        {f.id === "pilot" && (
          <div class="mock pilot">
            <div class="pilot-command"><FlowPilotBubbleOrb client:only="react" aria-label="FlowPilot" className="size-9 shrink-0" /><p>Prepare me for the Acme renewal meeting tomorrow. Include risks, recent conversations, and a proposed agenda.</p><span>FlowPilot · Company access</span></div>
            <div class="execution">{execSteps.map((s) => (<div><i>{s[0]}</i><span><b>{s[1]}</b><small>{s[2]}</small></span><em>Done ✓</em></div>))}</div>
            <div class="pilot-result light-screen"><label>BRIEFING READY</label><b>Acme Renewal · €1.2M ARR</b><p>Three expansion signals, one adoption risk, and a clear path to renewal.</p><button>Open briefing ↗</button></div>
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .v5-platform { --mono: ui-monospace, SFMono-Regular, Menlo, monospace; background: var(--background); color: var(--foreground); }
  .eyebrow { font: 9px/1 var(--mono); letter-spacing: .16em; color: var(--muted-foreground); }

  .story { position: relative; height: 700vh; background: var(--background); }
  .story-sticky { position: sticky; top: 0; height: 100vh; display: grid; grid-template-columns: 19vw 1fr 24vw; grid-template-rows: 55px 1fr; overflow: hidden; padding: 24px 3vw; background: radial-gradient(circle at 52% 50%, color-mix(in oklab, var(--primary) 8%, transparent), transparent 34%), var(--background); }
  .story-top { grid-column: 1/-1; display: grid; grid-template-columns: 19vw 1fr 24vw; align-items: center; padding-bottom: 14px; border-bottom: 1px solid var(--border); color: var(--muted-foreground); font: 9px var(--mono); letter-spacing: .12em; }
  .story-top > i { height: 1px; margin-right: 26px; background: var(--border); }
  .story-top > i b { display: block; height: 1px; background: var(--accent); transition: width .1s linear; }
  .story-sticky > h2 { position: absolute; top: 100px; left: 3vw; display: grid; margin: 0; font-size: clamp(45px, 4.4vw, 72px); line-height: .88; letter-spacing: -.065em; }
  .story-sticky > h2 span:nth-child(2) { color: var(--muted-foreground); }
  .story-sticky > nav { grid-column: 1; grid-row: 2; align-self: end; display: grid; margin-bottom: 18px; border-top: 1px solid var(--border); }
  .story-sticky > nav button { height: 43px; display: grid; grid-template-columns: 27px 1fr; gap: 8px; align-items: center; padding: 0 6px; border: 0; border-bottom: 1px solid var(--border); background: transparent; color: var(--muted-foreground); text-align: left; cursor: pointer; transition: color .2s, padding .2s, background .2s; }
  .story-sticky > nav button i { font: 8px var(--mono); font-style: normal; }
  .story-sticky > nav button span { font-size: 11px; }
  .story-sticky > nav button.active { padding-left: 13px; background: linear-gradient(90deg, color-mix(in oklab, var(--accent) 9%, transparent), transparent); color: var(--foreground); }
  .story-sticky > nav button.active i { color: var(--accent); }
  .stage { grid-column: 2; grid-row: 2; display: flex; align-items: center; justify-content: center; padding: 6vh 2vw 2vh; }
  .stage-item { display: none; width: min(100%, 900px); }
  .stage-item.is-active { display: block; animation: stageIn .55s cubic-bezier(.2, .8, .2, 1); }
  @keyframes stageIn { from { opacity: 0; transform: translateY(18px) scale(.985); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }
  .story-copy { grid-column: 3; grid-row: 2; align-self: end; padding: 0 0 18px 2vw; }
  .story-copy > label { color: var(--accent); font: 8px var(--mono); letter-spacing: .12em; }
  .story-copy h3 { margin: 16px 0 18px; font-size: clamp(30px, 3.2vw, 52px); letter-spacing: -.05em; }
  .story-copy p { margin: 0 0 24px; color: var(--muted-foreground); font-size: 14px; line-height: 1.6; }
  .story-copy > div { display: flex; flex-wrap: wrap; gap: 7px; }
  .story-copy em { padding: 7px 9px; border: 1px solid var(--border); border-radius: 20px; color: var(--muted-foreground); font: 8px var(--mono); font-style: normal; }
  .mock { position: relative; width: min(100%, 900px); height: min(68vh, 650px); overflow: hidden; border: 1px solid var(--border); border-radius: 16px; background: var(--card); box-shadow: 0 40px 120px rgba(0, 0, 0, .5); }
  .mock label { font: 8px var(--mono); letter-spacing: .12em; }
  /* Light product-screen islands on the dark stage: re-declare the light tokens
     for these subtrees so the mocks read like real app screenshots. */
  .light-screen {
    --background: oklch(0.9841 0.0035 39.4848);
    --foreground: oklch(0.184 0.0081 285.5768);
    --card: oklch(1 0 0);
    --muted: oklch(0.9401 0.0068 53.4438);
    --muted-foreground: oklch(0.5137 0.0156 285.8367);
    --border: oklch(0.8933 0.0111 54.4825);
    color: var(--foreground);
  }

  .builder { display: grid; grid-template-columns: 30% 70%; }
  .builder > aside { padding: 24px 18px; border-right: 1px solid var(--border); background: var(--background); }
  .builder > aside > label { color: var(--muted-foreground); }
  .builder > aside > p { margin-top: 20px; padding: 15px; border: 1px solid var(--border); border-radius: 12px 12px 12px 3px; background: var(--card); font-size: 13px; line-height: 1.45; }
  .building { display: flex; gap: 10px; margin-top: 28px; }
  .building > i { width: 16px; height: 16px; border: 2px solid var(--primary); border-top-color: transparent; border-radius: 50%; animation: spin 1s linear infinite; }
  .building span { display: grid; }
  .building b { font-size: 10px; }
  .building small { margin-top: 3px; color: var(--muted-foreground); font-size: 8px; }
  .builder ul { display: grid; gap: 10px; margin: 24px 0 0 26px; padding: 0; list-style: none; color: var(--muted-foreground); font-size: 9px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .app-preview { background: var(--muted); color: var(--foreground); }
  .app-preview > header, .frontend > section > header { height: 48px; display: flex; align-items: center; padding: 0 18px; border-bottom: 1px solid var(--border); background: var(--card); }
  .app-preview > header b, .frontend > section > header b { font-size: 11px; }
  .app-preview > header span, .frontend > section > header span { margin: auto; color: var(--muted-foreground); font-size: 8px; }
  .app-preview > header i, .frontend > section > header i { display: grid; place-items: center; width: 23px; height: 23px; border-radius: 50%; background: var(--foreground); color: var(--background); font-size: 7px; font-style: normal; }
  .app-preview > main { padding: 28px; }
  .app-preview > main label { color: var(--muted-foreground); }
  .app-preview > main h4 { margin: 10px 0 28px; font-size: 26px; letter-spacing: -.04em; }
  .preview-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
  .preview-metrics > span { display: grid; padding: 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); }
  .preview-metrics b { font-size: 20px; }
  .preview-metrics small { color: var(--muted-foreground); font-size: 7px; }
  .preview-bars { height: 190px; display: flex; align-items: end; gap: 8px; margin-top: 11px; padding: 22px; border-radius: 8px; background: var(--foreground); }
  .preview-bars i { flex: 1; border-radius: 3px 3px 0 0; background: linear-gradient(var(--accent), var(--primary)); }

  .workflow { background-color: var(--background); background-image: radial-gradient(color-mix(in oklab, var(--foreground) 12%, transparent) 1px, transparent 1px); background-size: 18px 18px; }
  .workflow > header { height: 48px; display: flex; align-items: center; justify-content: space-between; padding: 0 18px; border-bottom: 1px solid var(--border); background: var(--card); font-size: 10px; }
