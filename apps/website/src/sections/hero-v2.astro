---
import type { Lang, TranslationKey } from "../i18n";
import { translations, defaultLang } from "../i18n";

interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = (key: TranslationKey): string => {
  const l = translations[lang] as Record<string, string>;
  const e = translations.en as Record<string, string>;
  return l?.[key] ?? e[key] ?? key;
};

import { EmptyBackendProvider } from "../components/backend-provider";

const github = "https://github.com/TM9657/flow-like";
const webAppUrl = "https://app.flow-like.com";
---

<section
  class="relative isolate py-8 md:py-12 lg:py-16 mt-8"
  data-c1="hsl(222 89% 60% / .06)"
  data-c2="hsl(161 50% 45% / .06)"
>
  <!-- Animated pin connections -->
  <div
    id="hero-v2-connection-layer"
    class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-screen h-full -z-1 overflow-visible"
  >
    <svg
      id="hero-v2-connections"
      class="hidden lg:block absolute inset-0"
      style="overflow:visible;width:100vw"
      aria-hidden="true"
    >
      <path id="hero-v2-right-conn" class="hero-v2-pin-conn text-primary" fill="none"></path>
      <path id="hero-v2-left-conn" class="hero-v2-pin-conn text-emerald-500" fill="none"></path>
    </svg>
  </div>

  <div id="hero-v2-cover" class="mx-auto max-w-7xl px-4 lg:px-8 relative">
    <!-- Pin anchors (desktop only) -->
    <div id="hero-v2-right-pin" class="hidden lg:block size-2.5 bg-primary absolute top-48 right-4 lg:right-8 rounded-full z-10 pointer-events-none"></div>
    <div id="hero-v2-left-pin" class="hidden lg:block size-2.5 bg-emerald-500 absolute top-28 left-4 lg:left-8 rounded-full z-10 pointer-events-none"></div>

    <div class="hero-v2-card relative overflow-hidden rounded-2xl border border-border/50 bg-background/90 backdrop-blur-sm shadow-2xl shadow-black/20">
      <div class="absolute inset-0 bg-linear-to-br from-primary/2 via-transparent to-emerald-500/2 pointer-events-none"></div>

      <div class="relative grid lg:grid-cols-2 gap-0">
        <!-- Left: Content -->
        <div class="p-8 sm:p-10 lg:p-12 xl:p-14 flex flex-col justify-center hero-v2-reveal order-2 lg:order-1">
          <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem] xl:text-5xl font-bold tracking-tight leading-[1.1] mb-5">
            {t("v2.hero.headline")}
          </h1>

          <p class="text-base sm:text-lg text-muted-foreground leading-relaxed mb-2 max-w-xl">
            {t("v2.hero.sub")}
          </p>
          <p class="text-sm text-muted-foreground/80 leading-relaxed mb-8 max-w-xl">
            {t("v2.hero.sub2")}
          </p>

          <div class="flex flex-wrap items-center gap-3 mb-8">
            <a
              href="/download"
              class="group inline-flex items-center justify-center gap-2 rounded-full bg-foreground text-background px-6 py-3 text-sm font-semibold hover:bg-foreground/90 transition-all hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-black/20"
            >
              <span>{t("v2.hero.cta.download")}</span>
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
            </a>
            <a
              href={webAppUrl}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center justify-center rounded-full border border-border/80 bg-background/50 px-6 py-3 text-sm font-medium text-foreground hover:bg-muted/50 hover:border-border transition-colors"
            >{t("v2.hero.cta.web")}</a>
            <a
              href={github}
              target="_blank"
              rel="noreferrer"
              class="hidden sm:inline-flex items-center gap-1 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors group"
            >GitHub ★ <span class="group-hover:translate-x-0.5 transition-transform">→</span></a>
          </div>

          <p class="text-xs text-muted-foreground/80 mb-5"><strong class="text-foreground">{t("v2.hero.free")}</strong> · {t("v2.hero.noAccount")}</p>

          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-full border border-border/40 text-muted-foreground bg-muted/10">
              {t("v2.hero.badge.opensource")}
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-full border border-border/40 text-muted-foreground bg-muted/10">
              {t("v2.hero.badge.onprem")}
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-full border border-border/40 text-muted-foreground bg-muted/10">
              {t("v2.hero.badge.typesafe")}
            </span>
          </div>
        </div>

        <!-- Right: interactive canvas -->
        <div class="relative min-h-[200px] sm:min-h-60 lg:min-h-[340px] hero-v2-reveal order-1 lg:order-2 border-b lg:border-b-0 lg:border-l border-border/30">
          <EmptyBackendProvider data="/board.json" client:idle />
          <div aria-hidden="true" class="pointer-events-none absolute bottom-3 right-3 flex gap-1.5">
            <span class="text-[9px] sm:text-[10px] px-2 py-0.5 rounded bg-background/70 backdrop-blur-sm border border-border/30 text-muted-foreground/70">AI Nodes</span>
            <span class="text-[9px] sm:text-[10px] px-2 py-0.5 rounded bg-primary/10 border border-primary/20 text-primary">Database</span>
            <span class="text-[9px] sm:text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-500">Live UI</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-v2-pin-conn {
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 6 8;
    animation: hero-v2-flow-dots 1.2s linear infinite;
  }
  @keyframes hero-v2-flow-dots {
    to { stroke-dashoffset: -14px; }
  }
  .hero-v2-reveal {
    opacity: 0;
    transform: translateY(6px);
  }
  .hero-v2-reveal.is-visible {
    opacity: 1;
    transform: none;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-v2-reveal { transition: none !important; transform: none !important; }
    .hero-v2-pin-conn { animation: none !important; }
  }
</style>

<script>
  function initHeroV2Connections() {
    const heroEl = document.getElementById("hero-v2-cover");
    if (!heroEl) return;
    const sectionEl = heroEl.closest("section");
    const layer = document.getElementById("hero-v2-connection-layer");
    const svg = document.getElementById("hero-v2-connections");
    if (!sectionEl || !layer || !svg) return;
    const rp = document.getElementById("hero-v2-right-pin");
    const lp = document.getElementById("hero-v2-left-pin");

    const setSvgFrame = () => {
      const hr = heroEl.getBoundingClientRect();
      const vw = Math.max(document.documentElement.clientWidth, window.innerWidth || 0);
      layer.style.height = `${hr.height}px`;
      layer.style.width = vw + "px";
      svg.style.width = vw + "px";
      svg.setAttribute("viewBox", `0 0 ${vw} ${hr.height}`);
      svg.setAttribute("width", String(vw));
      svg.setAttribute("height", String(hr.height));
    };

    const bezier = (pin: HTMLElement, isRight: boolean) => {
      const baseRect = sectionEl?.getBoundingClientRect() || heroEl.getBoundingClientRect();
      const pr = pin.getBoundingClientRect();
      const layerRect = layer!.getBoundingClientRect();
      const sx = pr.left - layerRect.left + pr.width / 2;
      const sy = pr.top - baseRect.top + pr.height / 2;
      const vw = Math.max(document.documentElement.clientWidth, window.innerWidth || 0);
      const extra = window.innerWidth < 768 ? 50 : 220;
      const ex = isRight ? vw + extra : -extra;
      const ey = sy + (isRight ? 60 : 80);
      const dx = ex - sx;
      const cp1x = sx + dx * 0.42;
      const cp2x = sx + dx * 0.82;
      return `M${sx},${sy} C${cp1x},${sy} ${cp2x},${ey} ${ex},${ey}`;
    };

    const updatePaths = () => {
      setSvgFrame();
      const rc = document.getElementById("hero-v2-right-conn");
      const lc = document.getElementById("hero-v2-left-conn");
      if (rp && rc) rc.setAttribute("d", bezier(rp, true));
      if (lp && lc) lc.setAttribute("d", bezier(lp, false));
    };

    const raf = (fn: FrameRequestCallback) => requestAnimationFrame(fn);
    addEventListener("resize", () => raf(updatePaths));
    addEventListener("scroll", () => raf(updatePaths), { passive: true });
    addEventListener("load", () => raf(updatePaths));
    if (window.ResizeObserver) new ResizeObserver(() => raf(updatePaths)).observe(heroEl);
    raf(updatePaths);
    setTimeout(() => raf(updatePaths), 100);
  }

  // Reveal animations
  const revealEls = document.querySelectorAll(".hero-v2-reveal");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.15 },
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  }
  initHeroV2Connections();
</script>
