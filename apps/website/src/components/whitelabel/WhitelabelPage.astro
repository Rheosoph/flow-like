---
import "@flow-like/flow-like-ui/global.css";
import "../../styles/website-base.css";
import PostHog from "../posthog.astro";
import { Header } from "../header";
import { BlogFooter } from "../blog-footer";
import { tWhitelabel } from "../../i18n/locales/pages/whitelabel";
import { buildAlternateLinks, getOgLocale } from "../../lib/seo";
import { LuPaintbrush, LuCode, LuShield, LuGauge, LuArrowRight, LuLayers, LuMonitor, LuServer } from "react-icons/lu";

interface Props { lang?: string; }
const { lang = "en" } = Astro.props;
const t = (key: string) => tWhitelabel(lang, key);

const site = Astro.site ?? import.meta.env.SITE ?? "https://flow-like.com";
const siteUrl = typeof site === "string" ? site : site.toString();
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const alternateLinks = buildAlternateLinks(siteUrl, Astro.url.pathname);
const ogLocale = getOgLocale(lang);

const title = t("whitelabel.meta.title");
const desc = t("whitelabel.meta.description");
const cover = "/og.png";

const modes = [
  {
    icon: "monitor",
    title: t("whitelabel.modes.embed.title"),
    desc: t("whitelabel.modes.embed.desc"),
    feats: [
      t("whitelabel.modes.embed.feat1"),
      t("whitelabel.modes.embed.feat2"),
      t("whitelabel.modes.embed.feat3"),
    ],
    accent: "primary",
  },
  {
    icon: "server",
    title: t("whitelabel.modes.headless.title"),
    desc: t("whitelabel.modes.headless.desc"),
    feats: [
      t("whitelabel.modes.headless.feat1"),
      t("whitelabel.modes.headless.feat2"),
      t("whitelabel.modes.headless.feat3"),
    ],
    accent: "violet-500",
  },
  {
    icon: "layers",
    title: t("whitelabel.modes.hybrid.title"),
    desc: t("whitelabel.modes.hybrid.desc"),
    feats: [
      t("whitelabel.modes.hybrid.feat1"),
      t("whitelabel.modes.hybrid.feat2"),
      t("whitelabel.modes.hybrid.feat3"),
    ],
    accent: "emerald-500",
  },
];

const themingCards = [
  { key: "tokens", icon: "paintbrush" },
  { key: "logo", icon: "code" },
  { key: "domains", icon: "gauge" },
  { key: "email", icon: "shield" },
];

const oemCards = [
  { key: "sso" },
  { key: "metering" },
  { key: "isolation" },
  { key: "sdk" },
];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <meta name="theme-color" content="#ffffff" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Flow-Like" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={cover} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={cover} />

    <PostHog />

    <style is:global>
      body {
        background-image: radial-gradient(
          color-mix(in srgb, var(--muted) 20%, transparent) 1px,
          transparent 1px
        ) !important;
        background-size: 16px 16px !important;
        background-attachment: scroll !important;
      }
    </style>
  </head>

  <body class="bg-background text-foreground antialiased overflow-x-hidden max-w-full">
    <Header client:load pathname={Astro.url.pathname} />

    <main class="pt-16">
      <section class="relative min-h-[70vh] flex items-center overflow-hidden" data-c1="hsl(268 84% 62% / .06)" data-c2="hsl(161 40% 44% / .06)">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
          <div class="absolute inset-0 bg-[radial-gradient(60%_60%_at_50%_20%,hsl(var(--primary)/.08),transparent)]"></div>
          <div class="absolute inset-0 bg-[radial-gradient(40%_40%_at_80%_60%,hsl(268_84%_62%/.06),transparent)]"></div>
        </div>

        <div class="mx-auto max-w-5xl px-6 lg:px-8 py-20 lg:py-28 w-full">
          <div class="wl-reveal text-center">
            <span class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/5 backdrop-blur-sm px-4 py-1.5 text-xs font-semibold text-primary mb-8">
              {t("whitelabel.hero.tagline")}
            </span>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1] mb-6">
              {t("whitelabel.hero.headline")} <span class="bg-linear-to-r from-primary via-violet-500 to-primary bg-clip-text text-transparent">{t("whitelabel.hero.headline.highlight")}</span>
            </h1>

            <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed max-w-3xl mx-auto mb-10">
              {t("whitelabel.hero.description")}
            </p>

            <div class="flex flex-wrap items-center justify-center gap-4">
              <a
                href="mailto:sales@flow-like.com?subject=White-Label%20%26%20OEM%20Inquiry"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-primary text-primary-foreground px-6 py-3 text-sm font-medium hover:bg-primary/90 transition-all hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-primary/20"
              >
                {t("whitelabel.hero.cta")}
                <LuArrowRight className="w-4 h-4" />
              </a>
              <a
                href="https://docs.flow-like.com"
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center justify-center rounded-full border border-border/80 bg-background/50 px-6 py-3 text-sm font-medium text-foreground hover:bg-muted/50 hover:border-border transition-colors"
              >
                {t("whitelabel.hero.cta.docs")}
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="relative py-20 lg:py-28" data-c1="hsl(222 89% 60% / .06)" data-c2="hsl(268 84% 62% / .06)">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
          <div class="wl-reveal text-center mb-14">
            <p class="text-[11px] font-medium tracking-[0.3em] uppercase text-muted-foreground mb-4">
              {t("whitelabel.modes.tagline")}
            </p>
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
              {t("whitelabel.modes.headline")}
            </h2>
            <p class="text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto">
              {t("whitelabel.modes.description")}
            </p>
          </div>

          <div class="wl-reveal grid md:grid-cols-3 gap-6">
            {modes.map((mode) => (
              <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5">
                <div class="flex items-center gap-3 mb-4">
                  <div class="flex items-center justify-center size-10 rounded-xl bg-primary/10">
                    {mode.icon === "monitor" && <LuMonitor className="w-5 h-5 text-primary" />}
                    {mode.icon === "server" && <LuServer className="w-5 h-5 text-violet-500" />}
                    {mode.icon === "layers" && <LuLayers className="w-5 h-5 text-emerald-500" />}
                  </div>
                  <h3 class="text-lg font-semibold">{mode.title}</h3>
                </div>
                <p class="text-sm text-muted-foreground leading-relaxed mb-5">{mode.desc}</p>
                <ul class="space-y-2.5">
                  {mode.feats.map((feat) => (
                    <li class="flex items-start gap-2 text-sm text-muted-foreground">
                      <span class="mt-1 flex items-center justify-center w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-500 text-[10px] shrink-0">✓</span>
                      {feat}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="relative py-20 lg:py-28" data-c1="hsl(161 40% 44% / .06)" data-c2="hsl(222 89% 60% / .06)">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
          <div class="wl-reveal text-center mb-14">
            <p class="text-[11px] font-medium tracking-[0.3em] uppercase text-muted-foreground mb-4">
              {t("whitelabel.theming.tagline")}
            </p>
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
              <span class="bg-linear-to-r from-primary via-violet-500 to-primary bg-clip-text text-transparent">{t("whitelabel.theming.headline")}</span>
            </h2>
            <p class="text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto">
              {t("whitelabel.theming.description")}
            </p>
          </div>

          <div class="wl-reveal grid sm:grid-cols-2 gap-6">
            <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5">
              <div class="flex items-center gap-3 mb-3">
                <div class="flex items-center justify-center size-9 rounded-lg bg-primary/10">
                  <LuPaintbrush className="w-4.5 h-4.5 text-primary" />
                </div>
                <h3 class="text-sm font-semibold">{t("whitelabel.theming.tokens.title")}</h3>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">{t("whitelabel.theming.tokens.desc")}</p>
            </div>

            <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-violet-500/30 hover:shadow-lg hover:shadow-violet-500/5">
              <div class="flex items-center gap-3 mb-3">
                <div class="flex items-center justify-center size-9 rounded-lg bg-violet-500/10">
                  <LuCode className="w-4.5 h-4.5 text-violet-500" />
                </div>
                <h3 class="text-sm font-semibold">{t("whitelabel.theming.logo.title")}</h3>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">{t("whitelabel.theming.logo.desc")}</p>
            </div>

            <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-emerald-500/30 hover:shadow-lg hover:shadow-emerald-500/5">
              <div class="flex items-center gap-3 mb-3">
                <div class="flex items-center justify-center size-9 rounded-lg bg-emerald-500/10">
                  <LuGauge className="w-4.5 h-4.5 text-emerald-500" />
                </div>
                <h3 class="text-sm font-semibold">{t("whitelabel.theming.domains.title")}</h3>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">{t("whitelabel.theming.domains.desc")}</p>
            </div>

            <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-amber-500/30 hover:shadow-lg hover:shadow-amber-500/5">
              <div class="flex items-center gap-3 mb-3">
                <div class="flex items-center justify-center size-9 rounded-lg bg-amber-500/10">
                  <LuShield className="w-4.5 h-4.5 text-amber-500" />
                </div>
                <h3 class="text-sm font-semibold">{t("whitelabel.theming.email.title")}</h3>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">{t("whitelabel.theming.email.desc")}</p>
            </div>
          </div>
        </div>
      </section>

      <section class="relative py-20 lg:py-28" data-c1="hsl(268 84% 62% / .06)" data-c2="hsl(340 82% 52% / .06)">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
          <div class="wl-reveal text-center mb-14">
            <p class="text-[11px] font-medium tracking-[0.3em] uppercase text-muted-foreground mb-4">
              {t("whitelabel.oem.tagline")}
            </p>
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
              {t("whitelabel.oem.headline")}
            </h2>
            <p class="text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto">
              {t("whitelabel.oem.description")}
            </p>
          </div>

          <div class="wl-reveal grid sm:grid-cols-2 gap-6">
            <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5">
              <h3 class="text-base font-semibold mb-2">{t("whitelabel.oem.sso.title")}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{t("whitelabel.oem.sso.desc")}</p>
            </div>

            <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-violet-500/30 hover:shadow-lg hover:shadow-violet-500/5">
              <h3 class="text-base font-semibold mb-2">{t("whitelabel.oem.metering.title")}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{t("whitelabel.oem.metering.desc")}</p>
            </div>

            <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-emerald-500/30 hover:shadow-lg hover:shadow-emerald-500/5">
              <h3 class="text-base font-semibold mb-2">{t("whitelabel.oem.isolation.title")}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{t("whitelabel.oem.isolation.desc")}</p>
            </div>

            <div class="group relative rounded-2xl border border-border/50 bg-card/60 backdrop-blur-sm p-6 transition-all duration-300 hover:border-amber-500/30 hover:shadow-lg hover:shadow-amber-500/5">
              <h3 class="text-base font-semibold mb-2">{t("whitelabel.oem.sdk.title")}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{t("whitelabel.oem.sdk.desc")}</p>
            </div>
          </div>
        </div>
      </section>

      <section class="relative py-20 lg:py-28">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
          <div class="absolute inset-0 bg-[radial-gradient(60%_60%_at_50%_80%,hsl(var(--primary)/.08),transparent)]"></div>
        </div>

        <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
          <div class="wl-reveal">
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-6">
              {t("whitelabel.cta.headline")}
            </h2>

            <p class="text-lg text-muted-foreground leading-relaxed mb-10 max-w-xl mx-auto">
              {t("whitelabel.cta.description")}
            </p>

            <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
              <a
                href="mailto:partnerships@flow-like.com?subject=OEM%20Partnership%20Inquiry"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-primary text-primary-foreground px-8 py-4 text-base font-medium hover:bg-primary/90 transition-all hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-primary/25"
              >
                {t("whitelabel.cta.button")}
                <LuArrowRight className="w-4 h-4" />
              </a>
              <a
                href="https://docs.flow-like.com"
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center justify-center rounded-full border border-border/80 bg-background/50 px-8 py-4 text-base font-medium text-foreground hover:bg-muted/50 hover:border-border transition-colors"
              >
                {t("whitelabel.cta.docs")}
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <BlogFooter client:only="react" />
  </body>
</html>

<style>
  .wl-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .wl-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .wl-reveal {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>(".wl-reveal");
  if (els.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    for (const el of els) io.observe(el);
  }
</script>
