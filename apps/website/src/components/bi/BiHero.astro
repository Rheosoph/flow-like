---
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden">
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 -left-32 w-96 h-96 bg-primary/10 rounded-full blur-3xl animate-pulse" style="animation-duration: 4s;" />
    <div class="absolute bottom-1/4 -right-32 w-96 h-96 bg-violet-500/10 rounded-full blur-3xl animate-pulse" style="animation-duration: 5s; animation-delay: 1s;" />
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-emerald-500/5 rounded-full blur-3xl animate-pulse" style="animation-duration: 6s; animation-delay: 2s;" />
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8 py-24 w-full relative z-10">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center">
      <div class="text-left">
        <p class="text-[11px] font-medium tracking-[0.3em] uppercase text-primary mb-6">
          {t("bi.hero.tagline")}
        </p>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6 leading-[1.1]">
          {t("bi.hero.headline")} <span class="bg-gradient-to-r from-primary via-violet-500 to-emerald-500 bg-clip-text text-transparent">{t("bi.hero.headline.highlight")}</span> {t("bi.hero.headline.end")}
        </h1>

        <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed max-w-xl mb-10">
          {t("bi.hero.description")}
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="/download" class="group inline-flex items-center gap-3 px-7 py-4 bg-primary text-primary-foreground rounded-full font-medium hover:bg-primary/90 transition-all hover:gap-4 hover:shadow-lg hover:shadow-primary/25">
            {t("bi.hero.cta.primary")}
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a href="#solution" class="inline-flex items-center gap-2 px-6 py-4 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors border border-border/50 rounded-full hover:border-border hover:bg-card/50">
            {t("bi.hero.cta.secondary")}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>

      <div class="relative w-full max-w-[500px] mx-auto h-[500px] sm:h-[600px] font-sans">
        <div class="absolute top-1/4 right-0 w-64 h-64 bg-fuchsia-500/30 rounded-full blur-[80px] animate-pulse" style="animation-duration: 4s;"></div>
        <div class="absolute bottom-1/4 left-0 w-64 h-64 bg-cyan-500/20 rounded-full blur-[80px] animate-pulse" style="animation-duration: 5s;"></div>

        <div class="absolute inset-4 sm:inset-8 bg-[#1e2028]/80 backdrop-blur-2xl rounded-[2rem] border border-white/10 shadow-2xl flex flex-col">

          <div class="relative flex-1 w-full">

            <div class="absolute top-8 left-6 w-[55%] bg-white/5 border border-white/10 rounded-2xl p-4 shadow-lg backdrop-blur-md z-10 hover:bg-white/10 transition-colors">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-8 h-8 rounded-lg border border-cyan-500/30 flex items-center justify-center shadow-[0_0_15px_rgba(6,182,212,0.15)]">
                  <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
                  </svg>
                </div>
                <span class="text-sm font-semibold text-white tracking-wide">Raw Sources</span>
              </div>
              <div class="space-y-3">
                <div class="h-4 w-full rounded bg-slate-800/80 border border-white/5 overflow-hidden flex items-center">
                  <div class="h-full bg-gradient-to-r from-cyan-500 to-cyan-300 w-3/4 rounded-r"></div>
                </div>
                <div class="h-4 w-full rounded bg-slate-800/80 border border-white/5 overflow-hidden flex items-center">
                  <div class="h-full bg-gradient-to-r from-indigo-500 to-indigo-400 w-1/2 rounded-r"></div>
                </div>
                <div class="h-4 w-full rounded bg-slate-800/80 border border-white/5 overflow-hidden flex items-center">
                  <div class="h-full bg-gradient-to-r from-fuchsia-500 to-fuchsia-400 w-2/3 rounded-r"></div>
                </div>
              </div>
            </div>

            <div class="absolute top-24 left-[64%] w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_10px_2px_rgba(34,211,238,0.6)] z-10 animate-pulse"></div>

            <div class="absolute top-16 -right-6 sm:-right-8 w-[55%] bg-[#0f0c1b] border border-fuchsia-500/30 rounded-2xl p-5 shadow-[0_0_40px_rgba(168,85,247,0.2)] z-20 overflow-hidden group">
              <div class="absolute -top-10 -right-10 w-32 h-32 bg-fuchsia-600/30 rounded-full blur-2xl group-hover:bg-fuchsia-500/40 transition-colors"></div>

              <div class="relative z-10">
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-10 h-10 rounded-xl bg-fuchsia-500 flex items-center justify-center shadow-lg shadow-fuchsia-500/40">
                    <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-sm font-bold text-white">AI Engine</h3>
                    <p class="text-[8px] text-fuchsia-300/70 uppercase tracking-widest font-semibold mt-0.5">Processing Hub</p>
                  </div>
                </div>

                <div class="space-y-2">
                  <div class="flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5">
                    <div class="flex items-center gap-2 text-[10px] text-slate-300">
                      <span class="w-1.5 h-1.5 rounded-full bg-fuchsia-400"></span> Data Transformation
                    </div>
                    <span class="text-[9px] text-fuchsia-400">100%</span>
                  </div>
                  <div class="flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5">
                    <div class="flex items-center gap-2 text-[10px] text-slate-300">
                      <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span> Semantic Enrichment
                    </div>
                    <span class="text-[9px] text-purple-400">Active</span>
                  </div>
                  <div class="flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5">
                    <div class="flex items-center gap-2 text-[10px] text-slate-300">
                      <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span> Predictive Modeling
                    </div>
                    <span class="text-[9px] text-indigo-400">Yielding</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="absolute bottom-6 left-6 right-16 sm:right-20 bg-white/5 border border-white/10 rounded-2xl p-4 shadow-lg backdrop-blur-md z-10">
              <div class="flex items-end justify-between gap-1 h-12 w-full mb-3">
                <div class="w-full bg-gradient-to-t from-emerald-500 to-emerald-300 rounded-sm opacity-80" style="height: 40%;"></div>
                <div class="w-full bg-gradient-to-t from-emerald-500 to-emerald-300 rounded-sm opacity-80" style="height: 70%;"></div>
                <div class="w-full bg-gradient-to-t from-emerald-500 to-emerald-300 rounded-sm opacity-80" style="height: 50%;"></div>
                <div class="w-full bg-gradient-to-t from-emerald-500 to-emerald-300 rounded-sm opacity-100" style="height: 90%;"></div>
                <div class="w-full bg-gradient-to-t from-emerald-500 to-emerald-300 rounded-sm opacity-80" style="height: 60%;"></div>
                <div class="w-full bg-gradient-to-t from-emerald-500 to-emerald-300 rounded-sm opacity-80" style="height: 80%;"></div>
              </div>
              <div class="flex items-center justify-between border-t border-white/10 pt-2">
                <div>
                  <div class="text-[9px] text-emerald-200/60 uppercase font-semibold">Growth</div>
                  <div class="text-xs font-bold text-emerald-400">+34.2%</div>
                </div>
                <div class="text-right">
                  <div class="text-[9px] text-blue-200/60 uppercase font-semibold">Forecast</div>
                  <div class="text-xs font-bold text-blue-400">98.4%</div>
                </div>
              </div>
            </div>

          </div>

          <div class="h-14 sm:h-16 border-t border-white/5 flex items-center justify-between px-4 sm:px-6 relative z-10">
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-[10px] sm:text-xs font-semibold text-slate-300">System Fully Operational</span>
            </div>
            <div class="flex items-center gap-4 text-[10px] sm:text-xs text-slate-400">
              <span class="hidden sm:flex items-center gap-1.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg> 3 Streams</span>
              <span class="flex items-center gap-1.5 font-bold text-fuchsia-400"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg> AI Native</span>
              <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> &lt;0.1s</span>
            </div>
          </div>
        </div>

        <div class="absolute top-2 right-2 sm:top-4 sm:-right-2 w-14 h-14 bg-fuchsia-400/10 backdrop-blur-xl border border-white/20 rounded-2xl flex items-center justify-center shadow-xl z-30 animate-[bounce_4s_infinite]">
          <svg class="w-6 h-6 text-fuchsia-300 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <div class="absolute bottom-8 left-0 sm:bottom-12 sm:-left-4 w-14 h-14 bg-cyan-400/10 backdrop-blur-xl border border-white/20 rounded-2xl flex items-center justify-center shadow-xl z-30 animate-[bounce_5s_infinite_1s]">
          <svg class="w-6 h-6 text-cyan-300 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>