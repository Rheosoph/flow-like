---
import { createCompareMatrixData } from "./compare-matrix-data";

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props as Props;
const {
  capabilityGroups,
  flowLikeCapabilities,
  categories,
  renderSupport,
  getSupportNote,
  categorySpecs,
  competitorPosition,
  categoryAccent,
} = createCompareMatrixData(t);
---


<section id="matrix" class="relative py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    {categories.map((category, catIndex) => {
      const spec = categorySpecs[category.name];
      const accent = categoryAccent[category.name] ?? "rose";
      const colorClasses = {
        amber: "bg-amber-500/20 ring-amber-500/50 text-amber-700 dark:text-amber-300",
        blue: "bg-blue-500/20 ring-blue-500/50 text-blue-700 dark:text-blue-300",
        lime: "bg-lime-500/20 ring-lime-500/50 text-lime-700 dark:text-lime-300",
        purple: "bg-purple-500/20 ring-purple-500/50 text-purple-700 dark:text-purple-300",
        fuchsia: "bg-fuchsia-500/20 ring-fuchsia-500/50 text-fuchsia-700 dark:text-fuchsia-300",
        rose: "bg-rose-500/20 ring-rose-500/50 text-rose-700 dark:text-rose-300",
        orange: "bg-orange-500/20 ring-orange-500/50 text-orange-700 dark:text-orange-300",
        emerald: "bg-emerald-500/20 ring-emerald-500/50 text-emerald-700 dark:text-emerald-300",
        teal: "bg-teal-500/20 ring-teal-500/50 text-teal-700 dark:text-teal-300",
        violet: "bg-violet-500/20 ring-violet-500/50 text-violet-700 dark:text-violet-300",
        cyan: "bg-cyan-500/20 ring-cyan-500/50 text-cyan-700 dark:text-cyan-300",
        sky: "bg-sky-500/20 ring-sky-500/50 text-sky-700 dark:text-sky-300",
        slate: "bg-slate-500/20 ring-slate-500/50 text-slate-700 dark:text-slate-300",
      };
      const bubbleColor = (colorClasses as any)[accent] ?? colorClasses.rose;
      const compCount = category.competitors.length;
      const flPos = spec ? competitorPosition(flowLikeCapabilities, spec) : { x: 90, y: 90 };
      return (
      <div class:list={["mb-16 last:mb-0", catIndex > 0 && "pt-16 border-t border-border/30"]}>
        <!-- Category Header -->
        <div class="mb-8">
          <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-2">{category.name}</h2>
          <p class="text-muted-foreground max-w-2xl">{category.desc}</p>
        </div>

        <!-- Comparison Table -->
        <div class="compare-scroll overflow-x-auto -mx-4 px-4 pb-4">
          <div class="min-w-[800px]">
            <table class="w-full border-collapse">
              <thead>
                <tr class="border-b border-border/50">
                  <th class="sticky-col text-left py-4 pr-4 font-medium text-muted-foreground text-sm w-48">{t("compare.matrix.col.capability")}</th>
                  <th class="text-center py-4 px-3 font-semibold text-emerald-600 dark:text-emerald-400 text-sm">
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20">
                      <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                      </span>
                      Flow-Like
                    </div>
                  </th>
                  {category.competitors.map((comp) => (
                    <th class="text-center py-4 px-3 font-medium text-muted-foreground text-sm">
                      <div class="flex flex-col items-center gap-1">
                        <span>{comp.name}</span>
                        {comp.examples && comp.exampleNote && (
                          <span
                            class="max-w-[13rem] cursor-help text-[10px] font-normal leading-tight text-muted-foreground/70 underline decoration-dotted underline-offset-2"
                            title={comp.exampleNote}
                            tabindex="0"
                          >
                            {comp.examples}
                          </span>
                        )}
                        {comp.warning && (
                          <span
                            class="inline-flex items-center gap-1 rounded-full bg-red-500/15 border border-red-500/40 px-2 py-0.5 text-[10px] font-semibold text-red-400 leading-tight cursor-help"
                            title={comp.warning}
                          >
                            ⚠ {t("compare.matrix.security_risk")}
                          </span>
                        )}
                      </div>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {capabilityGroups.map((group) => (
                  <>
                    <tr class="compare-group-row">
                      <td
                        colspan={2 + category.competitors.length}
                        class="py-2 pr-4 pl-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-foreground"
                      >
                        {t(`compare.group.${group.id}`)}
                      </td>
                    </tr>
                    {group.capabilities.map((cap) => {
                      const flowLikeSupport = renderSupport(flowLikeCapabilities[cap]);
                      return (
                        <tr class="compare-row border-b border-border/20 hover:bg-muted/30 transition-colors">
                          <td class="sticky-col py-3 pr-4 pl-3 text-sm">{t(`compare.cap.${cap}`)}</td>
                          <td class="py-3 px-3 text-center">
                            <div class="flex flex-col items-center justify-center gap-0.5">
                              <span class:list={[
                                "inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-semibold",
                                flowLikeSupport.color === "emerald" && "bg-emerald-500/20 text-emerald-500",
                                flowLikeSupport.color === "amber" && "bg-amber-500/20 text-amber-500",
                                flowLikeSupport.color === "red" && "bg-red-500/20 text-red-500",
                              ]}>
                                {flowLikeSupport.icon}
                              </span>
                              {flowLikeSupport.label && (
                                <span class="text-[10px] text-muted-foreground leading-tight">{flowLikeSupport.label}</span>
                              )}
                            </div>
                          </td>
                          {category.competitors.map((comp) => {
                            const rawSupport = comp.capabilities[cap];
                            const support = renderSupport(rawSupport);
                            const note = getSupportNote(comp, cap, rawSupport);
                            return (
                              <td class="py-3 px-3 text-center">
                                <div class="relative mx-auto flex min-h-11 min-w-12 flex-col items-center justify-center gap-0.5">
                                  <span class:list={[
                                    "flex items-center justify-center w-6 h-6 rounded-full text-xs",
                                    support.color === "emerald" && "bg-emerald-500/20 text-emerald-500",
                                    support.color === "amber" && "bg-amber-500/20 text-amber-500",
                                    support.color === "red" && "bg-red-500/20 text-red-500",
                                    support.color === "muted" && "bg-muted/50 text-muted-foreground",
                                  ]}>
                                    {support.icon}
                                  </span>
                                  {support.label && (
                                    <span class="text-[10px] text-muted-foreground leading-tight">{support.label}</span>
                                  )}
                                  {note && (
                                    <button
                                      type="button"
                                      class="support-note-trigger"
                                      aria-label={`${t("compare.note.open")}: ${comp.name} - ${t(`compare.cap.${cap}`)}`}
                                      data-support-note-competitor={comp.name}
                                      data-support-note-title={t(`compare.cap.${cap}`)}
                                      data-support-note-summary={note.summary}
                                      data-support-note-evidence={note.evidence ?? ""}
                                      data-support-note-caveat={note.caveat ?? ""}
                                      data-support-note-sources={JSON.stringify(note.sources ?? [])}
                                      data-support-note-checked={note.checkedAt ?? ""}
                                    >
                                      i
                                    </button>
                                  )}
                                </div>
                              </td>
                            );
                          })}
                        </tr>
                      );
                    })}
                  </>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Position map: competitors on the workflow × app-building plane -->
        <div class="mt-6 rounded-2xl border border-border/40 bg-card/40 backdrop-blur-sm p-5 sm:p-6">
          <div class="flex items-start justify-between gap-4 mb-3">
            <div>
              <div class="text-[11px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">
                {t("compare.matrix.plot.title")}
              </div>
              <div class="text-xs text-muted-foreground/80 mt-1 max-w-md">
                {t("compare.matrix.plot.description")}
              </div>
            </div>
            <div class="hidden sm:block text-[10px] font-semibold uppercase tracking-[0.2em] text-emerald-500 whitespace-nowrap">
              ↗ {t("compare.matrix.plot.ideal")}
            </div>
          </div>

          <div class="flex gap-3">
            <div class="flex flex-col items-center justify-center text-[10px] uppercase tracking-[0.18em] text-muted-foreground w-4 shrink-0">
              <span class="[writing-mode:vertical-rl] rotate-180 whitespace-nowrap">{spec ? t(spec.y.labelKey) : ""}</span>
            </div>

            <div class="relative flex-1 aspect-video rounded-xl border border-border/40 bg-linear-to-br from-background/40 via-background/20 to-emerald-500/4 overflow-hidden">
              <!-- Quadrant lines -->
              <div aria-hidden="true" class="absolute inset-0">
                <div class="absolute left-1/2 top-0 bottom-0 w-px bg-border/40"></div>
                <div class="absolute top-1/2 left-0 right-0 h-px bg-border/40"></div>
              </div>

              <!-- Ideal diagonal -->
              <svg aria-hidden="true" class="absolute inset-0 w-full h-full opacity-50 pointer-events-none" viewBox="0 0 100 100" preserveAspectRatio="none">
                <line x1="0" y1="100" x2="100" y2="0" stroke="hsl(160 84% 39%)" stroke-opacity="0.4" stroke-width="0.4" stroke-dasharray="1 1.5" vector-effect="non-scaling-stroke" />
              </svg>

              <!-- Axis tick labels (corners describe axis extremes) -->
              {spec && (
                <div aria-hidden="true" class="absolute inset-0 text-[9px] sm:text-[10px] font-semibold tracking-[0.16em] uppercase text-muted-foreground/60 pointer-events-none">
                  <span class="sm:hidden absolute top-2 right-2 text-emerald-500/80">↗ {t("compare.matrix.plot.ideal")}</span>
                </div>
              )}

              <!-- Flow-Like reference bubble -->
              <div
                class="absolute -translate-x-1/2 -translate-y-1/2 rounded-full flex items-center justify-center ring-4 ring-emerald-500/70 bg-emerald-500/25 text-emerald-700 dark:text-emerald-300 shadow-[0_0_32px_-4px] shadow-emerald-500/50 transition-transform duration-300 hover:scale-110 z-10"
                style={`left: ${flPos.x}%; top: ${100 - flPos.y}%; width: 4.25rem; height: 4.25rem;`}
                title="Flow-Like"
              >
                <span class="text-[10px] font-bold leading-tight">Flow-Like</span>
              </div>

              <!-- Competitor bubbles -->
              {spec && category.competitors.map((comp, compIdx) => {
                const pos = competitorPosition(comp.capabilities, spec, compIdx, compCount);
                const bubbleSize = compCount >= 4 ? "2.75rem" : compCount === 3 ? "3rem" : "3.5rem";
                const fontSize = compCount >= 4 ? "9px" : "10px";
                return (
                  <div
                    class:list={[
                      "absolute -translate-x-1/2 -translate-y-1/2 rounded-full flex items-center justify-center ring-2 backdrop-blur-sm transition-transform duration-300 hover:scale-125 hover:z-20",
                      bubbleColor,
                    ]}
                    style={`left: ${pos.x}%; top: ${100 - pos.y}%; width: ${bubbleSize}; height: ${bubbleSize}; font-size: ${fontSize};`}
                    title={comp.warning ? `${comp.name} — ${comp.warning}` : comp.exampleNote ? `${comp.name} — ${comp.exampleNote}` : comp.name}
                  >
                    <span class="font-semibold leading-tight text-center px-1">{comp.name}</span>
                    {comp.warning && (
                      <span class="absolute -top-1 -right-1 flex h-3 w-3">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500 items-center justify-center text-[7px] text-white font-bold">!</span>
                      </span>
                    )}
                  </div>
                );
              })}
            </div>
          </div>

          <!-- X axis label -->
          {spec && (
            <div class="flex items-center justify-between mt-2 pl-0 sm:pl-7 text-[10px] uppercase tracking-[0.18em] text-muted-foreground">
              <span>{t(spec.x.lowKey)}</span>
              <span class="font-semibold text-foreground/70">{t(spec.x.labelKey)} →</span>
              <span>{t(spec.x.highKey)}</span>
            </div>
          )}
        </div>
      </div>
      );
    })}
  </div>

  <div
    id="support-note-modal"
    class="support-note-modal"
    hidden
    aria-hidden="true"
  >
    <button
      type="button"
      class="support-note-backdrop"
      aria-label={t("compare.note.close")}
      data-support-note-close
    ></button>
    <section
      class="support-note-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="support-note-modal-title"
      tabindex="-1"
    >
      <div class="support-note-header">
        <div>
          <p id="support-note-modal-kicker" class="support-note-kicker"></p>
          <h3 id="support-note-modal-title" class="support-note-title"></h3>
        </div>
        <button
          type="button"
          class="support-note-close"
          aria-label={t("compare.note.close")}
          data-support-note-close
        >
          ×
        </button>
      </div>

      <div class="support-note-content">
        <div class="support-note-summary-card">
          <p id="support-note-modal-summary" class="support-note-summary"></p>
        </div>

        <div id="support-note-evidence-section" class="support-note-section support-note-callout" hidden>
          <div class="support-note-label">{t("compare.note.evidence")}</div>
          <p id="support-note-modal-evidence"></p>
        </div>

        <div id="support-note-caveat-section" class="support-note-section support-note-callout support-note-caveat" hidden>
          <div class="support-note-label">{t("compare.note.caveat")}</div>
          <p id="support-note-modal-caveat"></p>
        </div>

        <div id="support-note-sources-section" class="support-note-section" hidden>
          <div class="support-note-label">{t("compare.note.sources")}</div>
          <ul id="support-note-modal-sources" class="support-note-sources"></ul>
        </div>

        <div
          id="support-note-modal-checked"
          class="support-note-checked"
          data-label={t("compare.note.checked")}
        ></div>
      </div>
    </section>
  </div>
</section>

<style>
  table {
    border-spacing: 0;
  }
  th, td {
    vertical-align: middle;
  }

  /* Sticky first column when scrolling horizontally on mobile */
  .sticky-col {
    position: sticky;
    left: 0;
    background: var(--background);
    z-index: 2;
  }
  thead th.sticky-col {
    z-index: 3;
  }
  .compare-group-row td {
    background: color-mix(in oklch, var(--muted) 40%, var(--background));
  }
  .compare-row:hover .sticky-col {
    background: color-mix(in oklch, var(--muted) 30%, var(--background));
  }

  :global(.support-note-trigger) {
    position: absolute;
    top: 0.08rem;
    right: 0.12rem;
    display: inline-flex;
    width: 0.78rem;
    height: 0.78rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in oklch, var(--primary) 16%, var(--border));
    border-radius: 9999px;
    background: color-mix(in oklch, var(--background) 94%, var(--primary));
    color: color-mix(in oklch, var(--muted-foreground) 78%, var(--primary));
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 0.55rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    opacity: 0.58;
    transition:
      border-color 150ms ease,
      color 150ms ease,
      background 150ms ease,
      opacity 150ms ease,
      transform 150ms ease;
  }

  :global(.support-note-trigger:hover),
  :global(.support-note-trigger:focus-visible) {
    border-color: color-mix(in oklch, var(--primary) 58%, var(--border));
    background: color-mix(in oklch, var(--background) 86%, var(--primary));
    color: var(--primary);
    opacity: 1;
    transform: scale(1.06);
    outline: none;
  }

  :global(html.support-note-lock) {
    overflow: hidden;
  }

  :global(.support-note-modal[hidden]) {
    display: none !important;
  }

  :global(.support-note-modal) {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  :global(.support-note-backdrop) {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 38%, rgb(255 255 255 / 0.07), transparent 24rem),
      rgb(0 0 0 / 0.42);
    backdrop-filter: blur(3px);
  }

  :global(.support-note-panel) {
    position: relative;
    display: flex;
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(38rem, calc(100vh - 2rem));
    flex-direction: column;
    border: 1px solid color-mix(in oklch, var(--border) 88%, var(--primary));
    border-radius: 1.05rem;
    padding: 0;
    background:
      linear-gradient(
        145deg,
        color-mix(in oklch, var(--card) 96%, var(--primary)) 0%,
        var(--card) 11rem
      ),
      var(--card);
    color: var(--card-foreground);
    box-shadow:
      0 30px 90px rgb(0 0 0 / 0.34),
      0 1px 0 rgb(255 255 255 / 0.1) inset;
    overflow: hidden;
  }

  :global(.support-note-panel::before) {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    border-radius: 1.1rem 1.1rem 0 0;
    background: linear-gradient(
      90deg,
      var(--primary),
      color-mix(in oklch, var(--primary) 50%, var(--accent))
    );
  }

  :global(.support-note-header) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 78%, transparent);
    padding: 1.25rem 1.35rem 1.1rem;
  }

  :global(.support-note-content) {
    min-height: 0;
    overflow: auto;
    padding: 1.05rem 1.35rem 1.25rem;
  }

  :global(.support-note-kicker),
  :global(.support-note-label),
  :global(.support-note-checked) {
    color: var(--muted-foreground);
    font-size: 0.6875rem;
  }

  :global(.support-note-kicker),
  :global(.support-note-label) {
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  :global(.support-note-kicker) {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    border-radius: 0.45rem;
    padding: 0;
    background: transparent;
    color: var(--primary);
    font-size: 0.7rem;
  }

  :global(.support-note-title) {
    margin-top: 0.42rem;
    color: var(--card-foreground);
    font-size: 1.45rem;
    font-weight: 750;
    letter-spacing: 0;
    line-height: 1.16;
  }

  :global(.support-note-close) {
    display: inline-flex;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in oklch, var(--border) 82%, transparent);
    border-radius: 9999px;
    background: color-mix(in oklch, var(--muted) 34%, var(--card));
    color: var(--muted-foreground);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    transition:
      background 150ms ease,
      color 150ms ease,
      transform 150ms ease;
  }

  :global(.support-note-close:hover),
  :global(.support-note-close:focus-visible) {
    background: var(--muted);
    color: var(--foreground);
    transform: scale(1.04);
    outline: none;
  }

  :global(.support-note-summary-card) {
    border: 1px solid color-mix(in oklch, var(--primary) 16%, var(--border));
    border-radius: 0.85rem;
    padding: 0.95rem 1rem 0.95rem 1.05rem;
    background:
      linear-gradient(90deg, color-mix(in oklch, var(--primary) 12%, transparent), transparent 52%),
      color-mix(in oklch, var(--muted) 18%, var(--card));
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.08) inset;
  }

  :global(.support-note-summary),
  :global(.support-note-section p) {
    color: var(--foreground);
    font-size: 0.9375rem;
    line-height: 1.58;
    text-align: left;
  }

  :global(.support-note-summary),
  :global(.support-note-section p) {
    margin: 0;
  }

  :global(.support-note-section) {
    margin-top: 0.8rem;
  }

  :global(.support-note-section[hidden]) {
    display: none !important;
  }

  :global(.support-note-callout) {
    border: 1px solid color-mix(in oklch, var(--border) 88%, transparent);
    border-radius: 0.85rem;
    padding: 0.82rem 0.95rem;
    background: color-mix(in oklch, var(--muted) 18%, var(--card));
  }

  :global(.support-note-caveat) {
    border-color: color-mix(in oklch, var(--primary) 20%, var(--border));
    background: color-mix(in oklch, var(--primary) 5%, var(--card));
  }

  :global(.support-note-label) {
    margin-bottom: 0.4rem;
    color: var(--muted-foreground);
  }

  :global(.support-note-sources) {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  :global(.support-note-sources a) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border: 1px solid color-mix(in oklch, var(--border) 88%, transparent);
    border-radius: 0.7rem;
    padding: 0.62rem 0.72rem;
    background: color-mix(in oklch, var(--muted) 14%, var(--card));
    color: var(--foreground);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      background 150ms ease,
      color 150ms ease;
  }

  :global(.support-note-sources a::after) {
    content: "↗";
    color: var(--muted-foreground);
    font-size: 0.8rem;
  }

  :global(.support-note-sources a:hover),
  :global(.support-note-sources a:focus-visible) {
    border-color: color-mix(in oklch, var(--primary) 46%, var(--border));
    background: color-mix(in oklch, var(--primary) 8%, var(--card));
    color: var(--primary);
    outline: none;
  }

  :global(.support-note-checked) {
    margin-top: 0.95rem;
    border-top: 1px solid color-mix(in oklch, var(--border) 82%, transparent);
    padding-top: 0.8rem;
  }

  @media (max-width: 640px) {
    :global(.support-note-modal) {
      align-items: flex-end;
      justify-content: center;
      padding: 0.75rem;
    }

    :global(.support-note-backdrop) {
      background: rgb(0 0 0 / 0.32);
    }

    :global(.support-note-panel) {
      width: 100%;
      max-height: min(82vh, 42rem);
      border-radius: 1rem;
    }
  }
</style>

<script is:inline>
  const supportNoteModal = document.getElementById("support-note-modal");
  const supportNotePanel = document.querySelector(".support-note-panel");
  const supportNoteKicker = document.getElementById("support-note-modal-kicker");
  const supportNoteTitle = document.getElementById("support-note-modal-title");
  const supportNoteSummary = document.getElementById("support-note-modal-summary");
  const supportNoteEvidenceSection = document.getElementById("support-note-evidence-section");
  const supportNoteEvidence = document.getElementById("support-note-modal-evidence");
  const supportNoteCaveatSection = document.getElementById("support-note-caveat-section");
  const supportNoteCaveat = document.getElementById("support-note-modal-caveat");
  const supportNoteSourcesSection = document.getElementById("support-note-sources-section");
  const supportNoteSources = document.getElementById("support-note-modal-sources");
  const supportNoteChecked = document.getElementById("support-note-modal-checked");
  let activeSupportNoteTrigger = null;

  const setSupportNoteSection = (section, contentNode, value) => {
    if (!section || !contentNode) return;
    if (value) {
      contentNode.textContent = value;
      section.hidden = false;
    } else {
      contentNode.textContent = "";
      section.hidden = true;
    }
  };

  const closeSupportNote = () => {
    if (!supportNoteModal) return;
    supportNoteModal.hidden = true;
    supportNoteModal.setAttribute("aria-hidden", "true");
    document.documentElement.classList.remove("support-note-lock");
    if (activeSupportNoteTrigger instanceof HTMLElement) {
      activeSupportNoteTrigger.focus();
    }
    activeSupportNoteTrigger = null;
  };

  const openSupportNote = (trigger) => {
    if (!supportNoteModal || !supportNotePanel) return;
    activeSupportNoteTrigger = trigger;

    if (supportNoteKicker) {
      supportNoteKicker.textContent = trigger.dataset.supportNoteCompetitor || "";
    }
    if (supportNoteTitle) {
      supportNoteTitle.textContent = trigger.dataset.supportNoteTitle || "";
    }
    if (supportNoteSummary) {
      supportNoteSummary.textContent = trigger.dataset.supportNoteSummary || "";
    }
    setSupportNoteSection(
      supportNoteEvidenceSection,
      supportNoteEvidence,
      trigger.dataset.supportNoteEvidence || "",
    );
    setSupportNoteSection(
      supportNoteCaveatSection,
      supportNoteCaveat,
      trigger.dataset.supportNoteCaveat || "",
    );

    supportNoteSources?.replaceChildren();
    try {
      const sources = JSON.parse(trigger.dataset.supportNoteSources || "[]");
      if (
        Array.isArray(sources) &&
        sources.length > 0 &&
        supportNoteSources &&
        supportNoteSourcesSection
      ) {
        for (const source of sources) {
          const item = document.createElement("li");
          const link = document.createElement("a");
          link.href = source.url;
          link.target = "_blank";
          link.rel = "noreferrer";
          link.textContent = source.label;
          item.append(link);
          supportNoteSources.append(item);
        }
        supportNoteSourcesSection.hidden = false;
      } else {
        if (supportNoteSourcesSection) supportNoteSourcesSection.hidden = true;
      }
    } catch {
      if (supportNoteSourcesSection) supportNoteSourcesSection.hidden = true;
    }

    if (supportNoteChecked) {
      supportNoteChecked.textContent = trigger.dataset.supportNoteChecked
        ? `${supportNoteChecked.dataset.label || "Last checked"}: ${trigger.dataset.supportNoteChecked}`
        : "";
    }

    supportNoteModal.hidden = false;
    supportNoteModal.setAttribute("aria-hidden", "false");
    document.documentElement.classList.add("support-note-lock");
    supportNotePanel.focus();
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const trigger = target.closest("[data-support-note-summary]");
    if (trigger) {
      openSupportNote(trigger);
      return;
    }

    if (target.closest("[data-support-note-close]")) closeSupportNote();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeSupportNote();
  });
</script>
