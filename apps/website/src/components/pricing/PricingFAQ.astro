---
import { tCommon } from "../../i18n/locales/pages/common";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = (key: string) => tCommon(lang, key);

const faqKeys = [
  { q: "What happens when I approach a plan limit?", a: "Your usage page shows used and reserved capacity. We warn at 75% and 90%. When an allowance is full, new work using that resource pauses until you free capacity, upgrade or the monthly allowance renews. Local execution and your own models remain available." },
  { q: "What counts as cloud runtime?", a: "Time spent running your cloud workflow, including time waiting for network or model responses. Realtime and async workflows use the same runtime allowance. Your local workflows use none." },
  { q: "Is this per-seat pricing?", a: "Free, Premium, Pro and Max are account subscriptions. Enterprise capacity and terms are agreed separately." },
  { q: "How does hosted AI usage work?", a: "Flow-Like-funded model and embedding requests use your hosted AI money and operation allowances. Included AI usage covers inference and serving costs. Your plan's hosted model selection applies. Your own models and local embeddings use neither AI allowance." },
  { q: "Can I work with larger datasets?", a: "Connect your own storage without using the included Flow-Like storage allowance. Data copied into Flow-Like counts toward hosted storage. Processing capacity depends on the workflow, memory and execution duration." },
  { q: "Can I use my existing coding assistant?", a: "Studio FlowPilot can use your GitHub Copilot, Codex or Claude Code instance without using Flow-Like hosted AI allowances. Your provider's subscription and usage limits still apply." },
  { q: "How do annual plans renew usage?", a: "Annual plans are billed once per year. Runtime, cloud starts, hosted AI money and hosted AI operations still renew monthly. Storage and project allowances measure current occupancy and do not reset." },
  { q: "Do public-project forks use project slots?", a: "No. Forks of public projects, including purchased projects, do not count toward the project limit. Their hosted storage, cloud runtime and hosted AI usage still use your normal plan allowances." },
];
---

<section class="py-20 md:py-32 relative overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-muted/30 via-muted/50 to-muted/30"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-primary/5 rounded-full blur-[150px]"></div>
  </div>

  <div class="max-w-4xl mx-auto px-4">
    {/* Header */}
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-card/50 backdrop-blur-sm border border-border/50 text-sm text-muted-foreground mb-6">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        FAQ
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-4">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-foreground to-foreground/70">
          {t("pricing.faq.title")}
        </span>
      </h2>
      <p class="text-lg text-muted-foreground max-w-xl mx-auto">{t("pricing.faq.subtitle")}</p>
    </div>

    {/* FAQ Grid - Two columns on desktop */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {faqKeys.map((faq, index) => (
        <details
          lang="en"
          class="group rounded-2xl bg-card/50 backdrop-blur-sm border border-border/50 hover:border-primary/30 transition-all duration-300 overflow-hidden"
        >
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <span class="font-semibold pr-4 group-hover:text-primary transition-colors">{faq.q}</span>
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-muted/50 flex items-center justify-center group-hover:bg-primary/10 transition-colors">
              <svg
                class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-all duration-300 group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-6 -mt-2">
            <p class="text-muted-foreground leading-relaxed">{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

    {/* Still have questions? */}
    <div class="mt-12 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-4 p-6 rounded-2xl bg-card/30 backdrop-blur-sm border border-border/50">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-primary/20 to-violet-500/20 flex items-center justify-center">
          <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <div class="text-center sm:text-left">
          <p class="font-semibold">{t("pricing.faq.moreQuestions") || "Still have questions?"}</p>
          <p class="text-sm text-muted-foreground">{t("pricing.faq.contactUs") || "We're here to help"}</p>
        </div>
        <a
          href="mailto:hello@flow-like.com"
          class="px-5 py-2.5 rounded-xl bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors"
        >
          {t("pricing.faq.contactButton") || "Contact us"}
        </a>
      </div>
    </div>
  </div>
</section>
