---
import config from "../../../../../flow-like.config.json";
import RuntimeCalculator from "./RuntimeCalculator.astro";
import { tCommon } from "../../i18n/locales/pages/common";
interface Props { lang: string; }
const { lang } = Astro.props;
const t = (key: string) => tCommon(lang, key);
const tiers = ["FREE", "PREMIUM", "PRO", "MAX"] as const;
type Plan = (typeof config.tiers)[(typeof tiers)[number]];
const price = (amount: number) => new Intl.NumberFormat(lang, { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(amount / 100);
const count = (value: number) => value < 0 ? "Unlimited" : value.toLocaleString(lang);
const runtime = (ms: number) => ms < 0 ? "Unlimited" : ms < 3_600_000 ? `${count(ms / 60_000)} min` : `${count(ms / 3_600_000)} h`;
const storage = (bytes: number) => bytes < 0 ? "Unlimited" : `${count(bytes / 1_000_000_000)} GB`;
const limits: {label: string; value: (tier: Plan) => string}[] = [
  {label: "Cloud runtime / month", value: tier => runtime(tier.max_runtime_ms)},
  {label: "Hosted AI allowance / month", value: tier => price(tier.max_ai_cost_micros / 10_000)},
  {label: "Cloud storage", value: tier => storage(tier.max_total_size)},
  {label: "Private cloud projects", value: tier => count(tier.max_non_visible_projects)},
  {label: "Cloud starts / month", value: tier => count(tier.max_remote_executions)},
  {label: "Hosted AI operations / month", value: tier => count(tier.max_llm_calls)},
  {label: "Concurrent cloud executions", value: tier => count(tier.max_concurrent_executions)},
  {label: "Hosted model access", value: tier => tier.llm_tiers.map(name => name.charAt(0) + name.slice(1).toLowerCase()).join(", ")},
];
---

<section class="py-16 md:py-24 relative">
  <div class="max-w-7xl mx-auto px-4 space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
      {tiers.map((key) => {
        const display = config.conversion.tier_display[key];
        const tier = config.tiers[key];
        const metrics = [
          {label: "Cloud runtime", value: runtime(tier.max_runtime_ms), period: "/ month"},
          {label: "Hosted AI allowance", value: price(tier.max_ai_cost_micros / 10_000), period: "/ month"},
          {label: "Cloud storage", value: storage(tier.max_total_size), period: "stored"},
        ];
        return <article class="flex flex-col rounded-3xl border border-border bg-card p-6 shadow-sm" lang="en">
          <header><h3 class="text-2xl font-bold">{display.display_name}</h3><p class="mt-2 text-sm leading-relaxed text-muted-foreground min-h-12">{display.tagline}</p></header>
          <div class="mt-4 min-h-24"><p><span class="text-4xl font-bold">{price(display.monthly_price_cents)}</span><span class="text-muted-foreground"> / month</span></p>{display.annual_price_cents > 0 && <p class="text-sm leading-relaxed text-muted-foreground mt-2">Or {price(display.annual_price_cents)} per year. Save {Math.round((1-display.annual_price_cents/(display.monthly_price_cents*12))*100)}%.</p>}</div>
          <a href={key === "FREE" ? "/download" : "https://app.flow-like.com/subscription"} class="mt-4 block rounded-xl bg-primary px-4 py-3 text-center font-semibold text-primary-foreground hover:bg-primary/90">{key === "FREE" ? t("pricing.cta.download") : `Choose ${display.display_name}`}</a>
          <dl class="mt-5 divide-y divide-border">{metrics.map(metric => <div class="flex items-center justify-between gap-3 py-3"><dt class="text-sm text-muted-foreground">{metric.label}</dt><dd class="text-right"><span class="block text-lg font-semibold tabular-nums">{metric.value}</span><span class="block text-xs text-muted-foreground">{metric.period}</span></dd></div>)}</dl>
        </article>;
      })}
    </div>
    <p class="text-sm text-muted-foreground" lang="en">Prices in EUR. Any applicable taxes are shown at checkout.</p>
    <RuntimeCalculator lang={lang} />
    <details class="group rounded-2xl border border-border bg-card" lang="en">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-semibold [&::-webkit-details-marker]:hidden">Compare all limits<span class="text-xl transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
      <div class="overflow-x-auto border-t border-border">
        <table class="w-full min-w-[640px] text-left text-sm">
          <caption class="sr-only">Plan allowances and included hosted model tiers</caption>
          <thead><tr class="border-b border-border bg-muted/30"><th scope="col" class="p-4 font-medium">Allowance</th>{tiers.map(key => <th scope="col" class="p-4 font-semibold">{config.conversion.tier_display[key].display_name}</th>)}</tr></thead>
          <tbody>{limits.map(limit => <tr class="border-b border-border last:border-0"><th scope="row" class="p-4 font-normal text-muted-foreground">{limit.label}</th>{tiers.map(key => <td class="p-4 tabular-nums">{limit.value(config.tiers[key])}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <div class="border-t border-border p-5 text-sm leading-relaxed text-muted-foreground space-y-2">
        <p>Monthly runtime, cloud starts and hosted AI allowances renew monthly, including on annual subscriptions. Both runtime and start limits apply. Both AI money and operation limits apply.</p>
        <p>Storage and project limits measure current usage. Concurrent execution slots become available when work finishes. Hosted AI usage includes inference and serving costs. Each plan's included hosted model selection applies.</p>
        <p>Data in your own connected storage uses no Flow-Like storage allowance; data copied into Flow-Like does.</p>
      </div>
    </details>
    <div class="rounded-3xl border border-border bg-muted/30 p-6 md:p-8 space-y-4" lang="en">
      <h3 class="text-xl font-bold">Keep building on every plan</h3>
      <ul class="grid gap-4 md:grid-cols-2 text-sm">
        <li><strong>Local execution and embeddings are free.</strong> Run on your own device without using cloud runtime or hosted AI allowances.</li>
        <li><strong>Bring your own models.</strong> Customer-funded models use no Flow-Like AI budget or AI operations. Your provider may charge separately. Cloud workflows still use cloud runtime.</li>
        <li><strong>Use your existing coding assistant.</strong> Studio FlowPilot works with your GitHub Copilot, Codex or Claude Code instance. Your provider's subscription and limits apply.</li>
        <li><strong>Explore public projects.</strong> Public-project forks, including purchases, use no project slots. Their storage, cloud runtime and hosted AI still use your normal allowances.</li>
      </ul>
    </div>
    <div class="rounded-3xl border border-border p-6 md:p-8 flex flex-wrap gap-6 items-center justify-between" lang="en">
      <div><h3 class="text-xl font-bold">Enterprise</h3><p class="text-muted-foreground">Capacity, deployment, governance and support agreed with your organization.</p></div>
      <a href="mailto:enterprise@flow-like.com" class="rounded-xl border px-5 py-3 font-semibold hover:bg-muted">{t("pricing.cta.contactSales")}</a>
    </div>
  </div>
</section>
