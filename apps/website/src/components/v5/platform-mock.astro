---
import { FlowPilotBubbleOrb } from "@flow-like/flow-like-ui/components/global-chat/flowpilot-bubble-orb";
import type { Lang, TranslationKey } from "../../i18n";
import { defaultLang, translations } from "../../i18n";

interface Props { id: string; lang?: Lang; }
const { id, lang = defaultLang } = Astro.props;
const t = (key: TranslationKey): string => {
  const localized = translations[lang] as Record<string, string>;
  const english = translations.en as Record<string, string>;
  return localized?.[key] ?? english[key] ?? key;
};
const tList = (key: TranslationKey): string[] => t(key).split("|");

const previewBars = [45, 59, 51, 73, 66, 89, 78];
const marketBars = [42, 55, 48, 72, 65, 88];
const components = tList("v5.platform.components");
const storeApps = ["Deal Desk", "People Hub", "Incident OS", "Research", "Vendor Risk", "Field Ops"];

const steps: [string, string, string][] = [
  ["01", t("v5.platform.wf.s1"), "Schedule"],
  ["02", t("v5.platform.wf.s2"), "Data Studio"],
  ["03", t("v5.platform.wf.s3"), "FlowScript"],
  ["04", t("v5.platform.wf.s4"), "Condition"],
  ["05", t("v5.platform.wf.s5"), "Mail + Teams"],
];

const auditRows: string[][] = [
  [t("v5.platform.gov.sys1"), t("v5.platform.owner.legal"), t("v5.platform.risk.limited"), t("v5.platform.status.compliant")],
  [t("v5.platform.gov.sys2"), t("v5.platform.owner.revenue"), t("v5.platform.risk.minimal"), t("v5.platform.status.compliant")],
  [t("v5.platform.gov.sys3"), t("v5.platform.owner.people"), t("v5.platform.risk.high"), t("v5.platform.status.reviewDue")],
  [t("v5.platform.gov.sys4"), t("v5.platform.owner.finance"), t("v5.platform.risk.minimal"), t("v5.platform.status.compliant")],
];

const execSteps: [string, string, string][] = [
  ["01", "Customer 360", t("v5.platform.exec.d1")],
  ["02", t("v5.platform.exec.email"), t("v5.platform.exec.d2")],
  ["03", t("v5.platform.exec.notes"), t("v5.platform.exec.d3")],
  ["04", t("v5.platform.exec.calendar"), t("v5.platform.exec.d4")],
];

const builderTabs = tList("v5.platform.builder.tabs");
const frontendTabs = tList("v5.platform.frontend.tabs");
const records = t("v5.platform.data.records");
const events = t("v5.platform.data.events");
const ontologyObjects: [string, string, string, string][] = [
  ["CO", t("v5.platform.data.obj.company"), "12.4k", records],
  ["PE", t("v5.platform.data.obj.person"), "84.2k", records],
  ["CT", t("v5.platform.data.obj.contract"), "31.8k", records],
  ["PR", t("v5.platform.data.obj.product"), "4.2k", records],
  ["EV", t("v5.platform.data.obj.interaction"), "2.8B", events],
];
const govMetrics: [string, string, string][] = [
  [t("v5.platform.gov.m1.label"), "84", t("v5.platform.gov.m1.sub")],
  [t("v5.platform.gov.m2.label"), "98.7%", t("v5.platform.gov.m2.sub")],
  [t("v5.platform.gov.m3.label"), "1.2M", t("v5.platform.gov.m3.sub")],
];
const auditCols = [t("v5.platform.gov.col.system"), t("v5.platform.gov.col.owner"), t("v5.platform.gov.col.risk"), t("v5.platform.gov.col.status")];
---

{id === "builder" && (
  <div class="mock builder">
    <aside><label>FLOWPILOT</label><p>{t("v5.platform.builder.prompt")}</p><div class="building"><i></i><span><b>{t("v5.platform.builder.building")}</b><small>{t("v5.platform.builder.connecting")}</small></span></div><ul><li>✓ {t("v5.platform.builder.li1")}</li><li>✓ {t("v5.platform.builder.li2")}</li><li>✓ {t("v5.platform.builder.li3")}</li></ul></aside>
    <section class="app-preview light-screen"><header><b>SupplyOS</b><span>{builderTabs[0]} &nbsp; {builderTabs[1]} &nbsp; {builderTabs[2]}</span><i>FL</i></header><main><label>{t("v5.platform.builder.screenLabel")}</label><h4>Good morning, Felix.</h4><div class="preview-metrics"><span><b>214</b><small>{t("v5.platform.builder.m1")}</small></span><span><b>96.8%</b><small>{t("v5.platform.builder.m2")}</small></span><span><b>8</b><small>{t("v5.platform.builder.m3")}</small></span></div><div class="preview-bars">{previewBars.map((x) => (<i style={`height:${x}%`}></i>))}</div></main></section>
  </div>
)}
{id === "workflow" && (
  <div class="mock workflow">
    <header><b>{t("v5.platform.workflow.title")}</b><span>LIVE</span></header>
    <div class="workflow-canvas">{steps.map((s, i) => (<div class={`flow-step fs${i + 1}`}><i>{s[0]}</i><span><b>{s[1]}</b><small>{s[2]}</small></span></div>))}<div class="wires" data-connect data-links="fs1-fs2,fs1-fs3,fs2-fs4,fs4-fs5"></div></div>
    <div class="code"><header><span>score_risk.flow</span><em>FlowScript</em></header><pre><span class="fn">onSchedule</span>() &#123;
  <span class="k">const</span> signals = <span class="fn">ontologySignals</span>(&#123; <span class="pr">supplier</span> &#125;)
  <span class="k">const</span> score = <span class="fn">modelPredict</span>(&#123; <span class="pr">model</span>: <span class="st">"risk-v3"</span>, <span class="pr">signals</span> &#125;)
  <span class="fn">log</span>(&#123; <span class="pr">text</span>: score.risk &#125;)
&#125;</pre></div>
  </div>
)}
{id === "frontend" && (
  <div class="mock frontend">
    <aside><label>{t("v5.platform.frontend.componentsLabel")}</label>{components.map((x) => (<span><i></i>{x}<b>＋</b></span>))}</aside>
    <section class="light-screen"><header><b>Northstar</b><span>{frontendTabs[0]} &nbsp; {frontendTabs[1]} &nbsp; {frontendTabs[2]}</span><i>NS</i></header><main><label>{t("v5.platform.frontend.portfolioValue")}</label><div><h4>€84.2M</h4><em>↗ 12.4%</em></div><section><i class="donut"></i><div class="market-bars">{marketBars.map((x) => (<i style={`height:${x}%`}></i>))}</div></section></main></section>
    <footer><span>{t("v5.platform.frontend.visual")}</span><b>React</b><b>Next.js</b><b>Angular</b></footer>
  </div>
)}
{id === "data" && (
  <div class="mock data">
    <header><b>{t("v5.platform.data.title")}</b><span>42 {t("v5.platform.data.objects")} · 128 {t("v5.platform.data.relations")}</span><em>{t("v5.platform.data.query")}</em></header>
    <div class="ontology">{ontologyObjects.map((o, i) => (<div class={`object o${i + 1}`}><i>{o[0]}</i><span><b>{o[1]}</b><small>{o[2]} {o[3]}</small></span></div>))}<div class="rels" data-connect data-links="o1-o2,o1-o3,o1-o4,o1-o5"></div></div>
    <footer><label>{t("v5.platform.data.askLabel")}</label><p>{t("v5.platform.data.askQuestion")}</p><b>⌘ ↵</b></footer>
  </div>
)}
{id === "store" && (
  <div class="mock store light-screen">
    <header><b>{t("v5.platform.store.title")}</b><div>{t("v5.platform.store.search")}</div><span>{t("v5.platform.store.myApps")}</span></header>
    <main><section class="dark"><span><label>{t("v5.platform.store.featured")}</label><b>Quarterly Business Review</b><p>{t("v5.platform.store.featuredDesc")}</p><em>{t("v5.platform.store.openApp")} ↗</em></span><i>Q3</i></section><div class="store-grid">{storeApps.map((x, i) => (<article><i>{x[0]}</i><span><b>{x}</b><small>{12 + i * 7} {t("v5.platform.store.users")}</small></span><em>↗</em></article>))}</div></main>
  </div>
)}
{id === "governance" && (
  <div class="mock governance light-screen">
    <header><span><label>{t("v5.platform.gov.label")}</label><b>{t("v5.platform.gov.title")}</b></span><em>{t("v5.platform.gov.status")}</em></header>
    <div class="gov-metrics">{govMetrics.map((m) => (<span><small>{m[0]}</small><b>{m[1]}</b><i>{m[2]}</i></span>))}</div>
    <div class="audit"><header>{auditCols.map((col) => (<span>{col}</span>))}</header>{auditRows.map((r) => (<div>{r.map((x) => (<span>{x}</span>))}</div>))}</div>
  </div>
)}
{id === "pilot" && (
  <div class="mock pilot">
    <div class="pilot-command"><FlowPilotBubbleOrb client:only="react" aria-label="FlowPilot" className="size-9 shrink-0" /><p>{t("v5.platform.pilot.prompt")}</p><span>{t("v5.platform.pilot.access")}</span></div>
    <div class="execution">{execSteps.map((s) => (<div><i>{s[0]}</i><span><b>{s[1]}</b><small>{s[2]}</small></span><em>{t("v5.platform.pilot.done")} ✓</em></div>))}</div>
    <div class="pilot-result light-screen"><label>{t("v5.platform.pilot.briefingReady")}</label><b>Acme Renewal · €1.2M ARR</b><p>{t("v5.platform.pilot.resultDesc")}</p><button>{t("v5.platform.pilot.openBriefing")} ↗</button></div>
  </div>
)}

<!--
  Mock styles live here, colocated with the markup, so Astro's scope hash lands on
  these elements. The JS-drawn connector bars (.wires/.rels > i) stay global in the
  parent section, since createElement() output never carries a scope hash.
-->
<style>
  .mock { --mono: ui-monospace, SFMono-Regular, Menlo, monospace; position: relative; width: min(100%, 900px); height: min(68vh, 650px); overflow: hidden; border: 1px solid var(--border); border-radius: 16px; background: var(--card); box-shadow: 0 40px 120px rgba(0, 0, 0, .5); }
  .mock label { font: 8px var(--mono); letter-spacing: .12em; }
  /* Light product-screen islands on the dark stage: re-declare the light tokens
     for these subtrees so the mocks read like real app screenshots. */
  .light-screen {
    --background: oklch(0.9841 0.0035 39.4848);
    --foreground: oklch(0.184 0.0081 285.5768);
    --card: oklch(1 0 0);
    --muted: oklch(0.9401 0.0068 53.4438);
    --muted-foreground: oklch(0.5137 0.0156 285.8367);
    --border: oklch(0.8933 0.0111 54.4825);
    color: var(--foreground);
  }

  .builder { display: grid; grid-template-columns: 30% 70%; }
  .builder > aside { padding: 24px 18px; border-right: 1px solid var(--border); background: var(--background); }
  .builder > aside > label { color: var(--muted-foreground); }
  .builder > aside > p { margin-top: 20px; padding: 15px; border: 1px solid var(--border); border-radius: 12px 12px 12px 3px; background: var(--card); font-size: 13px; line-height: 1.45; }
  .building { display: flex; gap: 10px; margin-top: 28px; }
  .building > i { width: 16px; height: 16px; border: 2px solid var(--primary); border-top-color: transparent; border-radius: 50%; animation: spin 1s linear infinite; }
  .building span { display: grid; }
  .building b { font-size: 10px; }
  .building small { margin-top: 3px; color: var(--muted-foreground); font-size: 8px; }
  .builder ul { display: grid; gap: 10px; margin: 24px 0 0 26px; padding: 0; list-style: none; color: var(--muted-foreground); font-size: 9px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .app-preview { background: var(--muted); color: var(--foreground); }
  .app-preview > header, .frontend > section > header { height: 48px; display: flex; align-items: center; padding: 0 18px; border-bottom: 1px solid var(--border); background: var(--card); }
  .app-preview > header b, .frontend > section > header b { font-size: 11px; }
  .app-preview > header span, .frontend > section > header span { margin: auto; color: var(--muted-foreground); font-size: 8px; }
  .app-preview > header i, .frontend > section > header i { display: grid; place-items: center; width: 23px; height: 23px; border-radius: 50%; background: var(--foreground); color: var(--background); font-size: 7px; font-style: normal; }
  .app-preview > main { padding: 28px; }
  .app-preview > main label { color: var(--muted-foreground); }
  .app-preview > main h4 { margin: 10px 0 28px; font-size: 26px; letter-spacing: -.04em; }
  .preview-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
  .preview-metrics > span { display: grid; padding: 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); }
  .preview-metrics b { font-size: 20px; }
  .preview-metrics small { color: var(--muted-foreground); font-size: 7px; }
  .preview-bars { height: 190px; display: flex; align-items: end; gap: 8px; margin-top: 11px; padding: 22px; border-radius: 8px; background: var(--foreground); }
  .preview-bars i { flex: 1; border-radius: 3px 3px 0 0; background: linear-gradient(var(--accent), var(--primary)); }

  .workflow { background-color: var(--background); background-image: radial-gradient(color-mix(in oklab, var(--foreground) 12%, transparent) 1px, transparent 1px); background-size: 18px 18px; }
  .workflow > header { height: 48px; display: flex; align-items: center; justify-content: space-between; padding: 0 18px; border-bottom: 1px solid var(--border); background: var(--card); font-size: 10px; }
  .workflow > header span { padding: 5px 8px; border: 1px solid color-mix(in oklab, var(--accent) 25%, transparent); border-radius: 20px; color: var(--accent); font: 7px var(--mono); }
  .workflow-canvas { position: relative; height: 60%; }
  .flow-step { position: absolute; z-index: 2; width: 145px; display: flex; align-items: center; gap: 10px; padding: 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--card); box-shadow: 0 8px 30px rgba(0, 0, 0, .25); }
  .flow-step > i { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 7px; background: color-mix(in oklab, var(--card) 85%, var(--foreground)); color: var(--accent); font: 7px var(--mono); font-style: normal; }
  .flow-step span { display: grid; }
  .flow-step b { font-size: 9px; }
  .flow-step small { margin-top: 3px; color: var(--muted-foreground); font-size: 7px; }
  .fs1 { left: 5%; top: 38%; }
  .fs2 { left: 29%; top: 17%; }
  .fs3 { left: 29%; top: 59%; }
  .fs4 { right: 26%; top: 38%; }
  .fs5 { right: 3%; top: 38%; border-color: color-mix(in oklab, var(--accent) 35%, transparent); }
  .wires { position: absolute; inset: 0; pointer-events: none; }
  .code { position: absolute; right: 0; bottom: 0; left: 0; height: 30%; padding: 12px 16px; border-top: 1px solid var(--border); background: color-mix(in oklab, var(--background) 68%, black); }
  .code > header { display: flex; justify-content: space-between; color: var(--muted-foreground); font: 7px var(--mono); }
  .code header em { font-style: normal; }
  .code pre { color: #e5e7eb; font: 9px/1.6 var(--mono); }
  .code pre .k { color: #60a5fa; }
  .code pre .fn { color: #22d3ee; }
  .code pre .pr { color: #93c5fd; }
  .code pre .st { color: #86efac; }

  .frontend { display: grid; grid-template-columns: 17% 1fr; background: var(--background); }
  .frontend > aside { display: grid; align-content: start; gap: 7px; padding: 15px 10px; border-right: 1px solid var(--border); }
  .frontend > aside > label { margin-bottom: 8px; color: var(--muted-foreground); font-size: 7px; }
  .frontend > aside > span { display: grid; grid-template-columns: 14px 1fr auto; gap: 7px; align-items: center; padding: 8px 6px; border-radius: 6px; background: var(--card); color: var(--muted-foreground); font-size: 7px; }
  .frontend > aside span i { width: 11px; height: 11px; border: 1px solid var(--border); border-radius: 2px; }
  .frontend > aside span b { font-weight: 400; }
  .frontend > section { margin: 30px 28px 48px; overflow: hidden; border-radius: 10px; background: var(--muted); color: var(--foreground); box-shadow: 0 20px 60px rgba(0, 0, 0, .3); }
  .frontend > section > main { padding: 28px; }
  .frontend > section > main > label { color: var(--muted-foreground); }
  .frontend > section > main > div { display: flex; align-items: end; justify-content: space-between; }
  .frontend > section h4 { margin: 7px 0; font-size: 38px; letter-spacing: -.05em; }
  .frontend > section main em { padding-bottom: 7px; color: oklch(0.62 0.13 150); font-size: 10px; font-style: normal; }
  .frontend > section > main > section { display: grid; grid-template-columns: .7fr 1.3fr; gap: 10px; }
  .donut { position: relative; height: 160px; border-radius: 8px; background: conic-gradient(var(--primary) 0 42%, var(--accent) 42% 68%, color-mix(in oklab, var(--accent) 60%, var(--card)) 68% 82%, var(--border) 82%); }
  .donut:after { content: "ALLOCATION"; position: absolute; inset: 34px; display: grid; place-items: center; border-radius: 50%; background: var(--card); font: 7px var(--mono); }
  .market-bars { height: 160px; display: flex; align-items: end; gap: 8px; padding: 20px; border-radius: 8px; background: var(--foreground); }
  .market-bars i { flex: 1; border-radius: 3px 3px 0 0; background: var(--primary); }
  .frontend > footer { position: absolute; right: 3%; bottom: 12px; left: 20%; display: flex; align-items: center; gap: 6px; font: 7px var(--mono); }
  .frontend > footer span { margin-right: auto; color: var(--accent); }
  .frontend > footer b { padding: 6px 9px; border: 1px solid var(--border); border-radius: 5px; color: var(--muted-foreground); font-weight: 400; }

  .data { background-color: var(--background); background-image: radial-gradient(color-mix(in oklab, var(--foreground) 10%, transparent) 1px, transparent 1px); background-size: 18px 18px; }
  .data > header { height: 52px; display: flex; align-items: center; gap: 14px; padding: 0 18px; border-bottom: 1px solid var(--border); background: var(--card); }
  .data > header b { font-size: 10px; }
  .data > header span { color: var(--muted-foreground); font-size: 8px; }
  .data > header em { margin-left: auto; color: var(--accent); font: 7px var(--mono); font-style: normal; }
  .ontology { position: relative; height: 73%; }
  .object { position: absolute; z-index: 2; width: 132px; display: grid; grid-template-columns: auto 1fr; column-gap: 9px; padding: 11px; border: 1px solid var(--border); border-radius: 10px; background: var(--card); }
  .object > i { grid-row: span 2; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: color-mix(in oklab, var(--primary) 18%, transparent); color: var(--accent); font: 7px var(--mono); font-style: normal; }
  .object span { display: grid; }
  .object b { font-size: 9px; }
  .object small { color: var(--muted-foreground); font-size: 7px; }
  .o1 { top: 36%; left: 40%; border-color: color-mix(in oklab, var(--accent) 40%, transparent); }
  .o1 > i { background: color-mix(in oklab, var(--accent) 12%, transparent); color: var(--accent); }
  .o2 { top: 16%; left: 9%; }
  .o3 { top: 13%; right: 8%; }
  .o4 { bottom: 12%; left: 15%; }
  .o5 { right: 15%; bottom: 10%; }
  .rels { position: absolute; inset: 0; pointer-events: none; }
  .data > footer { position: absolute; right: 13px; bottom: 13px; left: 13px; display: grid; grid-template-columns: 120px 1fr auto; align-items: center; padding: 11px 14px; border: 1px solid var(--border); border-radius: 10px; background: color-mix(in oklab, var(--background) 68%, black); }
  .data > footer label { color: var(--accent); font-size: 7px; }
  .data > footer p { margin: 0; color: var(--muted-foreground); font-size: 9px; }
  .data > footer b { color: var(--muted-foreground); font: 8px var(--mono); }

  .store { padding-bottom: 15px; background: var(--muted); color: var(--foreground); }
  .store > header { height: 52px; display: grid; grid-template-columns: 1fr 1.2fr 1fr; align-items: center; padding: 0 17px; border-bottom: 1px solid var(--border); background: var(--card); }
  .store > header b { font-size: 10px; }
  .store > header div { padding: 8px 12px; border-radius: 6px; background: color-mix(in oklab, var(--muted) 70%, var(--background)); color: var(--muted-foreground); font-size: 7px; }
  .store > header span { justify-self: end; font-size: 8px; }
  .store > main > section { position: relative; height: 175px; display: flex; align-items: center; overflow: hidden; margin: 14px; padding: 26px 32px; border-radius: 10px; background: var(--card); color: var(--foreground); }
  .store > main > section:after { content: ""; position: absolute; top: -90px; right: -80px; width: 250px; height: 250px; border: 50px solid color-mix(in oklab, var(--primary) 50%, transparent); border-radius: 50%; }
  .store > main > section span { position: relative; z-index: 2; display: grid; width: 55%; }
  .store > main > section label { color: var(--accent); font-size: 7px; }
  .store > main > section b { margin: 8px 0 4px; font-size: 20px; }
  .store > main > section p { margin: 0 0 12px; color: var(--muted-foreground); font-size: 8px; line-height: 1.4; }
  .store > main > section em { font-size: 8px; font-style: normal; }
  .store > main > section > i { position: relative; z-index: 2; margin-left: auto; color: var(--accent); font-size: 72px; font-weight: 800; font-style: normal; letter-spacing: -.08em; }
  .store-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 0 14px; }
  .store-grid > article { display: flex; align-items: center; gap: 9px; padding: 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); }
  .store-grid article > i { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 7px; background: color-mix(in oklab, var(--primary) 8%, var(--card)); color: var(--primary); font-size: 9px; font-weight: 700; font-style: normal; }
  .store-grid article span { display: grid; }
  .store-grid article b { font-size: 8px; }
  .store-grid article small { color: var(--muted-foreground); font-size: 7px; }
  .store-grid article em { margin-left: auto; font-size: 8px; font-style: normal; }

  .governance { padding: 22px; background: var(--muted); color: var(--foreground); }
  .governance > header { display: flex; align-items: center; justify-content: space-between; }
  .governance > header > span { display: grid; }
  .governance > header label { color: var(--muted-foreground); font-size: 7px; }
  .governance > header b { margin-top: 5px; font-size: 17px; }
  .governance > header em { color: oklch(0.62 0.13 150); font-size: 8px; font-style: normal; }
  .gov-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; margin: 22px 0; }
  .gov-metrics > span { display: grid; padding: 15px; border: 1px solid var(--border); border-radius: 9px; background: var(--card); }
  .gov-metrics small { color: var(--muted-foreground); font-size: 8px; }
  .gov-metrics b { margin: 6px 0; font-size: 28px; letter-spacing: -.04em; }
  .gov-metrics i { color: oklch(0.62 0.13 150); font-size: 7px; font-style: normal; }
