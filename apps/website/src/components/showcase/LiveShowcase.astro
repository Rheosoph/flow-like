---
import LiveShowcaseIsland, {
	type ShowcasePresentation,
} from "./live-showcase";

interface TimelineStep {
	kind: string;
	[key: string]: unknown;
}

interface Props {
	variant:
		| "chat"
		| "board"
		| "a2ui"
		| "runs"
		| "data"
		| "catalog"
		| "prototype"
		| "workflow";
	/** Optional progressive-enhancement poster. Landing demos use the UI skeleton instead. */
	poster?: string;
	posterAlt?: string;
	posterWidth?: number;
	posterHeight?: number;
	timeline?: TimelineStep[];
	/** Board/a2ui variant: URL of a static graph / definition. */
	data?: string;
	intro?: { role: "user" | "assistant"; content: string }[];
	replyText?: string;
	tools?: string[];
	caption?: string;
	/** Fill the parent (no frame / aspect-ratio) — for embedding inside an existing sized container. */
	bare?: boolean;
	/** Adapts the product demo density to its placement. */
	presentation?: ShowcasePresentation;
	/** Load the poster eagerly (above-the-fold / LCP surfaces like the hero). */
	eager?: boolean;
	class?: string;
}

const {
	variant,
	poster,
	posterAlt = "Interactive Flow-Like product demo",
	posterWidth = 16,
	posterHeight = 10,
	timeline,
	data,
	intro,
	replyText,
	tools,
	caption,
	bare = false,
	presentation = "full",
	eager = false,
	class: className,
} = Astro.props;
---

<div
	class:list={[
		"live-showcase dark relative isolate overflow-hidden",
		`live-showcase--${presentation}`,
		bare
			? "h-full w-full"
			: "rounded-xl border border-white/10 bg-neutral-950 shadow-2xl shadow-black/40",
		className,
	]}
	style={bare ? undefined : `aspect-ratio:${posterWidth} / ${posterHeight};`}
	role="group"
	aria-label={posterAlt}
>
	{
		poster ? (
			<img
				src={poster}
				alt={posterAlt}
				width={posterWidth}
				height={posterHeight}
				loading={eager ? "eager" : "lazy"}
				fetchpriority={eager ? "high" : "auto"}
				decoding="async"
				class="absolute inset-0 h-full w-full object-cover object-top"
			/>
		) : (
			<div
				class="live-showcase__skeleton absolute inset-0 overflow-hidden bg-background"
				aria-hidden="true"
			>
				<div class="flex h-10 items-center gap-2 border-b border-border/60 bg-muted/35 px-3">
					<span class="size-2 rounded-full bg-rose-400/55"></span>
					<span class="size-2 rounded-full bg-amber-400/55"></span>
					<span class="size-2 rounded-full bg-emerald-400/55"></span>
					<span class="ml-2 h-2.5 w-28 rounded-full bg-muted"></span>
				</div>
				<div class="grid h-[calc(100%-2.5rem)] grid-cols-[4.5rem_1fr] gap-3 p-3 sm:grid-cols-[8rem_1fr]">
					<div class="space-y-2 rounded-lg border border-border/50 bg-muted/20 p-2">
						<span class="block h-7 rounded-md bg-primary/10"></span>
						<span class="block h-7 rounded-md bg-muted/70"></span>
						<span class="block h-7 rounded-md bg-muted/70"></span>
					</div>
					<div class="relative overflow-hidden rounded-lg border border-border/50 bg-muted/15 p-3">
						<span class="block h-5 w-1/3 rounded bg-muted"></span>
						<div class="mt-4 grid grid-cols-2 gap-3">
							<span class="h-20 rounded-lg bg-muted/60"></span>
							<span class="h-20 rounded-lg bg-muted/60"></span>
						</div>
						<span class="live-showcase__shimmer absolute inset-y-0 -left-1/3 w-1/3 bg-gradient-to-r from-transparent via-background/55 to-transparent"></span>
					</div>
				</div>
			</div>
		)
	}
	<LiveShowcaseIsland
		client:only="react"
		variant={variant}
		presentation={presentation}
		timeline={timeline as any}
		data={data}
		intro={intro}
		replyText={replyText}
		tools={tools}
	/>
	{
		caption && (
			<div class="pointer-events-none absolute bottom-2 left-2 z-10 rounded bg-background/70 px-2 py-0.5 text-[10px] text-muted-foreground/80 backdrop-blur-sm">
				{caption}
			</div>
		)
	}
</div>

<style>
	.live-showcase--embedded .live-showcase__skeleton > div:first-child,
	.live-showcase--compact .live-showcase__skeleton > div:first-child {
		display: none;
	}
	.live-showcase--embedded .live-showcase__skeleton > div:nth-child(2),
	.live-showcase--compact .live-showcase__skeleton > div:nth-child(2) {
		height: 100%;
	}
	.live-showcase__shimmer {
		animation: showcase-shimmer 1.5s ease-in-out infinite;
	}
	@keyframes showcase-shimmer {
		to { transform: translateX(440%); }
	}
	@media (prefers-reduced-motion: reduce) {
		.live-showcase__shimmer { animation: none; }
	}
</style>
