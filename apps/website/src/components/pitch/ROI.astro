---
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;

const costCards = [
  { key: "execution",             icon: "zap" },
  { key: "lowcode",               icon: "app" },
  { key: "bi_analytics",          icon: "chart" },
  { key: "orchestration",         icon: "flow" },
  { key: "enterprise_data",       icon: "database" },
  { key: "enterprise_automation", icon: "bot" },
  { key: "rpa",                   icon: "bot" },
  { key: "compliance_grc",        icon: "shield" },
  { key: "agent_runtimes",        icon: "sparkles" },
  { key: "llm_frameworks",        icon: "code" },
  { key: "ai_ipaas",              icon: "link" },
  { key: "personal_agents",       icon: "terminal" },
  { key: "custom_development",    icon: "code" },
] as const;

const tiles = [
  { key: "tile1", accent: "amber",   initials: "FL", stars: "4.9", installs: "2.4k" },
  { key: "tile2", accent: "violet",  initials: "CM", stars: "4.8", installs: "3.1k" },
  { key: "tile3", accent: "emerald", initials: "FL", stars: "4.7", installs: "1.8k" },
  { key: "tile4", accent: "sky",     initials: "OS", stars: "4.6", installs: "5.2k" },
  { key: "tile5", accent: "rose",    initials: "FL", stars: "4.8", installs: "1.5k" },
  { key: "tile6", accent: "orange",  initials: "CM", stars: "4.7", installs: "2.0k" },
] as const;
---

<section id="roi" class="relative">
  <div class="absolute top-0 left-0 right-0 h-px bg-border" />

  <!-- ── ACT 1 — What you're already paying for ── -->
  <div class="roi-act1-scroll relative">
    <div class="sticky top-0 min-h-screen flex items-center py-12 lg:py-14">
      <div class="mx-auto max-w-6xl px-6 lg:px-8 w-full">
        <div class="mb-6 text-center">
          <p class="text-[11px] font-medium tracking-[0.3em] uppercase text-destructive/70 mb-4">
            {t("pitch.roi.act1.tagline")}
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">
            {t("pitch.roi.act1.headline")}
          </h2>
        </div>

        <!-- Invoice-pile card stack -->
        <div class="roi-stack space-y-2">
          {costCards.map(({ key, icon }, i) => (
            <div
              class="roi-card group relative grid grid-cols-[1fr_auto] lg:grid-cols-[2.25rem_minmax(0,1fr)_11rem_minmax(19rem,1fr)] items-center gap-x-4 gap-y-2 sm:gap-5 px-5 sm:px-6 py-2 sm:py-2.5 rounded-xl border border-border bg-card hover:border-destructive/20 transition-colors"
              style={`z-index:${costCards.length - i}`}
            >
              {/* Icon */}
              <div class="hidden lg:flex w-9 h-9 rounded-lg bg-destructive/8 items-center justify-center shrink-0">
                {icon === "link" && (
                  <svg class="w-4 h-4 text-destructive/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                )}
                {icon === "bot" && (
                  <svg class="w-4 h-4 text-destructive/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z" /></svg>
                )}
                {icon === "app" && (
                  <svg class="w-4 h-4 text-destructive/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6A2.25 2.25 0 016 3.75h12A2.25 2.25 0 0120.25 6v12A2.25 2.25 0 0118 20.25H6A2.25 2.25 0 013.75 18V6zM3.75 9h16.5M8.25 13.5h3m-3 3h7.5" /></svg>
                )}
                {icon === "flow" && (
                  <svg class="w-4 h-4 text-destructive/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 6.75h.008v.008H6.75V6.75zm0 10.5h.008v.008H6.75v-.008zm10.5-10.5h.008v.008h-.008V6.75zm0 10.5h.008v.008h-.008v-.008zM7.5 7.5h9m-9 9h9m-9-8.25v7.5m9-7.5v7.5" /></svg>
                )}
                {icon === "database" && (
                  <svg class="w-4 h-4 text-destructive/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125v-3.75" /></svg>
                )}
                {icon === "code" && (
                  <svg class="w-4 h-4 text-destructive/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
                )}
                {icon === "chart" && (
                  <svg class="w-4 h-4 text-destructive/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 19.5h16.5M6.75 16.5V9.75m5.25 6.75V4.5m5.25 12V12" /></svg>
                )}
                {icon === "shield" && (
                  <svg class="w-4 h-4 text-destructive/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3.75l7.5 2.625v5.532c0 4.035-2.584 7.617-6.415 8.891L12 21.15l-1.085-.352C7.084 19.524 4.5 15.942 4.5 11.907V6.375L12 3.75zm-2.25 8.5l1.5 1.5 3.25-3.25" /></svg>
                )}
                {icon === "zap" && (
                  <svg class="w-4 h-4 text-destructive/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
                )}
                {icon === "sparkles" && (
                  <svg class="w-4 h-4 text-destructive/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" /></svg>
                )}
                {icon === "terminal" && (
                  <svg class="w-4 h-4 text-destructive/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 7.5l3 3-3 3m4.5 0h6M4.5 5.25h15A2.25 2.25 0 0121.75 7.5v9A2.25 2.25 0 0119.5 18.75h-15A2.25 2.25 0 012.25 16.5v-9A2.25 2.25 0 014.5 5.25z" /></svg>
                )}
              </div>

              {/* Category + names */}
              <div class="min-w-0">
                <span class="block text-sm font-semibold text-foreground leading-tight">
                  {t(`pitch.roi.act1.${key}.category`)}
                </span>
                <span class="block text-xs text-muted-foreground mt-0.5">
                  {t(`pitch.roi.act1.${key}.names`)}
                </span>
              </div>

              {/* Struck-through price */}
              <span class="roi-price text-base font-bold text-destructive line-through decoration-destructive/40 decoration-2 whitespace-nowrap tabular-nums text-right">
                {t(`pitch.roi.act1.${key}.price`)}
              </span>

              {/* Flow-Like replacement */}
              <div class="col-span-2 lg:col-span-1 flex items-center gap-2 pl-5 sm:pl-8 lg:pl-10 xl:pl-12 lg:justify-start">
                <span class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500/15 shrink-0">
                  <svg class="w-3 h-3 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="text-sm font-medium text-emerald-600 dark:text-emerald-400 lg:whitespace-nowrap">
                  {t(`pitch.roi.act1.${key}.replacement`)}
                </span>
              </div>
            </div>
          ))}
        </div>

        <!-- Running total -->
        <div class="roi-total mt-6 relative overflow-hidden rounded-2xl border border-border">
          <div class="absolute inset-0 bg-linear-to-r from-destructive/5 via-transparent to-emerald-500/5" />
          <div class="relative flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-10 py-6 px-8">
            <div class="text-center sm:text-right">
              <span class="block text-[10px] font-medium text-muted-foreground mb-2 uppercase tracking-widest">
                {t("pitch.roi.act1.total.label")}
              </span>
              <span class="block text-3xl sm:text-4xl lg:text-5xl font-bold text-destructive line-through decoration-destructive/40 decoration-2 tabular-nums">
                {t("pitch.roi.act1.total.old")}
              </span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-12 h-px bg-muted-foreground/20 hidden sm:block" />
              <svg class="w-5 h-5 text-muted-foreground/40 rotate-90 sm:rotate-0 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
              <div class="w-12 h-px bg-muted-foreground/20 hidden sm:block" />
            </div>
            <div class="text-center sm:text-left">
              <span class="block text-xl sm:text-2xl font-bold text-emerald-600 dark:text-emerald-400">
                {t("pitch.roi.act1.total.new")}
              </span>
              <span class="block text-xs text-muted-foreground mt-1">
                {t("pitch.roi.act1.total.sub")}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── TRANSITION ── -->
  <div class="roi-transition relative py-20 sm:py-28">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <div class="h-px bg-linear-to-r from-transparent via-border to-transparent mb-10" />
      <p class="text-xl sm:text-2xl font-semibold leading-relaxed">
        <span class="text-muted-foreground">{t("pitch.roi.transition.save")}</span>
        {" "}
        <span class="text-foreground">{t("pitch.roi.transition.leverage")}</span>
      </p>
      <div class="h-px bg-linear-to-r from-transparent via-border to-transparent mt-10" />
    </div>
  </div>

  <!-- ── ACT 2 — What you couldn't buy at any price ── -->
  <div class="relative pb-28">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="mb-16 text-center">
        <p class="text-[11px] font-medium tracking-[0.3em] uppercase text-amber-500 mb-4">
          {t("pitch.roi.act2.tagline")}
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">
          {t("pitch.roi.act2.headline")}
        </h2>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto">
          {t("pitch.roi.act2.description")}
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {tiles.map(({ key, accent, initials, stars, installs }, i) => (
          <div
            class="roi-tile group relative rounded-2xl border border-border bg-card p-5 hover:border-primary/30 transition-all hover:shadow-lg hover:shadow-primary/5"
            style={`--tile-delay:${i * 80}ms`}
          >
            {/* Icon */}
            <div class:list={[
              "mb-4 w-10 h-10 rounded-xl flex items-center justify-center",
              accent === "amber"   && "bg-amber-500/10",
              accent === "violet"  && "bg-violet-500/10",
              accent === "emerald" && "bg-emerald-500/10",
              accent === "sky"     && "bg-sky-500/10",
              accent === "rose"    && "bg-rose-500/10",
              accent === "orange"  && "bg-orange-500/10",
            ]}>
              {accent === "amber" && (
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
              {accent === "violet" && (
                <svg class="w-5 h-5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
                </svg>
              )}
              {accent === "emerald" && (
                <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                </svg>
              )}
              {accent === "sky" && (
                <svg class="w-5 h-5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
              )}
              {accent === "rose" && (
                <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                </svg>
              )}
              {accent === "orange" && (
                <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
                </svg>
              )}
            </div>

            {/* Title + description */}
            <h3 class="text-sm font-semibold mb-1.5">{t(`pitch.roi.act2.${key}.title`)}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed mb-4">{t(`pitch.roi.act2.${key}.description`)}</p>

            {/* Social proof footer */}
            <div class="flex items-center justify-between text-xs text-muted-foreground pt-3 border-t border-border/50">
              <div class="flex items-center gap-2">
                <span class:list={[
                  "w-5 h-5 rounded-full flex items-center justify-center text-[9px] font-bold",
                  accent === "amber"   && "bg-amber-500/20 text-amber-600 dark:text-amber-400",
                  accent === "violet"  && "bg-violet-500/20 text-violet-600 dark:text-violet-400",
                  accent === "emerald" && "bg-emerald-500/20 text-emerald-600 dark:text-emerald-400",
                  accent === "sky"     && "bg-sky-500/20 text-sky-600 dark:text-sky-400",
                  accent === "rose"    && "bg-rose-500/20 text-rose-600 dark:text-rose-400",
                  accent === "orange"  && "bg-orange-500/20 text-orange-600 dark:text-orange-400",
                ]}>{initials}</span>
                <span>{t(`pitch.roi.act2.${key}.author`)}</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="flex items-center gap-0.5">
                  <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  {stars}
                </span>
                <span class="flex items-center gap-0.5">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  {installs}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .roi-act1-scroll {
    min-height: 360vh;
  }

  .roi-animated .roi-card {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .roi-animated .roi-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .roi-animated .roi-total {
    opacity: 0;
    transform: scale(0.97);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .roi-animated .roi-total.visible {
    opacity: 1;
    transform: scale(1);
  }

  .roi-animated .roi-tile {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    transition-delay: var(--tile-delay, 0ms);
  }
  .roi-animated .roi-tile.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function initROI() {
    const section = document.getElementById("roi");
    if (!section) return;

    section.classList.add("roi-animated");

    const wrapper = section.querySelector<HTMLElement>(".roi-act1-scroll");
    const cards = section.querySelectorAll<HTMLElement>(".roi-card");
    const total = section.querySelector<HTMLElement>(".roi-total");
    const tiles = section.querySelectorAll<HTMLElement>(".roi-tile");

    if (!wrapper || cards.length === 0) return;

    const totalSteps = cards.length + 1;

    let ticking = false;
    function updateAct1() {
      const rect = wrapper!.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      if (scrollable <= 0) return;

      const progress = Math.max(0, Math.min(1, -rect.top / scrollable));
      const step = 1 / totalSteps;

      cards.forEach((card, i) => {
        if (progress >= step * i) card.classList.add("visible");
      });

      if (progress >= step * cards.length && total) {
        total.classList.add("visible");
      }
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateAct1();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    updateAct1();

    const tileObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add("visible");
            tileObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    tiles.forEach((tile) => tileObserver.observe(tile));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initROI);
  } else {
    initROI();
  }
</script>
