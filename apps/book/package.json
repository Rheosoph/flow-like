	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/source-serif-4": "5.3.0",
		"pdf-lib": "^1.17.1",
		"puppeteer": "24.43.1",
		"typescript": "^5.9.3"
	}
