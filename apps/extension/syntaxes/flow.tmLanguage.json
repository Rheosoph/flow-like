{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "FlowScript",
	"scopeName": "source.flow",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#decorators" },
		{ "include": "#declarations" },
		{ "include": "#keywords" },
		{ "include": "#types" },
		{ "include": "#constants" },
		{ "include": "#strings" },
		{ "include": "#numbers" },
		{ "include": "#function-call" },
		{ "include": "#operators" },
		{ "include": "#object-keys" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.anchor.flow",
					"match": "//@[nvl]:[^\\n]*"
				},
				{
					"name": "comment.line.double-slash.flow",
					"begin": "//",
					"end": "$"
				}
			]
		},
		"decorators": {
			"patterns": [
				{
					"name": "meta.decorator.flow",
					"match": "(@)(secret|readonly|runtime|category|description|schema)\\b",
					"captures": {
						"1": { "name": "punctuation.decorator.flow" },
						"2": { "name": "entity.name.function.decorator.flow" }
					}
				}
			]
		},
		"declarations": {
			"patterns": [
				{
					"match": "\\b(const|let)\\s+([A-Za-z_$][\\w$]*)",
					"captures": {
						"1": { "name": "storage.type.flow" },
						"2": { "name": "variable.other.declaration.flow" }
					}
				},
				{
					"match": "\\b(function)\\s+([A-Za-z_$][\\w$]*)",
					"captures": {
						"1": { "name": "storage.type.function.flow" },
						"2": { "name": "entity.name.function.flow" }
					}
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.flow",
					"match": "\\b(if|else|for|of|return)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "support.type.primitive.flow",
					"match": "\\b(string|int|float|bool|void|Date|Generic|Byte|PathBuf)\\b"
				},
				{
					"name": "support.type.flow",
					"match": "\\b(Struct|Map|Set)\\b"
				},
				{
					"name": "entity.name.type.flow",
					"match": "(?<=:\\s)([A-Z][\\w$]*)"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.flow",
					"match": "\\b(true|false|null)\\b"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.flow",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.flow",
					"match": "\\\\(?:[\"\\\\/nrt]|u[0-9A-Fa-f]{4})"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.float.flow",
					"match": "\\b-?\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
				},
				{
					"name": "constant.numeric.integer.flow",
					"match": "\\b-?\\d+\\b"
				}
			]
		},
		"function-call": {
			"patterns": [
				{
					"match": "([A-Za-z_$][\\w$]*)\\s*(?=\\()",
					"name": "meta.function-call.flow",
					"captures": {
						"1": { "name": "entity.name.function.call.flow" }
					}
				}
			]
		},
		"object-keys": {
			"patterns": [
				{
					"match": "([A-Za-z_$][\\w$]*)\\s*(:)",
					"captures": {
						"1": { "name": "variable.parameter.flow" },
						"2": { "name": "punctuation.separator.key-value.flow" }
					}
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.comparison.flow",
					"match": "===|!==|==|!=|>=|<=|>|<"
				},
				{
					"name": "keyword.operator.logical.flow",
					"match": "&&|\\|\\||!"
				},
				{
					"name": "keyword.operator.arithmetic.flow",
					"match": "\\+|-|\\*|/|%"
				},
				{
					"name": "keyword.operator.assignment.flow",
					"match": "="
				},
				{
					"name": "keyword.operator.ternary.flow",
					"match": "\\?"
				}
			]
		}
	}
}
