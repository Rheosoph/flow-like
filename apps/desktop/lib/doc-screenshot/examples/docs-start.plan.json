{
	"schema": "flow-like.doc-screenshot-plan/v1",
	"app": "desktop",
	"outputDir": "apps/docs/src/assets",
	"tauriFixture": "../fixtures/docs-start.tauri.json",
	"defaults": {
		"viewport": {
			"width": 1624,
			"height": 1060,
			"deviceScaleFactor": 2
		},
		"theme": "dark",
		"format": "webp",
		"timeoutMs": 300000,
		"settleMs": 350,
		"disableAnimations": true,
		"hideScrollbars": true
	},
	"scenarios": [
		{
			"name": "first-use",
			"path": "/onboarding",
			"query": {
				"capture": "docs"
			},
			"localStorage": {
				"sidebar_state": "true",
				"developer-mode": "{\"state\": {\"localValue\": true, \"pendingSync\": false}, \"version\": 0}"
			},
			"steps": [
				{
					"type": "waitFor",
					"selector": "button[aria-pressed]",
					"state": "visible"
				},
				{
					"type": "click",
					"selector": "button[aria-pressed]",
					"index": 0
				},
				{
					"type": "waitFor",
					"selector": "button[aria-pressed=\"true\"]",
					"state": "visible"
				},
				{
					"type": "capture",
					"name": "selecting-first-profile",
					"output": "SelectingFirstProfile.webp",
					"mode": "viewport"
				},
				{
					"type": "goto",
					"path": "/onboarding/download",
					"query": {
						"profiles": "starter-chatting",
						"capture": "docs"
					}
				},
				{
					"type": "waitFor",
					"text": "Great Selection!"
				},
				{
					"type": "delay",
					"ms": 2200
				},
				{
					"type": "capture",
					"name": "loading-first-models",
					"output": "LoadingFirstModels.webp",
					"mode": "viewport",
					"hideSelectors": ["[data-sonner-toaster]"]
				}
			],
			"diagnosticAllowlist": [
				{
					"kind": "console",
					"message": "Error invoking backend function: Error: Profile or auth context not available",
					"reason": "The synthetic profile is signed out. The account information query is unavailable; the documented local workspace is asserted separately.",
					"maxCount": 8
				},
				{
					"kind": "request",
					"message": "GET /placeholder.webp: net::ERR_ABORTED",
					"reason": "The local placeholder thumbnail is cancelled when the synthetic profile image replaces it. The capture waits for the populated screen.",
					"maxCount": 2
				}
			]
		},
		{
			"name": "home-and-profile-menu",
			"path": "/",
			"query": {
				"capture": "docs"
			},
			"localStorage": {
				"sidebar_state": "true",
				"tutorial-finished-new": "true",
				"developer-mode": "{\"state\": {\"localValue\": true, \"pendingSync\": false}, \"version\": 0}"
			},
			"steps": [
				{
					"type": "waitFor",
					"selector": "button[aria-label=\"Customize\"]:not(:disabled)",
					"state": "visible"
				},
				{
					"type": "hover",
					"selector": "[data-home-controls]"
				},
				{
					"type": "delay",
					"ms": 350
				},
				{
					"type": "capture",
					"name": "landing-page",
					"output": "LandingPage.webp",
					"mode": "viewport"
				},
				{
					"type": "click",
					"selector": "button[data-sidebar=\"menu-button\"][data-size=\"lg\"]"
				},
				{
					"type": "waitFor",
					"selector": "[data-slot=\"dropdown-menu-content\"][data-state=\"open\"]",
					"state": "visible"
				},
				{
					"type": "capture",
					"name": "switch-and-edit-profiles",
					"output": "SwitchAndEditProfiles.webp",
					"mode": "element",
					"selector": "[data-slot=\"dropdown-menu-content\"][data-state=\"open\"]",
					"padding": 12
				}
			],
			"diagnosticAllowlist": [
				{
					"kind": "console",
					"message": "Error invoking backend function: Error: Profile or auth context not available",
					"reason": "The synthetic profile is signed out. The account information query is unavailable; the documented local workspace is asserted separately.",
					"maxCount": 12
				},
				{
					"kind": "request",
					"message": "GET /placeholder.webp: net::ERR_ABORTED",
					"reason": "The local placeholder thumbnail is cancelled when the synthetic profile image replaces it. The capture waits for the populated screen.",
					"maxCount": 2
				}
			]
		},
		{
			"name": "profile-settings",
			"path": "/settings/profiles",
			"query": {
				"capture": "docs"
			},
			"localStorage": {
				"sidebar_state": "true",
				"tutorial-finished-new": "true",
				"developer-mode": "{\"state\": {\"localValue\": true, \"pendingSync\": false}, \"version\": 0}"
			},
			"steps": [
				{
					"type": "waitFor",
					"selector": "#workspace-profile-name",
					"state": "visible"
				},
				{
					"type": "capture",
					"name": "ProfileSettings",
					"mode": "viewport"
				}
			],
			"diagnosticAllowlist": [
				{
					"kind": "console",
					"message": "Error invoking backend function: Error: Profile or auth context not available",
					"reason": "The synthetic profile is signed out. The account information query is unavailable; the documented local workspace is asserted separately.",
					"maxCount": 12
				},
				{
					"kind": "request",
					"message": "GET /placeholder.webp: net::ERR_ABORTED",
					"reason": "The local placeholder thumbnail is cancelled when the synthetic profile image replaces it. The capture waits for the populated screen.",
					"maxCount": 2
				}
			]
		},
		{
			"name": "customize-home",
			"path": "/",
			"query": {
				"capture": "docs"
			},
			"localStorage": {
				"tutorial-finished-new": "true",
				"sidebar_state": "true"
			},
			"steps": [
				{
					"type": "waitFor",
					"selector": "button[aria-label=\"Customize\"]:not(:disabled)",
					"state": "visible"
				},
				{
					"type": "hover",
					"selector": "[data-home-controls]"
				},
				{
					"type": "delay",
					"ms": 350
				},
				{
					"type": "click",
					"selector": "button[aria-label=\"Customize\"]"
				},
				{
					"type": "waitFor",
					"selector": "input[aria-label=\"Search widgets\"]",
					"state": "visible"
				},
				{
					"type": "capture",
					"name": "HomeWidgets",
					"output": "HomeWidgets.webp",
					"mode": "viewport"
				},
				{
					"type": "click",
					"selector": "button[aria-label=\"Close widget panel\"]"
				},
				{
					"type": "waitFor",
					"selector": "button[aria-label=\"Add widget\"]",
					"state": "visible"
				},
				{
					"type": "capture",
					"name": "HomeCustomize",
					"output": "HomeCustomize.webp",
					"mode": "viewport"
				}
			],
			"diagnosticAllowlist": [
				{
					"kind": "console",
					"message": "Error invoking backend function: Error: Profile or auth context not available",
					"reason": "The synthetic profile is signed out. The account information query is unavailable; the documented local workspace is asserted separately.",
					"maxCount": 8
				},
				{
					"kind": "request",
					"message": "GET /placeholder.webp: net::ERR_ABORTED",
					"reason": "The local placeholder thumbnail is cancelled when the synthetic profile image replaces it. The capture waits for the populated screen.",
					"maxCount": 2
				}
			]
		}
	],
	"httpFixture": "../fixtures/docs-account.http.json"
}
