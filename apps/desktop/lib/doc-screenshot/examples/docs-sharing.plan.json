{
	"schema": "flow-like.doc-screenshot-plan/v1",
	"app": "desktop",
	"outputDir": "apps/docs/src/assets",
	"tauriFixture": "../fixtures/docs-sharing.tauri.json",
	"defaults": {
		"viewport": {
			"width": 1624,
			"height": 1060,
			"deviceScaleFactor": 2
		},
		"theme": "dark",
		"format": "webp",
		"timeoutMs": 300000,
		"settleMs": 500,
		"disableAnimations": true,
		"hideScrollbars": true
	},
	"scenarios": [
		{
			"name": "visibility",
			"path": "/library/config",
			"query": {
				"id": "docs-app",
				"capture": "docs"
			},
			"steps": [
				{
					"type": "waitFor",
					"text": "Customer Support Copilot"
				},
				{
					"type": "click",
					"selector": "main button:has(svg.lucide-settings)"
				},
				{
					"type": "waitFor",
					"text": "Visibility Status"
				},
				{
					"type": "capture",
					"name": "AppVisibilitySettings",
					"mode": "element",
					"selector": "[data-slot=\"sheet-content\"]",
					"padding": 0
				}
			],
			"localStorage": {
				"developer-mode": "{\"state\": {\"localValue\": true, \"pendingSync\": false}, \"version\": 0}",
				"oidc.user:https://docs-auth.example:docs-capture": "{\"access_token\": \"documentation-fixture-access-token\", \"id_token\": \"documentation-fixture-id-token\", \"token_type\": \"Bearer\", \"scope\": \"openid profile\", \"profile\": {\"sub\": \"docs-user\", \"name\": \"Documentation\"}, \"expires_at\": 4102444800}"
			},
			"diagnosticAllowlist": [
				{
					"kind": "console",
					"message": "Error invoking backend function: Error: Profile or auth context not available",
					"reason": "The synthetic profile is signed out. The account information query is unavailable; the documented local workspace is asserted separately.",
					"maxCount": 4
				},
				{
					"kind": "request",
					"message": "GET /placeholder.webp: net::ERR_ABORTED",
					"reason": "The local placeholder thumbnail is cancelled when the synthetic profile image replaces it. The capture waits for the populated screen.",
					"maxCount": 2
				}
			]
		},
		{
			"name": "team-access",
			"path": "/library/config/team",
			"query": {
				"id": "docs-app",
				"capture": "docs"
			},
			"steps": [
				{
					"type": "waitFor",
					"selector": "h1::-p-text(Access)",
					"state": "visible"
				},
				{
					"type": "click",
					"selector": "nav[aria-label=\"Access sections\"] > div:first-child button",
					"index": 2
				},
				{
					"type": "waitFor",
					"text": "Invite links"
				},
				{
					"type": "capture",
					"name": "ShareApps",
					"mode": "viewport"
				}
			],
			"localStorage": {
				"developer-mode": "{\"state\": {\"localValue\": true, \"pendingSync\": false}, \"version\": 0}",
				"oidc.user:https://docs-auth.example:docs-capture": "{\"access_token\": \"documentation-fixture-access-token\", \"id_token\": \"documentation-fixture-id-token\", \"token_type\": \"Bearer\", \"scope\": \"openid profile\", \"profile\": {\"sub\": \"docs-user\", \"name\": \"Documentation\"}, \"expires_at\": 4102444800}"
			},
			"diagnosticAllowlist": [
				{
					"kind": "console",
					"message": "Error invoking backend function: Error: Profile or auth context not available",
					"reason": "The synthetic profile is signed out. The account information query is unavailable; the documented local workspace is asserted separately.",
					"maxCount": 4
				},
				{
					"kind": "request",
					"message": "GET /placeholder.webp: net::ERR_ABORTED",
					"reason": "The local placeholder thumbnail is cancelled when the synthetic profile image replaces it. The capture waits for the populated screen.",
					"maxCount": 2
				},
				{
					"kind": "request",
					"message": "GET https://api.flow-like.com/api/v1: net::ERR_ABORTED",
					"reason": "The hub hook aborts its first fixture-backed request when the synthetic authenticated profile scope settles; the replacement request renders Access successfully.",
					"maxCount": 2
				}
			]
		}
	],
	"httpFixture": "../fixtures/docs-account.http.json"
}
