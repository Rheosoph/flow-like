{
	"schema": "flow-like.doc-screenshot-plan/v1",
	"app": "desktop",
	"outputDir": "apps/docs/src/assets",
	"tauriFixture": "../fixtures/docs-runs.tauri.json",
	"defaults": {
		"viewport": {
			"width": 1624,
			"height": 1060,
			"deviceScaleFactor": 2
		},
		"theme": "dark",
		"format": "webp",
		"timeoutMs": 300000,
		"settleMs": 600,
		"disableAnimations": true,
		"hideScrollbars": true
	},
	"scenarios": [
		{
			"name": "runs-and-logs",
			"path": "/flow",
			"query": {
				"app": "docs-app",
				"id": "docs-board"
			},
			"localStorage": {
				"tutorial-finished-new": "true",
				"developer-mode": "{\"state\": {\"localValue\": true, \"pendingSync\": false}, \"version\": 0}"
			},
			"steps": [
				{
					"type": "waitFor",
					"selector": ".react-flow__pane",
					"state": "visible",
					"timeoutMs": 300000
				},
				{
					"type": "waitFor",
					"selector": ".react-flow__node",
					"state": "visible",
					"timeoutMs": 300000
				},
				{
					"type": "click",
					"selector": "nav[aria-label=\"Board surfaces\"] button[aria-label=\"Run History\"]"
				},
				{
					"type": "waitFor",
					"selector": "nav[aria-label=\"Board surfaces\"] button[aria-label=\"Run History\"][aria-pressed=\"true\"]",
					"state": "visible",
					"timeoutMs": 15000
				},
				{
					"type": "waitFor",
					"selector": "#board-panel span[title=\"Local execution\"]",
					"state": "visible",
					"timeoutMs": 15000
				},
				{
					"type": "click",
					"selector": "#board-panel span[title=\"Local execution\"]"
				},
				{
					"type": "waitFor",
					"selector": "nav[aria-label=\"Board surfaces\"] button[aria-label=\"Logs\"][aria-pressed=\"true\"]",
					"state": "visible",
					"timeoutMs": 15000
				},
				{
					"type": "waitFor",
					"selector": "#board-panel section[aria-label=\"Logs\"]",
					"state": "visible",
					"timeoutMs": 20000
				},
				{
					"type": "waitFor",
					"text": "Received onboarding request",
					"timeoutMs": 20000
				},
				{
					"type": "capture",
					"name": "RunsAndLogs",
					"output": "RunsAndLogs.webp",
					"mode": "viewport",
					"hideSelectors": [
						"[data-slot=\"tooltip-content\"]"
					]
				}
			],
			"diagnosticAllowlist": [
				{
					"kind": "console",
					"message": "Error invoking backend function: Error: Profile or auth context not available",
					"reason": "The synthetic profile is signed out. The account information query is unavailable; the documented local workspace is asserted separately.",
					"maxCount": 4
				},
				{
					"kind": "request",
					"message": "GET /placeholder.webp: net::ERR_ABORTED",
					"reason": "The local placeholder thumbnail is cancelled when the synthetic profile image replaces it. The capture waits for the populated screen.",
					"maxCount": 2
				}
			]
		}
	]
}
