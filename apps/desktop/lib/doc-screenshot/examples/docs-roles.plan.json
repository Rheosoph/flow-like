{
	"schema": "flow-like.doc-screenshot-plan/v1",
	"app": "desktop",
	"outputDir": "apps/docs/src/assets",
	"tauriFixture": "../fixtures/docs-roles.tauri.json",
	"defaults": {
		"viewport": {
			"width": 1624,
			"height": 1060,
			"deviceScaleFactor": 2
		},
		"theme": "dark",
		"format": "webp",
		"timeoutMs": 120000,
		"settleMs": 500,
		"disableAnimations": true,
		"hideScrollbars": true
	},
	"scenarios": [
		{
			"name": "roles",
			"path": "/library/config/roles",
			"query": {
				"id": "docs-app",
				"capture": "docs"
			},
			"steps": [
				{
					"type": "waitFor",
					"selector": "input[placeholder=\"Search roles...\"]",
					"state": "visible"
				},
				{
					"type": "click",
					"selector": "div.flex.flex-col.h-full.max-h-full.overflow-hidden.gap-4.p-4 > div:first-child button"
				},
				{
					"type": "waitFor",
					"selector": "input[placeholder=\"e.g. Editor, Viewer...\"]",
					"state": "visible"
				},
				{
					"type": "fill",
					"selector": "input[placeholder=\"e.g. Editor, Viewer...\"]",
					"value": "Support Specialist"
				},
				{
					"type": "capture",
					"name": "RightsAndRoles",
					"mode": "viewport"
				}
			]
		}
	]
}
