{
    "identifier": "com.flow-like.app",
    "build": {
        "beforeDevCommand": "bun ./scripts/prepare-mlx.ts --configuration Debug && bun run dev",
        "beforeBuildCommand": "bun ./scripts/prepare-mlx.ts --configuration Release && bun run build"
    },
    "bundle": {
        "externalBin": [
            "binaries/mac/arm/libggml-base.dylib",
            "binaries/mac/arm/libggml-blas.dylib",
            "binaries/mac/arm/libggml-cpu.dylib",
            "binaries/mac/arm/libggml-metal.dylib",
            "binaries/mac/arm/libggml-rpc.dylib",
            "binaries/mac/arm/libggml.dylib",
            "binaries/mac/arm/libllama.dylib",
            "binaries/mac/arm/libmtmd.dylib",
            "binaries/mac/arm/llama-server",
            "binaries/mac/arm/flow-like-mlx-service"
        ],
        "resources": {
            "icons/Assets.car": "Assets.car",
            "assets/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
            "binaries/mac/arm/mlx-resources/": ""
        }
    }
}
