<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bot_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/native_widget_background"
    android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="10dp"
            android:background="@drawable/native_widget_logo" android:padding="3dp" android:src="@drawable/ic_notification"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/bot_widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            style="@style/FlowLikeWidgetTitle" android:text="Flow-Like" android:maxLines="2" android:ellipsize="end" />
        <ImageButton android:id="@+id/bot_widget_configure" android:layout_width="48dp" android:layout_height="48dp"
            android:contentDescription="Configure widget" android:padding="13dp" android:src="@drawable/native_widget_settings"
            android:background="@drawable/native_widget_action" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bot_widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <ImageView android:id="@+id/bot_widget_image" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scaleType="fitCenter" android:visibility="gone" />
    <TextView android:id="@+id/bot_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        style="@style/FlowLikeWidgetCaption" android:paddingTop="8dp" android:text="Choose widget content"
        android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
