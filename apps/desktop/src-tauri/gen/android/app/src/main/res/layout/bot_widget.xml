<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bot_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="#202026">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/bot_widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Flow-Like" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/bot_widget_configure" android:layout_width="36dp" android:layout_height="36dp"
            android:text="⚙" android:contentDescription="Configure widget" android:gravity="center" android:textColor="#BBBBCC" android:textSize="20sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bot_widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <ImageView android:id="@+id/bot_widget_image" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scaleType="fitCenter" android:visibility="gone" />
    <TextView android:id="@+id/bot_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="4dp" android:text="Choose widget content" android:textColor="#BBBBCC" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
