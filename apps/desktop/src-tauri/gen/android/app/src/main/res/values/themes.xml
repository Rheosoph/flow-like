<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.flow_like_desktop" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/setup_background</item>
        <item name="android:fontFamily">@font/flow_inter_regular</item>
        <item name="fontFamily">@font/flow_inter_regular</item>
        <item name="colorPrimary">@color/setup_accent</item>
        <item name="colorPrimaryVariant">@color/setup_accent</item>
        <item name="colorSecondary">@color/setup_accent</item>
        <item name="colorOnPrimary">@color/setup_on_accent</item>
        <item name="colorSurface">@color/setup_surface</item>
        <item name="colorOnSurface">@color/setup_text</item>
        <item name="android:colorAccent">@color/setup_accent</item>
        <item name="android:textColorPrimary">@color/setup_text</item>
        <item name="android:textColorSecondary">@color/setup_muted</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FlowLike.AlertDialog</item>
    </style>
    <style name="Theme.FlowLike.NativeDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:fontFamily">@font/flow_inter_regular</item>
        <item name="fontFamily">@font/flow_inter_regular</item>
        <item name="colorPrimary">@color/setup_accent</item>
        <item name="colorSecondary">@color/setup_accent</item>
        <item name="colorSurface">@color/setup_surface</item>
        <item name="colorOnSurface">@color/setup_text</item>
    </style>
    <style name="ThemeOverlay.FlowLike.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:fontFamily">@font/flow_inter_regular</item>
        <item name="fontFamily">@font/flow_inter_regular</item>
        <item name="colorPrimary">@color/setup_accent</item>
        <item name="colorSecondary">@color/setup_accent</item>
        <item name="colorSurface">@color/setup_surface</item>
        <item name="colorOnSurface">@color/setup_text</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FlowLike.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.FlowLike.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.FlowLike.DialogBody</item>
        <item name="textAppearanceButton">@style/TextAppearance.FlowLike.DialogButton</item>
        <item name="buttonBarButtonStyle">@style/Widget.FlowLike.DialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.FlowLike.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.FlowLike.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.FlowLike.DialogButton.Neutral</item>
    </style>
    <style name="ShapeAppearance.FlowLike.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="TextAppearance.FlowLike.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:fontFamily">@font/flow_inter_medium</item>
        <item name="fontFamily">@font/flow_inter_medium</item>
        <item name="android:textColor">@color/setup_text</item>
    </style>
    <style name="TextAppearance.FlowLike.DialogBody" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:fontFamily">@font/flow_inter_regular</item>
        <item name="fontFamily">@font/flow_inter_regular</item>
        <item name="android:textColor">@color/setup_muted</item>
    </style>
    <style name="TextAppearance.FlowLike.DialogButton" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/flow_inter_medium</item>
        <item name="fontFamily">@font/flow_inter_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.FlowLike.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/flow_inter_medium</item>
        <item name="fontFamily">@font/flow_inter_medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.FlowLike.DialogButton.Neutral" parent="Widget.FlowLike.DialogButton">
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginLeft">0dp</item>
    </style>
</resources>
