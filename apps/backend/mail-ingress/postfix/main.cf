compatibility_level = 3.6
inet_interfaces = all
inet_protocols = ipv4
mydestination =
myorigin = $myhostname
mynetworks = 127.0.0.0/8
relay_domains =
relay_recipient_maps = socketmap:inet:mail-ingress:2526:recipients
relay_transport = lmtp:inet:mail-ingress:2525
smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = reject_unlisted_recipient
smtpd_reject_unlisted_recipient = yes
disable_vrfy_command = yes
smtpd_helo_required = yes
smtputf8_enable = no
smtpd_tls_security_level = may
smtpd_tls_cert_file = /run/secrets/mail_tls_certificate
smtpd_tls_key_file = /run/secrets/mail_tls_key
smtpd_tls_loglevel = 1
smtp_tls_security_level = may
message_size_limit = 10485760
smtpd_recipient_limit = 100
smtpd_client_connection_count_limit = 20
# Per client IP address within each anvil_rate_time_unit.
anvil_rate_time_unit = 60s
smtpd_client_connection_rate_limit = 60
smtpd_client_message_rate_limit = 60
smtpd_client_recipient_rate_limit = 200
smtpd_timeout = 60s
lmtp_destination_concurrency_limit = 10
lmtp_data_done_timeout = 120s
maximal_queue_lifetime = 1d
bounce_queue_lifetime = 1d
minimal_backoff_time = 60s
maximal_backoff_time = 15m
queue_run_delay = 60s
maillog_file = /dev/stdout
enable_long_queue_ids = yes
# Preserve the recipient and Postfix Received header for stable ingestion IDs.
local_header_rewrite_clients =
