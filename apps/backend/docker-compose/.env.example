# =============================================================================
# Flow-Like Docker Compose Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=flowlike
POSTGRES_PASSWORD=flowlike_dev_change_me
POSTGRES_DB=flowlike
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full DATABASE_URL (auto-constructed in docker-compose)
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Redis Configuration (Execution State + Job Queue)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Full REDIS_URL (auto-constructed in docker-compose)
# REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# Execution state backend: postgres, redis
# Redis is recommended for Docker Compose (native TTL, fast polling)
EXECUTION_STATE_BACKEND=redis
# TTL for execution state entries (default: 24 hours)
EXECUTION_STATE_TTL_SECONDS=86400

# Flow key/value cache backend: postgres, redis
# Redis is recommended here too (native TTL, no sweeper needed)
CACHE_BACKEND=redis
# Defaults to REDIS_URL when unset
# CACHE_REDIS_URL=redis://redis:6379
# 0 keeps entries until a flow deletes them
CACHE_DEFAULT_TTL_SECONDS=0

# -----------------------------------------------------------------------------
# Storage Provider Configuration
# -----------------------------------------------------------------------------
# Options: aws, azure, gcp
STORAGE_PROVIDER=aws
# Optional runtime-credential override. Usually omit it so runtime credentials
# follow STORAGE_PROVIDER. Use r2 for Cloudflare's temporary-credentials API
# while keeping the primary object-store protocol S3-compatible.
RUNTIME_CREDENTIALS_PROVIDER=

# Bucket/Container names (generic - works across all providers)
META_BUCKET=flow-like-meta
CONTENT_BUCKET=flow-like-content
LOG_BUCKET=flow-like-logs
# Optional public/CDN bucket. Falls back to CONTENT_BUCKET when empty/unset.
CDN_BUCKET_NAME=

# -----------------------------------------------------------------------------
# AWS S3 Configuration (when STORAGE_PROVIDER=aws)
# -----------------------------------------------------------------------------
# Authentication options:
#
# Option 1: Static credentials (for local dev, MinIO, R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: session token (for temporary credentials from STS AssumeRole)
# AWS_SESSION_TOKEN=
#
# Option 2: IAM Instance Role (on EC2/ECS - automatic, no env vars needed)
# Option 3: IRSA/Web Identity (on EKS - set AWS_WEB_IDENTITY_TOKEN_FILE + AWS_ROLE_ARN)
# AWS_WEB_IDENTITY_TOKEN_FILE=/var/run/secrets/eks.amazonaws.com/serviceaccount/token
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/FlowLikeRole
#
# Endpoint configuration
# For AWS S3: leave empty to use defaults
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# For MinIO: http://minio:9000
AWS_ENDPOINT=
AWS_REGION=us-east-1
# Set to true for MinIO, R2, or other S3-compatible stores
AWS_USE_PATH_STYLE=true

# Role ARN for scoped credentials (required for per-user/per-app isolated S3 prefixes)
# This role will be assumed via STS to generate short-lived scoped credentials
# Example: arn:aws:iam::123456789012:role/FlowLikeRuntimeRole
RUNTIME_ROLE_ARN=

# Provider-specific bucket overrides (optional)
# AWS_META_BUCKET=
# AWS_CONTENT_BUCKET=
# AWS_LOG_BUCKET=

# -----------------------------------------------------------------------------
# Cloudflare R2 Runtime Credentials
# -----------------------------------------------------------------------------
# For R2, keep STORAGE_PROVIDER=aws for the S3-compatible primary store and set
# RUNTIME_CREDENTIALS_PROVIDER=r2. Reuse the R2 S3 keys in AWS_* above, then
# configure the temporary-credentials API here.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_API_TOKEN=

# -----------------------------------------------------------------------------
# Azure Blob Storage Configuration (when STORAGE_PROVIDER=azure)
# -----------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# Provider-specific container overrides (optional)
# AZURE_META_CONTAINER=
# AZURE_CONTENT_CONTAINER=
# AZURE_LOG_CONTAINER=

# -----------------------------------------------------------------------------
# GCP Cloud Storage Configuration (when STORAGE_PROVIDER=gcp)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=
# Base64-encoded or raw service account JSON
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Provider-specific bucket overrides (optional)
# GCP_META_BUCKET=
# GCP_CONTENT_BUCKET=
# GCP_LOG_BUCKET=

# -----------------------------------------------------------------------------
# API Service Configuration
# -----------------------------------------------------------------------------
DB_INIT_IMAGE=flow-like-db-init:latest
API_IMAGE=flow-like-api:latest
API_HOST=0.0.0.0
API_PORT=8080
API_REPLICAS=2
RUST_LOG=info,docker_compose_api=debug

# Compile-time hub config embedded into the API image. The default points at the
# self-hosted docker-compose template. Set this to a file inside the build
# context if you maintain a custom hub config.
FLOW_LIKE_CONFIG=apps/backend/docker-compose/flow-like.config.example.json
# Runtime hub config consumed by sink-services.
FLOW_LIKE_RUNTIME_CONFIG_FILE=./flow-like.config.example.json

# -----------------------------------------------------------------------------
# Web Application Configuration
# -----------------------------------------------------------------------------
WEB_IMAGE=flow-like-web:latest
WEB_PORT=3001
# URL the web app uses to connect to the API (from browser perspective)
NEXT_PUBLIC_API_URL=http://localhost:8080
# OAuth redirect URLs (adjust domain/port for your environment)
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3001/callback
NEXT_PUBLIC_REDIRECT_LOGOUT_URL=http://localhost:3001/

# -----------------------------------------------------------------------------
# Realtime Collaboration
# -----------------------------------------------------------------------------
# MIGRATION (existing stacks): this release makes BACKEND_PUB and
# REALTIME_ALLOWED_ORIGINS REQUIRED at signaling boot — the container
# crashloops when either is empty (BACKEND_PUB was previously optional).
# Tauri desktop clients additionally need the exact literals
# tauri://localhost,http://tauri.localhost,https://tauri.localhost appended to
# REALTIME_ALLOWED_ORIGINS. Local-only escape hatch:
# SIGNALING_NODE_ENV=development plus REALTIME_ALLOW_INSECURE_LOCAL_DEV=true.
SIGNALING_IMAGE=flow-like-signaling:latest
SIGNALING_PORT=4444

# REQUIRED: the signaling container refuses to start in authenticated mode
# (the compose default, NODE_ENV=production) when BACKEND_PUB (see "Backend JWT
# Configuration" below) or REALTIME_ALLOWED_ORIGINS is empty.
#
# Comma-separated, exact browser origins allowed to open realtime connections.
# List every origin that serves the web app. The Tauri desktop app additionally
# needs the exact literals tauri://localhost, http://tauri.localhost and
# https://tauri.localhost. No wildcards.
#   Local compose (web app on port 3001): http://localhost:3001
#   With desktop clients: http://localhost:3001,tauri://localhost,http://tauri.localhost,https://tauri.localhost
REALTIME_ALLOWED_ORIGINS=http://localhost:3001

# Maximum concurrent signaling connections per authenticated user (token sub).
# Leave empty for the server default of 16.
REALTIME_MAX_CONNECTIONS_PER_SUB=

# For a deliberately unauthenticated local protocol test only, switch the
# signaling container to development mode and opt in explicitly:
#   SIGNALING_NODE_ENV=development
#   REALTIME_ALLOW_INSECURE_LOCAL_DEV=true
SIGNALING_NODE_ENV=production
REALTIME_ALLOW_INSECURE_LOCAL_DEV=false

# -----------------------------------------------------------------------------
# Runtime Execution Configuration
# -----------------------------------------------------------------------------
RUNTIME_IMAGE=flow-like-runtime:latest
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=9000
RUNTIME_REPLICAS=3

# Maximum concurrent executions per runtime instance
MAX_CONCURRENT_EXECUTIONS=10
# Execution timeout in seconds
EXECUTION_TIMEOUT_SECONDS=3600

# -----------------------------------------------------------------------------
# Execution Dispatch Configuration
# -----------------------------------------------------------------------------
# Backend for dispatching executions: http, redis
#   http  - Synchronous HTTP calls to EXECUTOR_URL (simpler, lower latency)
#   redis - Async queue via Redis LPUSH (better for streaming, retry support)
EXECUTION_BACKEND=http
ASYNC_EXECUTION_BACKEND=redis

# HTTP executor URL (when EXECUTION_BACKEND=http)
EXECUTOR_URL=http://runtime:9000

# Redis queue name (when EXECUTION_BACKEND=redis)
REDIS_EXECUTION_QUEUE=exec:jobs

# -----------------------------------------------------------------------------
# WASM Compilation Configuration
# -----------------------------------------------------------------------------
# Backend: http (dedicated compiler service) or redis (queue). The API never
# compiles or instantiates WASM itself, so one of these must be reachable for
# package publishing to work.
COMPILATION_BACKEND=http
# Compiler HTTP URL (when COMPILATION_BACKEND=http)
COMPILER_URL=http://compiler:8081
# API base URL for compilation callbacks
API_BASE_URL=http://api:8080
# Comma-separated compilation targets, e.g.: linux-x86_64,linux-aarch64
WASM_COMPILATION_TARGETS=
# Storage origins the compiler will accept signed URLs from, comma-separated.
# Public AWS S3, Azure Blob and GCS need no entry. Required for EVERY other
# S3-compatible endpoint (Cloudflare R2, MinIO, Ceph, Wasabi): all of them are
# configured as the AWS store and are therefore signed as S3, so the compiler
# holds them to the public AWS S3 host rules and rejects them without an entry.
# Set this whenever AWS_ENDPOINT above points somewhere other than AWS S3.
#
# A bare host means HTTPS on 443; a full origin pins scheme and port. Matching
# is exact on scheme+host+port - no wildcards, no suffix matching.
#   # Cloudflare R2 (host of AWS_ENDPOINT, no scheme; keep AWS_USE_PATH_STYLE=true)
#   COMPILER_ALLOWED_STORAGE_HOSTS=<account-id>.r2.cloudflarestorage.com
#   # Self-hosted MinIO on plaintext inside the compose network
#   COMPILER_ALLOWED_STORAGE_HOSTS=http://minio:9000
#
# The endpoint must be a hostname. An IP literal is rejected before the
# allowlist is consulted, so http://127.0.0.1:9000 never works - use the
# compose service name.
#
# SECURITY: a single http:// entry disables HTTPS-only enforcement on the
# compiler's storage HTTP client process-wide, not just for that origin. Each
# URL is still origin-checked and redirects stay disabled, but the transport
# backstop is gone. Use http only on a trusted, non-routable network.
#
# Missing/wrong entries fail every external compilation with an error naming the
# origin to add: "signed S3 URL origin <origin> is not an approved endpoint".
# See packages/compiler/README.md for the full operator guide.
COMPILER_ALLOWED_STORAGE_HOSTS=

# Compiler service settings
COMPILER_IMAGE=flow-like-compiler:latest
COMPILER_PORT=8081
COMPILER_METRICS_PORT=9092
COMPILER_TIMEOUT_SECS=600
COMPILER_CALLBACK_TIMEOUT_MS=10000
COMPILER_CALLBACK_RETRIES=3
# Leave empty to use all CPU cores
COMPILER_MAX_PARALLEL_TARGETS=

# -----------------------------------------------------------------------------
# Queue Worker Configuration (Runtime Service)
# -----------------------------------------------------------------------------
# Enable queue worker mode (polls Redis for jobs)
# When true, the runtime will poll the Redis queue in addition to serving HTTP
QUEUE_WORKER_ENABLED=true

# Concurrency for queue worker (independent of MAX_CONCURRENT_EXECUTIONS)
# Defaults to MAX_CONCURRENT_EXECUTIONS if not set
QUEUE_WORKER_CONCURRENCY=10

# Poll timeout for BRPOP in seconds (0 = block indefinitely)
QUEUE_POLL_TIMEOUT_SECS=30

# -----------------------------------------------------------------------------
# Backend JWT Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Generate these from this directory using: ../../../tools/gen-execution-keys.sh --export
#
# These keys enable stateless trust between API and all backend services.
# A single keypair is used for all token types: executor, user polling, realtime.
# The token type is embedded in the JWT claims (typ field).
#
# IMPORTANT: Only the API needs the private key (BACKEND_KEY).
# Executors only need the public key (BACKEND_PUB) or can fetch it from the API.
#
# BACKEND_KEY: Base64-encoded PEM private key (ES256) - API only
# BACKEND_PUB: Base64-encoded PEM public key (ES256) - Optional for executors
# BACKEND_KID: Key identifier for JWKS

BACKEND_KEY=
BACKEND_PUB=
BACKEND_KID=backend-es256-v1

# Sink service auth (required for cron/discord/telegram service-to-service calls)
# 1. Set SINK_SECRET to a high-entropy shared secret.
# 2. Generate SINK_TRIGGER_JWT with:
#    bun run ../../../tools/gen-sink-jwt.ts --type cron --secret "$SINK_SECRET"
SINK_SERVICES_IMAGE=flow-like-sink-services:latest
SINK_SECRET=
SINK_TRIGGER_JWT=
SINK_TOKEN_ENCRYPTION_KEY=

# API URL for executors to fetch JWKS if BACKEND_PUB is not set
# This allows zero-config secure JWT verification for executors
API_URL=http://api:8080

# -----------------------------------------------------------------------------
# LLM / Model Provider Configuration
# -----------------------------------------------------------------------------
# The backend can proxy LLM requests through various hosted providers.
# Models are defined as "Bits" in the database, each referencing a provider.
#
# Supported providers (set in Bit's provider_name field):
#   - hosted / hosted:openrouter  → Routes to OpenRouter
#   - hosted:openai               → Routes to OpenAI
#   - hosted:anthropic            → Routes to Anthropic
#   - hosted:azure                → Routes to Azure OpenAI
#   - hosted:bedrock              → Routes to AWS Bedrock
#   - hosted:vertex               → Routes to Google Vertex AI

# OpenRouter (default for "hosted" provider)
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api

# OpenAI
HOSTED_OPENAI_API_KEY=
HOSTED_OPENAI_ENDPOINT=https://api.openai.com

# Anthropic
HOSTED_ANTHROPIC_API_KEY=
HOSTED_ANTHROPIC_ENDPOINT=https://api.anthropic.com

# Azure OpenAI (endpoint includes your resource name)
HOSTED_AZURE_API_KEY=
HOSTED_AZURE_ENDPOINT=

# AWS Bedrock (uses AWS credentials from storage config above)
HOSTED_BEDROCK_ENDPOINT=

# Google Vertex AI
HOSTED_VERTEX_API_KEY=
HOSTED_VERTEX_ENDPOINT=

# -----------------------------------------------------------------------------
# Optional: External Services
# -----------------------------------------------------------------------------
# Sentry for error tracking
# SENTRY_DSN=https://...@sentry.io/...

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090

# Health check endpoints
HEALTH_CHECK_ENABLED=true

# -----------------------------------------------------------------------------
# Distributed Tracing (Optional - requires monitoring profile)
# -----------------------------------------------------------------------------
# OTLP endpoint for sending traces (Tempo in docker-compose)
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Sampling configuration
# parentbased_traceidratio samples based on parent trace or ratio
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# Sample 10% of traces (0.1 = 10%, 1.0 = 100%)
OTEL_TRACES_SAMPLER_ARG=0.1

# Tempo ports (when using monitoring profile)
TEMPO_HTTP_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

# -----------------------------------------------------------------------------
# Platform-Internal Telemetry (Optional)
# -----------------------------------------------------------------------------
# Anonymous, opt-in product telemetry, crash issues, traces, Web Vitals and
# alerts. Nothing here stores a user id, an IP address or prompt content.
# The whole surface is additionally gated by the `telemetry` platform feature.

# Release stamped on backend spans and used for release health. Leave empty to
# stamp nothing.
# FLOW_LIKE_RELEASE=

# Where accepted telemetry goes: db (default) | log | none.
#   db   - persist into the telemetry tables
#   log  - log a summary line only, never persist
#   none - accept and drop (endpoints stay live, storage stays empty)
FLOW_LIKE_TELEMETRY_SINK=db

# Head-based trace sampling rate for backend spans, 0.0..=1.0 (default 0.05).
FLOW_LIKE_TRACE_SAMPLE_RATE=0.05

# Retention sweeper for the high-volume tracing/performance tables.
# Days spans are kept (default 7, minimum 1).
FLOW_LIKE_TRACE_RETENTION_DAYS=7
# Days Web Vitals samples are kept (default 30, minimum 1).
FLOW_LIKE_PERF_RETENTION_DAYS=30
# How often the sweeper runs, in seconds (default 3600).
FLOW_LIKE_TELEMETRY_SWEEP_INTERVAL_SECS=3600
# Set to 1/true to stop the in-process sweeper. POST /admin/telemetry/sweep
# still works, which is how serverless deployments sweep.
# FLOW_LIKE_TELEMETRY_SWEEP_DISABLED=0

# Alert evaluator for the in-app alert inbox (no outbound routing).
# How often enabled alert rules are evaluated, in seconds (default 300,
# clamped to at least 30).
FLOW_LIKE_TELEMETRY_ALERT_INTERVAL_SECS=300
# Dedicated token for the database-less maintenance Lambda. Generate at least
# 32 random bytes; leave empty when no external maintenance runner is used.
MAINTENANCE_TOKEN=
# Set to 1/true to stop the in-process evaluator. The service-authenticated
# POST /api/v1/maintenance/run endpoint remains available for serverless
# deployments; the Admin endpoint remains available for manual runs.
# FLOW_LIKE_TELEMETRY_ALERTS_DISABLED=0
