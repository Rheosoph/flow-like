# Generate a private .env with scripts/setup-env.py. This template has no secrets.
# Per-run execution requires Linux, gVisor, and digest-pinned runner images.
COMPOSE_PROJECT_NAME=flowlike
COMPOSE_PROFILES=per-run
COMPOSE_FILE=docker-compose.yml
EXECUTION_ISOLATION_MODE=per_run
OBJECT_STORE_MODE=bundled
BIND_ADDRESS=127.0.0.1

# Public URLs must match browser and desktop reachability. For public hosting,
# terminate TLS at an operator-managed reverse proxy and configure the web URLs.
API_PORT=8080
WEB_PORT=3001
SIGNALING_PORT=4444
PUBLIC_API_URL=http://localhost:8080
# Existing Flow-Like web origin, used by the API's /c, /f and /u shortlinks.
FRONTEND_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3001/callback
NEXT_PUBLIC_REDIRECT_LOGOUT_URL=http://localhost:3001/
REALTIME_ALLOWED_ORIGINS=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
REALTIME_MAX_CONNECTIONS_PER_SUB=16
SIGNALING_NODE_ENV=production
REALTIME_ALLOW_INSECURE_LOCAL_DEV=false

# Separate bounded pools. Budget rollout overlap and administrative connections.
POSTGRES_USER=flowlike
POSTGRES_DB=flowlike
POSTGRES_PASSWORD=
POSTGRES_MAX_CONNECTIONS=100
DATABASE_URL=
# Migration owner credentials are mounted only into db-init.
MIGRATION_DATABASE_URL=
AUDIT_DATABASE_URL=
DATABASE_POOL_MAX_CONNECTIONS=10
DATABASE_POOL_MIN_CONNECTIONS=1
MIGRATION_LOCK_TIMEOUT_SECONDS=120
EXECUTION_STATE_BACKEND=redis
EXECUTION_STATE_TTL_SECONDS=86400
CACHE_BACKEND=redis
CACHE_DEFAULT_TTL_SECONDS=0
REDIS_MAXMEMORY=768mb
REDIS_API_PASSWORD=
REDIS_RUNTIME_PASSWORD=
REDIS_SIGNALING_PASSWORD=
REDIS_SINK_PASSWORD=
REDIS_METRICS_PASSWORD=
# Optional external URLs override the service-specific bundled Redis ACL users.
REDIS_URL=
RUNTIME_REDIS_URL=
SIGNALING_REDIS_URL=
SINK_REDIS_URL=

# Bundled S3 with prefix-scoped STS. Root keys enter bootstrap and storage only.
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-rc.5@sha256:c36b3efea3d1e503f1a2581abd0e7611e0e5820dd30e1850a52384b3fc52bda4
RUSTFS_ROOT_USER=
RUSTFS_ROOT_PASSWORD=
STORAGE_PROVIDER=aws
RUNTIME_CREDENTIALS_PROVIDER=aws
S3_STS_PROVIDER=rustfs
S3_INTERNAL_ENDPOINT=http://object-store:9000
# One exact origin is signed and used by clients, the compiler, and run gateways.
# s3.localhost resolves to loopback locally and to the data gateway in Compose.
S3_GATEWAY_ALIAS=s3.localhost
S3_PORT=9000
S3_PUBLIC_ENDPOINT=http://s3.localhost:9000
AWS_ENDPOINT=
AWS_REGION=us-east-1
AWS_USE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
STS_ENDPOINT_URL=http://object-store:9000
STS_ISSUER_ACCESS_KEY=
STS_ISSUER_SECRET_KEY=
STS_SESSION_TTL_SECONDS=7200
RUNTIME_ROLE_ARN=
META_BUCKET=flow-like-meta
CONTENT_BUCKET=flow-like-content
LOG_BUCKET=flow-like-logs
CDN_BUCKET_NAME=
META_BUCKET_ENDPOINT=
CONTENT_BUCKET_ENDPOINT=
LOGS_BUCKET_ENDPOINT=
S3_KMS_KEY_ARN=
META_BUCKET_KMS_KEY_ARN=
CONTENT_BUCKET_KMS_KEY_ARN=
LOG_BUCKET_KMS_KEY_ARN=
S3_KMS_BUCKET_KEY=false

# Audit trail archive. Bootstrap creates AUDIT_BUCKET with Object Lock, which can only
# be enabled at creation, and a write-only identity for it. The audit worker runs in
# a separate audit-worker service and reaches the store
# directly, not through the bucket-only gateway. An immutable AUDIT_BUCKET is required.
# docker-stack.yml has no bundled object store: point AUDIT_BUCKET_ENDPOINT and
# the dedicated identity at an externally provisioned immutable bucket.
AUDIT_BUCKET=flow-like-audit
AUDIT_BUCKET_ENDPOINT=http://object-store:9000
AUDIT_BUCKET_ACCESS_KEY_ID=
AUDIT_BUCKET_SECRET_ACCESS_KEY=
AUDIT_BUCKET_LOCK_MODE=COMPLIANCE
AUDIT_BUCKET_RETENTION_YEARS=4
AUDIT_BUCKET_KMS_KEY_ARN=
# Audit key: exactly one of AUDIT_SIGNING_KEY (base64 PKCS#8 PEM P-256 key) and
# AUDIT_KMS_KEY_ID (a key in AWS KMS, Cloud KMS, Azure Key Vault, or a Vault /
# OpenBao transit mount); the worker refuses to start with both. setup-env.py
# generates AUDIT_SIGNING_KEY unless AUDIT_KMS_KEY_ID is set in its environment.
# The worker logs the kid and public key.
AUDIT_SIGNING_KEY=
AUDIT_KID=
AUDIT_KMS_KEY_ID=
AUDIT_KMS_PROVIDER=
# AWS KMS only. The region defaults to the one in a key ARN, else AWS_REGION. The
# dedicated credentials are required with bundled storage, whose AWS_* keys would
# otherwise be sent to AWS KMS.
AUDIT_KMS_REGION=
AUDIT_KMS_AWS_ACCESS_KEY_ID=
AUDIT_KMS_AWS_SECRET_ACCESS_KEY=
# Self-hosted key service instead of a cloud one: HashiCorp Vault or OpenBao with a
# transit mount, which signs without a cloud account and is free of per-signature
# charges. Setting the address selects it; AUDIT_KMS_KEY_ID is then the transit key
# name, `audit` or `<mount>/audit`. Create the key with
#   bao secrets enable transit
#   bao write -f transit/keys/audit type=ecdsa-p256
# The token needs only `update` on transit/sign/audit and `read` on
# transit/keys/audit. Point AUDIT_VAULT_TOKEN_FILE at a Vault Agent sink to have
# the token renewed in place; it is re-read for every request.
AUDIT_VAULT_ADDR=
AUDIT_VAULT_TOKEN=
AUDIT_VAULT_TOKEN_FILE=
# PEM bundle of the CA that signed the Vault certificate. Needed whenever Vault
# uses a private CA: only these roots and the built-in public ones are trusted,
# so without it an https:// address fails to connect. Setting it with an http://
# address is refused.
AUDIT_VAULT_CA_FILE=
# Entry key for pending records, base64 of 32 bytes. Empty derives it from
# BACKEND_KEY; set it explicitly before rotating BACKEND_KEY. While rotating it, keep
# the old key in AUDIT_ENTRY_KEY_PREVIOUS until records written before the switch
# are sealed and signed.
AUDIT_ENTRY_KEY=
AUDIT_ENTRY_KEY_PREVIOUS=
# Public keys of audit keys this deployment does not hold, as {"<kid>": "<PEM>"}.
AUDIT_VERIFYING_KEYS=

# Instance counts apply within one Docker host. Compose is not host failover.
API_REPLICAS=2
WEB_REPLICAS=1
SIGNALING_REPLICAS=1
COMPILER_REPLICAS=1
EXECUTION_MANAGER_REPLICAS=1
RUNTIME_REPLICAS=3
API_CPUS=2
API_MEMORY=2G
COMPILER_CPUS=4
COMPILER_MEMORY=8G
RUNTIME_CPUS=4
RUNTIME_MEMORY=8G
WEB_CPUS=0.5
WEB_MEMORY=128M
SIGNALING_CPUS=1
SIGNALING_MEMORY=256M
POSTGRES_CPUS=2
POSTGRES_MEMORY=2G
REDIS_CPUS=1
REDIS_MEMORY=1G
OBJECT_STORE_CPUS=2
OBJECT_STORE_MEMORY=2G

# Disposable execution. pull-images.py pins registry digests; prepare-images.py pins local IDs.
SANDBOX_IMAGE=
SANDBOX_GATEWAY_IMAGE=
SANDBOX_RUNTIME=runsc
DOCKER_SOCKET_PATH=/var/run/docker.sock
EXECUTION_MANAGER_TOKEN=
EXECUTION_ALLOWED_HTTPS_HOSTS=
# Only enable for a TLS origin that forwards bucket data and rejects STS/admin.
EXECUTION_OBJECT_STORE_TLS_GATEWAY=false
MAX_CONCURRENT_EXECUTIONS=10
# Ready, pristine sandboxes per manager, in addition to active run capacity.
# Minimum 1. Empty inventory rejects admission while replacement runs in the background.
SANDBOX_WARM_POOL_SIZE=2
SANDBOX_CREATE_CONCURRENCY=2
EXECUTION_MANAGER_WORKER_THREADS=2
SANDBOX_IDLE_TIMEOUT_SECONDS=300
SANDBOX_STARTUP_TIMEOUT_SECONDS=120
EXECUTION_CLEANUP_TIMEOUT_SECONDS=30
EXECUTION_TERMINAL_GRACE_SECONDS=60
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_PIDS=128
SANDBOX_TMP_MB=256
EXECUTION_TIMEOUT_SECONDS=3600
SHUTDOWN_GRACE_PERIOD=60s
# Allow assigned hour-long runs and finalization to drain on shutdown.
EXECUTION_STOP_GRACE_PERIOD=65m
EXECUTION_BACKEND=http
ASYNC_EXECUTION_BACKEND=redis
EXECUTOR_URL=http://execution-gateway:9000
API_BASE_URL=http://execution-callback:8080
REDIS_EXECUTION_QUEUE=exec:jobs:v3
QUEUE_WORKER_ENABLED=true
QUEUE_WORKER_CONCURRENCY=10
QUEUE_POLL_TIMEOUT_SECS=5
QUEUE_POLL_INTERVAL_MS=250
EXECUTION_QUEUE_MAX_DEPTH=10000
EXECUTION_QUEUE_MAX_WAIT_SECONDS=300
EXECUTION_CREDENTIAL_MARGIN_SECONDS=120
CHANNEL_TTL_SECONDS=7200
QUEUE_BRIDGE_REPLICAS=1

# This deployment implements an HTTP compiler; no compiler Redis consumer exists.
COMPILATION_BACKEND=http
COMPILER_URL=http://compiler-gateway:8081
COMPILER_ALLOWED_STORAGE_HOSTS=http://s3.localhost:9000,http://object-store:9000
COMPILER_TIMEOUT_SECS=600
COMPILER_CALLBACK_TIMEOUT_MS=10000
COMPILER_CALLBACK_RETRIES=3
COMPILER_MAX_PARALLEL_TARGETS=2
COMPILER_MAX_CONCURRENT_JOBS=2

# Analytics prices runs from their duration and the reference function sizing
# (2 GB x86_64 for the full run plus 1.2 GB arm64 for half of it). Scale the
# estimate when this deployment sizes its functions differently. Unset means 1.0.
# COMPUTE_COST_MULTIPLIER=1.0

# Shared host-side hub config, mounted read-only into API and sink-services.
FLOW_LIKE_RUNTIME_CONFIG_FILE=./flow-like.config.example.json
# Container path. Set explicitly empty when selecting JSON or SECRET_REF below.
FLOW_LIKE_CONFIG_FILE=/app/flow-like.config.json
FLOW_LIKE_CONFIG_JSON=
FLOW_LIKE_CONFIG_SECRET_REF=
# Build input for API and audit-worker images. The API falls back to it when no
# runtime source is set; the audit worker takes its audit policy only from its
# audit section, so change it and rebuild the worker to change that policy.
FLOW_LIKE_CONFIG=apps/backend/docker-compose/flow-like.config.example.json
RUST_LOG=info
# Published images: ghcr.io/rheosoph/flow-like-docker-compose-<workload>:FLOW_LIKE_IMAGE_TAG.
# Empty *_IMAGE selects the published image at that tag. scripts/pull-images.py
# pins registry digests; scripts/prepare-images.py builds runtime images locally.
FLOW_LIKE_IMAGE_TAG=dev
API_IMAGE=
AUDIT_WORKER_IMAGE=
DB_INIT_IMAGE=
WEB_IMAGE=
RUNTIME_IMAGE=
COMPILER_IMAGE=
SIGNALING_IMAGE=
SINK_SERVICES_IMAGE=
EXECUTION_MANAGER_IMAGE=
OBJECT_STORE_INIT_IMAGE=

# Generated ES256 keys are base64 PEM. Only the API receives the private key.
BACKEND_KEY=
BACKEND_PUB=
BACKEND_KID=backend-es256-v1
SINK_SECRET=
SINK_TRIGGER_JWT=
SINK_TOKEN_ENCRYPTION_KEY=
MAINTENANCE_TOKEN=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

# Enable with COMPOSE_PROFILES=per-run,monitoring. Grafana is loopback-only.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3002
GRAFANA_ROOT_URL=http://localhost:3002
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# -----------------------------------------------------------------------------
# Cloudflare R2 Runtime Credentials
# -----------------------------------------------------------------------------
# For R2, keep STORAGE_PROVIDER=aws for the S3-compatible primary store and set
# RUNTIME_CREDENTIALS_PROVIDER=r2. Reuse the R2 S3 keys in AWS_* above, then
# configure the temporary-credentials API here.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_API_TOKEN=

# -----------------------------------------------------------------------------
# Azure Blob Storage Configuration (when STORAGE_PROVIDER=azure)
# -----------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# Provider-specific container overrides (optional)
# AZURE_META_CONTAINER=
# AZURE_CONTENT_CONTAINER=
# AZURE_LOG_CONTAINER=

# -----------------------------------------------------------------------------
# GCP Cloud Storage Configuration (when STORAGE_PROVIDER=gcp)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=
# Base64-encoded or raw service account JSON
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Provider-specific bucket overrides (optional)
# GCP_META_BUCKET=
# GCP_CONTENT_BUCKET=
# GCP_LOG_BUCKET=

# -----------------------------------------------------------------------------
# LLM / Model Provider Configuration
# -----------------------------------------------------------------------------
# The backend can proxy LLM requests through various hosted providers.
# Models are defined as "Bits" in the database, each referencing a provider.
#
# Supported providers (set in Bit's provider_name field):
#   - premium / internal / hosted / hosted:openrouter → Routes to OpenRouter
#   - hosted:openai               → Routes to OpenAI
#   - hosted:anthropic            → Routes to Anthropic
#   - hosted:azure                → Routes to Azure OpenAI
#   - hosted:bedrock              → Routes to AWS Bedrock
#   - hosted:vertex               → Routes to Google Vertex AI

# OpenRouter (default for "hosted" provider)
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api

# OpenAI
HOSTED_OPENAI_API_KEY=
HOSTED_OPENAI_ENDPOINT=https://api.openai.com

# Anthropic OpenAI-compatible endpoint
HOSTED_ANTHROPIC_API_KEY=
HOSTED_ANTHROPIC_ENDPOINT=https://api.anthropic.com

# Azure OpenAI. Set the resource root; the proxy appends /openai/v1/chat/completions.
HOSTED_AZURE_API_KEY=
HOSTED_AZURE_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com

# AWS Bedrock OpenAI-compatible endpoint. This proxy uses a Bedrock API key.
# IAM and SigV4 credentials from storage configuration are not used for LLM proxy calls.
HOSTED_BEDROCK_API_KEY=
HOSTED_BEDROCK_ENDPOINT=https://bedrock-mantle.YOUR-REGION.api.aws/v1

# Google Vertex AI OpenAI-compatible endpoint. Supply a current OAuth access token.
HOSTED_VERTEX_API_KEY=
HOSTED_VERTEX_ENDPOINT=https://YOUR-REGION-aiplatform.googleapis.com/v1/projects/YOUR-PROJECT/locations/YOUR-REGION/endpoints/openapi

# Stripe secrets remain server-side. Payment creation defaults off in the hub config.
# Use separate signing secrets for the legacy, Connect and marketplace endpoints.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET_PREVIOUS=
STRIPE_MARKETPLACE_WEBHOOK_SECRET=
STRIPE_MARKETPLACE_WEBHOOK_SECRET_PREVIOUS=
