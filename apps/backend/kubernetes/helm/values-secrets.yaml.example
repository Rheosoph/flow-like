# =============================================================================
# Flow-Like Helm Secrets Configuration
# =============================================================================
# Copy this file to values-secrets.yaml and fill in your actual secrets.
# DO NOT commit values-secrets.yaml to version control!
#
# Usage:
#   helm install flow-like ./helm -f values.yaml -f values-secrets.yaml
#   helm upgrade flow-like ./helm -f values.yaml -f values-secrets.yaml
# =============================================================================

# JWT Configuration (Required unless jwt.existingSecret is set)
# From the repository root, generate keys with:
#   ./tools/gen-execution-keys.sh --export
jwt:
  backendKey: "YOUR_BASE64_ENCODED_PRIVATE_KEY"
  backendPub: "YOUR_BASE64_ENCODED_PUBLIC_KEY"
  backendKid: "backend-es256-v1"

# Storage Credentials (choose the block selected by storage.provider)
storage:
  # Azure Blob Storage
  azure:
    accountName: "your-storage-account"
    accountKey: "your-storage-key"

  # AWS S3
  # aws:
  #   accessKeyId: "AKIAIOSFODNN7EXAMPLE"
  #   secretAccessKey: "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

  # Cloudflare R2
  # r2:
  #   accountId: "your-account-id"
  #   accessKeyId: "your-access-key-id"
  #   secretAccessKey: "your-secret-access-key"

  # Google Cloud Storage
  # gcp:
  #   serviceAccountKey: "BASE64_ENCODED_SERVICE_ACCOUNT_JSON"

  # S3-Compatible Storage
  # s3:
  #   accessKeyId: "your-access-key"
  #   secretAccessKey: "your-secret-key"

# Hosted LLM provider credentials are consumed by the API deployment only.
# Executor pods call the authenticated API proxy through API_BASE_URL.
llm:
  # OpenRouter is enabled by default in values.yaml.
  openrouter:
    apiKey: "your-openrouter-api-key"
    # endpoint: "https://openrouter.ai/api"
    # Instead of apiKey, set existingSecret to a Secret containing
    # OPENROUTER_API_KEY and optional OPENROUTER_ENDPOINT.
    # existingSecret: "flow-like-openrouter"

  # Enable only the hosted providers used by this installation.
  # openai:
  #   enabled: true
  #   apiKey: "your-openai-api-key"
  #   endpoint: "https://api.openai.com"
  #   # existingSecret must contain HOSTED_OPENAI_API_KEY and may contain
  #   # HOSTED_OPENAI_ENDPOINT.
  #   existingSecret: ""

  # anthropic:
  #   enabled: true
  #   apiKey: "your-anthropic-api-key"
  #   endpoint: "https://api.anthropic.com"
  #   # existingSecret must contain HOSTED_ANTHROPIC_API_KEY and may contain
  #   # HOSTED_ANTHROPIC_ENDPOINT.
  #   existingSecret: ""

  # azure:
  #   enabled: true
  #   apiKey: "your-azure-api-key"
  #   endpoint: "https://your-resource.openai.azure.com"
  #   # existingSecret must contain HOSTED_AZURE_API_KEY and
  #   # HOSTED_AZURE_ENDPOINT.
  #   existingSecret: ""

  # bedrock:
  #   enabled: true
  #   apiKey: "your-bedrock-api-key"
  #   endpoint: "https://bedrock-mantle.YOUR-REGION.api.aws/v1"
  #   # existingSecret must contain HOSTED_BEDROCK_API_KEY and
  #   # HOSTED_BEDROCK_ENDPOINT.
  #   existingSecret: ""

  # vertex:
  #   enabled: true
  #   apiKey: "your-current-google-oauth-access-token"
  #   endpoint: "https://YOUR-REGION-aiplatform.googleapis.com/v1/projects/YOUR-PROJECT/locations/YOUR-REGION/endpoints/openapi"
  #   # existingSecret must contain HOSTED_VERTEX_API_KEY and
  #   # HOSTED_VERTEX_ENDPOINT.
  #   existingSecret: ""

# Grafana admin password (optional - auto-generated if empty)
# monitoring:
#   grafana:
#     adminPassword: "your-secure-password"

# Redis password (optional - auto-generated if empty)
# redis:
#   auth:
#     password: "your-redis-password"

# CockroachDB password (optional - auto-generated if empty)
# database:
#   internal:
#     auth:
#       password: "your-cockroach-password"
