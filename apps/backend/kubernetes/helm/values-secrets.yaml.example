# Prefer scripts/setup-config.py. It creates Secrets and a matching values file
# without embedding secret bytes in Helm values or release history.
# These are references only. Create the Secrets before installing.
jwt:
  existingSecret: flow-like-backend-jwt
api:
  existingSecret: flow-like-api-config
  # API only. The audit worker's policy is the config its image was built with.
  runtimeConfig:
    existingSecret: flow-like-hub-config
audit:
  existingSecret: flow-like-audit
  entrySecret: flow-like-audit-entry
  bucketSecret: flow-like-audit-bucket
  bucket: flow-like-audit
  database:
    existingSecret: flow-like-database-audit
  # Copy the public key mapping produced by setup into audit.verifyingKeys.
database:
  apiExistingSecret: flow-like-database
  caSecret: flow-like-database-ca
  migration:
    existingSecret: flow-like-database-migration
  internal:
    auth:
      username: flowlike_migration
    tls:
      nodeSecret: flow-like-database-node
      initSecret: flow-like-database-init
execution:
  existingSecret: flow-like-execution
rustfs:
  existingSecret: flow-like-rustfs-root
storage:
  provider: s3
  s3:
    existingSecret: flow-like-storage
redis:
  auth:
    existingSecret: flow-like-redis
# For a production database:
# database:
#   type: external
#   external:
#     existingSecret: flow-like-database
# Keep database.migration.existingSecret and audit.database.existingSecret
# separate. All three URLs use TLS and distinct database users/passwords.
# Optional hosted model credentials stay in the API only:
# llm:
#   openrouter:
#     existingSecret: flow-like-openrouter
