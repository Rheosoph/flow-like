# =============================================================================
# Flow-Like Kubernetes Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Database type: internal | external
#   internal - Single-node CockroachDB with TLS and separate runtime roles
#   external - Bring your own PostgreSQL/CockroachDB
DATABASE_TYPE=internal

# For external database only:
# The schema-owner login is only for the migration job. All three roles and
# passwords must differ; setup and the migration helper enforce that boundary.
# DATABASE_URL=postgresql://migration:owner-password@your-host:5432/flowlike?sslmode=verify-full
# API_DATABASE_URL=postgresql://api:api-password@your-host:5432/flowlike?sslmode=verify-full
# AUDIT_DATABASE_URL=postgresql://audit:worker-password@your-host:5432/flowlike?sslmode=verify-full
# For a private database CA, set DATABASE_CA_FILE to its local PEM file and
# append &sslrootcert=/etc/database/ca.crt to all URLs.
# DATABASE_CA_FILE=/path/to/database-ca.pem
# Bundled setup generates TLS certificates valid for one year. Retain its
# database-ca-admin secret for renewal; no workload mounts that signing key.

# -----------------------------------------------------------------------------
# Redis Configuration (Job Queue + Execution State)
# -----------------------------------------------------------------------------
# Redis is deployed internally for job queuing
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL is auto-constructed by the chart

# Execution state backend: redis (recommended for Kubernetes)
EXECUTION_STATE_BACKEND=redis
EXECUTION_STATE_TTL_SECONDS=86400

# Flow key/value cache backend: postgres, redis
CACHE_BACKEND=redis
CACHE_DEFAULT_TTL_SECONDS=0

# -----------------------------------------------------------------------------
# Storage Provider Configuration
# -----------------------------------------------------------------------------
# Options: aws, azure, gcp, r2, s3
#   aws   - Native AWS S3 with STS support
#   azure - Native Azure Blob Storage
#   gcp   - Native Google Cloud Storage
#   r2    - Cloudflare R2 (S3-compatible)
#   s3    - Generic S3-compatible storage
STORAGE_PROVIDER=aws

# Bucket/Container names (generic - works across all providers)
META_BUCKET=flow-like-meta
CONTENT_BUCKET=flow-like-content
LOG_BUCKET=flow-like-logs

# -----------------------------------------------------------------------------
# AWS S3 Configuration (when STORAGE_PROVIDER=aws)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_USE_PATH_STYLE=false

# Role ARN for scoped credentials (optional but recommended)
# Used to generate short-lived STS credentials for isolated user/app access
# Example: arn:aws:iam::123456789012:role/FlowLikeRuntimeRole
RUNTIME_ROLE_ARN=

# Customer-managed KMS key encrypting the buckets (optional)
# Scoped STS credentials always carry a KMS grant, so the role behind
# RUNTIME_ROLE_ARN must allow kms:Decrypt / kms:GenerateDataKey on the key.
# Naming the key here narrows that session grant to it (and fences it with
# kms:ViaService) instead of leaning on the role policy alone.
# S3_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/1234abcd-12ab-34cd-56ef-1234567890ab
# META_BUCKET_KMS_KEY_ARN=
# CONTENT_BUCKET_KMS_KEY_ARN=
# LOG_BUCKET_KMS_KEY_ARN=
# A named key is also sent as an explicit SSE-KMS header on writes, which a
# bucket policy denying header-less PUTs requires. Ask for an S3 Bucket Key:
# S3_KMS_BUCKET_KEY=false

# -----------------------------------------------------------------------------
# Audit Trail (Helm values: audit.*)
# -----------------------------------------------------------------------------
# Bucket for monthly archives and daily heads, created with Object Lock by the
# bundled object-store init job. Empty keeps every record in the database.
# scripts/setup-config.py enables it for bundled RustFS and generates the
# write-only identity and the audit key.
AUDIT_BUCKET=flow-like-audit
# External storage only; bundled RustFS is reached directly.
# AUDIT_BUCKET_ENDPOINT=
# AUDIT_BUCKET_ACCESS_KEY_ID=
# AUDIT_BUCKET_SECRET_ACCESS_KEY=
# SSE-KMS key sent with every audit upload (AWS S3)
# AUDIT_BUCKET_KMS_KEY_ARN=
# A dedicated audit-worker Deployment owns signing and archiving. API pods always
# use AUDIT_WORKER=off. Helm audit.worker=false stops the dedicated worker too.
# New bundled buckets default to COMPLIANCE retention for four years.
# Audit key: exactly one of AUDIT_SIGNING_KEY (base64 PKCS#8 PEM P-256 key) and
# AUDIT_KMS_KEY_ID (a key in AWS KMS, Cloud KMS, Azure Key Vault, or a Vault /
# OpenBao transit mount); the worker refuses to start with both. setup-config.py
# generates AUDIT_SIGNING_KEY unless AUDIT_KMS_KEY_ID is set. The worker logs the
# kid and public key.
# AUDIT_SIGNING_KEY=
# AUDIT_KMS_KEY_ID=
# AUDIT_KMS_PROVIDER=aws
# AUDIT_KID=
# AWS KMS only. The region defaults to the one in a key ARN, else AWS_REGION.
# Dedicated credentials are required with bundled RustFS, whose AWS_* keys would
# otherwise be sent to AWS KMS. Azure Key Vault uses Workload Identity when
# AZURE_FEDERATED_TOKEN_FILE is set, else the managed identity.
# AUDIT_KMS_REGION=
# AUDIT_KMS_AWS_ACCESS_KEY_ID=
# AUDIT_KMS_AWS_SECRET_ACCESS_KEY=
# Self-hosted key service instead of a cloud one: HashiCorp Vault or OpenBao with
# a transit mount, in or outside the cluster. The address selects it and
# AUDIT_KMS_KEY_ID is then the transit key, `audit` or `<mount>/audit`:
#   bao secrets enable transit
#   bao write -f transit/keys/audit type=ecdsa-p256
# setup-config.py puts AUDIT_VAULT_TOKEN in the audit secret. With a Vault Agent
# sidecar, set AUDIT_VAULT_TOKEN_FILE to its sink instead; the worker re-reads the
# file for every request, so a renewed token needs no restart.
# AUDIT_VAULT_ADDR=https://vault.vault:8200
# AUDIT_VAULT_TOKEN=
# AUDIT_VAULT_TOKEN_FILE=
# Entry key for pending records, base64 of 32 bytes. Setup generates a separate
# audit-entry secret shared by API and worker. The worker never gets BACKEND_KEY.
# While rotating it, keep the old key in AUDIT_ENTRY_KEY_PREVIOUS until records
# written before the switch are sealed and signed.
# AUDIT_ENTRY_KEY=
# AUDIT_ENTRY_KEY_PREVIOUS=
# Public keys of audit keys this deployment does not hold: {"<kid>": "<PEM>"}
# AUDIT_VERIFYING_KEYS=
# Worker runtime settings are copied from the hub's audit object. When the API
# resolves a remote hub secret, provide that audit object here too.
# AUDIT_CONFIG_JSON={"enabled":true,"require_signing":true}

# -----------------------------------------------------------------------------
# Cloudflare R2 Configuration (when STORAGE_PROVIDER=r2)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: custom bucket names
# R2_META_BUCKET=flow-like-meta
# R2_CONTENT_BUCKET=flow-like-content

# -----------------------------------------------------------------------------
# Azure Blob Storage Configuration (when STORAGE_PROVIDER=azure)
# -----------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
# Optional: container name overrides
# AZURE_META_CONTAINER=flow-like-meta
# AZURE_CONTENT_CONTAINER=flow-like-content

# -----------------------------------------------------------------------------
# GCP Cloud Storage Configuration (when STORAGE_PROVIDER=gcp)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=
# Base64-encoded or raw service account JSON
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Optional: bucket name overrides
# GCP_META_BUCKET=flow-like-meta
# GCP_CONTENT_BUCKET=flow-like-content

# -----------------------------------------------------------------------------
# S3-Compatible Storage Configuration (when STORAGE_PROVIDER=s3)
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# API Service Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
RUST_LOG=info,k8s_api=debug

# -----------------------------------------------------------------------------
# Execution Backend Configuration
# -----------------------------------------------------------------------------
# EXECUTION_BACKEND: Backend for sync/streaming requests (/invoke)
#   http           - HTTP to warm executor pool (default, recommended)
#   kubernetes_job - Create isolated K8s Job per execution (slower, more isolated)
#   redis          - Queue to Redis (consumed by executor pool)
EXECUTION_BACKEND=http

# ASYNC_EXECUTION_BACKEND: Backend for async requests (/invoke/async)
#   redis          - Queue to Redis (default, recommended for K8s)
#   http           - Direct HTTP to executor pool
#   kubernetes_job - Create isolated K8s Job per execution
ASYNC_EXECUTION_BACKEND=redis

# Executor pool URL (for http backend)
EXECUTOR_URL=http://executor-pool:8080

# -----------------------------------------------------------------------------
# Executor Configuration
# -----------------------------------------------------------------------------
K8S_NAMESPACE=flow-like
# Published images: ghcr.io/rheosoph/flow-like-kubernetes-<workload>:<tag>.
# The Helm chart sets these from executor.image, sinkServices.image and
# global.imagePullSecrets; pin digests with scripts/resolve-images.py.
K8S_EXECUTOR_IMAGE=ghcr.io/rheosoph/flow-like-kubernetes-executor:dev
# Comma-separated docker-registry Secret names for private packages or mirrors
K8S_IMAGE_PULL_SECRETS=
# Sink CronJob trigger image and pull secrets (SINK_SCHEDULER_PROVIDER=kubernetes)
SINK_TRIGGER_IMAGE=ghcr.io/rheosoph/flow-like-kubernetes-sink-trigger:dev
SINK_IMAGE_PULL_SECRETS=
USE_KATA_CONTAINERS=false
JOB_TIMEOUT=3600
MAX_CONCURRENT_JOBS=100

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090

# WASM Compilation
COMPILATION_BACKEND=http
COMPILER_URL=http://compiler:8080
API_BASE_URL=http://api:8080
COMPILER_TIMEOUT_SECS=600
COMPILER_CALLBACK_TIMEOUT_MS=10000
COMPILER_CALLBACK_RETRIES=3
COMPILER_MAX_PARALLEL_TARGETS=

# -----------------------------------------------------------------------------
# Platform-Internal Telemetry (Optional)
# -----------------------------------------------------------------------------
# Anonymous, opt-in product telemetry, crash issues, traces, Web Vitals and
# alerts. Nothing here stores a user id, an IP address or prompt content.
# The whole surface is additionally gated by the `telemetry` platform feature.

# Release stamped on backend spans and used for release health. Leave empty to
# stamp nothing.
# FLOW_LIKE_RELEASE=

# Where accepted telemetry goes: db (default) | log | none.
#   db   - persist into the telemetry tables
#   log  - log a summary line only, never persist
#   none - accept and drop (endpoints stay live, storage stays empty)
FLOW_LIKE_TELEMETRY_SINK=db

# Head-based trace sampling rate for backend spans, 0.0..=1.0 (default 0.05).
FLOW_LIKE_TRACE_SAMPLE_RATE=0.05

# Retention sweeper for the high-volume tracing/performance tables.
# Days spans are kept (default 7, minimum 1).
FLOW_LIKE_TRACE_RETENTION_DAYS=7
# Days Web Vitals samples are kept (default 30, minimum 1).
FLOW_LIKE_PERF_RETENTION_DAYS=30
# How often the sweeper runs, in seconds (default 3600).
FLOW_LIKE_TELEMETRY_SWEEP_INTERVAL_SECS=3600
# Set to 1/true to stop the in-process sweeper. POST /admin/telemetry/sweep
# still works, which is how serverless deployments sweep.
# FLOW_LIKE_TELEMETRY_SWEEP_DISABLED=0

# Alert evaluator for the in-app alert inbox (no outbound routing).
# How often enabled alert rules are evaluated, in seconds (default 300,
# clamped to at least 30).
FLOW_LIKE_TELEMETRY_ALERT_INTERVAL_SECS=300
# Dedicated token for an external maintenance runner. Generate at least 32
# random bytes; leave empty when no external runner is used.
MAINTENANCE_TOKEN=
# Set to 1/true to stop the in-process evaluator. The service-authenticated
# POST /api/v1/maintenance/run endpoint remains available for external
# schedulers; the Admin endpoint remains available for manual runs.
# FLOW_LIKE_TELEMETRY_ALERTS_DISABLED=0

# Stripe secrets remain server-side. Payment creation defaults off in the hub config.
# Use separate signing secrets for the legacy, Connect and marketplace endpoints.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET_PREVIOUS=
STRIPE_MARKETPLACE_WEBHOOK_SECRET=
STRIPE_MARKETPLACE_WEBHOOK_SECRET_PREVIOUS=
